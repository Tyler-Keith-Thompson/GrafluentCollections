{"metadata":{"role":"collection","symbolKind":"module","modules":[{"name":"BinarySearchTrees"}],"title":"BinarySearchTrees","externalID":"BinarySearchTrees","roleHeading":"Framework"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree"},{"type":"text","text":" is a sorted set and an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"},{"type":"text","text":" a sorted dictionary, both kept in an AVL"},{"type":"text","text":" "},{"type":"text","text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most"},{"type":"text","text":" "},{"type":"text","text":"one, so lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") and the height stays below"},{"type":"text","text":" "},{"type":"text","text":"1.4405 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 2) − 0.3277. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree"},{"type":"text","text":" is the same sorted set kept in a red–black"},{"type":"text","text":" "},{"type":"text","text":"tree (Guibas and Sedgewick, 1978), whose height stays at most 2 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 1) and whose"},{"type":"text","text":" "},{"type":"text","text":"insertions and removals rotate at most two and three times. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"},{"type":"text","text":" (Seidel and Aragon,"},{"type":"text","text":" "},{"type":"text","text":"1996) keeps a random priority on each vertex, so its shape is a random binary search tree’s"},{"type":"text","text":" "},{"type":"text","text":"whatever order the elements came in: O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected for each operation, plus "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"join(_:)"},{"type":"text","text":", which cut a set at an element and put two sets that don’t interleave back"},{"type":"text","text":" "},{"type":"text","text":"together. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"},{"type":"text","text":" (Sleator and Tarjan, 1985) keeps no balance information: each"},{"type":"text","text":" "},{"type":"text","text":"mutation, and each "},{"type":"codeVoice","code":"access(_:)"},{"type":"text","text":", rotates the element it reaches to the root, for O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized per operation and fast repeated access to the elements in use. Its other reads leave"},{"type":"text","text":" "},{"type":"text","text":"the tree as it is. The sets share one API, so any of them can stand in for another. Their elements are random-access collections in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" for range queries."}]},{"type":"codeListing","code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays linked by "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" slots, so a tree is a copy-on-write value"},{"type":"text","text":" "},{"type":"text","text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside this"},{"type":"text","text":" "},{"type":"text","text":"one), so Grafluent’s tree algorithms and drawings run over it."}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"topicSections":[{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"title":"Sorted sets","anchor":"Sorted-sets"},{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"title":"Sorted dictionaries","anchor":"Sorted-dictionaries"},{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"generated":true,"title":"Extended Modules","anchor":"Extended-Modules"}],"variants":[{"paths":["\/documentation\/binarysearchtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"role":"collection","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"title":"BinarySearchTrees","type":"topic","url":"\/documentation\/binarysearchtrees","kind":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"navigatorTitle":[{"kind":"identifier","text":"Treap"}],"kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"}],"title":"Treap","abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"type":"topic","url":"\/documentation\/binarysearchtrees\/treap"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree":{"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"navigatorTitle":[{"kind":"identifier","text":"SplayTree"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SplayTree"}],"type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","url":"\/documentation\/binarysearchtrees\/splaytree","title":"SplayTree","kind":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree":{"navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}],"kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}],"title":"RedBlackTree","abstract":[{"text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,","type":"text"},{"text":" ","type":"text"},{"text":"with no red vertex under a red one and the same number of black vertices on every path from the","type":"text"},{"text":" ","type":"text"},{"text":"root down (Guibas and Sedgewick, 1978).","type":"text"}],"type":"topic","url":"\/documentation\/binarysearchtrees\/redblacktree"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"abstract":[{"text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AVLTree"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLTree"}],"url":"\/documentation\/binarysearchtrees\/avltree","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","type":"topic","title":"AVLTree","kind":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"navigatorTitle":[{"text":"AVLDictionary","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLDictionary","kind":"identifier"}],"title":"AVLDictionary","abstract":[{"type":"text","text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value."}],"type":"topic","url":"\/documentation\/binarysearchtrees\/avldictionary"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"role":"collection","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees","abstract":[],"type":"topic","title":"Trees","url":"\/documentation\/binarysearchtrees\/trees","kind":"symbol"}}}