{"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees"]}],"metadata":{"roleHeading":"Framework","modules":[{"name":"BinarySearchTrees"}],"role":"collection","title":"BinarySearchTrees","symbolKind":"module","externalID":"BinarySearchTrees"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"},"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"anchor":"Sorted-dictionaries"},{"title":"Extended Modules","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"generated":true,"anchor":"Extended-Modules"}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","isActive":true,"type":"reference"},{"text":" is a sorted set and an ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","isActive":true,"type":"reference"},{"text":" a sorted dictionary, both kept in an AVL","type":"text"},{"text":" ","type":"text"},{"text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most","type":"text"},{"text":" ","type":"text"},{"text":"one, so lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") and the height stays below","type":"text"},{"text":" ","type":"text"},{"text":"1.4405 log₂(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + 2) − 0.3277. A ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","isActive":true,"type":"reference"},{"text":" is the same sorted set kept in a red–black","type":"text"},{"text":" ","type":"text"},{"text":"tree (Guibas and Sedgewick, 1978), whose height stays at most 2 log₂(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + 1) and whose","type":"text"},{"text":" ","type":"text"},{"text":"insertions and removals rotate at most two and three times. A ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","isActive":true,"type":"reference"},{"text":" (Seidel and Aragon,","type":"text"},{"text":" ","type":"text"},{"text":"1996) keeps a random priority on each vertex, so its shape is a random binary search tree’s","type":"text"},{"text":" ","type":"text"},{"text":"whatever order the elements came in: O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected for each operation, plus ","type":"text"},{"code":"split(at:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"join(_:)","type":"codeVoice"},{"text":", which cut a set at an element and put two sets that don’t interleave back","type":"text"},{"text":" ","type":"text"},{"text":"together. A ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","isActive":true,"type":"reference"},{"text":" (Sleator and Tarjan, 1985) keeps no balance information: each","type":"text"},{"text":" ","type":"text"},{"text":"mutation, and each ","type":"text"},{"code":"access(_:)","type":"codeVoice"},{"text":", rotates the element it reaches to the root, for O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"amortized per operation and fast repeated access to the elements in use. Its other reads leave","type":"text"},{"text":" ","type":"text"},{"text":"the tree as it is. The sets share one API, so any of them can stand in for another. Their elements are random-access collections in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":" for range queries.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays linked by "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" slots, so a tree is a copy-on-write value"},{"type":"text","text":" "},{"type":"text","text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside this"},{"type":"text","text":" "},{"type":"text","text":"one), so Grafluent’s tree algorithms and drawings run over it."}]}],"kind":"content"}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLTree","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","url":"\/documentation\/binarysearchtrees\/avltree","abstract":[{"type":"text","text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s"},{"type":"text","text":" "},{"type":"text","text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962)."}],"title":"AVLTree","navigatorTitle":[{"text":"AVLTree","kind":"identifier"}],"type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree":{"role":"symbol","kind":"symbol","url":"\/documentation\/binarysearchtrees\/redblacktree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}],"abstract":[{"text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,","type":"text"},{"text":" ","type":"text"},{"text":"with no red vertex under a red one and the same number of black vertices on every path from the","type":"text"},{"text":" ","type":"text"},{"text":"root down (Guibas and Sedgewick, 1978).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}],"title":"RedBlackTree","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"role":"collection","kind":"symbol","url":"\/documentation\/binarysearchtrees","abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"title":"BinarySearchTrees","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"kind":"symbol","role":"collection","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees","url":"\/documentation\/binarysearchtrees\/trees","abstract":[],"title":"Trees","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SplayTree","kind":"identifier"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","url":"\/documentation\/binarysearchtrees\/splaytree","type":"topic","title":"SplayTree","navigatorTitle":[{"text":"SplayTree","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it","type":"text"},{"text":" ","type":"text"},{"text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985).","type":"text"}],"role":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AVLDictionary"}],"title":"AVLDictionary","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLDictionary"}],"abstract":[{"text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value.","type":"text"}],"url":"\/documentation\/binarysearchtrees\/avldictionary","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","type":"topic","url":"\/documentation\/binarysearchtrees\/treap","title":"Treap","navigatorTitle":[{"kind":"identifier","text":"Treap"}],"kind":"symbol","abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"role":"symbol"}}}