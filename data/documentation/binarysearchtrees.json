{"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree"},{"type":"text","text":" is a sorted set and an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"},{"type":"text","text":" a sorted dictionary, both kept in an AVL"},{"type":"text","text":" "},{"type":"text","text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most"},{"type":"text","text":" "},{"type":"text","text":"one, so lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") and the height stays below"},{"type":"text","text":" "},{"type":"text","text":"1.4405 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 2) − 0.3277. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree"},{"type":"text","text":" is the same sorted set kept in a red–black"},{"type":"text","text":" "},{"type":"text","text":"tree (Guibas and Sedgewick, 1978), whose height stays at most 2 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 1) and whose"},{"type":"text","text":" "},{"type":"text","text":"insertions and removals rotate at most two and three times. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"},{"type":"text","text":" (Seidel and Aragon,"},{"type":"text","text":" "},{"type":"text","text":"1996) keeps a random priority on each vertex, so its shape is a random binary search tree’s"},{"type":"text","text":" "},{"type":"text","text":"whatever order the elements came in: O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected for each operation, plus "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"join(_:)","type":"codeVoice"},{"type":"text","text":", which cut a set at an element and put two sets that don’t interleave back"},{"type":"text","text":" "},{"type":"text","text":"together. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"},{"type":"text","text":" (Sleator and Tarjan, 1985) keeps no balance information: each"},{"type":"text","text":" "},{"type":"text","text":"mutation, and each "},{"code":"access(_:)","type":"codeVoice"},{"type":"text","text":", rotates the element it reaches to the root, for O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized per operation and fast repeated access to the elements in use. Its other reads leave"},{"type":"text","text":" "},{"type":"text","text":"the tree as it is. The sets share one API, so any of them can stand in for another. Their elements are random-access collections in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" for range queries."}]},{"code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays linked by "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" slots, so a tree is a copy-on-write value"},{"type":"text","text":" "},{"type":"text","text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":" (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" module beside this"},{"type":"text","text":" "},{"type":"text","text":"one), so Grafluent’s tree algorithms and drawings run over it."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees"]}],"metadata":{"role":"collection","modules":[{"name":"BinarySearchTrees"}],"title":"BinarySearchTrees","symbolKind":"module","externalID":"BinarySearchTrees","roleHeading":"Framework"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"},"abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"anchor":"Sorted-dictionaries"},{"title":"Extended Modules","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"generated":true,"anchor":"Extended-Modules"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[[]]},"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"}],"title":"Treap","navigatorTitle":[{"text":"Treap","kind":"identifier"}],"url":"\/documentation\/binarysearchtrees\/treap","abstract":[{"text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random","type":"text"},{"text":" ","type":"text"},{"text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996).","type":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","type":"topic","kind":"symbol","role":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"type":"topic","url":"\/documentation\/binarysearchtrees\/avldictionary","title":"AVLDictionary","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLDictionary","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"AVLDictionary","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value."}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"title":"Trees","url":"\/documentation\/binarysearchtrees\/trees","kind":"symbol","type":"topic","abstract":[],"role":"collection","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLTree","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","abstract":[{"type":"text","text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s"},{"type":"text","text":" "},{"type":"text","text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962)."}],"title":"AVLTree","url":"\/documentation\/binarysearchtrees\/avltree","navigatorTitle":[{"text":"AVLTree","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RedBlackTree"}],"title":"RedBlackTree","navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}],"url":"\/documentation\/binarysearchtrees\/redblacktree","abstract":[{"text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,","type":"text"},{"text":" ","type":"text"},{"text":"with no red vertex under a red one and the same number of black vertices on every path from the","type":"text"},{"text":" ","type":"text"},{"text":"root down (Guibas and Sedgewick, 1978).","type":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","type":"topic","kind":"symbol","role":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"type":"topic","url":"\/documentation\/binarysearchtrees","title":"BinarySearchTrees","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree":{"navigatorTitle":[{"text":"SplayTree","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/binarysearchtrees\/splaytree","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SplayTree","kind":"identifier"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","role":"symbol","abstract":[{"text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it","type":"text"},{"text":" ","type":"text"},{"text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985).","type":"text"}],"title":"SplayTree"}}}