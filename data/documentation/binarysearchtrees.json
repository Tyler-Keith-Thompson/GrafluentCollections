{"metadata":{"role":"collection","title":"BinarySearchTrees","externalID":"BinarySearchTrees","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"BinarySearchTrees"}]},"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"anchor":"Sorted-dictionaries"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","interfaceLanguage":"swift"},"abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","type":"reference"},{"type":"text","text":" is a sorted set and an "},{"isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","type":"reference"},{"type":"text","text":" a sorted dictionary, both kept in an AVL"},{"type":"text","text":" "},{"type":"text","text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most"},{"type":"text","text":" "},{"type":"text","text":"one, so lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") and the height stays below"},{"type":"text","text":" "},{"type":"text","text":"1.4405 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 2) − 0.3277. Their elements are random-access collections in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" for range queries."}]},{"type":"codeListing","syntax":"swift","code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays linked by ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" slots, so a tree is a copy-on-write value","type":"text"},{"text":" ","type":"text"},{"text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":" (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside this","type":"text"},{"text":" ","type":"text"},{"text":"one), so Grafluent’s tree algorithms and drawings run over it.","type":"text"}]}],"kind":"content"}],"kind":"symbol","references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"url":"\/documentation\/binarysearchtrees","title":"BinarySearchTrees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLTree","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"AVLTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s"},{"type":"text","text":" "},{"type":"text","text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962)."}],"kind":"symbol","url":"\/documentation\/binarysearchtrees\/avltree","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","title":"AVLTree","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLDictionary"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AVLDictionary"}],"kind":"symbol","url":"\/documentation\/binarysearchtrees\/avldictionary","abstract":[{"text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value.","type":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","title":"AVLDictionary","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"url":"\/documentation\/binarysearchtrees\/trees","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees","title":"Trees","type":"topic"}}}