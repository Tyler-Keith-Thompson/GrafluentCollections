{"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","interfaceLanguage":"swift"},"sections":[],"metadata":{"symbolKind":"module","modules":[{"name":"BinarySearchTrees"}],"roleHeading":"Framework","title":"BinarySearchTrees","role":"collection","externalID":"BinarySearchTrees"},"topicSections":[{"anchor":"Sorted-sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"title":"Sorted sets"},{"anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"title":"Sorted dictionaries"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"generated":true,"title":"Extended Modules"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","isActive":true,"type":"reference"},{"text":" is a sorted set and an ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","isActive":true,"type":"reference"},{"text":" a sorted dictionary, both kept in an AVL","type":"text"},{"text":" ","type":"text"},{"text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most","type":"text"},{"text":" ","type":"text"},{"text":"one, so lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") and the height stays below","type":"text"},{"text":" ","type":"text"},{"text":"1.4405 log₂(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + 2) − 0.3277. A ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","isActive":true,"type":"reference"},{"text":" is the same sorted set kept in a red–black","type":"text"},{"text":" ","type":"text"},{"text":"tree (Guibas and Sedgewick, 1978), whose height stays at most 2 log₂(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" + 1) and whose","type":"text"},{"text":" ","type":"text"},{"text":"insertions and removals rotate at most two and three times. A ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","isActive":true,"type":"reference"},{"text":" (Seidel and Aragon,","type":"text"},{"text":" ","type":"text"},{"text":"1996) keeps a random priority on each vertex, so its shape is a random binary search tree’s","type":"text"},{"text":" ","type":"text"},{"text":"whatever order the elements came in: O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected for each operation, plus ","type":"text"},{"type":"codeVoice","code":"split(at:)"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"join(_:)"},{"text":", which cut a set at an element and put two sets that don’t interleave back","type":"text"},{"text":" ","type":"text"},{"text":"together. A ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","isActive":true,"type":"reference"},{"text":" (Sleator and Tarjan, 1985) keeps no balance information: each","type":"text"},{"text":" ","type":"text"},{"text":"mutation, and each ","type":"text"},{"type":"codeVoice","code":"access(_:)"},{"text":", rotates the element it reaches to the root, for O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"amortized per operation and fast repeated access to the elements in use. Its other reads leave","type":"text"},{"text":" ","type":"text"},{"text":"the tree as it is. The sets share one API, so any of them can stand in for another. Their elements are random-access collections in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank, with ","type":"text"},{"type":"codeVoice","code":"lowerBound(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"upperBound(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"elements(in:)"},{"text":" for range queries.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays linked by "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" slots, so a tree is a copy-on-write value"},{"type":"text","text":" "},{"type":"text","text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside this"},{"type":"text","text":" "},{"type":"text","text":"one), so Grafluent’s tree algorithms and drawings run over it."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees"]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree":{"url":"\/documentation\/binarysearchtrees\/redblacktree","type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","title":"RedBlackTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,","type":"text"},{"text":" ","type":"text"},{"text":"with no red vertex under a red one and the same number of black vertices on every path from the","type":"text"},{"text":" ","type":"text"},{"text":"root down (Guibas and Sedgewick, 1978).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree":{"url":"\/documentation\/binarysearchtrees\/splaytree","type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","title":"SplayTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SplayTree"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it","type":"text"},{"text":" ","type":"text"},{"text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SplayTree"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"title":"Trees","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees","url":"\/documentation\/binarysearchtrees\/trees","abstract":[],"kind":"symbol","role":"collection","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","navigatorTitle":[{"text":"AVLDictionary","kind":"identifier"}],"url":"\/documentation\/binarysearchtrees\/avldictionary","kind":"symbol","type":"topic","title":"AVLDictionary","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLDictionary","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value."}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"role":"symbol","abstract":[{"text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random","type":"text"},{"text":" ","type":"text"},{"text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996).","type":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","title":"Treap","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Treap"}],"url":"\/documentation\/binarysearchtrees\/treap"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"url":"\/documentation\/binarysearchtrees\/avltree","type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","title":"AVLTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLTree","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s"},{"type":"text","text":" "},{"type":"text","text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962)."}],"navigatorTitle":[{"text":"AVLTree","kind":"identifier"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"url":"\/documentation\/binarysearchtrees","type":"topic","kind":"symbol","title":"BinarySearchTrees","role":"collection","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"}}}