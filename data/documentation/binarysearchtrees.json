{"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","type":"reference"},{"text":" is a sorted set and an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","type":"reference"},{"text":" a sorted dictionary, both kept in an AVL","type":"text"},{"text":" ","type":"text"},{"text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most","type":"text"},{"text":" ","type":"text"},{"text":"one, so lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") and the height stays below","type":"text"},{"text":" ","type":"text"},{"text":"1.4405 log₂(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + 2) − 0.3277. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","type":"reference"},{"text":" is the same sorted set kept in a red–black","type":"text"},{"text":" ","type":"text"},{"text":"tree (Guibas and Sedgewick, 1978), whose height stays at most 2 log₂(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" + 1) and whose","type":"text"},{"text":" ","type":"text"},{"text":"insertions and removals rotate at most two and three times. The sets share one API, so either","type":"text"},{"text":" ","type":"text"},{"text":"can stand in for the other. Their elements are random-access collections in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":" for range queries.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays linked by "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" slots, so a tree is a copy-on-write value"},{"type":"text","text":" "},{"type":"text","text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":" (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" module beside this"},{"type":"text","text":" "},{"type":"text","text":"one), so Grafluent’s tree algorithms and drawings run over it."}]}]}],"topicSections":[{"anchor":"Sorted-sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree"],"title":"Sorted sets"},{"anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"title":"Sorted dictionaries"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"generated":true,"title":"Extended Modules"}],"sections":[],"metadata":{"title":"BinarySearchTrees","role":"collection","externalID":"BinarySearchTrees","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"BinarySearchTrees"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees"]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"title":"BinarySearchTrees","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/binarysearchtrees","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"title":"AVLTree","navigatorTitle":[{"text":"AVLTree","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","type":"topic","abstract":[{"type":"text","text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s"},{"type":"text","text":" "},{"type":"text","text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962)."}],"role":"symbol","url":"\/documentation\/binarysearchtrees\/avltree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLTree","kind":"identifier"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees","abstract":[],"type":"topic","url":"\/documentation\/binarysearchtrees\/trees","title":"Trees","role":"collection","kind":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree":{"abstract":[{"text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,","type":"text"},{"text":" ","type":"text"},{"text":"with no red vertex under a red one and the same number of black vertices on every path from the","type":"text"},{"text":" ","type":"text"},{"text":"root down (Guibas and Sedgewick, 1978).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","url":"\/documentation\/binarysearchtrees\/redblacktree","role":"symbol","title":"RedBlackTree"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"title":"AVLDictionary","navigatorTitle":[{"text":"AVLDictionary","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value.","type":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","type":"topic","role":"symbol","url":"\/documentation\/binarysearchtrees\/avldictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLDictionary","kind":"identifier"}]}}}