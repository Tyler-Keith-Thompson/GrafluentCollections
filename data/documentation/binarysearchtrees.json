{"topicSections":[{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"anchor":"Sorted-sets","title":"Sorted sets"},{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"anchor":"Sorted-dictionaries","title":"Sorted dictionaries"},{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees"]}],"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","isActive":true},{"type":"text","text":" is a sorted set and an "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","isActive":true},{"type":"text","text":" a sorted dictionary, both kept in an AVL"},{"type":"text","text":" "},{"type":"text","text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most"},{"type":"text","text":" "},{"type":"text","text":"one, so lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") and the height stays below"},{"type":"text","text":" "},{"type":"text","text":"1.4405 log₂("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" + 2) − 0.3277. A "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","isActive":true},{"type":"text","text":" is the same sorted set kept in a red–black"},{"type":"text","text":" "},{"type":"text","text":"tree (Guibas and Sedgewick, 1978), whose height stays at most 2 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 1) and whose"},{"type":"text","text":" "},{"type":"text","text":"insertions and removals rotate at most two and three times. A "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","isActive":true},{"type":"text","text":" (Seidel and Aragon,"},{"type":"text","text":" "},{"type":"text","text":"1996) keeps a random priority on each vertex, so its shape is a random binary search tree’s"},{"type":"text","text":" "},{"type":"text","text":"whatever order the elements came in: O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected for each operation, plus "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"join(_:)","type":"codeVoice"},{"type":"text","text":", which cut a set at an element and put two sets that don’t interleave back"},{"type":"text","text":" "},{"type":"text","text":"together. A "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","isActive":true},{"type":"text","text":" (Sleator and Tarjan, 1985) keeps no balance information: each"},{"type":"text","text":" "},{"type":"text","text":"mutation, and each "},{"code":"access(_:)","type":"codeVoice"},{"type":"text","text":", rotates the element it reaches to the root, for O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized per operation and fast repeated access to the elements in use. Its other reads leave"},{"type":"text","text":" "},{"type":"text","text":"the tree as it is. The sets share one API, so any of them can stand in for another. Their elements are random-access collections in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" for range queries."}]},{"syntax":"swift","type":"codeListing","code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays linked by ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" slots, so a tree is a copy-on-write value","type":"text"},{"text":" ","type":"text"},{"text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":" (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside this","type":"text"},{"text":" ","type":"text"},{"text":"one), so Grafluent’s tree algorithms and drawings run over it.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"},"metadata":{"externalID":"BinarySearchTrees","roleHeading":"Framework","role":"collection","modules":[{"name":"BinarySearchTrees"}],"title":"BinarySearchTrees","symbolKind":"module"},"hierarchy":{"paths":[[]]},"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"role":"collection","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"url":"\/documentation\/binarysearchtrees","type":"topic","kind":"symbol","title":"BinarySearchTrees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"title":"Trees","kind":"symbol","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/binarysearchtrees\/trees","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"type":"topic","title":"Treap","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","url":"\/documentation\/binarysearchtrees\/treap","abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Treap","kind":"identifier"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"title":"AVLTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLTree"}],"kind":"symbol","url":"\/documentation\/binarysearchtrees\/avltree","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AVLTree"}],"abstract":[{"text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962).","type":"text"}],"type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","abstract":[{"text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value.","type":"text"}],"url":"\/documentation\/binarysearchtrees\/avldictionary","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVLDictionary","kind":"identifier"}],"title":"AVLDictionary","navigatorTitle":[{"text":"AVLDictionary","kind":"identifier"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree":{"role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","abstract":[{"type":"text","text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,"},{"type":"text","text":" "},{"type":"text","text":"with no red vertex under a red one and the same number of black vertices on every path from the"},{"type":"text","text":" "},{"type":"text","text":"root down (Guibas and Sedgewick, 1978)."}],"url":"\/documentation\/binarysearchtrees\/redblacktree","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}],"title":"RedBlackTree","navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree":{"title":"SplayTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SplayTree","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/binarysearchtrees\/splaytree","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","role":"symbol","navigatorTitle":[{"text":"SplayTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"type":"topic"}}}