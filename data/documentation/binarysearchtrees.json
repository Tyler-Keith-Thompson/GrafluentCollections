{"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/binarysearchtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"},"metadata":{"roleHeading":"Framework","title":"BinarySearchTrees","role":"collection","externalID":"BinarySearchTrees","symbolKind":"module","modules":[{"name":"BinarySearchTrees"}]},"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"],"anchor":"Sorted-dictionaries"},{"title":"Extended Modules","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"],"anchor":"Extended-Modules","generated":true}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree"},{"type":"text","text":" is a sorted set and an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary"},{"type":"text","text":" a sorted dictionary, both kept in an AVL"},{"type":"text","text":" "},{"type":"text","text":"tree (Adelson-Velsky and Landis, 1962): the heights of every vertex’s subtrees differ by at most"},{"type":"text","text":" "},{"type":"text","text":"one, so lookup, insertion and removal take O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") and the height stays below"},{"type":"text","text":" "},{"type":"text","text":"1.4405 log₂("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" + 2) − 0.3277. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree"},{"type":"text","text":" is the same sorted set kept in a red–black"},{"type":"text","text":" "},{"type":"text","text":"tree (Guibas and Sedgewick, 1978), whose height stays at most 2 log₂("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" + 1) and whose"},{"type":"text","text":" "},{"type":"text","text":"insertions and removals rotate at most two and three times. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"},{"type":"text","text":" (Seidel and Aragon,"},{"type":"text","text":" "},{"type":"text","text":"1996) keeps a random priority on each vertex, so its shape is a random binary search tree’s"},{"type":"text","text":" "},{"type":"text","text":"whatever order the elements came in: O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") expected for each operation, plus "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"join(_:)","type":"codeVoice"},{"type":"text","text":", which cut a set at an element and put two sets that don’t interleave back"},{"type":"text","text":" "},{"type":"text","text":"together. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"},{"type":"text","text":" (Sleator and Tarjan, 1985) keeps no balance information: each"},{"type":"text","text":" "},{"type":"text","text":"mutation, and each "},{"code":"access(_:)","type":"codeVoice"},{"type":"text","text":", rotates the element it reaches to the root, for O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized per operation and fast repeated access to the elements in use. Its other reads leave"},{"type":"text","text":" "},{"type":"text","text":"the tree as it is. The sets share one API, so any of them can stand in for another. Their elements are random-access collections in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" for range queries."}]},{"type":"codeListing","syntax":"swift","code":["import BinarySearchTrees","","var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: AVLDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays linked by ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" slots, so a tree is a copy-on-write value","type":"text"},{"text":" ","type":"text"},{"text":"that copies a few arrays, and only when a shared copy is mutated. Its shape converts to","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":" (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside this","type":"text"},{"text":" ","type":"text"},{"text":"one), so Grafluent’s tree algorithms and drawings run over it.","type":"text"}]}],"kind":"content"}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree":{"url":"\/documentation\/binarysearchtrees\/splaytree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SplayTree","kind":"identifier"}],"navigatorTitle":[{"text":"SplayTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","role":"symbol","title":"SplayTree"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLDictionary":{"type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLDictionary","role":"symbol","abstract":[{"text":"A sorted dictionary kept in an AVL tree: unique keys in ascending order, each with a value.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AVLDictionary"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLDictionary"}],"kind":"symbol","title":"AVLDictionary","url":"\/documentation\/binarysearchtrees\/avldictionary"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree":{"type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","role":"symbol","abstract":[{"type":"text","text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,"},{"type":"text","text":" "},{"type":"text","text":"with no red vertex under a red one and the same number of black vertices on every path from the"},{"type":"text","text":" "},{"type":"text","text":"root down (Guibas and Sedgewick, 1978)."}],"navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}],"kind":"symbol","url":"\/documentation\/binarysearchtrees\/redblacktree","title":"RedBlackTree"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree":{"abstract":[{"text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962).","type":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","navigatorTitle":[{"kind":"identifier","text":"AVLTree"}],"kind":"symbol","role":"symbol","url":"\/documentation\/binarysearchtrees\/avltree","title":"AVLTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLTree"}],"type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Trees":{"type":"topic","kind":"symbol","abstract":[],"role":"collection","url":"\/documentation\/binarysearchtrees\/trees","title":"Trees","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Trees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","navigatorTitle":[{"kind":"identifier","text":"Treap"}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"}],"title":"Treap","abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"url":"\/documentation\/binarysearchtrees\/treap"},"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"title":"BinarySearchTrees","type":"topic","role":"collection","abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","url":"\/documentation\/binarysearchtrees"}}}