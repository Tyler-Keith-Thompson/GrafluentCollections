           \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"type":"codeVoice","code":"Int32"},{"text":" links, so the tree holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/init(_:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/height"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/elements(in:)-27opt","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/elements(in:)-7qo69","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/max()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/min()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/remove(at:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/remove(checkedAt:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/upperBound(_:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Subscripts","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/subscript(checked:)"],"generated":true,"anchor":"Subscripts"},{"title":"Default Implementations","identifiers":["doc:\/\/BinarySearchTrees\/docume