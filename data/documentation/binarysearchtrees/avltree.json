rt of Computer Programming","type":"text"}],"type":"emphasis"},{"text":", vol. 3, §6.2.3).","type":"text"},{"text":" ","type":"text"},{"text":"The elements are a random-access collection in ascending order, indexed by rank like an","type":"text"},{"text":" ","type":"text"},{"text":"array: ","type":"text"},{"type":"codeVoice","code":"tree[0]"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), and a","type":"text"},{"text":" ","type":"text"},{"text":"pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the tree holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/AVLTree/remove(at:)":{"kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/remove(at:)","abstract":[{"text":"Removes and returns the element at ","type":"text"},{"type":"codeVoice","code":"index"},{"text":".","type":"text"}],"url":"\/documentation\/binarysearchtrees\/avltree\/remove(at:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"kind":"typeIdentifier","precise