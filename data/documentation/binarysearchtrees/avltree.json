{"kind":"symbol","abstract":[{"type":"text","text":"A sorted set kept in an AVL tree: a binary search tree in which the heights of every vertex’s"},{"type":"text","text":" "},{"type":"text","text":"two subtrees differ by at most one (Adelson-Velsky and Landis, 1962)."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and the height stays below"},{"type":"text","text":" "},{"type":"text","text":"1.4405 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 2) − 0.3277 (Knuth, "},{"type":"emphasis","inlineContent":[{"text":"The Art of Computer Programming","type":"text"}]},{"type":"text","text":", vol. 3, §6.2.3)."},{"type":"text","text":" "},{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"type":"text","text":"pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}]},{"code":["var primes: AVLTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the tree holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}]}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Structure","modules":[{"name":"BinarySearchTrees"}],"remoteSource":{"fileName":"AVLTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/AVLTree.swift#L23"},"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVLTree"}],"navigatorTitle":[{"kind":"identifier","text":"AVLTree"}],"externalID":"s:17BinarySearchTrees7AVLTreeV","symbolKind":"struct","title":"AVLTree"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/init(_:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/height"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVL