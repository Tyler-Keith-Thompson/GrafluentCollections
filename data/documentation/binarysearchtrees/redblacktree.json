ackTree\/SetAlgebra-Implementations"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and the height stays at most 2 log₂("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" + 1)."},{"type":"text","text":" "},{"type":"text","text":"An insertion rotates at most twice and a removal at most three times; the recolouring above"},{"type":"text","text":" "},{"type":"text","text":"them is O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") in the worst case and O(1) amortized."},{"type":"text","text":" "},{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"code":"tree[0]","type":"codeVoice"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"type":"text","text":"pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the tree holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/redblacktree"]}],"metadata":{"title":"RedBlackTree","remoteSource":{"fileName":"RedBlackTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/RedBlackTree.swift#L23"},"navigatorTitle":[{"text":"RedBlackTree","kind":"identifier"}],"modules":[{"name":"BinarySearchTrees"}],"symbolKind":"struct","externalID":"s:17BinarySearchTrees12RedBlackTreeV","roleHeading":"Structure","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}]},"seeAlsoSections":[{"title":"Sorted sets","generated":true,"anchor":"Sorted-sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree/ExpressibleByArrayLiteral-Implementations":{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/ExpressibleByA