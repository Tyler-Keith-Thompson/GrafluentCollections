 3, the index of 7"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the tree holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}]}],"seeAlsoSections":[{"generated":true,"title":"Sorted sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"anchor":"Sorted-sets"}],"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/BinarySearchTrees\/SK","doc:\/\/BinarySearchTrees\/Sl","doc:\/\/BinarySearchTrees\/s8CopyableP","doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","doc:\/\/BinarySearchTrees\/Se","doc:\/\/BinarySearchTrees\/SE","doc:\/\/BinarySearchTrees\/SQ","doc:\/\/BinarySearchTrees\/s9EscapableP","doc:\/\/BinarySearchTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/BinarySearchTrees\/SH","doc:\/\/BinarySearchTrees\/Sk","doc:\/\/BinarySearchTrees\/s8SendableP","doc:\/\/BinarySearchTrees\/s16SendableMetatypeP","doc:\/\/BinarySearchTrees\/ST","doc:\/\/BinarySearchTrees\/s10SetAlgebraP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/redblacktree"]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree/lowerBound(_:)":{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/lowerBound(_:)","kind":"symbol","url":"\/