ype":"emphasis"},{"type":"text","text":" + 1)."},{"type":"text","text":" "},{"type":"text","text":"An insertion rotates at most twice and a removal at most three times; the recolouring above"},{"type":"text","text":" "},{"type":"text","text":"them is O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") in the worst case and O(1) amortized."},{"type":"text","text":" "},{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"type":"text","text":"pass through the whole collection costs O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"]},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the tree holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","interfaceLanguage":"swift"},"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree/height":{"url":"\/documentation\/binarysearchtrees\/redblacktree\/height","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"height"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","title":"height","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/height","abstract":[{"type":"text","text":"The number of elements on the longest path from the root down: 0 when empty, 1 for one"},{"type":"text","text":" "},{"type":"text","text":"element, and at most 2 log₂("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" + 1) always. The tree does not record it, so reading it"},{"type":"text","text":" "},{"type":"text","text":"walks every vertex. O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}],"kind":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree":{"navigatorTitle":[{"text":"SplayTree","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/binarysearchtrees\/splaytree","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SplayTree","kind":"identifier"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","role":"symbol","abstract":[{"text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it","type":"text"},{"text":" ","type":"text"},{"text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985).","type":"text"}],"title":"SplayTree"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree/remove(at:)":{"url":"\/documentation\/binarysearchtrees\/redblacktree\/remove(at:)","abstract":[{"text":"Removes and returns the element at ","type":"text"},{"code":"index","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"remove(at:)","type":"topic","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/remove(at:)","role":"symbol","fragments":[{"kind":"