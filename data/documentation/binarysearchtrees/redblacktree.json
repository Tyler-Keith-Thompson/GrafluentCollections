","text":"), and a"},{"type":"text","text":" "},{"type":"text","text":"pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}]},{"syntax":"swift","type":"codeListing","code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"]},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the tree holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/redblacktree"]}],"sections":[],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init(_:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/height"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/color(of:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-37c2j","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-6yum3","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTre