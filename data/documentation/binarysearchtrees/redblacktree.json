neContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":")."}]},{"type":"codeListing","code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the tree holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init(_:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/height"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-37c2j","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-6yum3","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/max()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/min()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/remove(at:)","d