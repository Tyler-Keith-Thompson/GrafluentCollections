{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/redblacktree"]}],"abstract":[{"type":"text","text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,"},{"type":"text","text":" "},{"type":"text","text":"with no red vertex under a red one and the same number of black vertices on every path from the"},{"type":"text","text":" "},{"type":"text","text":"root down (Guibas and Sedgewick, 1978)."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"RedBlackTree","symbolKind":"struct","role":"symbol","modules":[{"name":"BinarySearchTrees"}],"externalID":"s:17BinarySearchTrees12RedBlackTreeV","roleHeading":"Structure","remoteSource":{"fileName":"RedBlackTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/RedBlackTree.swift#L23"},"navigatorTitle":[{"text":"RedBlackTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedBlackTree","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/BinarySearchTrees\/SK","doc:\/\/BinarySearchTrees\/Sl","doc:\/\/BinarySearchTrees\/s8CopyableP","doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","doc:\/\/BinarySearchTrees\/Se","doc:\/\/BinarySearchTrees\/SE","doc:\/\/BinarySearchTrees\/SQ","doc:\/\/BinarySearchTrees\/s9EscapableP","doc:\/\/BinarySearchTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/BinarySearchTrees\/SH","doc:\/\/BinarySearchTrees\/Sk","doc:\/\/BinarySearchTrees\/s8SendableP","doc:\/\/BinarySearchTrees\/s16SendableMetatypeP","doc:\/\/BinarySearchTrees\/ST","doc:\/\/BinarySearchTrees\/s10SetAlgebraP"],"title":"Conforms To","type":"conformsTo"}],"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/docu