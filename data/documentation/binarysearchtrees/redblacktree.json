{"abstract":[{"type":"text","text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,"},{"type":"text","text":" "},{"type":"text","text":"with no red vertex under a red one and the same number of black vertices on every path from the"},{"type":"text","text":" "},{"type":"text","text":"root down (Guibas and Sedgewick, 1978)."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/BinarySearchTrees\/SK","doc:\/\/BinarySearchTrees\/Sl","doc:\/\/BinarySearchTrees\/s8CopyableP","doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","doc:\/\/BinarySearchTrees\/Se","doc:\/\/BinarySearchTrees\/SE","doc:\/\/BinarySearchTrees\/SQ","doc:\/\/BinarySearchTrees\/s9EscapableP","doc:\/\/BinarySearchTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/BinarySearchTrees\/SH","doc:\/\/BinarySearchTrees\/Sk","doc:\/\/BinarySearchTrees\/s8SendableP","doc:\/\/BinarySearchTrees\/s16SendableMetatypeP","doc:\/\/BinarySearchTrees\/ST","doc:\/\/BinarySearchTrees\/s10SetAlgebraP"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"metadata":{"roleHeading":"Structure","symbolKind":"struct","externalID":"s:17BinarySearchTrees12RedBlackTreeV","title":"RedBlackTree","navigatorTitle":[{"text":"RedBlackTree","kind":"identifier"}],"modules":[{"name":"BinarySearchTrees"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/RedBlackTree.swift#L23","fileName":"RedBlackTree.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedBlackTree","kind":"identifier"}],"role":"symbol"},"seeAlsoSections":[{"generated":true,"title":"Sorted sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"anchor":"Sorted-sets"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedBlackTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), and the height stays at most 2 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 1)."},{"type":"text","text":" "},{"type":"text","text":"An insertion rotates at most twice and a removal at most three times; the recolouring above"},{"type":"text","text":" "},{"type":"text","text":"them is O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in the worst case and O(1) amortized."},{"type":"text","text":" "},{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"type":"text","text":"pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}]},{"syntax":"swift","type":"codeListing","code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"]},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"type":"codeVoice","code":"Int32"},{"text":" links, so the tree holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/binarysearchtrees\/redblacktree"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init(_:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/height"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-37c2j","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-6yum3","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/max()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/min()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/remove(at:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTre