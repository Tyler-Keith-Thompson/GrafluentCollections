{"abstract":[{"text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,","type":"text"},{"text":" ","type":"text"},{"text":"with no red vertex under a red one and the same number of black vertices on every path from the","type":"text"},{"text":" ","type":"text"},{"text":"root down (Guibas and Sedgewick, 1978).","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedBlackTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), and the height stays at most 2 log₂(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + 1).","type":"text"},{"text":" ","type":"text"},{"text":"An insertion rotates at most twice and a removal at most three times; the recolouring above","type":"text"},{"text":" ","type":"text"},{"text":"them is O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in the worst case and O(1) amortized.","type":"text"},{"text":" ","type":"text"},{"text":"The elements are a random-access collection in ascending order, indexed by rank like an","type":"text"},{"text":" ","type":"text"},{"text":"array: ","type":"text"},{"code":"tree[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), and a","type":"text"},{"text":" ","type":"text"},{"text":"pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the tree holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"variants":[{"paths":["\/documentation\/binarysearchtrees\/redblacktree"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/init(_:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/height"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-37c2j","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/elements(in:)-6yum3","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlack