ineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + 1).","type":"text"},{"text":" ","type":"text"},{"text":"An insertion rotates at most twice and a removal at most three times; the recolouring above","type":"text"},{"text":" ","type":"text"},{"text":"them is O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in the worst case and O(1) amortized.","type":"text"},{"text":" ","type":"text"},{"text":"The elements are a random-access collection in ascending order, indexed by rank like an","type":"text"},{"text":" ","type":"text"},{"text":"array: ","type":"text"},{"code":"tree[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), and a","type":"text"},{"text":" ","type":"text"},{"text":"pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":").","type":"text"}]},{"type":"codeListing","code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the tree holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/BinarySearchTrees\/SK","doc:\/\/BinarySearchTrees\/Sl","doc:\/\/BinarySearchTrees\/s8CopyableP","doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","doc:\/\/BinarySearchTrees\/Se","doc:\/\/BinarySearchTrees\/SE","doc:\/\/BinarySearchTrees\/SQ","doc:\/\/BinarySearchTrees\/s9Esc