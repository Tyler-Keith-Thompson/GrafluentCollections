g","text":"Overview"},{"inlineContent":[{"type":"text","text":"Lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and the height stays at most 2 log₂("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 1)."},{"type":"text","text":" "},{"type":"text","text":"An insertion rotates at most twice and a removal at most three times; the recolouring above"},{"type":"text","text":" "},{"type":"text","text":"them is O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in the worst case and O(1) amortized."},{"type":"text","text":" "},{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"code":"tree[0]","type":"codeVoice"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"type":"text","text":"pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}],"type":"paragraph"},{"code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the tree holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"RedBlackTree","kind":"identifier"