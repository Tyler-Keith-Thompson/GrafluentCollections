pe":"paragraph"},{"code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the tree holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A sorted set kept in a red–black tree: a binary search tree whose vertices are red or black,"},{"type":"text","text":" "},{"type":"text","text":"with no red vertex under a red one and the same number of black vertices on every path from the"},{"type":"text","text":" "},{"type":"text","text":"root down (Guibas and Sedgewick, 1978)."}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","title":"RedBlackTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedBlackTree"}],"externalID":"s:17BinarySearchTrees12RedBlackTreeV","symbolKind":"struct","modules":[{"name":"BinarySearchTrees"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"RedBlackTree"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/RedBlackTree.swift#L23","fileName":"RedBlackTree.swift"}},"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree/ExpressibleByArrayLiteral-Implementations":{"kind":"article","role":"collectionGroup","abstract":[],"url":"\/documentation\/binarysearchtrees\/redb