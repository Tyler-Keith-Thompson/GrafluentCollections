nlineContent":[{"type":"text","text":"n"}]},{"text":" + 1).","type":"text"},{"text":" ","type":"text"},{"text":"An insertion rotates at most twice and a removal at most three times; the recolouring above","type":"text"},{"text":" ","type":"text"},{"text":"them is O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") in the worst case and O(1) amortized.","type":"text"},{"text":" ","type":"text"},{"text":"The elements are a random-access collection in ascending order, indexed by rank like an","type":"text"},{"text":" ","type":"text"},{"text":"array: ","type":"text"},{"type":"codeVoice","code":"tree[0]"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":"), and a","type":"text"},{"text":" ","type":"text"},{"text":"pass through the whole collection costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var primes: RedBlackTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)        \/\/ false","Array(primes)             \/\/ [2, 3, 5, 7, 11, 13]","primes.lowerBound(6)      \/\/ 3, the index of 7"]},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"type":"codeVoice","code":"Int32"},{"text":" links, so the tree holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/binarysearchtrees\/redblacktree"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"}],"abstract":[{"type":"text","text":"A so