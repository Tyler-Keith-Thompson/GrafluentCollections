BlackTree","preciseIdentifier":"s:17BinarySearchTrees12RedBlackTreeV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Color","kind":"typeIdentifier","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/Color","preciseIdentifier":"s:17BinarySearchTrees12RedBlackTreeV5ColorO"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The root is black, no red vertex has a red child, and every path from the root to an"},{"type":"text","text":" "},{"type":"text","text":"empty link passes the same number of black vertices. Which vertices are red depends on"},{"type":"text","text":" "},{"type":"text","text":"the order of the insertions and removals that built the tree, not only on its elements."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}]}],"name":"Complexity"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/color(of:)"},"variants":[{"paths":["\/documentation\/binarysearchtrees\/redblacktree\/color(of:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/RedBlackTree/color(of:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree\/color(of:)","abstract":[{"text":"The colour of the vertex holding ","type":"text"},{"code":"element","type":"codeVoice"},{"text":", or nil when the tree doesn’t hold it.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":"("},{"kind":"