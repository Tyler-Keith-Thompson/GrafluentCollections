:[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A splay tree keeps no balance information. Any sequence of ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" insertions, removals and","type":"text"},{"text":" ","type":"text"},{"text":"accesses on ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" elements costs O((","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") in all, so each takes O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"amortized, and recently or frequently accessed elements stay near the root: accessing the","type":"text"},{"text":" ","type":"text"},{"text":"elements in ascending order costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in all. Reads (","type":"text"},{"code":"contains(_:)","type":"codeVoice"},{"text":", the bounds, the","type":"text"},{"text":" ","type":"text"},{"text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the","type":"text"},{"text":" ","type":"text"},{"text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run","type":"text"},{"text":" ","type":"text"},{"text":"of ascending insertions can make ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":". Use ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","isActive":true,"type":"reference"},{"text":" to look an element up and splay it.","type":"text"}],"type":"paragraph"},{"syntax":"swift",