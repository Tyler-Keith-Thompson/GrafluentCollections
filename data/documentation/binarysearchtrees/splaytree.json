ructure","symbolKind":"struct","role":"symbol","title":"SplayTree","navigatorTitle":[{"kind":"identifier","text":"SplayTree"}],"remoteSource":{"fileName":"SplayTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/SplayTree.swift#L28"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SplayTree"}],"externalID":"s:17BinarySearchTrees9SplayTreeV","modules":[{"name":"BinarySearchTrees"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SplayTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A splay tree keeps no balance information. Any sequence of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" insertions, removals and"},{"type":"text","text":" "},{"type":"text","text":"accesses on "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" elements costs O(("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") in all, so each takes O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized, and recently or frequently accessed elements stay near the root: accessing the"},{"type":"text","text":" "},{"type":"text","text":"elements in ascending order costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") in all. Reads ("},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":", the bounds, the"},{"type":"text","text":" "},{"type":"text","text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the"},{"type":"text","text":" "},{"type":"text","text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run"},{"type":"text","text":" "},{"type":"text","text":"of ascending insertions can make "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":". Use "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","isActive":true},{"type":"text","text":" to look an element up and splay it."}]},{"code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"code":"tree[0]","type":"codeVoice"},{"type":"text","text":" is the smallest element. The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only"},{"type":"text","text":" "},{"type":"text","text":"when one copy is mutated."}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/splaytree"]}],"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"references":{"doc://BinarySearchTrees/s23CustomStringConvertibleP":{"identifier":"doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","type":"unresolvable","title":"Swift.CustomStringConvertible"},"doc://BinarySearchTrees/SQ":{"identifier":"doc:\/\/BinarySearchTrees\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree/Hashable-Implementations":{"abstract":[],"kind":"article","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Hashable-Implementations","title":"Hashable Implementations","url":"\/documentation\/binarysearchtrees\/splaytree\/hashable-implementations","role":"collectionGroup","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree/SetAlgebra-Implementations":{"kind":"article","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/SetAlgebra-Implementations","url":"\/documentation\/binarysearchtrees\/splaytree\/setalgebra-implementations","type":"topic","title":"SetAlgebr