it is, so they keep the value semantics and the","type":"text"},{"text":" ","type":"text"},{"text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run","type":"text"},{"text":" ","type":"text"},{"text":"of ascending insertions can make ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":". Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)"},{"text":" to look an element up and splay it.","type":"text"}]},{"type":"codeListing","code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The elements are a random-access collection in ascending order, indexed by rank like an","type":"text"},{"text":" ","type":"text"},{"text":"array: ","type":"text"},{"code":"tree[0]","type":"codeVoice"},{"text":" is the smallest element. The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" ","type":"text"},{"text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only","type":"text"},{"text":" ","type":"text"},{"text":"when one copy is mutated.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Sorted sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"],"anchor":"Sorted-sets"}],"kind":"symbol","sections":[],"relationshipsSections":[{"type":"conform