text","text":"n"}]},{"type":"text","text":". Use "},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","type":"reference","isActive":true},{"type":"text","text":" to look an element up and splay it."}]},{"type":"codeListing","syntax":"swift","code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" "},{"type":"text","text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only"},{"type":"text","text":" "},{"type":"text","text":"when one copy is mutated."}]}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/binarysearchtrees\/splaytree"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Split"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/init(_:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/height"]}