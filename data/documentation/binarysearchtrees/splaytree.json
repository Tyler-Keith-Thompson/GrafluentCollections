{"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"seeAlsoSections":[{"title":"Sorted sets","generated":true,"anchor":"Sorted-sets","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/splaytree"]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"SplayTree"}],"roleHeading":"Structure","externalID":"s:17BinarySearchTrees9SplayTreeV","modules":[{"name":"BinarySearchTrees"}],"role":"symbol","title":"SplayTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SplayTree","kind":"identifier"}],"symbolKind":"struct","remoteSource":{"fileName":"SplayTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/SplayTree.swift#L28"}},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SplayTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A splay tree keeps no balance information. Any sequence of "},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" insertions, removals and"},{"type":"text","text":" "},{"type":"text","text":"accesses on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" elements costs O(("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in all, so each takes O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized, and recently or frequently accessed elements stay near the root: accessing the"},{"type":"text","text":" "},{"type":"text","text":"elements in ascending order costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in all. Reads ("},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":", the bounds, the"},{"type":"text","text":" "},{"type":"text","text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the"},{"type":"text","text":" "},{"type":"text","text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run"},{"type":"text","text":" "},{"type":"text","text":"of ascending insertions can make "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":". Use "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","isActive":true},{"type":"text","text":" to look an element up and splay it."}],"type":"paragraph"},{"synt