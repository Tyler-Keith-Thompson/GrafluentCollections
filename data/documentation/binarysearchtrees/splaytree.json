ext":" ","type":"text"},{"text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the","type":"text"},{"text":" ","type":"text"},{"text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run","type":"text"},{"text":" ","type":"text"},{"text":"of ascending insertions can make ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":". Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)"},{"text":" to look an element up and splay it.","type":"text"}],"type":"paragraph"},{"code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" "},{"type":"text","text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only"},{"type":"text","text":" "},{"type":"text","text":"when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"seeAlsoSections":[{"anchor":"Sorted-sets","generated":true,"identifiers":["doc:\/\/BinarySe