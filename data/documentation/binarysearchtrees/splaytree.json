e":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"A splay tree keeps no balance information. Any sequence of ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" insertions, removals and","type":"text"},{"text":" ","type":"text"},{"text":"accesses on ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" elements costs O((","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in all, so each takes O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"amortized, and recently or frequently accessed elements stay near the root: accessing the","type":"text"},{"text":" ","type":"text"},{"text":"elements in ascending order costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in all. Reads (","type":"text"},{"code":"contains(_:)","type":"codeVoice"},{"text":", the bounds, the","type":"text"},{"text":" ","type":"text"},{"text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the","type":"text"},{"text":" ","type":"text"},{"text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run","type":"text"},{"text":" ","type":"text"},{"text":"of ascending insertions can make ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":". Use ","type":"text"},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","isActive":true,"type":"reference"},{"text":" to look an element up and splay it.","type":"text"}],"type":"paragraph"},{"code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" "},{"type":"text","text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only"},{"type":"text","text":" "},{"type":"text","text":"when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree/upperBound(_:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/upperBound(_:)","url":"\/documentation\/binarysearchtrees\/splaytree\/upperbound(_:)","title":"upperBound(_:)","abstract":[{"type":"text","text":"The index of the first element greater than "},{"type":"codeVoice","code":"element"},{"type":"text","text":", or "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":" when none is."},{"type":"text","text":" "},{"type":"text","text":"O(depth)."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"upperBound","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap":{"title":"Treap","type":"topic","url":"\/documentation\/binarysearchtrees\/tre