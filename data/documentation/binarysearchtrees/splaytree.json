als and"},{"type":"text","text":" "},{"type":"text","text":"accesses on "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" elements costs O(("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" + "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") in all, so each takes O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized, and recently or frequently accessed elements stay near the root: accessing the"},{"type":"text","text":" "},{"type":"text","text":"elements in ascending order costs O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") in all. Reads ("},{"code":"contains(_:)","type":"codeVoice"},{"type":"text","text":", the bounds, the"},{"type":"text","text":" "},{"type":"text","text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the"},{"type":"text","text":" "},{"type":"text","text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run"},{"type":"text","text":" "},{"type":"text","text":"of ascending insertions can make "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":". Use "},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","type":"reference","isActive":true},{"type":"text","text":" to look an element up and splay it."}],"type":"paragraph"},{"syntax":"swift","code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" "},{"type":"text","text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only"},{"type":"text","text":" "},{"type":"text","text":"when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"references":{"doc://BinarySearchTrees/SK":{"title":"Swift.BidirectionalCollection","identifier":"doc:\/\/BinarySearchTrees\/SK","type":"unresolvable"},"doc://BinarySearchTrees/s25ExpressibleByArrayLiteralP":{"identifier":"doc:\/\/BinarySearchTrees\/s25ExpressibleByArrayLiteralP","type":"unresolvable","title":"Swift.ExpressibleByArrayLiteral"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree/Decodable-Implementations":{"title":"Decodable Implementations","type":"topic","url":"\/documentation\/binarysearchtrees\/splaytree\/decodable-implementations","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Decodable-Implementations","kind":"article","abstract":[],"role":"collectionGroup"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree/init(_:)":{"role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/init(_:)","abstract":[{"type":"text","text":"The tree holding the distinct elements of "},{"code":"elements","type":"codeVoice"},{"type":"