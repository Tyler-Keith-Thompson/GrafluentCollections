"anchor":"Default-Implementations","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/BidirectionalCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Collection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/CustomStringConvertible-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Decodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Encodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Equatable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/ExpressibleByArrayLiteral-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Hashable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/RandomAccessCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Sequence-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/SetAlgebra-Implementations"],"title":"Default Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SplayTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A splay tree keeps no balance information. Any sequence of "},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" insertions, removals and"},{"type":"text","text":" "},{"type":"text","text":"accesses on "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" elements costs O(("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in all, so each takes O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized, and recently or frequently accessed elements stay near the root: accessing the"},{"type":"text","text":" "},{"type":"text","text":"elements in ascending order costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in all. Reads ("},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":", the bounds, the"},{"type":"text","text":" "},{"type":"text","text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the"},{"type":"text","text":" "},{"type":"text","text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run"},{"type":"text","text":" "},{"type":"text","text":"of ascending insertions can make "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":". Use "},{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","type":"reference","isActive":true},{"type":"text","text":" to look an element up and splay it."}]},{"type":"codeListing","syntax":"swift","code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements are a random-access collection in ascending order, indexed by rank like an"},{"type":"text","text":" "},{"type":"text","text":"array: "},{"type":"codeVoice","code":"tree[0]"},{"type":"text","text":" is the smallest element. The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" "},{"type":"text","text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only"},{"type":"text","text":" "},{"type":"text","text":"when one copy is mutated."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/splaytree"]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"kind":"symbol","type":"topic","url":"\/documentation\/binarysearchtrees","role":"collection","abstract":[{"text":"Balanced binary search trees as sorted sets and sorted dictionaries.","type":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","title":"BinarySearchTrees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/SplayTree/Split":{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Split","type":"topic","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"navigatorTitle":[{"text":"Split","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Split","kind":"identifier"}],"url":"\/documentation\/binary