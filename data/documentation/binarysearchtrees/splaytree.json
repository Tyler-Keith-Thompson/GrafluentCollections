{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/BinarySearchTrees\/SK","doc:\/\/BinarySearchTrees\/Sl","doc:\/\/BinarySearchTrees\/s8CopyableP","doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","doc:\/\/BinarySearchTrees\/Se","doc:\/\/BinarySearchTrees\/SE","doc:\/\/BinarySearchTrees\/SQ","doc:\/\/BinarySearchTrees\/s9EscapableP","doc:\/\/BinarySearchTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/BinarySearchTrees\/SH","doc:\/\/BinarySearchTrees\/Sk","doc:\/\/BinarySearchTrees\/s8SendableP","doc:\/\/BinarySearchTrees\/s16SendableMetatypeP","doc:\/\/BinarySearchTrees\/ST","doc:\/\/BinarySearchTrees\/s10SetAlgebraP"]}],"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"metadata":{"title":"SplayTree","roleHeading":"Structure","modules":[{"name":"BinarySearchTrees"}],"externalID":"s:17BinarySearchTrees9SplayTreeV","navigatorTitle":[{"text":"SplayTree","kind":"identifier"}],"role":"symbol","remoteSource":{"fileName":"SplayTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/SplayTree.swift#L28"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SplayTree"}],"symbolKind":"struct"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SplayTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A splay tree keeps no balance information. Any sequence of "},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" insertions, removals and"},{"type":"text","text":" "},{"type":"text","text":"accesses on "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" elements costs O(("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" + "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") in all, so each takes O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized, and recently or frequently accessed elements stay near the root: accessing the"},{"type":"text","text":" "},{"type":"text","text":"elements in ascending order costs O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") in all. Reads ("},{"code":"contains(_:)","type":"codeVoice"},{"type":"text","text":", the bounds, the"},{"type":"text","text":" "},{"type":"text","text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the"},{"type":"text","text":" "},{"type":"text","text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run"},{"type":"text","text":" "},{"type":"text","text":"of ascending insertions can make "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":". Use "},{"isActive":true,"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","type":"reference"},{"type":"text","text":" to look an element up and splay it."}]},{"syntax":"swift","code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The elements are a random-access collection in ascending order, indexed by rank like an","type":"text"},{"text":" ","type":"text"},{"text":"array: ","type":"text"},{"code":"tree[0]","type":"codeVoice"},{"text":" is the smallest element. The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" ","type":"text"},{"text":"links, so the tree holds fewer than 2³¹ − 1 elements, and copying it copies a few arrays only","type":"text"},{"text":" ","type":"text"},{"text":"when one copy is mutated.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"A sorted set kept in a splay tree: a binary search tree that rotates each element it"},{"type":"text","text":" "},{"type":"text","text":"accesses, inserts or removes up to the root (Sleator and Tarjan, 1985)."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/Split"],"generated":true},{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/init(_:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/height"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc: