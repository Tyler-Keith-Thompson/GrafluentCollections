"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" elements costs O((","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"text":" + ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") in all, so each takes O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"amortized, and recently or frequently accessed elements stay near the root: accessing the","type":"text"},{"text":" ","type":"text"},{"text":"elements in ascending order costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") in all. Reads (","type":"text"},{"type":"codeVoice","code":"contains(_:)"},{"text":", the bounds, the","type":"text"},{"text":" ","type":"text"},{"text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the","type":"text"},{"text":" ","type":"text"},{"text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run","type":"text"},{"text":" ","type":"text"},{"text":"of ascending insertions can make ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":". Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)"},{"text":" to look an element up and splay it.","type":"text"}]},{"code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root","recent.contains(25)           \/\/ false, and the tree is unchanged","let parts = recent.split(at: 30)","Array(parts.lower)            \/\/ [10, 20]","Array(parts.upper)            \/\/ [30, 40, 50]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineConten