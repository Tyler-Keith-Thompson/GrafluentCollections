"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A splay tree keeps no balance information. Any sequence of "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" insertions, removals and"},{"type":"text","text":" "},{"type":"text","text":"accesses on "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" elements costs O(("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" + "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") in all, so each takes O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"amortized, and recently or frequently accessed elements stay near the root: accessing the"},{"type":"text","text":" "},{"type":"text","text":"elements in ascending order costs O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") in all. Reads ("},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":", the bounds, the"},{"type":"text","text":" "},{"type":"text","text":"subscripts and iteration) leave the tree as it is, so they keep the value semantics and the"},{"type":"text","text":" "},{"type":"text","text":"API of the other sorted sets, and take time proportional to the element’s depth, which a run"},{"type":"text","text":" "},{"type":"text","text":"of ascending insertions can make "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":". Use "},{"type":"reference","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree\/access(_:)","isActive":true},{"type":"text","text":" to look an element up and splay it."}],"type":"paragraph"},{"syntax":"swift","code":["var recent: SplayTree 