{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Split"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:using:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(using:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/height"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-1pv5t","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-98uf2","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/join(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/max()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/min()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/remove(at:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/remove(checkedAt:)