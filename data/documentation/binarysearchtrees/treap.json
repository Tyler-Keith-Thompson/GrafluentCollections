"Subscripts","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/subscript(checked:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/BidirectionalCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Collection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/CustomStringConvertible-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Decodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Encodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Equatable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/ExpressibleByArrayLiteral-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Hashable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/RandomAccessCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Sequence-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/SetAlgebra-Implementations"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The random priorities make the shape that of a random binary search tree, whatever order the"},{"type":"text","text":" "},{"type":"text","text":"elements arrive in, so lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected time. A treap"},{"type":"text","text":" "},{"type":"text","text":"also splits at an element into the elements below it and the rest, and joins two treaps whose"},{"type":"text","text":" "},{"type":"text","text":"elements don’t interleave. The elements are a random-access collection in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank like an array: "},{"type":"codeVoice","code":"treap[0]"},{"type":"text","text":" is the smallest element. Reading an element by index"},{"type":"text","text":" "},{"type":"text","text":"costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}],"type":"paragraph"},{"code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The priorities come from a random number generator given at creation,"},{"type":"text","text":" "},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"priorities as its original."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://BinarySearchTrees/s23CustomStringConvertibleP":{"identifier":"doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","type":"unresolvable","title":"Swift.CustomStringConvertible"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/init()":{"fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol","title":"init()","abstract":[{"type":"text","text":"An empty treap whose priorities come from "},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init()","url":"\/documentation\/binarysearchtrees\/treap\/init()","type":"topic","kind":"symbol"},"doc://BinarySearchTrees/Se":{"identifier":"doc:\/\/BinarySearchTrees\/Se","type":"unresolvable","title":"Swift.Decodable"},"doc://BinarySearchTrees/s8CopyableP":{"identifier":"doc:\/\/BinarySearchTrees\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/init(using:)":{"abstract":[{"type":"text","text":"An empty treap whose priorities come from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":"."}],"title":"init(using:)","type":"topic","url":"\/documentation\/binarysearchtrees\/treap\/init(using:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","