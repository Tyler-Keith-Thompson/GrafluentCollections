scripts"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/BidirectionalCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Collection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/CustomStringConvertible-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Decodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Encodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Equatable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/ExpressibleByArrayLiteral-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Hashable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/RandomAccessCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Sequence-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/SetAlgebra-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The random priorities make the shape that of a random binary search tree, whatever order the","type":"text"},{"text":" ","type":"text"},{"text":"elements arrive in, so lookup, insertion and removal take O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") expected time. A treap","type":"text"},{"text":" ","type":"text"},{"text":"also splits at an element into the elements below it and the rest, and joins two treaps whose","type":"text"},{"text":" ","type":"text"},{"text":"elements don’t interleave. The elements are a random-access collection in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank like an array: ","type":"text"},{"type":"codeVoice","code":"treap[0]"},{"text":" is the smallest element. Reading an element by index","type":"text"},{"text":" ","type":"text"},{"text":"costs O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") expected, and a pass through the whole collection costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"]},{"type":"paragraph","inlineContent":[{"text":"The priorities come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"priorities as its original.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/treap"]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/upperBound(_:)":{"type":"topic","url":"\/documentation\/binarysearchtrees\/treap\/upperbound(_:)","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/upperBound(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"upperBound","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","title":"upperBound(_:)","abstract":[{"type":"text","text":"The index of the first element greater than "},{"type":"codeVoice","code":"element"},{"type":"text","text":", or "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":" when none is."},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected."}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/Collection-Implementations":{"type":"topic","url":"\/documentation\/binarysearchtrees\/treap\/collection-implementations","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Collection-Implementations","role":"collectionGroup","abstract":[],"kind":"article","title":"Collection Implementations"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/SetAlgebra-Implementations":{"abstract":[],"url":"\/documentation\/binarysearchtrees\/treap\/setalgebra-implementations","identifier"