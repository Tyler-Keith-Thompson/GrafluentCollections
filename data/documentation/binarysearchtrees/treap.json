tifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The random priorities make the shape that of a random binary search tree, whatever order the"},{"type":"text","text":" "},{"type":"text","text":"elements arrive in, so lookup, insertion and removal take O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") expected time. A treap"},{"type":"text","text":" "},{"type":"text","text":"also splits at an element into the elements below it and the rest, and joins two treaps whose"},{"type":"text","text":" "},{"type":"text","text":"elements don’t interleave. The elements are a random-access collection in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank like an array: "},{"type":"codeVoice","code":"treap[0]"},{"type":"text","text":" is the smallest element. Reading an element by index"},{"type":"text","text":" "},{"type":"text","text":"costs O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") expected, and a pass through the whole collection costs O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"type":"codeListing"},{"inlineContent":[{"text":"The priorities come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"priorities as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the treap holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/treap"]}],"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"kind":"symbol","topicSections":[{"title":"Structures","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Split"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:using:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(using:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/height"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-1pv5t","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-98uf2","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/join(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/docu