{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"},"abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/treap"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"Treap","kind":"identifier"}],"externalID":"s:17BinarySearchTrees5TreapV","title":"Treap","modules":[{"name":"BinarySearchTrees"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/Treap.swift#L31","fileName":"Treap.swift"}},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The random priorities make the shape that of a random binary search tree, whatever order the","type":"text"},{"text":" ","type":"text"},{"text":"elements arrive in, so lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") expected time. A treap","type":"text"},{"text":" ","type":"text"},{"text":"also splits at an element into the elements below it and the rest, and joins two treaps whose","type":"text"},{"text":" ","type":"text"},{"text":"elements don’t interleave. The elements are a random-access collection in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank like an array: ","type":"text"},{"type":"codeVoice","code":"treap[0]"},{"text":" is the smallest element. Reading an element by index","type":"text"},{"text":" ","type":"text"},{"text":"costs O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}]},{"code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The priorities come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"priorities as its original."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"text":" links, so the treap holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}]}],"topicSections":[{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Split"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:using:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(using:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/height"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-1pv5t","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-98uf2","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/join(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/max()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/min()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/priority(of:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/remove(at:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/remove(checkedAt:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/split(at:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/upperBound(_:)"]