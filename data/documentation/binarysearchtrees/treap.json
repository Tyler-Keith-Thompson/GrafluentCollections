nce-Properties","title":"Instance Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/height"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/contains(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-1pv5t","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/elements(in:)-98uf2","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/join(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/lowerBound(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/max()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/min()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/priority(of:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/remove(at:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/remove(checkedAt:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/split(at:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/upperBound(_:)"],"generated":true},{"anchor":"Subscripts","title":"Subscripts","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/subscript(checked:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/BidirectionalCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Collection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/CustomStringConvertible-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Decodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Encodable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Equatable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/ExpressibleByArrayLiteral-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Hashable-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/RandomAccessCollection-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Sequence-Implementations","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/SetAlgebra-Implementations"],"generated":true}],"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The random priorities make the shape that of a random binary search tree, whatever order the","type":"text"},{"text":" ","type":"text"},{"text":"elements arrive in, so lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time. A treap","type":"text"},{"text":" ","type":"text"},{"text":"also splits at an element into the elements below it and the rest, and joins two treaps whose","type":"text"},{"text":" ","type":"text"},{"text":"elements don’t interleave. The elements are a random-access collection in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank like an array: ","type":"text"},{"code":"treap[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index","type":"text"},{"text":" ","type":"text"},{"text":"costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The priorities come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"priorities as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"type":"codeVoice","code":"Int32"},{"text":" links, so the treap holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:17BinarySearchTrees5TreapV","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Treap"}],"t