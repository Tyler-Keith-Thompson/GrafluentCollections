ry search tree, whatever order the"},{"type":"text","text":" "},{"type":"text","text":"elements arrive in, so lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected time. A treap"},{"type":"text","text":" "},{"type":"text","text":"also splits at an element into the elements below it and the rest, and joins two treaps whose"},{"type":"text","text":" "},{"type":"text","text":"elements don’t interleave. The elements are a random-access collection in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank like an array: "},{"type":"codeVoice","code":"treap[0]"},{"type":"text","text":" is the smallest element. Reading an element by index"},{"type":"text","text":" "},{"type":"text","text":"costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}],"type":"paragraph"},{"code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The priorities come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"priorities as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/binarysearchtrees\/treap"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees","role":"collection","type":"topic","title":"BinarySearchTrees","kind":"symbol","url":"\/documentation\/binarysearchtrees"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/min()":{"role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/min()","type":"topic","abstract":[{"type":"text","text":"The smallest element, or nil when empty. O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected."}],"url":"\/documentation\/binarysearchtrees\/treap\/min()","title":"min()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"min"},{"text":"() -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/contains(_:)":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Whether the treap holds an element equal to "},{"type":"codeVoice","code":"element"},{"type":"text","text":". O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected."}],"url":"\/documentation\/binarysearchtrees\/treap\/contains(_:)","title":"contains(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text