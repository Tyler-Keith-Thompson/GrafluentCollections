bleP","doc:\/\/BinarySearchTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/BinarySearchTrees\/SH","doc:\/\/BinarySearchTrees\/Sk","doc:\/\/BinarySearchTrees\/s8SendableP","doc:\/\/BinarySearchTrees\/s16SendableMetatypeP","doc:\/\/BinarySearchTrees\/ST","doc:\/\/BinarySearchTrees\/s10SetAlgebraP"],"title":"Conforms To","type":"conformsTo"}],"metadata":{"externalID":"s:17BinarySearchTrees5TreapV","roleHeading":"Structure","modules":[{"name":"BinarySearchTrees"}],"remoteSource":{"fileName":"Treap.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/Treap.swift#L31"},"role":"symbol","symbolKind":"struct","title":"Treap","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"}],"navigatorTitle":[{"text":"Treap","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"title":"Sorted sets","generated":true,"anchor":"Sorted-sets"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The random priorities make the shape that of a random binary search tree, whatever order the"},{"type":"text","text":" "},{"type":"text","text":"elements arrive in, so lookup, insertion and removal take O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") expected time. A treap"},{"type":"text","text":" "},{"type":"text","text":"also splits at an element into the elements below it and the rest, and joins two treaps whose"},{"type":"text","text":" "},{"type":"text","text":"elements don’t interleave. The elements are a random-access collection in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank like an array: "},{"code":"treap[0]","type":"codeVoice"},{"type":"text","text":" is the smallest element. Reading an element by index"},{"type":"text","text":" "},{"type":"text","text":"costs O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") expected, and a pass through the whole collection costs O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"]},{"inlineContent":[{"type":"text","text":"The priorities come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"priorities as its original."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/binarysearchtrees\/treap"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/init(_:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:)","url":"\/documentation\/binarysearchtrees\/treap\/init(_:)","type":"topic","title":"init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"abstract":[{"type":"text","text":"The treap holding the distinct elements of "},{"type":"codeVoice","code":"elements"},{"type":"text","text":", with priorities from"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":"; of equal elements, the first is kept."}]},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/ExpressibleByArrayLiteral-Implementations":{"type":"topic","url":"\/documentation\/binarysearchtrees\/treap\/expressiblebyarrayliteral-implementations","title":"ExpressibleByArrayLiteral Implementations","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/ExpressibleByArrayLiteral-Implementations","abstract":[],"kind":"article","role":"collectionGroup"},"doc://BinarySearchTrees/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/BinarySearchTrees\/s16SendableMetatypeP"},"doc://BinarySearchTrees/documentation/Bina