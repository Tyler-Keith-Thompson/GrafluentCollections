{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binarysearchtrees\/treap"]}],"identifier":{"url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:17BinarySearchTrees5TreapV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"}],"symbolKind":"struct","remoteSource":{"fileName":"Treap.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/Treap.swift#L31"},"modules":[{"name":"BinarySearchTrees"}],"role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Treap"}],"title":"Treap"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The random priorities make the shape that of a random binary search tree, whatever order the","type":"text"},{"text":" ","type":"text"},{"text":"elements arrive in, so lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") expected time. A treap","type":"text"},{"text":" ","type":"text"},{"text":"also splits at an element into the elements below it and the rest, and joins two treaps whose","type":"text"},{"text":" ","type":"text"},{"text":"elements don’t interleave. The elements are a random-access collection in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank like an array: ","type":"text"},{"code":"treap[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index","type":"text"},{"text":" ","type":"text"},{"text":"costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The priorities come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"priorities as its original."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}]}]}],"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/BinarySearchTrees\/SK","doc:\/