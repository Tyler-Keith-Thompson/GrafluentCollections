ry search tree, whatever order the"},{"type":"text","text":" "},{"type":"text","text":"elements arrive in, so lookup, insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected time. A treap"},{"type":"text","text":" "},{"type":"text","text":"also splits at an element into the elements below it and the rest, and joins two treaps whose"},{"type":"text","text":" "},{"type":"text","text":"elements don’t interleave. The elements are a random-access collection in ascending order,"},{"type":"text","text":" "},{"type":"text","text":"indexed by rank like an array: "},{"code":"treap[0]","type":"codeVoice"},{"type":"text","text":" is the smallest element. Reading an element by index"},{"type":"text","text":" "},{"type":"text","text":"costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"]},{"inlineContent":[{"type":"text","text":"The priorities come from a random number generator given at creation,"},{"type":"text","text":" "},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"priorities as its original."}],"type":"paragraph"},{"inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the treap holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/binarysearchtrees\/treap"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BinarySearchTrees/Se":{"type":"unresolvable","identifier":"doc:\/\/BinarySearchTrees\/Se","title":"Swift.Decodable"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/Split":{"role":"symbol","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Split","abstract":[{"type":"text","text":"The two treaps a split produces: the elements below the split point, and the rest."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Split","kind":"identifier"}],"type":"topic","title":"Treap.Split","navigatorTitle":[{"text":"Split","kind":"identifier"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"url":"\/documentation\/binarysearchtrees\/treap\/split","kind":"symbol"},"doc://BinarySearchTrees/SE":{"type":"unresolvable","title":"Swift.Encodable","identifier":"doc:\/\/BinarySearchTrees\/SE"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/join(_:)":{"abstract":[{"type":"text","text":"Adds the elements of "},{"type":"codeVoice","code":"other"},{"type":"text","text":", all of which lie above this treap’s elements or all below"},{"type":"text","text":" "},{"type":"text","text":"them."}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]