inlineContent":[{"text":"n","type":"text"}]},{"text":") expected, and a pass through the whole collection costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":").","type":"text"}]},{"syntax":"swift","code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The priorities come from a random number generator given at creation,"},{"type":"text","text":" "},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"priorities as its original."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/BinarySearchTrees\/SK","doc:\/\/BinarySearchTrees\/Sl","doc:\/\/BinarySearchTrees\/s8CopyableP","doc:\/\/BinarySearchTrees\/s23CustomStringConvertibleP","doc:\/\/BinarySearchTrees\/Se","doc:\/\/BinarySearchTrees\/SE","doc:\/\/BinarySearchTrees\/SQ","doc:\/\/BinarySearchTrees\/s9EscapableP","doc:\/\/BinarySearchTrees\/s25ExpressibleByArrayLiteralP",