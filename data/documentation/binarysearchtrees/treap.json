"text","text":"n"}]},{"text":") expected time. A treap","type":"text"},{"text":" ","type":"text"},{"text":"also splits at an element into the elements below it and the rest, and joins two treaps whose","type":"text"},{"text":" ","type":"text"},{"text":"elements don’t interleave. The elements are a random-access collection in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank like an array: ","type":"text"},{"type":"codeVoice","code":"treap[0]"},{"text":" is the smallest element. Reading an element by index","type":"text"},{"text":" ","type":"text"},{"text":"costs O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") expected, and a pass through the whole collection costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":").","type":"text"}],"type":"paragraph"},{"code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The priorities come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"priorities as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/CustomStringConvertible-Implementations":{"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/CustomStringConvertible-Implementations","url":"\/documentation\/binarysearchtrees\/treap\/customstringconvertible-implementations","kind":"article","title":"CustomStringConvertible Implementations","role":"collectionGroup","abstract":[],"type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/init()":{"title":"init()","kind":"symbol","url":"\/documentation\/binarysearchtrees\/treap\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init()","abstract":[{"type":"text","text":"An empty treap whose priorities come from "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":"."}],"role":"symbol","type":"topic"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/Collection-Implementations":{"type":"topic","url":"\/documentation\/binarysearchtrees\/treap\/collection-implementations","kind":"article","title":"Collection Implementations","role":"collectionGroup","abstract":[],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Collection-Implementations"},"doc://BinarySearchTrees/documentation/BinarySearchTrees":{"abstract":[{"type":"text","text":"Balanced binary search trees as sorted sets and sorted dictionaries."}],"identifier":"doc:\/\/BinarySearchTrees\/documentati