"sections":[],"abstract":[{"type":"text","text":"A sorted set kept in a treap: a binary search tree whose vertices also carry random"},{"type":"text","text":" "},{"type":"text","text":"priorities, with no vertex of higher priority than its parent (Seidel and Aragon, 1996)."}],"metadata":{"externalID":"s:17BinarySearchTrees5TreapV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Treap","kind":"identifier"}],"role":"symbol","title":"Treap","roleHeading":"Structure","modules":[{"name":"BinarySearchTrees"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/BinarySearchTrees\/Treap.swift#L31","fileName":"Treap.swift"},"navigatorTitle":[{"kind":"identifier","text":"Treap"}],"symbolKind":"struct"},"seeAlsoSections":[{"identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/AVLTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/RedBlackTree","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/SplayTree"],"anchor":"Sorted-sets","title":"Sorted sets","generated":true}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Treap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"The random priorities make the shape that of a random binary search tree, whatever order the","type":"text"},{"text":" ","type":"text"},{"text":"elements arrive in, so lookup, insertion and removal take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time. A treap","type":"text"},{"text":" ","type":"text"},{"text":"also splits at an element into the elements below it and the rest, and joins two treaps whose","type":"text"},{"text":" ","type":"text"},{"text":"elements don’t interleave. The elements are a random-access collection in ascending order,","type":"text"},{"text":" ","type":"text"},{"text":"indexed by rank like an array: ","type":"text"},{"code":"treap[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index","type":"text"},{"text":" ","type":"text"},{"text":"costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"syntax":"swift"},{"inlineContent":[{"text":"The priorities come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"priorities as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees"]]},"references":{"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/upperBound(_:)":{"kind":"symbol","abstract":[{"type":"text","text":"The index of the first element greater than "},{"type":"codeVoice","code":"element"},{"type":"text","text":", or "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":" when none is."},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"upperBound","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"upperBound(_:)","type":"topic","url":"\/documentation\/binarysearchtrees\/treap\/upperbound(_:)","identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/upperBound(_:)","role":"symbol"},"doc://BinarySearchTrees/documentation/BinarySearchTrees/Treap/subscript(checked:)":{"url":"\/documentation\/binarysearchtrees\/treap\/subscript(checked:)","title":"subscript(checked:)","abstract":[{"type":"text","text":"The element at "},{"type":"codeVoice","code":"position"},{"type":"text","text":", throwing instead of trapping on an invalid index."}],"identifier":"doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/subscript(checked:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{