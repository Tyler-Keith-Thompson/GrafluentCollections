inlineContent":[{"text":"n","type":"text"}]},{"text":").","type":"text"}]},{"code":["var numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The priorities come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The treap draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"priorities as its original."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the treap holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"elements, and copying it copies a few arrays only when one copy is mutated."}]}]}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/Split"],"title":"Structures","generated":true},{"anchor":"Initializers","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init()","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(_:using:)","doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/init(using:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/BinarySearchTrees\/documentation\/BinarySearchTrees\/Treap\/height"],"title":"Instance Properties","