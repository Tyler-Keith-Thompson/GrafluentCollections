{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true},{"type":"text","text":" is a sorted set and a "},{"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Framework","role":"collection","title":"BTrees","modules":[{"name":"BTrees"}],"externalID":"BTrees","symbolKind":"module"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BTrees\/documentation\/BTrees"},"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"topicSections":[{"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"title":"Sorted dictionaries","anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"generated":true}],"sections":[],"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BTrees/documentation/BTrees/Trees":{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","url":"\/documentation\/btrees\/trees","type":"topic","abstract":[],"kind":"symbol","role":"collection","title":"Trees"},"doc://BTrees/documentation/BTrees":{"identifier":"doc:\/\/BTrees\/documentation\/BTrees","role":"collection","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"url":"\/documentation\/btrees","kind":"symbol","type":"topic","title":"BTrees"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"title":"BTreeDictionary","role":"symbol","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","url":"\/documentation\/btrees\/btreedictionary","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}]},"doc://BTrees/documentation/BTrees/BTree":{"navigatorTitle":[{"kind":"identifier","text":"BTree"}],"title":"BTree","role":"symbol","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","kind":"symbol","url":"\/documentation\/btrees\/btree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTree"}],"abstract":[{"text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972).","type":"text"}]}}}