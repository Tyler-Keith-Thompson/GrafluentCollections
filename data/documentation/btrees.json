{"sections":[],"kind":"symbol","metadata":{"role":"collection","modules":[{"name":"BTrees"}],"title":"BTrees","symbolKind":"module","roleHeading":"Framework","externalID":"BTrees"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BTrees\/documentation\/BTrees"},"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true,"type":"reference"},{"type":"text","text":" is a sorted set and a "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true,"type":"reference"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"topicSections":[{"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"title":"Sorted dictionaries","anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"]}],"references":{"doc://BTrees/documentation/BTrees":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"url":"\/documentation\/btrees","title":"BTrees","identifier":"doc:\/\/BTrees\/documentation\/BTrees","role":"collection"},"doc://BTrees/documentation/BTrees/BTree":{"title":"BTree","role":"symbol","kind":"symbol","abstract":[{"text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972).","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"navigatorTitle":[{"text":"BTree","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","url":"\/documentation\/btrees\/btree"},"doc://BTrees/documentation/BTrees/Trees":{"abstract":[],"title":"Trees","kind":"symbol","url":"\/documentation\/btrees\/trees","type":"topic","role":"collection","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"title":"BTreeDictionary","url":"\/documentation\/btrees\/btreedictionary","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","abstract":[{"type":"text","text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}],"navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}]}}}