{"kind":"symbol","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BTrees\/documentation\/BTrees"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"BTrees","externalID":"BTrees","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"BTrees"}],"role":"collection"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree"},{"type":"text","text":" is a sorted set and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"code":"BinarySearchTrees","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}]}]}],"topicSections":[{"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"title":"Sorted dictionaries","anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"]}],"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[[]]},"references":{"doc://BTrees/documentation/BTrees/Trees":{"url":"\/documentation\/btrees\/trees","abstract":[],"role":"collection","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","title":"Trees","kind":"symbol"},"doc://BTrees/documentation/BTrees/BTree":{"kind":"symbol","title":"BTree","role":"symbol","navigatorTitle":[{"text":"BTree","kind":"identifier"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","url":"\/documentation\/btrees\/btree","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}]},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"role":"symbol","title":"BTreeDictionary","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","url":"\/documentation\/btrees\/btreedictionary","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}]},"doc://BTrees/documentation/BTrees":{"kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees","url":"\/documentation\/btrees","type":"topic","title":"BTrees","role":"collection","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}]}}}