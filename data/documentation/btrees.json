{"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree"},{"type":"text","text":" is a sorted set and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Trees"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}]}],"kind":"content"}],"metadata":{"role":"collection","symbolKind":"module","title":"BTrees","modules":[{"name":"BTrees"}],"roleHeading":"Framework","externalID":"BTrees"},"topicSections":[{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"title":"Sorted sets","anchor":"Sorted-sets"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"title":"Sorted dictionaries","anchor":"Sorted-dictionaries"},{"generated":true,"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BTrees/documentation/BTrees/BTree":{"url":"\/documentation\/btrees\/btree","abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"navigatorTitle":[{"text":"BTree","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","title":"BTree","type":"topic","kind":"symbol"},"doc://BTrees/documentation/BTrees":{"url":"\/documentation\/btrees","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"role":"collection","identifier":"doc:\/\/BTrees\/documentation\/BTrees","type":"topic","title":"BTrees","kind":"symbol"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"url":"\/documentation\/btrees\/btreedictionary","abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","title":"BTreeDictionary","type":"topic","kind":"symbol"},"doc://BTrees/documentation/BTrees/Trees":{"title":"Trees","kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/btrees\/trees","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees"}}}