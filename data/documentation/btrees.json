,"type":"codeVoice"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"metadata":{"title":"BTrees","externalID":"BTrees","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"BTrees"}],"role":"collection"},"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"references":{"doc://BTrees/documentation/BTrees/BTree":{"abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"url":"\/documentation\/btrees\/btree","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BTree"}],"fra