{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"sections":[],"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true,"type":"reference"},{"text":" is a sorted set and a ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true,"type":"reference"},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"split(at:)","type":"codeVoice"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"BTrees","modules":[{"name":"BTrees"}],"roleHeading":"Framework","role":"collection","externalID":"BTrees","symbolKind":"module"},"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries"},{"title":"Extended Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"anchor":"Extended-Modules","generated":true}],"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"references":{"doc://BTrees/documentation/BTrees/Trees":{"kind":"symbol","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","url":"\/documentation\/btrees\/trees","title":"Trees","role":"collection","abstract":[]},"doc://BTrees/documentation/BTrees":{"title":"BTrees","kind":"symbol","type":"topic","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees","url":"\/documentation\/btrees","role":"collection"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"url":"\/documentation\/btrees\/btreedictionary","title":"BTreeDictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value."}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}]},"doc://BTrees/documentation/BTrees/BTree":{"url":"\/documentation\/btrees\/btree","navigatorTitle":[{"text":"BTree","kind":"identifier"}],"type":"topic","title":"BTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","role":"symbol"}}}