{"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true,"type":"reference"},{"text":" is a sorted set and a ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true,"type":"reference"},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"split(at:)","type":"codeVoice"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"collection","modules":[{"name":"BTrees"}],"title":"BTrees","externalID":"BTrees","roleHeading":"Framework","symbolKind":"module"},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"topicSections":[{"anchor":"Sorted-sets","title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"anchor":"Sorted-dictionaries","title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"anchor":"Extended-Modules","generated":true,"title":"Extended Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"]}],"references":{"doc://BTrees/documentation/BTrees/BTreeDictionary":{"type":"topic","navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","url":"\/documentation\/btrees\/btreedictionary","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"title":"BTreeDictionary"},"doc://BTrees/documentation/BTrees/BTree":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BTree"}],"abstract":[{"text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972).","type":"text"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","url":"\/documentation\/btrees\/btree","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTree"}],"title":"BTree"},"doc://BTrees/documentation/BTrees":{"type":"topic","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees","url":"\/documentation\/btrees","kind":"symbol","role":"collection","title":"BTrees"},"doc://BTrees/documentation/BTrees/Trees":{"type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","kind":"symbol","abstract":[],"url":"\/documentation\/btrees\/trees","role":"collection","title":"Trees"}}}