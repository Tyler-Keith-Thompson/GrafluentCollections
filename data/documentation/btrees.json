{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true},{"type":"text","text":" is a sorted set and a "},{"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","externalID":"BTrees","modules":[{"name":"BTrees"}],"title":"BTrees","role":"collection","symbolKind":"module"},"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries"},{"title":"Extended Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"generated":true,"anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"references":{"doc://BTrees/documentation/BTrees/BTreeDictionary":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"type":"topic","url":"\/documentation\/btrees\/btreedictionary","navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"title":"BTreeDictionary","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},"doc://BTrees/documentation/BTrees":{"role":"collection","kind":"symbol","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"type":"topic","url":"\/documentation\/btrees","title":"BTrees","identifier":"doc:\/\/BTrees\/documentation\/BTrees"},"doc://BTrees/documentation/BTrees/Trees":{"url":"\/documentation\/btrees\/trees","role":"collection","type":"topic","title":"Trees","kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","abstract":[]},"doc://BTrees/documentation/BTrees/BTree":{"navigatorTitle":[{"text":"BTree","kind":"identifier"}],"type":"topic","url":"\/documentation\/btrees\/btree","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","title":"BTree","kind":"symbol","abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"role":"symbol"}}}