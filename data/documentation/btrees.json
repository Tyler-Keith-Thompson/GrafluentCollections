{"hierarchy":{"paths":[[]]},"metadata":{"title":"BTrees","modules":[{"name":"BTrees"}],"role":"collection","roleHeading":"Framework","externalID":"BTrees","symbolKind":"module"},"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","type":"reference","isActive":true},{"type":"text","text":" is a sorted set and a "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"reference","isActive":true},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"code":"BinarySearchTrees","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"anchor":"Extended-Modules"}],"references":{"doc://BTrees/documentation/BTrees":{"type":"topic","url":"\/documentation\/btrees","role":"collection","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"title":"BTrees","identifier":"doc:\/\/BTrees\/documentation\/BTrees","kind":"symbol"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"type":"topic","url":"\/documentation\/btrees\/btreedictionary","kind":"symbol","title":"BTreeDictionary","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"role":"symbol"},"doc://BTrees/documentation/BTrees/BTree":{"kind":"symbol","type":"topic","title":"BTree","url":"\/documentation\/btrees\/btree","navigatorTitle":[{"text":"BTree","kind":"identifier"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","abstract":[{"text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972).","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}]},"doc://BTrees/documentation/BTrees/Trees":{"title":"Trees","url":"\/documentation\/btrees\/trees","abstract":[],"type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","kind":"symbol","role":"collection"}}}