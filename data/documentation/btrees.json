{"metadata":{"title":"BTrees","symbolKind":"module","externalID":"BTrees","roleHeading":"Framework","role":"collection","modules":[{"name":"BTrees"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree"},{"type":"text","text":" is a sorted set and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}]}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"topicSections":[{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets","title":"Sorted sets"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries","title":"Sorted dictionaries"},{"generated":true,"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"anchor":"Extended-Modules","title":"Extended Modules"}],"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"references":{"doc://BTrees/documentation/BTrees/Trees":{"kind":"symbol","role":"collection","title":"Trees","url":"\/documentation\/btrees\/trees","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","type":"topic","abstract":[]},"doc://BTrees/documentation/BTrees":{"type":"topic","url":"\/documentation\/btrees","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"identifier":"doc:\/\/BTrees\