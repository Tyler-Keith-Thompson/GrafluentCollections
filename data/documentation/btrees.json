{"metadata":{"modules":[{"name":"BTrees"}],"externalID":"BTrees","symbolKind":"module","roleHeading":"Framework","role":"collection","title":"BTrees"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets","title":"Sorted sets"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries","title":"Sorted dictionaries"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree"},{"type":"text","text":" is a sorted set and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"sections":[],"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"references":{"doc://BTrees/documentation/BTrees":{"type":"topic","url":"\/documentation\/btrees","title":"BTrees","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees","role":"collection","kind":"symbol"},"doc://BTrees/documentation/BTrees/BTree":{"abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"url":"\/documentation\/btrees\/btree","title":"BTree","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BTree"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTree"}]},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"type":"topic","title":"BTreeDictionary","url":"\/documentation\/btrees\/btreedictionary","abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}]},"doc://BTrees/documentation/BTrees/Trees":{"type":"topic","url":"\/documentation\/btrees\/trees","abstract":[],"title":"Trees","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","role":"collection","kind":"symbol"}}}