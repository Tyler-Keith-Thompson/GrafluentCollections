{"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BTrees\/documentation\/BTrees"},"kind":"symbol","metadata":{"symbolKind":"module","roleHeading":"Framework","title":"BTrees","externalID":"BTrees","modules":[{"name":"BTrees"}],"role":"collection"},"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree"},{"type":"text","text":" is a sorted set and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"code":"BinarySearchTrees","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"title":"Sorted sets","anchor":"Sorted-sets"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"title":"Sorted dictionaries","anchor":"Sorted-dictionaries"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"title":"Extended Modules","generated":true,"anchor":"Extended-Modules"}],"references":{"doc://BTrees/documentation/BTrees":{"type":"topic","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees","url":"\/documentation\/btrees","role":"collection","title":"BTrees"},"doc://BTrees/documentation/BTrees/BTree":{"title":"BTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTree"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BTree"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"url":"\/documentation\/btrees\/btree"},"doc://BTrees/documentation/BTrees/Trees":{"type":"topic","url":"\/documentation\/btrees\/trees","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","kind":"symbol","abstract":[],"title":"Trees","role":"collection"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"title":"BTreeDictionary","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"type":"topic","url":"\/documentation\/btrees\/btreedictionary","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}]}}}