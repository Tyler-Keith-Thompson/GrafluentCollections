{"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"kind":"symbol","topicSections":[{"anchor":"Sorted-sets","title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"anchor":"Sorted-dictionaries","title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"generated":true}],"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Framework","externalID":"BTrees","symbolKind":"module","role":"collection","modules":[{"name":"BTrees"}],"title":"BTrees"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","type":"reference","isActive":true},{"type":"text","text":" is a sorted set and a "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"reference","isActive":true},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"code":"BinarySearchTrees","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://BTrees/documentation/BTrees/BTreeDictionary":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"type":"topic","url":"\/documentation\/btrees\/btreedictionary","kind":"symbol","title":"BTreeDictionary","abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}]},"doc://BTrees/documentation/BTrees/BTree":{"type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"title":"BTree","url":"\/documentation\/btrees\/btree","abstract":[{"text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972).","type":"text"}],"navigatorTitle":[{"text":"BTree","kind":"identifier"}],"role":"symbol"},"doc://BTrees/documentation/BTrees":{"role":"collection","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees","url":"\/documentation\/btrees","title":"BTrees","kind":"symbol"},"doc://BTrees/documentation/BTrees/Trees":{"role":"collection","type":"topic","abstract":[],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","url":"\/documentation\/btrees\/trees","kind":"symbol","title":"Trees"}}}