{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Framework","role":"collection","externalID":"BTrees","modules":[{"name":"BTrees"}],"title":"BTrees","symbolKind":"module"},"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"kind":"symbol","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree"},{"text":" is a sorted set and a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"type":"codeVoice","code":"lowerBound(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"upperBound(_:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"elements(in:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"split(at:)"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BinarySearchTrees"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"title":"Sorted sets","anchor":"Sorted-sets"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"title":"Sorted dictionaries","anchor":"Sorted-dictionaries"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules","generated":true}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"references":{"doc://BTrees/documentation/BTrees/BTreeDictionary":{"kind":"symbol","navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value."}],"url":"\/documentation\/btrees\/btreedictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"title":"BTreeDictionary","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"topic","role":"symbol"},"doc://BTrees/documentation/BTrees":{"kind":"symbol","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"url":"\/documentation\/btrees","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees","title":"BTrees","role":"collection"},"doc://BTrees/documentation/BTrees/BTree":{"abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","title":"BTree","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"navigatorTitle":[{"text":"BTree","kind":"identifier"}],"url":"\/documentation\/btrees\/btree","kind":"symbol"},"doc://BTrees/documentation/BTrees/Trees":{"kind":"symbol","url":"\/documentation\/btrees\/trees","role":"collection","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","type":"topic","abstract":[],"title":"Trees"}}}