{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","type":"reference","isActive":true},{"text":" is a sorted set and a ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"reference","isActive":true},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"type":"codeVoice","code":"lowerBound(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"upperBound(_:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"elements(in:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"split(at:)"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BinarySearchTrees"},{"text":".","type":"text"}]},{"code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"anchor":"Extended-Modules"}],"metadata":{"role":"collection","modules":[{"name":"BTrees"}],"externalID":"BTrees","roleHeading":"Framework","symbolKind":"module","title":"BTrees"},"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"references":{"doc://BTrees/documentation/BTrees":{"url":"\/documentation\/btrees","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"role":"collection","title":"BTrees","identifier":"doc:\/\/BTrees\/documentation\/BTrees","kind":"symbol","type":"topic"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"title":"BTreeDictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"type":"topic","abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","role":"symbol","navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/btrees\/btreedictionary"},"doc://BTrees/documentation/BTrees/Trees":{"role":"collection","title":"Trees","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","url":"\/documentation\/btrees\/trees"},"doc://BTrees/documentation/BTrees/BTree":{"url":"\/documentation\/btrees\/btree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","title":"BTree","navigatorTitle":[{"text":"BTree","kind":"identifier"}]}}}