{"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","type":"reference"},{"text":" is a sorted set and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"reference"},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"split(at:)","type":"codeVoice"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets","title":"Sorted sets"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries","title":"Sorted dictionaries"},{"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","roleHeading":"Framework","modules":[{"name":"BTrees"}],"role":"collection","title":"BTrees","externalID":"BTrees"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://BTrees/documentation/BTrees/BTreeDictionary":{"role":"symbol","title":"BTreeDictionary","navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"abstract":[{"type":"text","text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value."}],"url":"\/documentation\/btrees\/btreedictionary","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},"doc://BTrees/documentation/BTrees":{"role":"collection","title":"BTrees","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"url":"\/documentation\/btrees","type":"topic","kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees"},"doc://BTrees/documentation/BTrees/BTree":{"abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","url":"\/documentation\/btrees\/btree","type":"topic","navigatorTitle":[{"text":"BTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"title":"BTree","kind":"symbol","role":"symbol"},"doc://BTrees/documentation/BTrees/Trees":{"type":"topic","abstract":[],"role":"collection","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","url":"\/documentation\/btrees\/trees","title":"Trees","kind":"symbol"}}}