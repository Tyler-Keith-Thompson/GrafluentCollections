{"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true,"type":"reference"},{"type":"text","text":" is a sorted set and a "},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true,"type":"reference"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"code":"lowerBound(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"upperBound(_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"elements(in:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"split(at:)","type":"codeVoice"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"code":"BinarySearchTrees","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}]}]}],"topicSections":[{"anchor":"Sorted-sets","title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"anchor":"Sorted-dictionaries","title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"anchor":"Extended-Modules","title":"Extended Modules","generated":true,"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"]}],"sections":[],"metadata":{"symbolKind":"module","roleHeading":"Framework","title":"BTrees","role":"collection","modules":[{"name":"BTrees"}],"externalID":"BTrees"},"references":{"doc://BTrees/documentation/BTrees/BTree":{"kind":"symbol","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","role":"symbol","title":"BTree","navigatorTitle":[{"kind":"identifier","text":"BTree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTree"}],"url":"\/documentation\/btrees\/btree","abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}]},"doc://BTrees/documentation/BTrees":{"kind":"symbol","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees","role":"collection","title":"BTrees","url":"\/documentation\/btrees","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}]},"doc://BTrees/documentation/BTrees/Trees":{"role":"collection","type":"topic","abstract":[],"url":"\/documentation\/btrees\/trees","kind":"symbol","title":"Trees","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}],"navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"type":"topic","role":"symbol","abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"url":"\/documentation\/btrees\/btreedictionary","title":"BTreeDictionary"}}}