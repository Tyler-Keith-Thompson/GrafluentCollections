{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"kind":"symbol","metadata":{"modules":[{"name":"BTrees"}],"role":"collection","symbolKind":"module","externalID":"BTrees","roleHeading":"Framework","title":"BTrees"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"anchor":"Sorted-sets"},{"title":"Sorted dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"anchor":"Sorted-dictionaries"},{"title":"Extended Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"anchor":"Extended-Modules","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true,"type":"reference"},{"text":" is a sorted set and a ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true,"type":"reference"},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"split(at:)","type":"codeVoice"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Trees"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BTrees\/documentation\/BTrees"},"references":{"doc://BTrees/documentation/BTrees/Trees":{"title":"Trees","abstract":[],"url":"\/documentation\/btrees\/trees","type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","role":"collection","kind":"symbol"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}],"title":"BTreeDictionary","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/btrees\/btreedictionary","role":"symbol"},"doc://BTrees/documentation/BTrees":{"kind":"symbol","type":"topic","title":"BTrees","url":"\/documentation\/btrees","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"role":"collection","identifier":"doc:\/\/BTrees\/documentation\/BTrees"},"doc://BTrees/documentation/BTrees/BTree":{"title":"BTree","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BTree"}],"url":"\/documentation\/btrees\/btree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTree"}],"kind":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","abstract":[{"text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972).","type":"text"}]}}}