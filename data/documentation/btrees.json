{"metadata":{"modules":[{"name":"BTrees"}],"role":"collection","externalID":"BTrees","symbolKind":"module","title":"BTrees","roleHeading":"Framework"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","type":"reference"},{"type":"text","text":" is a sorted set and a "},{"isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"reference"},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BTrees\/documentation\/BTrees"},"topicSections":[{"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"title":"Sorted dictionaries","anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"]}],"references":{"doc://BTrees/documentation/BTrees/BTreeDictionary":{"abstract":[{"text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value.","type":"text"}],"type":"topic","url":"\/documentation\/btrees\/btreedictionary","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","role":"symbol","fragments"