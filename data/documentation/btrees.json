{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Framework","modules":[{"name":"BTrees"}],"externalID":"BTrees","title":"BTrees","symbolKind":"module","role":"collection"},"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/btrees"]}],"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"topicSections":[{"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"title":"Sorted dictionaries","anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","isActive":true},{"type":"text","text":" is a sorted set and a "},{"type":"reference","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","isActive":true},{"type":"text","text":" a sorted dictionary, both kept in a B-tree"},{"type":"text","text":" "},{"type":"text","text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and"},{"type":"text","text":" "},{"type":"text","text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") with a node-sized constant. Their elements are random-access"},{"type":"text","text":" "},{"type":"text","text":"collections in ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"split(at:)"},{"type":"text","text":"; the API matches the sorted sets and dictionaries of"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"inlineContent":[{"type":"text","text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the"},{"type":"text","text":" "},{"type":"text","text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a vertex per node (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" module beside"},{"type":"text","text":" "},{"type":"text","text":"this one)."}],"type":"paragraph"}]}],"references":{"doc://BTrees/documentation/BTrees/Trees":{"type":"topic","role":"collection","kind":"symbol","title":"Trees","url":"\/documentation\/btrees\/trees","abstract":[],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}],"navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"title":"BTreeDictionary","abstract":[{"type":"text","text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value."}],"url":"\/documentation\/btrees\/btreedictionary","kind":"symbol","role":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"},"doc://BTrees/documentation/BTrees":{"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees","url":"\/documentation\/btrees","role":"collection","kind":"symbol","title":"BTrees","type":"topic"},"doc://BTrees/documentation/BTrees/BTree":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"navigatorTitle":[{"text":"BTree","kind":"identifier"}],"title":"BTree","kind":"symbol","url":"\/documentation\/btrees\/btree","abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"role":"symbol","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree"}}}