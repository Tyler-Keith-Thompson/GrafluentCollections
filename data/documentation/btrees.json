{"identifier":{"url":"doc:\/\/BTrees\/documentation\/BTrees","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"kind":"symbol","metadata":{"modules":[{"name":"BTrees"}],"title":"BTrees","externalID":"BTrees","roleHeading":"Framework","symbolKind":"module","role":"collection"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","type":"reference","isActive":true},{"text":" is a sorted set and a ","type":"text"},{"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"reference","isActive":true},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"split(at:)","type":"codeVoice"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Trees"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"]},{"title":"Sorted dictionaries","anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"]},{"title":"Extended Modules","anchor":"Extended-Modules","generated":true,"identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"]}],"references":{"doc://BTrees/documentation/BTrees/BTree":{"role":"symbol","url":"\/documentation\/btrees\/btree","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","kind":"symbol","abstract":[{"type":"text","text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972)."}],"type":"topic","title":"BTree","navigatorTitle":[{"text":"BTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}]},"doc://BTrees/documentation/BTrees":{"title":"BTrees","url":"\/documentation\/btrees","identifier":"doc:\/\/BTrees\/documentation\/BTrees","kind":"symbol","abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"type":"topic","role":"collection"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"title":"BTreeDictionary","url":"\/documentation\/btrees\/btreedictionary","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","kind":"symbol","abstract":[{"type":"text","text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value."}],"navigatorTitle":[{"text":"BTreeDictionary","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTreeDictionary","kind":"identifier"}]},"doc://BTrees/documentation/BTrees/Trees":{"title":"Trees","url":"\/documentation\/btrees\/trees","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","kind":"symbol","abstract":[],"type":"topic","role":"collection"}}}