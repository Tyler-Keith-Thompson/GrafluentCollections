{"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"B-trees as sorted sets and sorted dictionaries.","type":"text"}],"metadata":{"role":"collection","title":"BTrees","symbolKind":"module","roleHeading":"Framework","externalID":"BTrees","modules":[{"name":"BTrees"}]},"kind":"symbol","topicSections":[{"anchor":"Sorted-sets","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTree"],"title":"Sorted sets"},{"anchor":"Sorted-dictionaries","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary"],"title":"Sorted dictionaries"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/BTrees\/documentation\/BTrees\/Trees"],"generated":true,"title":"Extended Modules"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","type":"reference"},{"text":" is a sorted set and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","type":"reference"},{"text":" a sorted dictionary, both kept in a B-tree","type":"text"},{"text":" ","type":"text"},{"text":"(Bayer and McCreight, 1972): each node holds tens of elements side by side in ascending order, and","type":"text"},{"text":" ","type":"text"},{"text":"every leaf lies at the same depth. A lookup reads a few nodes, and few cache lines, so lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal take O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") with a node-sized constant. Their elements are random-access","type":"text"},{"text":" ","type":"text"},{"text":"collections in ascending order, indexed by rank, with ","type":"text"},{"type":"codeVoice","code":"lowerBound(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"upperBound(_:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"elements(in:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"split(at:)"},{"text":"; the API matches the sorted sets and dictionaries of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BinarySearchTrees"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import BTrees","","var primes: BTree = [7, 2, 11, 3, 5]","primes.insert(13)","primes.contains(4)      \/\/ false","primes.lowerBound(6)    \/\/ 3, the index of 7","","var stock: BTreeDictionary = [\"pear\": 4, \"apple\": 7]","stock[\"fig\"] = 2","stock.map(\\.key)        \/\/ [\"apple\", \"fig\", \"pear\"]"]},{"type":"paragraph","inlineContent":[{"text":"Each node is one allocation, shared between copies of the tree: mutating a copy copies only the","type":"text"},{"text":" ","type":"text"},{"text":"nodes on the path it changes and leaves the rest shared. The shape converts to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", a vertex per node (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside","type":"text"},{"text":" ","type":"text"},{"text":"this one).","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/BTrees\/documentation\/BTrees"},"sections":[],"variants":[{"paths":["\/documentation\/btrees"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BTrees/documentation/BTrees":{"url":"\/documentation\/btrees","kind":"symbol","type":"topic","title":"BTrees","role":"collection","abstract":[{"type":"text","text":"B-trees as sorted sets and sorted dictionaries."}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees"},"doc://BTrees/documentation/BTrees/BTreeDictionary":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A sorted dictionary kept in a B-tree: unique keys in ascending order, each with a value."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BTreeDictionary"}],"identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTreeDictionary","title":"BTreeDictionary","navigatorTitle":[{"kind":"identifier","text":"BTreeDictionary"}],"url":"\/documentation\/btrees\/btreedictionary"},"doc://BTrees/documentation/BTrees/Trees":{"kind":"symbol","role":"collection","abstract":[],"type":"topic","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/Trees","title":"Trees","url":"\/documentation\/btrees\/trees"},"doc://BTrees/documentation/BTrees/BTree":{"role":"symbol","title":"BTree","identifier":"doc:\/\/BTrees\/documentation\/BTrees\/BTree","url":"\/documentation\/btrees\/btree","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BTree","kind":"identifier"}],"navigatorTitle":[{"text":"BTree","kind":"identifier"}],"abstract":[{"text":"A sorted set kept in a B-tree: a search tree whose nodes each hold many elements in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, every leaf at the same depth (Bayer and McCreight, 1972).","type":"text"}]}}}