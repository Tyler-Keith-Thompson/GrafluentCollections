{"topicSections":[{"title":"Caches","anchor":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"],"generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache"},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}],"type":"paragraph"},{"code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)"},{"text":" read without promoting, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)"},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The recency list converts to Grafluent’s ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", a path from the most","type":"text"},{"text":" ","type":"text"},{"text":"recent entry down.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/caches"]}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"roleHeading":"Framework","title":"Caches","externalID":"Caches","symbolKind":"module","role":"collection","modules":[{"name":"Caches"}]},"sections":[],"abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"references":{"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"title":"peek(_:)","url":"\/documentation\/caches\/lrucache\/peek(_:)","kind":"symbol","abstract":[{"text":"The value for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" without making it the most recent, or nil when absent. O(1).","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"peek"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":"?"}]},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"abstract":[{"type":"text","text":"Stores "},{"code":"value","type":"codeVoice"},{"type":"text","text":" for "},{"code":"key","type":"codeVoice"},{"type":"text","text":" as the most recent entry, and returns the entry evicted to make"},{"type":"text","text":" "},{"type":"text","text":"room: nil when "},{"code":"key","type":"codeVoice"},{"type":"text","text":" was present (its value is replaced) or the cache had room, and the new"},{"type":"text","text":" "},{"type":"text","text":"entry itself when the capacity is 0."}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"forKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"LRUCache","preciseIdentifier":"s:6Caches8LRUCacheV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Entry","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"insert(_:forKey:)","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)"},"doc://Caches/documentation/Caches/LRUCache":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","title":"LRUCache","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"LRUCache","kind":"identifier"}],"abstract":[{"type":"text","text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion, removal and eviction each take O(1) on average."}],"url":"\/documentation\/caches\/lrucache","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LRUCache","kind":"identifier"}]},"doc://Caches/documentation/Caches":{"url":"\/documentation\/caches","title":"Ca