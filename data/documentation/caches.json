{"abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","type":"reference","isActive":true},{"text":" holds at most a fixed number of entries. Storing one more when it is full evicts","type":"text"},{"text":" ","type":"text"},{"text":"the least recently used entry, where reading a value or storing it counts as a use.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"type":"codeListing"},{"inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","type":"reference"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","type":"reference"},{"text":" read without promoting, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","type":"reference"},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Caches","title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"]}],"metadata":{"role":"collection","externalID":"Caches","modules":[{"name":"Caches"}],"roleHeading":"Framework","symbolKind":"module","title":"Caches"},"variants":[{"paths":["\/documentation\/caches"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"references":{"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"abstract":[{"type":"text","text":"The value for "},{"type":"codeVoice","code":"key"},{"type":"text","text":" without making it the most recent, or nil when absent. O(1)."}],"role":"symbol","title":"peek(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"peek","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/caches\/lrucache\/peek(_:)"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"abstract":[{"type":"text","text":"Stores "},{"type":"codeVoice","code":"value"},{"type":"text","text":" for "},{"type":"codeVoice","code":"key"},{"type":"text","text":" as the most recent entry, and returns the entry evicted to make"},{"type":"text","text":" "},{"type":"text","text":"room: nil when "},{"type":"codeVoice","code":"key"},{"type":"text","text":" was present (its value is replaced) or the cache had room, and the new"},{"type":"text","text":" "},{"type":"text","text":"entry itself when the capacity is 0."}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"forKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"LRUCache","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV"},{"text":"<","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Entry","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","title":"insert(_:forKey:)"},"doc://Caches/documentation/Caches/Trees":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","role":"collection","type":"topic","url":"\/documentation\/caches\/trees","title":"Trees"},"doc://Caches/documentation/Caches/LRUCache":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LRUCache","kind":"identifier"}],"type":"topic","kind":"symbol","title":"LRUCache","role":"symbol","abstract":[{"type":"text","text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion, removal and eviction each take O(1) on average."}],"navigatorTitle":[{"text":"LRUCache","kind":"identifier"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","url":"\/documentation\/caches\/lrucache"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"url":"\/documentation\/caches\/lrucache\/contains(_:)","role":"symbol","title":"contains(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"type":"codeVoice","code":"key"},{"type":"text","text":", without changing its recency. O(1)."}]},"doc://Caches/documentation/Caches":{"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"role":"collection","title":"Caches","identifier":"doc:\/\/Caches\/documentation\/Caches","type":"topic","kind":"symbol","url":"\/documentation\/caches"}}}