{"variants":[{"paths":["\/documentation\/caches"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","type":"reference"},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}]},{"type":"codeListing","syntax":"swift","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"]},{"type":"paragraph","inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)"},{"text":" read without promoting, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)"},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The recency list converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", a path from the most","type":"text"},{"text":" ","type":"text"},{"text":"recent entry down.","type":"text"}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Caches","title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"anchor":"Extended-Modules","title":"Extended Modules","generated":true,"identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"]}],"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"metadata":{"role":"collection","externalID":"Caches","symbolKind":"module","roleHeading":"Framework","title":"Caches","modules":[{"name":"Caches"}]},"references":{"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"type":"topic","kind":"symbol","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","title":"insert(_:forKey:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","abstract":[{"text":"Stores ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"te