. O(1).","type":"text"}],"title":"peek(_:)"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"url":"\/documentation\/caches\/lrucache\/contains(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","kind":"symbol","abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"code":"key","type":"codeVoice"},{"type":"text","text":", without changing its recency. O(1)."}],"title":"contains(_:)"},"doc://Caches/documentation/Caches/Trees":{"title":"Trees","url":"\/documentation\/caches\/trees","abstract":[],"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees"},"doc://Caches/documentation/Caches/LRUCache":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","type":"topic","role":"symbol","url":"\/documentation\/caches\/lrucache","kind":"symbol","title":"LRUCache","navigatorTitle":[{"kind":"identifier","text":"LRUCache"}],"abstract":[{"text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion, removal and eviction each take O(1) on average.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LRUCache"}]},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","type":"topic","role":"symbol","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","kind":"symbol","title":"insert(_:forKey:)","abstract":[{"type":"text","text":"Stores "},{"code":"value","type":"codeVoice"},{"type":"text","text":" for