{"kind":"symbol","metadata":{"modules":[{"name":"Caches"}],"title":"Caches","symbolKind":"module","roleHeading":"Framework","role":"collection","externalID":"Caches"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/caches"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"],"anchor":"Caches"},{"title":"Extended Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"],"anchor":"Extended-Modules","generated":true}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","isActive":true},{"text":" holds at most a fixed number of entries. Storing one more when it is full evicts","type":"text"},{"text":" ","type":"text"},{"text":"the least recently used entry, where reading a value or storing it counts as a use.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"]},{"inlineContent":[{"type":"text","text":"The entries live in one flat array, linked by indices from the most recent to the least, beside"},{"type":"text","text":" "},{"type":"text","text":"a hash table from keys to positions, so every operation is O(1) on average. "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","isActive":true},{"type":"text","text":" read without promoting, "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","isActive":true},{"type":"text","text":" reports the"},{"type":"text","text":" "},{"type":"text","text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a"},{"type":"text","text":" "},{"type":"text","text":"value: a copy is a snapshot whose order changes independently."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}],"type":"paragraph"}]}],"sections":[],"references":{"doc://Caches/documentation/Caches/LRUCache":{"navigatorTitle":[{"text":"LRUCache","kind":"identifier"}],"url":"\/documentation\/caches\/lrucache","title":"LRUCache","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LRUCache","kind":"identifier"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","abstract":[{"text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion, removal and eviction each take O(1) on average.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"abstract":[{"text":"Whether the cache holds an entry for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":", without changing its recency. O(1).","type":"text"}],"url":"\/documentation\/caches\/lrucache\/contains(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","title":"contains(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Caches/documentation/Caches/Trees":{"title":"Trees","url":"\/documentation\/caches\/trees","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","abstract":[],"type":"topic","role":"collection","kind":"symbol"},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"abstract":[{"text":"The value for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" without making it the most recent, or nil when absent. O(1).","type":"text"}],"url":"\/documentation\/caches\/lrucache\/peek(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","title":"peek(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"peek","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","title":"insert(_:forKey:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"forKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"LRUCache","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV"},{"text":"<","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Entry","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","abstract":[{"text":"Stores ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://Caches/documentation/Caches":{"abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"kind":"symbol","url":"\/documentation\/caches","type":"topic","role":"collection","identifier":"doc:\/\/Caches\/documentation\/Caches","title":"Caches"}}}