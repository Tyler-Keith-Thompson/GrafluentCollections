{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache"},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}],"type":"paragraph"},{"code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","isActive":true,"type":"reference"},{"text":" read without promoting, ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","isActive":true,"type":"reference"},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"title":"Caches","anchor":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"collection","externalID":"Caches","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"Caches"}],"title":"Caches"},"hierarchy":{"paths":[[]]},"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/caches"]}],"references":{"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"url":"\/documentation\/caches\/lrucache\/peek(_:)","title":"peek(_:)","role":"symbol","abstract":[{"type":"text","text":"The value for "},{"code":"key","type":"codeVoice"},{"type":"text","text":" without making it the most recent, or nil when absent. O(1)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"peek"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","title":"insert(_:forKey:)","role":"symbol","abstract":[{"type":"text","text":"Stores "},{"code":"value","type":"codeVoice"},{"type":"text","text":" for "},{"code":"key","type":"codeVoice"},{"type":"text","text":" as the most recent entry, and returns the entry evicted to make"},{"type":"text","text":" "},{"type":"text","text":"room: nil when "},{"code":"key","type":"codeVoice"},{"type":"text","text":" was present (its value is replaced) or the cache had room, and the new"},{"type":"text","text":" "},{"type":"text","text":"entry itself when the capacity is 0."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"forKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LRUCache","preciseIdentifier":"s:6Caches8LRUCacheV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Entry","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"title":"contains(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"type":"codeVoice","code":"key"},{"type":"text","text":", without changing its recency. O(1)."}],"url":"\/documentation\/caches\/lrucache\/contains(_:)"},"doc://Caches/documentation/Caches/Trees":{"abstract":[],"title":"Trees","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","type":"topic","url":"\/documentation\/caches\/trees","role":"collection","kind":"symbol"},"doc://Caches/documentation/Caches/LRUCache":{"title":"LRUCache","navigatorTitle":[{"kind":"identifier","text":"LRUCache"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LRUCache"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion, removal and eviction each take O(1) on average."}],"url":"\/documentation\/caches\/lrucache"},"doc://Caches/documentation/Caches":{"title":"Caches","identifier":"doc:\/\/Caches\/documentation\/Caches","kind":"symbol","role":"collection","type":"topic","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"url":"\/documentation\/caches"}}}