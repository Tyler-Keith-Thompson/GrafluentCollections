{"sections":[],"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","isActive":true},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}]},{"type":"codeListing","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The entries live in one flat array, linked by indices from the most recent to the least, beside"},{"type":"text","text":" "},{"type":"text","text":"a hash table from keys to positions, so every operation is O(1) on average. "},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","isActive":true,"type":"reference"},{"type":"text","text":" read without promoting, "},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","isActive":true,"type":"reference"},{"type":"text","text":" reports the"},{"type":"text","text":" "},{"type":"text","text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a"},{"type":"text","text":" "},{"type":"text","text":"value: a copy is a snapshot whose order changes independently."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}]}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"variants":[{"paths":["\/documentation\/caches"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Framework","role":"collection","modules":[{"name":"Caches"}],"title":"Caches","externalID":"Caches","symbolKind":"module"},"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"anchor":"Caches","title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"],"generated":true}],"references":{"doc://Caches/documentation/Caches":{"identifier":"doc:\/\/Caches\/documentation\/Caches","title":"Caches","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"role":"collection","url":"\/documentation\/caches"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Stores "},{"code":"value","type":"codeVoice"},{"type":"text","text":" for "},{"code":"key","type":"codeVoice"},{"type":"text","text":" as the most recent entry, and returns the entry evicted to make"},{"type":"text","text":" "},{"type":"text","text":"room: nil when "},{"code":"key","type":"codeVoice"},{"type":"text","text":" was present (its value is replaced) or the cache had room, and the new"},{"type":"text","text":" "},{"type":"text","text":"entry itself when the capacity is 0."}],"url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"forKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"LRUCache","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV"},{"text":"<","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Entry","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"text":"?","kind":"text"}],"title":"insert(_:forKey:)"},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"peek","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/caches\/lrucache\/peek(_:)","kind":"symbol","title":"peek(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","abstract":[{"type":"text","text":"The value for "},{"type":"codeVoice","code":"key"},{"type":"text","text":" without making it the most recent, or nil when absent. O(1)."}]},"doc://Caches/documentation/Caches/LRUCache":{"navigatorTitle":[{"kind":"identifier","text":"LRUCache"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","url":"\/documentation\/caches\/lrucache","type":"topic","kind":"symbol","title":"LRUCache","abstract":[{"type":"text","text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion, removal and eviction each take O(1) on average."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LRUCache"}]},"doc://Caches/documentation/Caches/Trees":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","type":"topic","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/caches\/trees","title":"Trees"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"code":"key","type":"codeVoice"},{"type":"text","text":", without changing its recency. O(1)."}],"url":"\/documentation\/caches\/lrucache\/contains(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"contains(_:)"}}}