{"hierarchy":{"paths":[[]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","type":"reference"},{"text":" holds at most a fixed number of entries. Storing one more when it is full evicts","type":"text"},{"text":" ","type":"text"},{"text":"the least recently used entry, where reading a value or storing it counts as a use.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"]},{"type":"paragraph","inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","type":"reference","isActive":true},{"text":" read without promoting, ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","type":"reference","isActive":true},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/caches"]}],"metadata":{"modules":[{"name":"Caches"}],"roleHeading":"Framework","title":"Caches","externalID":"Caches","role":"collection","symbolKind":"module"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Caches","title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"]}],"references":{"doc://Caches/documentation/Caches":{"kind":"symbol","url":"\/documentation\/caches","identifier":"doc:\/\/Caches\/documentation\/Caches","title":"Caches","role":"collection","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"type":"topic"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"type":"codeVoice","code":"key"},{"type":"text","text":", without changing its recency. O(1)."}],"role":"symbol","type":"topic","url":"\/documentation\/caches\/lrucache\/contains(_:)","title":"contains(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind