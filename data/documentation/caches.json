{"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","isActive":true,"type":"reference"},{"text":" holds at most a fixed number of entries. Storing one more when it is full evicts","type":"text"},{"text":" ","type":"text"},{"text":"the least recently used entry, where reading a value or storing it counts as a use.","type":"text"}],"type":"paragraph"},{"code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","isActive":true,"type":"reference"},{"text":" read without promoting, ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","isActive":true,"type":"reference"},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/caches"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Caches\/documentation\/Caches"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"collection","roleHeading":"Framework","title":"Caches","externalID":"Caches","symbolKind":"module","modules":[{"name":"Caches"}]},"topicSections":[{"anchor":"Caches","title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"anchor":"Extended-Modules","generated":true,"title":"Extended Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"]}],"references":{"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"forKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Caches8LRUCacheV","kind":"typeIdentifier","text":"LRUCache"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">."},{"preciseIdentifier":"s:6Caches8LRUCacheV5EntryV","kind":"typeIdentifier","text":"Entry"},{"kind":"text","text":"?"}],"url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","type":"topic","kind":"symbol","abstract":[{"text":"Stores ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"role":"symbol","title":"insert(_:forKey:)"},"doc://Caches/documentation/Caches/Trees":{"url":"\/documentation\/caches\/trees","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","type":"topic","kind":"symbol","abstract":[],"role":"collection","title":"Trees"},"doc://Caches/documentation/Caches/LRUCache":{"url":"\/documentation\/caches\/lrucache","title":"LRUCache","role":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","abstract":[{"type":"text","text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion, removal and eviction each take O(1) on average."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LRUCache"}],"navigatorTitle":[{"kind":"identifier","text":"LRUCache"}]},"doc://Caches/documentation/Caches":{"url":"\/documentation\/caches","identifier":"doc:\/\/Caches\/documentation\/Caches","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"role":"collection","title":"Caches"},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"peek"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":"?"}],"url":"\/documentation\/caches\/lrucache\/peek(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","type":"topic","kind":"symbol","abstract":[{"text":"The value for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" without making it the most recent, or nil when absent. O(1).","type":"text"}],"role":"symbol","title":"peek(_:)"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"kind":"symbol","role":"symbol","title":"contains(_:)","type":"topic","url":"\/documentation\/caches\/lrucache\/contains(_:)","abstract":[{"text":"Whether the cache holds an entry for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":", without changing its recency. O(1).","type":"text"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}}}