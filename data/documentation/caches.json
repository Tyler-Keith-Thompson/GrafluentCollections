{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","isActive":true},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}]},{"type":"codeListing","syntax":"swift","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The entries live in one flat array, linked by indices from the most recent to the least, beside"},{"type":"text","text":" "},{"type":"text","text":"a hash table from keys to positions, so every operation is O(1) on average. "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","isActive":true},{"type":"text","text":" read without promoting, "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","isActive":true},{"type":"text","text":" reports the"},{"type":"text","text":" "},{"type":"text","text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a"},{"type":"text","text":" "},{"type":"text","text":"value: a copy is a snapshot whose order changes independently."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}]}]}],"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Caches\/documentation\/Caches"},"metadata":{"role":"collection","title":"Caches","externalID":"Caches","symbolKind":"module","modules":[{"name":"Caches"}],"roleHeading":"Framework"},"variants":[{"paths":["\/documentation\/caches"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","topicSections":[{"anchor":"Caches","title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"]},{"anchor":"Extended-Modules","generated":true,"title":"Extended Modules","identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"]}],"references":{"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"type":"codeVoice","code":"key"},{"type":"text","text":", without changing its recency. O(1)."}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","title":"contains(_:)","url":"\/documentation\/caches\/lrucache\/contains(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","kind":"symbol","role":"symbol","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"forKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"LRUCache","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV"},{"text":"<","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Entry","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"text":"?","kind":"text"}],"title":"insert(_:forKey:)","abstract":[{"text":"Stores ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"type":"topic"},"doc://Caches/documentation/Caches/Trees":{"abstract":[],"identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","url":"\/documentation\/caches\/trees","type":"topic","title":"Trees","role":"collection","kind":"symbol"},"doc://Caches/documentation/Caches":{"identifier":"doc:\/\/Caches\/documentation\/Caches","type":"topic","title":"Caches","role":"collection","kind":"symbol","abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"url":"\/documentation\/caches"},"doc://Caches/documentation/Caches/LRUCache":{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","kind":"symbol","navigatorTitle":[{"text":"LRUCache","kind":"identifier"}],"role":"symbol","url":"\/documentation\/caches\/lrucache","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LRUCache","kind":"identifier"}],"title":"LRUCache","abstract":[{"text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion, removal and eviction each take O(1) on average.","type":"text"}],"type":"topic"},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/caches\/lrucache\/peek(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"peek","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"peek(_:)","abstract":[{"type":"text","text":"The value for "},{"type":"codeVoice","code":"key"},{"type":"text","text":" without making it the most recent, or nil when absent. O(1)."}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)"}}}