 without promoting, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)"},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/caches"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Caches\/documentation\/Caches"},"references":{"doc://Caches/documentation/Caches/Trees":{"title":"Trees","role":"collection","url":"\/documentation\/caches\/trees","abstract":[],"type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","kind":"symbol"},"doc://Caches/documentation/Caches":{"type":"topic","role":"collection","abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"kind":"symbol","title":"Caches","identifier":"doc:\/\/Caches\/documentation\/Caches","url":"\/documentation\/caches"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"forKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LRUCache","preciseIdentifier":"s:6Caches8LRUCacheV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Entry","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"kind":"text","text":"?"}],"title":"insert(_:forKey:)","role":"symbol","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","abstract":[{"text":"Stores ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","kind":"symbol"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"type":"topic","role":"symbol","abstract":[{"text":"Whether the cache holds an entry for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":", without changing its recency. O(1).","type":"text"}],"kind":"symbol","title":"contains(_:)","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/caches\/lrucache\/contains(_:)"},"doc://Caches/documentation/Caches/LRUCache":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LRUCache"}],"title":"LRUCache","navigatorT