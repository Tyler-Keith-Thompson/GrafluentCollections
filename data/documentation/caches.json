{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache"},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}]},{"type":"codeListing","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","isActive":true},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","isActive":true},{"text":" read without promoting, ","type":"text"},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","isActive":true},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}]}]}],"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/caches"]}],"kind":"symbol","topicSections":[{"title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"],"anchor":"Caches"},{"title":"Extended Modules","generated":true,"identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"],"anchor":"Extended-Modules"}],"metadata":{"role":"collection","externalID":"Caches","symbolKind":"module","modules":[{"name":"Caches"}],"roleHeading":"Framework","title":"Caches"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"abstract":[{"text":"Stores ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"forKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LRUCache","preciseIdentifier":"s:6Caches8LRUCacheV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Entry","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"kind":"text","text":"?"}],"title":"insert(_:forKey:)"},"doc://Caches/documentation/Caches/Trees":{"abstract":[],"identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","kind":"symbol","role":"collection","url":"\/documentation\/caches\/trees","type":"topic","title":"Trees"},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","url":"\/documentation\/caches\/lrucache\/peek(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"peek","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"peek(_:)","abstract":[{"text":"The value for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" without making it the most recent, or nil when absent. O(1).","type":"text"}],"role":"symbol"},"doc://Caches/documentation/Caches":{"abstract":[{"text":"Bounded dictionaries that evict by recency.","type":"text"}],"identifier":"doc:\/\/Caches\/documentation\/Caches","url":"\/documentation\/caches","type":"topic","kind":"symbol","role":"collection","title":"Caches"},"doc://Caches/documentation/Caches/LRUCache":{"type":"topic","title":"LRUCache","abstract":[{"type":"text","text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion, removal and eviction each take O(1) on average."}],"url":"\/documentation\/caches\/lrucache","navigatorTitle":[{"text":"LRUCache","kind":"identifier"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LRUCache","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"abstract":[{"text":"Whether the cache holds an entry for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":", without changing its recency. O(1).","type":"text"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","url":"\/documentation\/caches\/lrucache\/contains(_:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"contains(_:)"}}}