{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache"},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}]},{"code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The entries live in one flat array, linked by indices from the most recent to the least, beside"},{"type":"text","text":" "},{"type":"text","text":"a hash table from keys to positions, so every operation is O(1) on average. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)"},{"type":"text","text":" read without promoting, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)"},{"type":"text","text":" reports the"},{"type":"text","text":" "},{"type":"text","text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a"},{"type":"text","text":" "},{"type":"text","text":"value: a copy is a snapshot whose order changes independently."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}]}]}],"sections":[],"abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"kind":"symbol","identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Caches","identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"],"anchor":"Caches"},{"title":"Extended Modules","generated":true,"identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"],"anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/caches"]}],"metadata":{"externalID":"Caches","title":"Caches","role":"collection","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"Caches"}]},"references":{"doc://Caches/documentation/Caches/Trees":{"title":"Trees","type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","role":"collection","url":"\/documentation\/caches\/trees","kind":"symbol","abstract":[]},"doc://Caches/documentation/Caches":{"url":"\/documentation\/caches","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches","title":"Caches","type":"topic","role":"collection"},"doc://Caches/documentation/Caches/LRUCache":{"navigatorTitle":[{"text":"LRUCache","kind":"identifier"}],"title":"LRUCache","type":"topic","role":"symbol","url":"\/documentation\/caches\/lrucache","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LRUCache","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion, removal and eviction each take O(1) on average.","type":"text"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","abstract":[{"text":"Stores ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"forKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"LRUCache","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV"},{"text":"<","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Entry","kind":"typeIdentifier","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"text":"?","kind":"text"}],"title":"insert(_:forKey:)","type":"topic","role":"symbol"},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"url":"\/documentation\/caches\/lrucache\/peek(_:)","abstract":[{"text":"The value for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" without making it the most recent, or nil when absent. O(1).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"peek","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"peek(_:)","type":"topic","role":"symbol"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"url":"\/documentation\/caches\/lrucache\/contains(_:)","abstract":[{"text":"Whether the cache holds an entry for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":", without changing its recency. O(1).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"contains(_:)","type":"topic","role":"symbol"}}}