{"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"],"anchor":"Caches","title":"Caches"},{"identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","isActive":true},{"type":"text","text":" holds at most a fixed number of entries. Storing one more when it is full evicts"},{"type":"text","text":" "},{"type":"text","text":"the least recently used entry, where reading a value or storing it counts as a use."}],"type":"paragraph"},{"syntax":"swift","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"type":"codeListing"},{"inlineContent":[{"text":"The entries live in one flat array, linked by indices from the most recent to the least, beside","type":"text"},{"text":" ","type":"text"},{"text":"a hash table from keys to positions, so every operation is O(1) on average. ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","type":"reference","isActive":true},{"text":" read without promoting, ","type":"text"},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","type":"reference","isActive":true},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a","type":"text"},{"text":" ","type":"text"},{"text":"value: a copy is a snapshot whose order changes independently.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}],"type":"paragraph"}]}],"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"variants":[{"paths":["\/documentation\/caches"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"Caches","symbolKind":"module","modules":[{"name":"Caches"}],"role":"collection","roleHeading":"Framework","title":"Caches"},"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Caches\/documentation\/Caches"},"references":{"doc://Caches/documentation/Caches":{"type":"topic","role":"collection","url":"\/documentation\/caches","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches","title":"Caches"},"doc://Caches/documentation/Caches/LRUCache":{"kind":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","title":"LRUCache","abstract":[{"type":"text","text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion, removal and eviction each take O(1) on average."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LRUCache"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LRUCache"}],"url":"\/documentation\/caches\/lrucache"},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"role":"symbol","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","type":"topic","title":"contains(_:)","url":"\/documentation\/caches\/lrucache\/contains(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"code":"key","type":"codeVoice"},{"type":"text","text":", without changing its recency. O(1)."}]},"doc://Caches/documentation/Caches/Trees":{"url":"\/documentation\/caches\/trees","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","title":"Trees","abstract":[],"type":"topic","role":"collection","kind":"symbol"},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"type":"topic","role":"symbol","url":"\/documentation\/caches\/lrucache\/peek(_:)","abstract":[{"text":"The value for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" without making it the most recent, or nil when absent. O(1).","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"peek"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","title":"peek(_:)"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"type":"topic","role":"symbol","url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","abstract":[{"text":"Stores ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"forKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LRUCache","preciseIdentifier":"s:6Caches8LRUCacheV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Entry","preciseIdentifier":"s:6Caches8LRUCacheV5EntryV"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","title":"insert(_:forKey:)"}}}