{"metadata":{"symbolKind":"module","title":"Caches","modules":[{"name":"Caches"}],"externalID":"Caches","role":"collection","roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/Caches\/documentation\/Caches\/LRUCache"],"title":"Caches","anchor":"Caches"},{"generated":true,"identifiers":["doc:\/\/Caches\/documentation\/Caches\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/caches"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache"},{"text":" holds at most a fixed number of entries. Storing one more when it is full evicts","type":"text"},{"text":" ","type":"text"},{"text":"the least recently used entry, where reading a value or storing it counts as a use.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Caches","","var cache = LRUCache<String, Int>(capacity: 2)","cache[\"a\"] = 1","cache[\"b\"] = 2","_ = cache[\"a\"]                     \/\/ 1, and \"a\" is now the most recent","cache[\"c\"] = 3                     \/\/ evicts \"b\", the least recent","cache.map(\\.key)                   \/\/ [\"c\", \"a\"]"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The entries live in one flat array, linked by indices from the most recent to the least, beside"},{"type":"text","text":" "},{"type":"text","text":"a hash table from keys to positions, so every operation is O(1) on average. "},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","type":"reference","isActive":true},{"type":"text","text":" read without promoting, "},{"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","type":"reference","isActive":true},{"type":"text","text":" reports the"},{"type":"text","text":" "},{"type":"text","text":"entry it evicted, and iterating visits the entries from most to least recent. The cache is a"},{"type":"text","text":" "},{"type":"text","text":"value: a copy is a snapshot whose order changes independently."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recency list converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", a path from the most"},{"type":"text","text":" "},{"type":"text","text":"recent entry down."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"identifier":{"url":"doc:\/\/Caches\/documentation\/Caches","interfaceLanguage":"swift"},"references":{"doc://Caches/documentation/Caches/LRUCache":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LRUCache","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache","navigatorTitle":[{"text":"LRUCache","kind":"identifier"}],"url":"\/documentation\/caches\/lrucache","role":"symbol","title":"LRUCache","kind":"symbol","abstract":[{"text":"A bounded dictionary that evicts its least recently used entry to make room: lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion, removal and eviction each take O(1) on average.","type":"text"}]},"doc://Caches/documentation/Caches/Trees":{"title":"Trees","url":"\/documentation\/caches\/trees","type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/Trees","role":"collection","kind":"symbol","abstract":[]},"doc://Caches/documentation/Caches/LRUCache/peek(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"peek"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":"?"}],"url":"\/documentation\/caches\/lrucache\/peek(_:)","title":"peek(_:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The value for "},{"type":"codeVoice","code":"key"},{"type":"text","text":" without making it the most recent, or nil when absent. O(1)."}],"identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/peek(_:)","role":"symbol"},"doc://Caches/documentation/Caches":{"url":"\/documentation\/caches","title":"Caches","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Bounded dictionaries that evict by recency."}],"identifier":"doc:\/\/Caches\/documentation\/Caches","role":"collection"},"doc://Caches/documentation/Caches/LRUCache/insert(_:forKey:)":{"title":"insert(_:forKey:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"forKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Caches8LRUCacheV","text":"LRUCache","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:6Caches8LRUCacheV5EntryV","text":"Entry","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/caches\/lrucache\/insert(_:forkey:)","type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/insert(_:forKey:)","role":"symbol","kind":"symbol","abstract":[{"text":"Stores ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" as the most recent entry, and returns the entry evicted to make","type":"text"},{"text":" ","type":"text"},{"text":"room: nil when ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" was present (its value is replaced) or the cache had room, and the new","type":"text"},{"text":" ","type":"text"},{"text":"entry itself when the capacity is 0.","type":"text"}]},"doc://Caches/documentation/Caches/LRUCache/contains(_:)":{"title":"contains(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/caches\/lrucache\/contains(_:)","type":"topic","identifier":"doc:\/\/Caches\/documentation\/Caches\/LRUCache\/contains(_:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Whether the cache holds an entry for "},{"type":"codeVoice","code":"key"},{"type":"text","text":", without changing its recency. O(1)."}]}}}