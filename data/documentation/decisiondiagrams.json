ode":"x0","type":"codeVoice"},{"text":" false and ","type":"text"},{"code":"x0 ∧ ¬x1","type":"codeVoice"},{"text":" both leave ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" equal to ","type":"text"},{"code":"x2","type":"codeVoice"},{"text":", so both lead","type":"text"},{"text":" ","type":"text"},{"text":"to the one vertex that stands for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Functions combine under any of the sixteen binary operators with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/apply(_:_:_:)","isActive":true},{"text":" in O(|","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"f"}]},{"text":"| |","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"g"}]},{"text":"|), through a computed table of results","type":"text"},{"text":" ","type":"text"},{"text":"already found. ","type":"text"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/restrict(_:variable:to:)","isActive":true},{"text":" fixes a variable, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/exists(_:in:)","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/forall(_:in:)","isActive":true},{"text":" quantify","type":"text"},{"text":" ","type":"text"},{"text":"over variables. The table’s vertices are a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/graphView-swift.property","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so Graflue