{"identifier":{"url":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/decisiondiagrams"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[[]]},"sections":[],"metadata":{"externalID":"DecisionDiagrams","symbolKind":"module","modules":[{"name":"DecisionDiagrams"}],"roleHeading":"Framework","role":"collection","title":"DecisionDiagrams"},"kind":"symbol","abstract":[{"text":"Canonical diagrams of Boolean functions and families of sets.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram"],"anchor":"Binary-decision-diagrams","title":"Binary decision diagrams"},{"identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram"],"anchor":"Zero-suppressed-decision-diagrams","title":"Zero-suppressed decision diagrams"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram","type":"reference","isActive":true},{"text":" is a table of reduced ordered binary decision diagrams (Bryant,","type":"text"},{"text":" ","type":"text"},{"text":"1986). Each function is a directed acyclic graph whose vertices test variables in index order,","type":"text"},{"text":" ","type":"text"},{"text":"with a low child for the variable false and a high child for true, down to the constants. No two","type":"text"},{"text":" ","type":"text"},{"text":"vertices test the same variable with the same children, and none has equal children, so each","type":"text"},{"text":" ","type":"text"},{"text":"function has exactly one root, and checking whether two functions are equal is comparing roots.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import DecisionDiagrams","","var diagram = BinaryDecisionDiagram(variableCount: 3)","let x0 = diagram.variable(0), x1 = diagram.variable(1), x2 = diagram.variable(2)","let f = diagram.or(diagram.and(x0, x1), x2)   \/\/ x0 ∧ x1 ∨ x2","diagram.satisfyingAssignmentCount(of: f)       \/\/ 5","diagram.anySatisfyingAssignment(of: f)         \/\/ [false, false, true]"]},{"inlineContent":[{"text":"The diagram of ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" has five vertices: three tests and the two constants. Following the low edge","type":"text"},{"text":" ","type":"text"},{"text":"means the variable is false, the high edge that it is true.","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Vertex","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tests"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Low child","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"High child"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"root"}],"type":"paragraph"}],[{"inlineContent":[{"code":"x0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"the test of "},{"code":"x2","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"the test of ","type":"text"},{"code":"x1","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"code":"x1","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"the test of ","type":"text"},{"type":"codeVoice","code":"x2"}],"type":"paragraph"}],[{"inlineContent":[{"text":"true","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"code":"x2","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"false","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"true"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"The test of ","type":"text"},{"code":"x2","type":"codeVoice"},{"text":" is shared: ","type":"text"},{"code":"x0","type":"codeVoice"},{"text":" false and ","type":"text"},{"code":"x0 ∧ ¬x1","type":"codeVoice"},{"text":" both leave ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" equal to ","type":"text"},{"code":"x2","type":"codeVoice"},{"text":", so both lead","type":"text"},{"text":" ","type":"text"},{"text":"to the one vertex that stands for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Functions combine under any of the sixteen binary operators with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/apply(_:_:_:)"},{"type":"text","text":" in O(|"},{"type":"emphasis","inlineContent":[{"type":"text","text":"f"}]},{"type":"text","text":"| |"},{"type":"emphasis","inlineContent":[{"type":"text","text":"g"}]},{"type":"text","text":"|), through a computed table of results"},{"type":"text","text":" "},{"type":"text","text":"already found. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/restrict(_:variable:to:)"},{"type":"text","text":" fixes a variable, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/exists(_:in:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/forall(_:in:)"},{"type":"text","text":" quantify"},{"type":"text","text":" "},{"type":"text","text":"over variables. The table’s vertices are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/graphView-swift.property"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so Grafluent’s traversals and drawings run over a function’s diagram from its root."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram","isActive":true,"type":"reference"},{"text":" is a table of families of sets (Minato, 1993). Its vertices","type":"text"},{"text":" ","type":"text"},{"text":"test elements in index order, with a low child for the sets without the element and a high child","type":"text"},{"text":" ","type":"text"},{"text":"for those with it. In place of the rule that removes a vertex with equal children, it removes one","type":"text"},{"text":" ","type":"text"},{"text":"whose high child is the empty family, so an element no set contains never appears in a diagram,","type":"text"},{"text":" ","type":"text"},{"text":"and a sparse family over many elements stays small.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var diagram = ZeroSuppressedDecisionDiagram(elementCount: 3)","let f = diagram.family([[0, 1], [1, 2], [2]])","diagram.count(of: f)                                 \/\/ 3","diagram.minimalSets(of: diagram.including(2, in: f)) \/\/ {{2}}"]},{"inlineContent":[{"type":"text","text":"Families combine by "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/union(_:_:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/intersection(_:_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/subtracting(_:from:)","isActive":true},{"type":"text","text":", and set by set by"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/join(_:_:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/meet(_:_:)","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/setsView(of:)","isActive":true},{"type":"text","text":" lists a family’s sets, and its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/graphView-swift.property","isActive":true},{"type":"text","text":" is a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" like the binary diagram’s."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://DecisionDiagrams/documentation/DecisionDiagrams/BinaryDecisionDiagram/GraphView-swift.struct/isHighEdge(at:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isHighEdge","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","kind":"symbol","url":"\/documentation\/decisiondiagrams\/binarydecisiondiagram\/graphview-swift.struct\/ishighedge(at:)","abstract":[{"text":"Whether the edge is its source’s high edge, taken when the source’s variable is true.","type":"text"}],"title":"isHighEdge(at:)","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/GraphView-swift.struct\/isHighEdge(at:)","role":"symbol"},"doc