{"metadata":{"roleHeading":"Framework","modules":[{"name":"DecisionDiagrams"}],"title":"DecisionDiagrams","role":"collection","externalID":"DecisionDiagrams","symbolKind":"module"},"identifier":{"url":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram"],"title":"Binary decision diagrams","anchor":"Binary-decision-diagrams"},{"identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram"],"title":"Zero-suppressed decision diagrams","anchor":"Zero-suppressed-decision-diagrams"}],"abstract":[{"text":"Canonical diagrams of Boolean functions and families of sets.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram"},{"type":"text","text":" is a table of reduced ordered binary decision diagrams (Bryant,"},{"type":"text","text":" "},{"type":"text","text":"1986). Each function is a directed acyclic graph whose vertices test variables in index order,"},{"type":"text","text":" "},{"type":"text","text":"with a low child for the variable false and a high child for true, down to the constants. No two"},{"type":"text","text":" "},{"type":"text","text":"vertices test the same variable with the same children, and none has equal children, so each"},{"type":"text","text":" "},{"type":"text","text":"function has exactly one root, and checking whether two functions are equal is comparing roots."}],"type":"paragraph"},{"code":["import DecisionDiagrams","","var diagram = BinaryDecisionDiagram(variableCount: 3)","let x0 = diagram.variable(0), x1 = diagram.variable(1), x2 = diagram.variable(2)","let f = diagram.or(diagram.and(x0, x1), x2)   \/\/ x0 ∧ x1 ∨ x2","diagram.satisfyingAssignmentCount(of: f)       \/\/ 5","diagram.anySatisfyingAssignment(of: f)         \/\/ [false, false, true]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The diagram of ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" has five vertices: three tests and the two constants. Following the low edge","type":"text"},{"text":" ","type":"text"},{"text":"means the variable is false, the high edge that it is true.","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Vertex","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tests","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low child","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"High child"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"root"}]}],[{"type":"paragraph","inlineContent":[{"code":"x0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"the test of ","type":"text"},{"type":"codeVoice","code":"x2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"the test of "},{"type":"codeVoice","code":"x1"}]}]],[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"x1"}]}],[{"type":"paragraph","inlineContent":[{"text":"the test of ","type":"text"},{"type":"codeVoice","code":"x2"}]}],[{"type":"paragraph","inlineContent":[{"text":"true","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"x2"}]}],[{"type":"paragraph","inlineContent":[{"text":"false","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"true"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The test of "},{"type":"codeVoice","code":"x2"},{"type":"text","text":" is shared: "},{"type":"codeVoice","code":"x0"},{"type":"text","text":" false and "},{"type":"codeVoice","code":"x0 ∧ ¬x1"},{"type":"text","text":" both leave "},{"type":"codeVoice","code":"f"},{"type":"text","text":" equal to "},{"type":"codeVoice","code":"x2"},{"type":"text","text":", so both lead"},{"type":"text","text":" "},{"type":"text","text":"to the one vertex that stands for it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Functions combine under any of the sixteen binary operators with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/apply(_:_:_:)","isActive":true},{"type":"text","text":" in O(|"},{"type":"emphasis","inlineContent":[{"text":"f","type":"text"}]},{"type":"text","text":"| |"},{"type":"emphasis","inlineContent":[{"text":"g","type":"text"}]},{"type":"text","text":"|), through a computed table of results"},{"type":"text","text":" "},{"type":"text","text":"already found. "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/restrict(_:variable:to:)","isActive":true},{"type":"text","text":" fixes a variable, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/exists(_:in:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/forall(_:in:)","isActive":true},{"type":"text","text":" quantify"},{"type":"text","text":" "},{"type":"text","text":"over variables. The table’s vertices are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/graphView-swift.property","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so Grafluent’s traversals and drawings run over a function’s diagram from its root."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram"},{"type":"text","text":" is a table of families of sets (Minato, 1993). Its vertices"},{"type":"text","text":" "},{"type":"text","text":"test elements in index order, with a low child for the sets without the element and a high child"},{"type":"text","text":" "},{"type":"text","text":"for those with it. In place of the rule that removes a vertex with equal children, it removes one"},{"type":"text","text":" "},{"type":"text","text":"whose high child is the empty family, so an element no set contains never appears in a diagram,"},{"type":"text","text":" "},{"type":"text","text":"and a sparse family over many elements stays small."}],"type":"paragraph"},{"code":["var diagram = ZeroSuppressedDecisionDiagram(elementCount: 3)","let f = diagram.family([[0, 1], [1, 2], [2]])","diagram.count(of: f)                                 \/\/ 3","diagram.minimalSets(of: diagram.including(2, in: f)) \/\/ {{2}}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Families combine by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/union(_:_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/intersection(_:_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/subtracting(_:from:)"},{"type":"text","text":", and set by set by"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/join(_:_:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/meet(_:_:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/setsView(of:)"},{"type":"text","text":" lists a family’s sets, and its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/graphView-swift.property"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" like the binary diagram’s."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/decisiondiagrams"]}],"references":{"doc://DecisionDiagrams/documentation/DecisionDiagrams/ZeroSuppressedDecisionDiagram/meet(_:_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"meet"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppressedA7DiagramV","text":"ZeroSuppressedDecisionDiagram"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppressedA7DiagramV6FamilyV","text":"Family"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppressedA7DiagramV","text":"ZeroSuppressedDecisionDiagram"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppressedA7DiagramV6FamilyV","text":"Family"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppr