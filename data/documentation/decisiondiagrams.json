cumentation\/DecisionDiagrams\/BinaryDecisionDiagram\/apply(_:_:_:)","abstract":[{"code":"f","type":"codeVoice"},{"type":"text","text":" and "},{"code":"g","type":"codeVoice"},{"type":"text","text":" combined by "},{"code":"operator","type":"codeVoice"},{"type":"text","text":": the function whose value at every assignment is the"},{"type":"text","text":" "},{"type":"text","text":"operator applied to theirs."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"apply"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV","text":"BinaryDecisionDiagram"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV8OperatorV","text":"Operator"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV","text":"BinaryDecisionDiagram"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV8FunctionV","text":"Function"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV","text":"BinaryDecisionDiagram"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV8FunctionV","text":"Function"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV","text":"BinaryDecisionDiagram"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV8FunctionV","text":"Function"}],"title":"apply(_:_:_:)"},"doc://DecisionDiagrams/documentation/DecisionDiagrams/BinaryDecisionDiagram":{"navigatorTitle":[{"text":"BinaryDecisionDiagram","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram","fragments":[{"text":"struct","ki