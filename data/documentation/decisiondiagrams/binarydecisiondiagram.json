"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/collectGarbage(keeping:)","isActive":true},{"type":"text","text":" drops the ones no"},{"type":"text","text":" "},{"type":"text","text":"kept function reaches."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/decisiondiagrams\/binarydecisiondiagram"]}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","title":"BinaryDecisionDiagram","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryDecisionDiagram"}],"externalID":"s:16DecisionDiagrams06BinaryA7DiagramV","navigatorTitle":[{"kind":"identifier","text":"BinaryDecisionDiagram"}],"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/DecisionDiagrams\/BinaryDecisionDiagram.swift#L28","fileName":"BinaryDecisionDiagram.swift"},"modules":[{"name":"DecisionDiagrams"}]},"hierarchy":{"paths":[["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams"]]},"identifier":{"url":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram","interfaceLanguage":"swift"},"abstract":[{"text":"A shared table of reduced ordered binary decision diagrams: Boolean functions of a fixed number","type":"text"},{"text":" ","type":"text"},{"text":"of variables, each a directed acyclic graph whose vertices test one variable and branch to a","type":"text"},{"text":" ","type":"text"},{"text":"low child (the variable false) and a high child (true), down to the constants (Bryant,","type":"text"},{"text":" ","type":"text"},{"text":"“Graph-Based Algorithms for Boolean Function Manipulation”, 1986).","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/DecisionDiagrams\/s8SendableP","doc:\/\/DecisionDiagrams\/s16Se