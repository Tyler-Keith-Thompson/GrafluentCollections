sionDiagrams"]]},"abstract":[{"text":"A shared table of reduced ordered binary decision diagrams: Boolean functions of a fixed number","type":"text"},{"text":" ","type":"text"},{"text":"of variables, each a directed acyclic graph whose vertices test one variable and branch to a","type":"text"},{"text":" ","type":"text"},{"text":"low child (the variable false) and a high child (true), down to the constants (Bryant,","type":"text"},{"text":" ","type":"text"},{"text":"“Graph-Based Algorithms for Boolean Function Manipulation”, 1986).","type":"text"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/DecisionDiagrams\/s8SendableP","doc:\/\/DecisionDiagrams\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"url":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryDecisionDiagram"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Variables are tested in index order, 0 nearest the root. The table never holds two vertices"},{"type":"text","text":" "},{"type":"text","text":"that test the same variable with the same children, nor a vertex whose children are equal, so"},{"type":"text","text":" "},{"type":"text","text":"each function has one vertex: two "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/Function","isActive":true},{"type":"text","text":" values are equal exactly when they are the same"},{"type":"text","text":" "},{"type":"text","text":"function."}],"type":"paragraph"},{"code":["var diagram = BinaryDecisionDiagram(variableCount: 3)","let x0 = diagram.variable(0), x1 = diagram.variable(1), x2 = diagram.variable(2)","let f = diagram.or(diagram.and(x0, x1), x2)          \/\/ x0 ∧ x1 ∨ x2","diagram.satisfyingAssignmentCount(of: f)              \/\/ 5","diagram.vertexCount(of: f)                            \/\/ 5: x0, x1, x2 and both constants","let g = diagram.restrict(f, variable: 2, to: false)   \/\/ x0 ∧ x1","g == diagram.and(x0, x1)                              \/\/ true"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Functions are built by the mutating methods, which add vertices to the table and leave every","type":"text"},{"text":" ","type":"text"},{"text":"existing function as it was; a function belongs to the table it was built in and its copies.","type":"text"},{"text":" ","type":"text"},{"text":"The table keeps every vertex it has made.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://DecisionDiagrams/documentation/DecisionDiagrams/BinaryDecisionDiagram/variable(_:)":{"role":"symbol","abstract":[{"text":"The function that is the variable at ","type":"text"},{"code":"index","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","url":"\/documentation\/decisiondiagrams\/binarydecisiondiagram\/variable(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"variable","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV","text":"BinaryDecisionDiagram","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:16DecisionDiagrams06BinaryA7DiagramV8FunctionV","text":"Function","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/variable(_:)","title":"variable(_:)"},"doc://DecisionDiagrams/documentation/DecisionDiagrams/BinaryDecisionDiagram/satisfyingAssign