{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A shared table of reduced ordered binary decision diagrams: Boolean functions of a fixed number","type":"text"},{"text":" ","type":"text"},{"text":"of variables, each a directed acyclic graph whose vertices test one variable and branch to a","type":"text"},{"text":" ","type":"text"},{"text":"low child (the variable false) and a high child (true), down to the constants (Bryant,","type":"text"},{"text":" ","type":"text"},{"text":"“Graph-Based Algorithms for Boolean Function Manipulation”, 1986).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryDecisionDiagram","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Variables are tested in index order, 0 nearest the root. The table never holds two vertices","type":"text"},{"text":" ","type":"text"},{"text":"that test the same variable with the same children, nor a vertex whose children are equal, so","type":"text"},{"text":" ","type":"text"},{"text":"each function has one vertex: two ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/Function"},{"text":" values are equal exactly when they are the same","type":"text"},{"text":" ","type":"text"},{"text":"function.","type":"text"}],"type":"paragraph"},{"code":["var diagram = BinaryDecisionDiagram(variableCount: 3)","let x0 = diagram.variable(0), x1 = diagram.variable(1), x2 = diagram.variable(2)","let f = diagram.or(diagram.and(x0, x1), x2)          \/\/ x0 ∧ x1 ∨ x2","diagram.satisfyingAssignmentCount(of: f)              \/\/ 5","diagram.vertexCount(of: f)                            \/\/ 5: x0, x1, x2 and both constants","let g = diagram.restrict(f, variable: 2, to: false)   \/\/ x0 ∧ x1","g == diagram.and(x0, x1)                              \/\/ true"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Functions are built by the mutating methods, which add vertices to the table and leave every","type":"text"},{"text":" ","type":"text"},{"text":"existing function as it was; a function belongs to the table it was built in and its copies.","type":"text"},{"text":" ","type":"text"},{"text":"The table keeps every vertex it has made until ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/collectGarbage(keeping:)"},{"text":" drops the ones no","type":"text"},{"text":" ","type":"text"},{"text":"kept function reaches.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/DecisionDiagrams\/BinaryDecisionDiagram.swift#L28","fileName":"BinaryDecisionDiagram.swift"},"modules":[{"name":"DecisionDiagrams"}],"role":"symbol","roleHeading":"Structure","navigatorTitle":[{"text":"BinaryDecisionDiagram","kind":"identifier"}],"title":"BinaryDecisionDiagram","externalID":"s:16DecisionDiagrams06BinaryA7DiagramV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryDecisionDiagram","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams"]]},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/DecisionDiagrams\/s8SendableP","doc:\/\/DecisionDiagrams\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/ComputedTableStatistics-swift.struct","doc:\/\/DecisionDiagrams\/doc