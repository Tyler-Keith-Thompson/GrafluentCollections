{"hierarchy":{"paths":[["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryDecisionDiagram","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Variables are tested in index order, 0 nearest the root. The table never holds two vertices"},{"type":"text","text":" "},{"type":"text","text":"that test the same variable with the same children, nor a vertex whose children are equal, so"},{"type":"text","text":" "},{"type":"text","text":"each function has one vertex: two "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/Function"},{"type":"text","text":" values are equal exactly when they are the same"},{"type":"text","text":" "},{"type":"text","text":"function."}],"type":"paragraph"},{"type":"codeListing","code":["var diagram = BinaryDecisionDiagram(variableCount: 3)","let x0 = diagram.variable(0), x1 = diagram.variable(1), x2 = diagram.variable(2)","let f = diagram.or(diagram.and(x0, x1), x2)          \/\/ x0 ∧ x1 ∨ x2","diagram.satisfyingAssignmentCount(of: f)              \/\/ 5","diagram.vertexCount(of: f)                            \/\/ 5: x0, x1, x2 and both constants","let g = diagram.restrict(f, variable: 2, to: false)   \/\/ x0 ∧ x1","g == diagram.and(x0, x1)                              \/\/ true"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Functions are built by the mutating methods, which add vertices to the table and leave every"},{"type":"text","text":" "},{"type":"text","text":"existing function as it was; a function belongs to the table it was built in and its copies."},{"type":"text","text":" "},{"type":"text","text":"The table keeps every vertex it has made."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/decisiondiagrams\/binarydecisiondiagram"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryDecisionDiagram","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"BinaryDecisionDiagram"}],"remoteSource":{"fileName":"BinaryDecisionDiagram.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/DecisionDiagrams\/BinaryDecisionDiagram.swift#L27"},"modules":[{"name":"DecisionDiagrams"}],"role":"symbol","title":"BinaryDecisionDiagram","roleHeading":"Structure","externalID":"s:16DecisionDiagrams06BinaryA7DiagramV"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/ComputedTableStatistics-swift.struct","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/Function","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/GraphView-swift.struct","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/Operator"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/init(variableCount:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/computedTableStatistics-swift.property","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/BinaryDecisionDiagram\/graphView-swift.property","doc:\/\/DecisionDiagra