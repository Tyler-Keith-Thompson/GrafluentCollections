ions\/blob\/main\/Sources\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram.swift#L27","fileName":"ZeroSuppressedDecisionDiagram.swift"},"roleHeading":"Structure","navigatorTitle":[{"text":"ZeroSuppressedDecisionDiagram","kind":"identifier"}],"title":"ZeroSuppressedDecisionDiagram"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ZeroSuppressedDecisionDiagram"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Elements are tested in index order, 0 nearest the root. The table never holds two vertices","type":"text"},{"text":" ","type":"text"},{"text":"that test the same element with the same children, nor a vertex whose high child is the empty","type":"text"},{"text":" ","type":"text"},{"text":"family, so each family has one vertex: two ","type":"text"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/Family","isActive":true},{"text":" values are equal exactly when they hold","type":"text"},{"text":" ","type":"text"},{"text":"the same sets. An element no set of a family contains never appears in its diagram, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"the diagrams of sparse families small.","type":"text"}],"type":"paragraph"},{"code":["var diagram = ZeroSuppressedDecisionDiagram(elementCount: 3)","let f = diagram.family([[0, 1], [1, 2], [2]])","diagram.count(of: f)                                  \/\/ 3","let g = diagram.including(2, in: f)                   \/\/ {{1, 2}, {2}}","diagram.minimalSets(of: g) == diagram.family([[2]])   \/\/ true","diagram.join(diagram.single(0), g)                    \/\/ {{0, 1, 2}, {0, 2}}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Families are built by the mutating methods, which add vertices to the table and leave every","type":"text"},{"text":" ","type":"text"},{"text":"existing family as it was; a family belongs to the table it was built in and its copies. The","type":"text"},{"text":" ","type":"text"},{"text":"table keeps every vertex it has made until ","type":"text"},{"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/collectGarbage(keeping:)","type":"reference","isActive":true},{"text":" drops the ones no kept","type":"text"},{"text":" ","type":"text"},{"text":"family reaches.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"A shared table of zero-suppressed decision diagrams: families of sets drawn from the elements","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0 ..< elementCount"},{"text":", each a directed acyclic graph whose vertices test one element and branch","type":"text"},{"text":" ","type":"text"},{"text":"to a low child (the sets without it) and a high child (the sets with it, the element removed),","type":"text"},{"text":" ","type":"text"},{"text":"down to the constants: the empty family and the family holding only the empty set (Minato,","type":"text"},{"text":" ","type":"text"},{"text":"“Zero-Suppressed BDDs for Set Manipulation in Combinatorial Problems”, 1993).","type":"text"}],"references":{"doc://DecisionDiagrams/documentation/DecisionDiagrams/ZeroSuppressedDecisionDiagram":{"type":"topic","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram","url":"\/documentation\/decisiondiagrams\/zerosuppresseddecisiondiagram","abstract":[{"type":"text","text":"A shared table of zero-suppressed decision diagrams: families of sets drawn from the elements"},{"type":"text","text":"