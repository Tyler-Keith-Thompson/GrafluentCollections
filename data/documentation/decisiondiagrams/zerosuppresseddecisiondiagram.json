grams\/ZeroSuppressedDecisionDiagram\/minimalSets(of:)","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/setsView(of:)","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/single(_:)","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/single(checked:)","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/subtracting(_:from:)","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/union(_:_:)","doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/vertexCount(of:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ZeroSuppressedDecisionDiagram"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Elements are tested in index order, 0 nearest the root. The table never holds two vertices"},{"type":"text","text":" "},{"type":"text","text":"that test the same element with the same children, nor a vertex whose high child is the empty"},{"type":"text","text":" "},{"type":"text","text":"family, so each family has one vertex: two "},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/Family","isActive":true},{"type":"text","text":" values are equal exactly when they hold"},{"type":"text","text":" "},{"type":"text","text":"the same sets. An element no set of a family contains never appears in its diagram, which keeps"},{"type":"text","text":" "},{"type":"text","text":"the diagrams of sparse families small."}]},{"syntax":"swift","type":"codeListing","code":["var diagram = ZeroSuppressedDecisionDiagram(elementCount: 3)","let f = diagram.family([[0, 1], [1, 2], [2]])","diagram.count(of: f)                                  \/\/ 3","let g = diagram.including(2, in: f)                   \/\/ {{1, 2}, {2}}","diagram.minimalSets(of: g) == diagram.family([[2]])   \/\/ true","diagram.join(diagram.single(0), g)                    \/\/ {{0, 1, 2}, {0, 2}}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Families are built by the mutating methods, which add vertices to the table and leave every"},{"type":"text","text":" "},{"type":"text","text":"existing family as it was; a family belongs to the table it was built in and its copies. The"},{"type":"text","text":" "},{"type":"text","text":"table keeps every vertex it has made."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/decisiondiagrams\/zerosuppresseddecisiondiagram"]}],"references":{"doc://DecisionDiagrams/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/DecisionDiagrams\/s16SendableMetatypeP"},"doc://DecisionDiagrams/documentation/DecisionDiagrams/ZeroSuppressedDecisionDiagram/empty":{"role":"symbol","abstract":[{"type":"text","text":"The family with no sets, ∅."}],"title":"empty","url":"\/documentation\/decisiondiagrams\/zerosuppresseddecisiondiagram\/empty","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/empty","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"empty","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ZeroSuppressedDecisionDiagram","preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppressedA7DiagramV","kind":"typeIde