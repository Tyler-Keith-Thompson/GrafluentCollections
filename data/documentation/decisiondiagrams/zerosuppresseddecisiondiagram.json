roSuppressedDecisionDiagram","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A shared table of zero-suppressed decision diagrams: families of sets drawn from the elements"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< elementCount"},{"type":"text","text":", each a directed acyclic graph whose vertices test one element and branch"},{"type":"text","text":" "},{"type":"text","text":"to a low child (the sets without it) and a high child (the sets with it, the element removed),"},{"type":"text","text":" "},{"type":"text","text":"down to the constants: the empty family and the family holding only the empty set (Minato,"},{"type":"text","text":" "},{"type":"text","text":"“Zero-Suppressed BDDs for Set Manipulation in Combinatorial Problems”, 1993)."}],"relationshipsSections":[{"identifiers":["doc:\/\/DecisionDiagrams\/s8SendableP","doc:\/\/DecisionDiagrams\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZeroSuppressedDecisionDiagram","kind":"identifier"}]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Elements are tested in index order, 0 nearest the root. The table never holds two vertices","type":"text"},{"text":" ","type":"text"},{"text":"that test the same element with the same children, nor a vertex whose high child is the empty","type":"text"},{"text":" ","type":"text"},{"text":"family, so each family has one vertex: two ","type":"text"},{"type":"reference","identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/Family","isActive":true},{"text":" values are equal exactly when they hold","type":"text"},{"text":" ","ty