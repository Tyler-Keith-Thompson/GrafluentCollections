ce","isActive":true},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"graphView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppressedA7DiagramV","text":"ZeroSuppressedDecisionDiagram","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:16DecisionDiagrams014ZeroSuppressedA7DiagramV9GraphViewV","text":"GraphView","kind":"typeIdentifier"}],"type":"topic","role":"symbol","title":"graphView","url":"\/documentation\/decisiondiagrams\/zerosuppresseddecisiondiagram\/graphview-swift.property"},"doc://DecisionDiagrams/documentation/DecisionDiagrams/ZeroSuppressedDecisionDiagram/GraphView-swift.struct":{"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/GraphView-swift.struct","abstract":[{"type":"text","text":"A zero-suppressed decision diagram table as a directed graph; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/DecisionDiagrams\/documentation\/DecisionDiagrams\/ZeroSuppressedDecisionDiagram\/graphView-swift.property","type":"reference","isActive":true},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"GraphView"}],"type":"topic","title":"ZeroSuppressedDecisionDiagram.GraphView","url":"\/documentation\/decisiondiagrams\/zerosuppresseddecisiondiagram\/graphview-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphView"}],"kind":"symbol","role":"symbol"}}}