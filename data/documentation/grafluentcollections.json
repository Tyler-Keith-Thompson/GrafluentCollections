":"codeVoice","code":"PersistentTrees"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees","type":"link","title":"PersistentTrees"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,","type":"text"},{"text":" ","type":"text"},{"text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent.","type":"text"}],"url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","kind":"symbol","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","type":"topic","role":"collection"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"url":"\/documentation\/grafluentcollections\/choosingasearchtree","title":"Choosing a search tree","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","type":"topic","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","role":"article","title":"Tries and suffix structures","type":"topic"},"https://tyler-keith-thompson.github.io/GrafluentCollections/documentation/caches":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/caches","title":"Caches","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Caches"}],"url":"https:\/\/tyler-