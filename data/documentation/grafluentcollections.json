{"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every collection is a copy-on-write struct with the API shape of the standard library’s","type":"text"},{"text":" ","type":"text"},{"text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent type of that shape (","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":"), so Grafluent’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithms and drawings run over it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import GrafluentCollections"},{"type":"text","text":" imports every module. Each module also has its own documentation and"},{"type":"text","text":" "},{"type":"text","text":"can be imported on its own."}]},{"type":"codeListing","syntax":"swift","code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"},"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"text"},{"text":"with value semantics, built on Grafluent.","type":"text"}],"metadata":{"role":"collection","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Framework","title":"GrafluentCollections","symbolKind":"module","externalID":"GrafluentCollections"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfa