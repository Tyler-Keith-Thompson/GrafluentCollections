{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"},"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"text"},{"text":"with value semantics, built on Grafluent.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Every collection is a copy-on-write struct with the API shape of the standard library’s"},{"type":"text","text":" "},{"type":"text","text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the"},{"type":"text","text":" "},{"type":"text","text":"Grafluent type of that shape ("},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":", "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":"), so Grafluent’s"},{"type":"text","text":" "},{"type":"text","text":"algorithms and drawings run over it."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import GrafluentCollections"},{"type":"text","text":" imports every module. Each module also has its own documentation and"},{"type":"text","text":" "},{"type":"text","text":"can be imported on its own."}],"type":"paragraph"},{"syntax":"swift","code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/grafluentcollections"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"GrafluentCollections"}],"title":"GrafluentCollections","roleHeading":"Framework","role":"collection","externalID":"GrafluentCollections","symbolKind":"module"},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"url":"\/documentation\/grafluentcollections","abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"text"},{"text":"with value semantics, built on Grafluent.","type":"text"}],"title":"GrafluentCollections","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"}}}