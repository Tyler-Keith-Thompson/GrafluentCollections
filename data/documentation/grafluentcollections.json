{"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Every collection is a copy-on-write struct with the API shape of the standard library’s","type":"text"},{"text":" ","type":"text"},{"text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent type of that shape (","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":"), so Grafluent’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithms and drawings run over it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"import GrafluentCollections","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation and"},{"type":"text","text":" "},{"type":"text","text":"can be imported on its own."}],"type":"paragraph"},{"code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"],"syntax":"swift","type":"codeListing"}]}],"metadata":{"roleHeading":"Framework","externalID":"GrafluentCollections","symbolKind":"module","role":"collection","title":"GrafluentCollections","modules":[{"name":"GrafluentCollections"}]},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections"]}],"sections":[],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","interfaceLanguage":"swift"},"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"text"},{"text":"with value semantics, built on Gr