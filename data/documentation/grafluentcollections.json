{"hierarchy":{"paths":[[]]},"sections":[],"topicSections":[{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","interfaceLanguage":"swift"},"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,","type":"text"},{"text":" ","type":"text"},{"text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent.","type":"text"}],"metadata":{"title":"GrafluentCollections","externalID":"GrafluentCollections","symbolKind":"module","role":"collection","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Framework"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"import GrafluentCollections","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation","type":"text"},{"text":" ","type":"text"},{"text":"and can be imported on its own.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"]},{"text":"Values, not references","level":3,"type":"heading","anchor":"Values-not-references"},{"type":"paragraph","inlineContent":[{"text":"Every collection is a copy-on-write struct. Assigning one copies nothing until one of the copies","type":"text"},{"text":" ","type":"text"},{"text":"is mutated; then only that copy pays, once, and the other keeps its elements:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let original: BTree = [1, 2, 3]","var copy = original","copy.insert(4)","Array(original)   \/\/ [1, 2, 3]","Array(copy)       \/\/ [1, 2, 3, 4]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices of a tree live in flat arrays linked by integer indices rather than in a class per"},{"type":"text","text":" "},{"type":"text","text":"vertex, so a copy is a few array copies and a traversal reads memory almost in order. The API"},{"type":"text","text":" "},{"type":"text","text":"follows the standard library and Swift Collections: the sorted sets are "},{"type":"codeVoice","code":"SetAlgebra"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"random-access collections indexed by rank, the dictionaries take "},{"type":"codeVoice","code":"subscript(_:default:)"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"range trees are collections of their values."}]},{"text":"Traps and checked spellings","level":3,"type":"heading","anchor":"Traps-and-checked-spellings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A plain spelling traps when its precondition fails, like an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript out of range: it is"},{"type":"text","text":" "},{"type":"text","text":"the fast path, for callers who know the precondition holds. Beside it, a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" spelling"},{"type":"text","text":" "},{"type":"text","text":"throws a typed error instead, one of those in "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/collectionerrors"},{"type":"text","text":"; "},{"type":"codeVoice","code":"try?"},{"type":"text","text":" turns it into an"},{"type":"text","text":" "},{"type":"text","text":"optional."}]},{"syntax":"swift","type":"codeListing","code":["let primes: AVLTree = [2, 3, 5, 7]","primes[2]                    \/\/ 5","try primes[checked: 9]       \/\/ throws IndexOutOfRange"]},{"type":"paragraph","inlineContent":[{"text":"A mutation that would break a structure’s invariant, such as joining two treaps whose elements","type":"text"},{"text":" ","type":"text"},{"text":"interleave, throws on its plain spelling and changes nothing. Where the standard library’s","type":"text"},{"text":" ","type":"text"},{"text":"collections return an optional (","type":"text"},{"code":"remove(_:)","type":"codeVoice"},{"text":", a dictionary’s subscript, ","type":"text"},{"code":"min()","type":"codeVoice"},{"text":"), these do too.","type":"text"}]},{"text":"Grafluent conversions","level":3,"type":"heading","anchor":"Grafluent-conversions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A collection whose shape is a tree converts to the Grafluent type of that shape: "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":", "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" or "},{"code":"PrefixTree","type":"codeVoice"},{"type":"text","text":", with an initializer on the Grafluent type that"},{"type":"text","text":" "},{"type":"text","text":"costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") once. Structures whose shape is a general graph, such as decision diagrams and"},{"type":"text","text":" "},{"type":"text","text":"automata, offer a view that is a Grafluent graph without copying. Either way, Grafluent’s"},{"type":"text","text":" "},{"type":"text","text":"algorithms, drawings and file formats run over the collection; its own operations never go"},{"type":"text","text":" "},{"type":"text","text":"through the conversion. "},{"type":"reference","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","isActive":true},{"type":"text","text":" shows the round trip."}]},{"text":"Modules","level":3,"type":"heading","anchor":"Modules"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Group"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modules"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Search trees","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/binarysearchtrees","type":"reference","isActive":true},{"type":"text","text":" (AVL, red–black and splay trees, treaps), "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/btrees","type":"reference","isActive":true},{"type":"text","text":" (B-trees), "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/skiplists","type":"reference","isActive":true},{"type":"text","text":" (skip lists)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tries"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/tries","type":"reference","isActive":true},{"text":" (tries over any sequence of symbols, radix and Patricia trees, Aho–Corasick automata)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Suffix structures","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/suffixstructures","type":"reference","isActive":true},{"text":" (suffix arrays with LCP, suffix trees, suffix automata)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decision diagrams"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/decisiondiagrams","isActive":true},{"text":" (reduced ordered BDDs, zero-suppressed ZDDs)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Range and spatial trees","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/rangetrees"},{"type":"text","text":" (Fenwick trees, segment trees with lazy propagation, interval trees), "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/spatialtrees"},{"type":"text","text":" (k-d trees, quadtrees, octrees)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sequences and persistence"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/ropes","type":"reference","isActive":true},{"type":"text","text":" (ropes: sequences as balanced trees of chunks), "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees","type":"reference","isActive":true},{"type":"text","text":" (path-copying weight-balanced trees that keep every version)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Caches"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/caches","isActive":true},{"text":" (LRU caches)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shared","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"overridingTitle":"CollectionErrors","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/collectionerrors","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"codeVoice","code":"CollectionErrors"}]},{"text":": the errors the ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" spellings throw, re-exported by every module that throws them","type":"text"}]}]]],"type":"table"}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/grafluentcollections"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://tyler-keith-thompson.github.io/GrafluentCollections/documentation/suffixstructures":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/suffixstructures","titleInlineContent":[{"type":"codeVoice","code":"SuffixStructures"}],"title":"SuffixStructures","url":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/suffixstructures","type":"link"},"https://tyler-keith-thompson.github.io/GrafluentCollections/documentation/decisiondiagrams":{"type":"link","title":"DecisionDiagrams","url":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/decisiondiagrams","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/decisiondiagrams","titleInlineContent":[{"type":"codeVoice","code":"DecisionDiagrams"}]},"doc://GrafluentCollections/documentation/GrafluentCollections":{"role":"collection","type":"topic","url":"\/documentation\/grafluentcollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","title":"GrafluentCollections","kind":"symbol"},"doc://GrafluentCollections/documentation/GrafluentCollectio