{"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"GrafluentCollections","externalID":"GrafluentCollections","roleHeading":"Framework","role":"collection","modules":[{"name":"GrafluentCollections"}],"symbolKind":"module"},"variants":[{"paths":["\/documentation\/grafluentcollections"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Every collection is a copy-on-write struct with the API shape of the standard library’s","type":"text"},{"text":" ","type":"text"},{"text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent type of that shape (","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":"), so Grafluent’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithms and drawings run over it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"import GrafluentCollections","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation and"},{"type":"text","text":" "},{"type":"text","text":"can be imported on its own."}],"type":"paragraph"},{"code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"text"},{"text":"with value semantics, built on Grafluent.","type":"text"}],"hierarchy":{"paths":[[]]},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"title":"GrafluentCollections","abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"text"},{"text":"with value semantics, built on Grafluent.","type":"text"}],"type":"topic","url":"\/documentation\/grafluentcollections","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","role":"collection","kind":"symbol"}}}