{"metadata":{"roleHeading":"Framework","symbolKind":"module","externalID":"GrafluentCollections","title":"GrafluentCollections","role":"collection","modules":[{"name":"GrafluentCollections"}]},"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Every collection is a copy-on-write struct with the API shape of the standard library’s"},{"type":"text","text":" "},{"type":"text","text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the"},{"type":"text","text":" "},{"type":"text","text":"Grafluent type of that shape ("},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":", "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":"), so Grafluent’s"},{"type":"text","text":" "},{"type":"text","text":"algorithms and drawings run over it."}],"type":"paragraph"},{"inlineContent":[{"code":"import GrafluentCollections","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation and","type":"text"},{"text":" ","type":"text"},{"text":"can be imported on its own.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections"]}],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"t