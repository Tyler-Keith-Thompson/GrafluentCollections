{"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every collection is a copy-on-write struct with the API shape of the standard library’s"},{"type":"text","text":" "},{"type":"text","text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the"},{"type":"text","text":" "},{"type":"text","text":"Grafluent type of that shape ("},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":", "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":"), so Grafluent’s"},{"type":"text","text":" "},{"type":"text","text":"algorithms and drawings run over it."}]},{"type":"paragraph","inlineContent":[{"code":"import GrafluentCollections","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation and"},{"type":"text","text":" "},{"type":"text","text":"can be imported on its own."}]},{"type":"codeListing","code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"],"syntax":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams"},{"type":"text","text":" "},{"type":"text","text":"with value semantics, built on Grafluent."}],"variants":[{"paths":["\/documentation\/grafluentcollections"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"collection","title":"GrafluentCollections","modules":[{"name":"GrafluentCollections"}],"externalID":"GrafluentCollections","symbolKind":"module","roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol","type":"topic","role":"collection","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams"},{"type":"text","text":" "},{"type":"text","text":"with value semantics, built on Grafluent."}],"url":"\/documentation\/grafluentcollections","title":"GrafluentCollections"}}}