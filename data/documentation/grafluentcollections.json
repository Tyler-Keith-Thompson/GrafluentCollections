{"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"Every collection is a copy-on-write struct with the API shape of the standard library’s","type":"text"},{"text":" ","type":"text"},{"text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent type of that shape (","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":"), so Grafluent’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithms and drawings run over it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"import GrafluentCollections","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation and","type":"text"},{"text":" ","type":"text"},{"text":"can be imported on its own.","type":"text"}],"type":"paragraph"},{"code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections"]}],"kind":"symbol","metadata":{"symbolKind":"module","role":"collection","externalID":"GrafluentCollections","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Framework","title":"GrafluentCollections"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams"},{"type":"text","text":" "},{"type":"text","text":"with value semantics, built on Grafluent."}],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"role":"collection","url":"\/documentation\/grafluentcollections","abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams","type":"text"},{"text":" ","type":"text"},{"text":"with value semantics, built on Grafluent.","type":"text"}],"title":"GrafluentCollections","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol","type":"topic"}}}