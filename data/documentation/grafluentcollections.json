{"hierarchy":{"paths":[[]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"},"sections":[],"metadata":{"symbolKind":"module","role":"collection","roleHeading":"Framework","title":"GrafluentCollections","modules":[{"name":"GrafluentCollections"}],"externalID":"GrafluentCollections"},"abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams"},{"type":"text","text":" "},{"type":"text","text":"with value semantics, built on Grafluent."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every collection is a copy-on-write struct with the API shape of the standard library’s"},{"type":"text","text":" "},{"type":"text","text":"collections and Swift Collections. Where a structure is a tree or a graph, it also converts to the"},{"type":"text","text":" "},{"type":"text","text":"Grafluent type of that shape ("},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":", "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":"), so Grafluent’s"},{"type":"text","text":" "},{"type":"text","text":"algorithms and drawings run over it."}]},{"type":"paragraph","inlineContent":[{"code":"import GrafluentCollections","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation and"},{"type":"text","text":" "},{"type":"text","text":"can be imported on its own."}]},{"type":"codeListing","syntax":"swift","code":["import GrafluentCollections","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","print(scores.prefixSum(through: 3))  \/\/ 9","print(scores.sum(in: 2 ..< 6))       \/\/ 19"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/grafluentcollections"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"kind":"symbol","role":"collection","url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures and decision diagrams"},{"type":"text","text":" "},{"type":"text","text":"with value semantics, built on Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","type":"topic"}}}