{"sections":[],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The sorted sets share one API: "},{"type":"codeVoice","code":"insert(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"SetAlgebra"},{"type":"text","text":"’s set"},{"type":"text","text":" "},{"type":"text","text":"operations, "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":", and the elements as a"},{"type":"text","text":" "},{"type":"text","text":"random-access collection in ascending order, indexed by rank. Changing which one a program uses"},{"type":"text","text":" "},{"type":"text","text":"is a change of type name:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let avl: AVLTree = [40, 10, 30, 20]","let redBlack: RedBlackTree = [40, 10, 30, 20]","let bTree: BTree = [40, 10, 30, 20]","let skipList: SkipList = [40, 10, 30, 20]","","Array(avl)              \/\/ [10, 20, 30, 40], and the same for the others","avl.lowerBound(25)      \/\/ 2, the index of 30","bTree.lowerBound(25)    \/\/ 2"]},{"inlineContent":[{"type":"text","text":"Every one takes O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") per lookup, insertion and removal (expected for the treap and skip"},{"type":"text","text":" "},{"type":"text","text":"list, amortized for the splay tree). They differ in the constant, in what else they offer, and in"},{"type":"text","text":" "},{"type":"text","text":"which workloads they suit."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Lookups and scans over a large set: BTree","anchor":"Lookups-and-scans-over-a-large-set-BTree"},{"inlineContent":[{"text":"A B-tree node (","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/btrees","type":"reference","isActive":true},{"text":") holds tens of elements side by side, so a lookup reads a few nodes and few","type":"text"},{"text":" ","type":"text"},{"text":"cache lines, and iteration walks contiguous arrays. For a large set that is read far more often","type":"text"},{"text":" ","type":"text"},{"text":"than it is changed, and for range scans, a ","type":"text"},{"code":"BTree","type":"codeVoice"},{"text":" is the default. Copying a B-tree shares its","type":"text"},{"text":" ","type":"text"},{"text":"nodes, and a mutated copy copies only the nodes on the path it changes. ","type":"text"},{"code":"BTreeDictionary","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"its sorted dictionary.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Balanced binary trees: AVLTree and RedBlackTree","anchor":"Balanced-binary-trees-AVLTree-and-RedBlackTree"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"AVLTree","type":"codeVoice"},{"text":" keeps the heights of every vertex’s subtrees within one of each other, so it is the","type":"text"},{"text":" ","type":"text"},{"text":"shallowest of the binary trees and the quickest of them to search. A ","type":"text"},{"code":"RedBlackTree","type":"codeVoice"},{"text":" allows a","type":"text"},{"text":" ","type":"text"},{"text":"taller tree and in return rotates at most two or three times per insertion or removal; prefer it","type":"text"},{"text":" ","type":"text"},{"text":"when changes outnumber lookups. Both convert to a Grafluent ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" that shows the exact","type":"text"},{"text":" ","type":"text"},{"text":"shape. ","type":"text"},{"code":"AVLDictionary","type":"codeVoice"},{"text":" is the sorted dictionary in an AVL tree.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Splitting and joining: Treap","anchor":"Splitting-and-joining-Treap"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Treap"},{"text":" keeps a random priority on each vertex, which makes its shape a random binary search","type":"text"},{"text":" ","type":"text"},{"text":"tree’s whatever order the elements arrive in, and gives it ","type":"text"},{"type":"codeVoice","code":"split(at:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"join(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"]},{"inlineContent":[{"type":"codeVoice","code":"join(_:)"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"OverlappingKeys"},{"type":"text","text":" when the sets interleave. Pass a seeded generator to"},{"type":"text","text":" "},{"type":"codeVoice","code":"Treap(_:using:)"},{"type":"text","text":" to make every shape reproducible. "},{"type":"codeVoice","code":"BTree"},{"type":"text","text":" splits too."}],"type":"paragraph"},{"level":3,"type":"heading","text":"A working set of hot elements: SplayTree","anchor":"A-working-set-of-hot-elements-SplayTree"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SplayTree"},{"type":"text","text":" keeps no balance information. "},{"type":"codeVoice","code":"access(_:)"},{"type":"text","text":" and each mutation rotate the element"},{"type":"text","text":" "},{"type":"text","text":"they reach to the root, so a run of lookups that keeps returning to a few elements finds them"},{"type":"text","text":" "},{"type":"text","text":"near the top:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root"]},{"inlineContent":[{"type":"text","text":"Its other reads, "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":" among them, leave the tree as it is, so they keep value"},{"type":"text","text":" "},{"type":"text","text":"semantics; use "},{"type":"codeVoice","code":"access(_:)"},{"type":"text","text":" where the splay is wanted."}],"type":"paragraph"},{"level":3,"type":"heading","text":"A sorted queue with a simple structure: SkipList","anchor":"A-sorted-queue-with-a-simple-structure-SkipList"},{"inlineContent":[{"type":"text","text":"A skip list ("},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/skiplists","isActive":true},{"type":"text","text":") stacks sorted linked levels, each holding about half the elements of"},{"type":"text","text":" "},{"type":"text","text":"the one below. Its insertions touch only the levels an element reaches, and its levels are a"},{"type":"text","text":" "},{"type":"text","text":"Grafluent graph through "},{"type":"codeVoice","code":"layersView"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Keeping every version: PersistentTreeSet","anchor":"Keeping-every-version-PersistentTreeSet"},{"inlineContent":[{"type":"text","text":"When old versions must stay readable, as in undo histories, snapshots handed to other tasks or"},{"type":"text","text":" "},{"type":"text","text":"backtracking searches, a persistent set ("},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees"},{"type":"text","text":") shares all but the vertices an edit touched:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                    \/\/ [5]","Array(two)                    \/\/ [3, 5]","Array(three)                  \/\/ [3]"]},{"inlineContent":[{"text":"Each version costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") new vertices rather than a copy of the whole tree.","type":"text"},{"text":" ","type":"text"},{"code":"PersistentTreeDictionary","type":"codeVoice"},{"text":" is the sorted dictionary.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Summary","anchor":"Summary"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Workload","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Large sets, mostly lookups, range scans"}]}],[{"type":"paragraph","inlineContent":[{"code":"BTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"BTreeDictionary","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Mostly lookups, a binary shape to inspect","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AVLTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AVLDictionary"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Mostly insertions and removals","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"RedBlackTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Splitting and joining sets","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Treap"},{"type":"text","text":", "},{"type":"codeVoice","code":"BTree"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Repeated access to a few elements","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"SplayTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Every version kept","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PersistentTreeSet"},{"type":"text","text":", "},{"type":"codeVoice","code":"PersistentTreeDictionary"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"A simple sorted queue"}]}],[{"type":"paragraph","inlineContent":[{"code":"SkipList","type":"codeVoice"}]}]]],"type":"table","header":"row"}]}],"metadata":{"role":"article","title":"Choosing a search tree","roleHeading":"Article","modules":[{"name":"GrafluentCollections"}]},"variants":[{"paths":["\/documentation\/grafluentcollections\/choosingasearchtree"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"generated":true,"anchor":"Guides"}],"abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"references":{"https://tyler-keith-thompson.github.io/GrafluentCollections/documentation/persistenttrees":{"titleInlineContent":[{"code":"PersistentTrees","type":"codeVoice"}],"title":"PersistentTrees","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees"},"https://tyler-keith-thompson.github.io/GrafluentCollections/documentation/btrees":{"title":"BTrees","titleInlineContent":[{"code":"BTrees","type":"codeVoice"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/btrees","url":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/btrees"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","kind":"article","title":"Range and spatial trees","abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"type":"topic","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"title":"GrafluentCollections","type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol","url":"\/documentation\/grafluentcollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"role":"collection"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","kind":"article","title":"Seeing a collection as a graph","abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"type":"topic","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","kind":"article","title":"Tries and suffix structures","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"type":"topic","role":"article"},"https://tyler-keith-thompson.github.io/GrafluentCollections/documentation/skiplists":{"titleInlineContent":[{"type":"codeVoice","code":"SkipLists"}],"url":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/skiplists","title":"SkipLists","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/skiplists"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"url":"\/documentation\/grafluentcollections\/decisiondiagrams","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","kind":"article","title":"Decision diagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"type":"topic","role":"article"}}}