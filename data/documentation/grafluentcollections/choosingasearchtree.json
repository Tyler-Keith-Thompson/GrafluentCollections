{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/choosingasearchtree"]}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"metadata":{"role":"article","title":"Choosing a search tree","roleHeading":"Article","modules":[{"name":"GrafluentCollections"}]},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The sorted sets share one API: ","type":"text"},{"code":"insert(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"contains(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SetAlgebra","type":"codeVoice"},{"text":"’s set","type":"text"},{"text":" ","type":"text"},{"text":"operations, ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":", and the elements as a","type":"text"},{"text":" ","type":"text"},{"text":"random-access collection in ascending order, indexed by rank. Changing which one a program uses","type":"text"},{"text":" ","type":"text"},{"text":"is a change of type name:","type":"text"}],"type":"paragraph"},{"code":["let avl: AVLTree = [40, 10, 30, 20]","let redBlack: RedBlackTree = [40, 10, 30, 20]","let bTree: BTree = [40, 10, 30, 20]","let skipList: SkipList = [40, 10, 30, 20]","","Array(avl)              \/\/ [10, 20, 30, 40], and the same for the others","avl.lowerBound(25)      \/\/ 2, the index of 30","bTree.lowerBound(25)    \/\/ 2"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Every one takes O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") per lookup, insertion and removal (expected for the treap and skip","type":"text"},{"text":" ","type":"text"},{"text":"list, amortized for the splay tree). They differ in the constant, in what else they offer, and in","type":"text"},{"text":" ","type":"text"},{"text":"which workloads they suit.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Lookups and scans over a large set: BTree","type":"heading","anchor":"Lookups-and-scans-over-a-large-set-BTree"},{"inlineContent":[{"text":"A B-tree node (","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/btrees"},{"text":") holds tens of elements side by side, so a lookup reads a few nodes and few","type":"text"},{"text":" ","type":"text"},{"text":"cache lines, and iteration walks contiguous arrays. For a large set that is read far more often","type":"text"},{"text":" ","type":"text"},{"text":"than it is changed, and for range scans, a ","type":"text"},{"type":"codeVoice","code":"BTree"},{"text":" is the default. Copying a B-tree shares its","type":"text"},{"text":" ","type":"text"},{"text":"nodes, and a mutated copy copies only the nodes on the path it changes. ","type":"text"},{"type":"codeVoice","code":"BTreeDictionary"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"its sorted dictionary.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Balanced binary trees: AVLTree and RedBlackTree","type":"heading","anchor":"Balanced-binary-trees-AVLTree-and-RedBlackTree"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"AVLTree","type":"codeVoice"},{"text":" keeps the heights of every vertex’s subtrees within one of each other, so it is the","type":"text"},{"text":" ","type":"text"},{"text":"shallowest of the binary trees and the quickest of them to search. A ","type":"text"},{"code":"RedBlackTree","type":"codeVoice"},{"text":" allows a","type":"text"},{"text":" ","type":"text"},{"text":"taller tree and in return rotates at most two or three times per insertion or removal; prefer it","type":"text"},{"text":" ","type":"text"},{"text":"when changes outnumber lookups. Both convert to a Grafluent ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" that shows the exact","type":"text"},{"text":" ","type":"text"},{"text":"shape. ","type":"text"},{"code":"AVLDictionary","type":"codeVoice"},{"text":" is the sorted dictionary in an AVL tree.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Splitting and joining: Treap","type":"heading","anchor":"Splitting-and-joining-Treap"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Treap"},{"text":" keeps a random priority on each vertex, which makes its shape a random binary search","type":"text"},{"text":" ","type":"text"},{"text":"tree’s whatever order the elements arrive in, and gives it ","type":"text"},{"type":"codeVoice","code":"split(at:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"join(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let numbers: Treap = [8, 3, 5, 1, 9]","let parts = numbers.split(at: 5)","Array(parts.lower)            \/\/ [1, 3]","Array(parts.upper)            \/\/ [5, 8, 9]","var rejoined = parts.lower","try rejoined.join(parts.upper)","rejoined == numbers           \/\/ true"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"join(_:)"},{"text":" throws ","type":"text"},{"type":"codeVoice","code":"OverlappingKeys"},{"text":" when the sets interleave. Pass a seeded generator to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Treap(_:using:)"},{"text":" to make every shape reproducible. ","type":"text"},{"type":"codeVoice","code":"BTree"},{"text":" splits too.","type":"text"}],"type":"paragraph"},{"level":3,"text":"A working set of hot elements: SplayTree","type":"heading","anchor":"A-working-set-of-hot-elements-SplayTree"},{"inlineContent":[{"type":"text","text":"A "},{"code":"SplayTree","type":"codeVoice"},{"type":"text","text":" keeps no balance information. "},{"code":"access(_:)","type":"codeVoice"},{"type":"text","text":" and each mutation rotate the element"},{"type":"text","text":" "},{"type":"text","text":"they reach to the root, so a run of lookups that keeps returning to a few elements finds them"},{"type":"text","text":" "},{"type":"text","text":"near the top:"}],"type":"paragraph"},{"code":["var recent: SplayTree = [10, 20, 30, 40, 50]","recent.access(40)             \/\/ 40, now at the root"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Its other reads, "},{"code":"contains(_:)","type":"codeVoice"},{"type":"text","text":" among them, leave the tree as it is, so they keep value"},{"type":"text","text":" "},{"type":"text","text":"semantics; use "},{"code":"access(_:)","type":"codeVoice"},{"type":"text","text":" where the splay is wanted."}],"type":"paragraph"},{"level":3,"text":"A sorted queue with a simple structure: SkipList","type":"heading","anchor":"A-sorted-queue-with-a-simple-structure-SkipList"},{"inlineContent":[{"text":"A skip list (","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/skiplists","isActive":true,"type":"reference"},{"text":") stacks sorted linked levels, each holding about half the elements of","type":"text"},{"text":" ","type":"text"},{"text":"the one below. Its insertions touch only the levels an element reaches, and its levels are a","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent graph through ","type":"text"},{"code":"layersView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Keeping every version: PersistentTreeSet","type":"heading","anchor":"Keeping-every-version-PersistentTreeSet"},{"inlineContent":[{"text":"When old versions must stay readable, as in undo histories, snapshots handed to other tasks or","type":"text"},{"text":" ","type":"text"},{"text":"backtracking searches, a persistent set (","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees"},{"text":") shares all but the vertices an edit touched:","type":"text"}],"type":"paragraph"},{"code":["let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                    \/\/ [5]","Array(two)                    \/\/ [3, 5]","Array(three)                  \/\/ [3]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each version costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") new vertices rather than a copy of the whole tree."},{"type":"text","text":" "},{"type":"codeVoice","code":"PersistentTreeDictionary"},{"type":"text","text":" is the sorted dictionary."}],"type":"paragraph"},{"level":3,"text":"Summary","type":"heading","anchor":"Summary"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Workload"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Large sets, mostly lookups, range scans"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"BTreeDictionary"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Mostly lookups, a binary shape to inspect","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"AVLTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"AVLDictionary"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Mostly insertions and removals"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RedBlackTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Splitting and joining sets","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Treap","type":"codeVoice"},{"type":"text","text":", "},{"code":"BTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Repeated access to a few elements"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"SplayTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Every version kept"}],"type":"paragraph"}],[{"inlineContent":[{"code":"PersistentTreeSet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PersistentTreeDictionary","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"A simple sorted queue"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SkipList","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"}]}],"abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","interfaceLanguage":"swift"},"references":{"https://tyler-keith-thompson.github.io/GrafluentCollections/documentation/persistenttrees":{"type":"link","title":"PersistentTrees","titleInlineContent":[{"code":"PersistentTrees","type":"codeVoice"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees","url":"https:\/\/tyler-keith-thompson.github.io\/GrafluentCollections\/documentation\/persistenttrees"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"type":"