{"variants":[{"paths":["\/documentation\/grafluentcollections\/decisiondiagrams"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"GrafluentCollections"}],"title":"Decision diagrams","role":"article","roleHeading":"Article"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"generated":true,"title":"Guides","anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A decision diagram stores many Boolean functions, or many families of sets, in one table of","type":"text"},{"text":" ","type":"text"},{"text":"shared vertices. Equal functions are the same vertex, so comparing two functions is comparing","type":"text"},{"text":" ","type":"text"},{"text":"two integers, and operations that combine functions are memoized over the table.","type":"text"}]},{"text":"Binary decision diagrams","anchor":"Binary-decision-diagrams","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"BinaryDecisionDiagram"},{"text":" is reduced and ordered: variables appear in one order on every path,","type":"text"},{"text":" ","type":"text"},{"text":"and no vertex is redundant. Build functions from variables with ","type":"text"},{"type":"codeVoice","code":"and"},{"text":", ","type":"text"},{"type":"codeVoice","code":"or"},{"text":", ","type":"text"},{"type":"codeVoice","code":"not"},{"text":" and the other","type":"text"},{"text":" ","type":"text"},{"text":"operators, then ask about them:","type":"text"}]},{"code":["var diagram = BinaryDecisionDiagram(variableCount: 3)","let x0 = diagram.variable(0), x1 = diagram.variable(1), x2 = diagram.variable(2)","let f = diagram.or(diagram.and(x0, x1), x2)","let g = diagram.or(x2, diagram.and(x1, x0))","f == g                                     \/\/ true: the same function, the same vertex","diagram.satisfyingAssignmentCount(of: f)   \/\/ 5"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The functions are handles into the diagram that made them, so the diagram is the value that","type":"text"},{"text":" ","type":"text"},{"text":"mutates as functions are built. Use one when a problem is a constraint over Boolean variables:","type":"text"},{"text":" ","type":"text"},{"text":"configurations, reachability in a finite state system, equivalence of circuits.","type":"text"}]},{"text":"Zero-suppressed decision diagrams","anchor":"Zero-suppressed-decision-diagrams","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram"},{"type":"text","text":" drops a vertex when its “with this element” branch is empty,"},{"type":"text","text":" "},{"type":"text","text":"rather than when both branches agree. That suits families of sparse sets, where most elements"},{"type":"text","text":" "},{"type":"text","text":"are absent from most sets: combinations, paths in a graph, itemsets."}]},{"code":["var diagram = ZeroSuppressedDecisionDiagram(elementCount: 3)","let f = diagram.family([[0, 1], [1, 2], [2]])","diagram.count(of: f)                                  \/\/ 3","let g = diagram.including(2, in: f)                   \/\/ {{1, 2}, {2}}","diagram.minimalSets(of: g) == diagram.family([[2]])   \/\/ true"],"type":"codeListing","syntax":"swift"},{"text":"Choosing","anchor":"Choosing","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use a BDD for a Boolean function of the variables, and a ZDD for a family of sets over a","type":"text"},{"text":" ","type":"text"},{"text":"universe of elements, most of which are absent from each set. A family can be written as a BDD","type":"text"},{"text":" ","type":"text"},{"text":"too, and a function as a ZDD, but the other choice is usually smaller.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both diagrams’ "},{"type":"codeVoice","code":"graphView"},{"type":"text","text":" is a Grafluent "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" over the whole table, so Grafluent’s"},{"type":"text","text":" "},{"type":"text","text":"traversals and writers run over it."}]}],"kind":"content"}],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"role":"collection","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"role":"article","url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"type":"topic","title":"Range and spatial trees"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"role":"article","abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","title":"Tries and suffix structures","type":"topic","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"role":"article","url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"type":"topic","title":"Seeing a collection as a graph"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"role":"article","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","url":"\/documentation\/grafluentcollections\/choosingasearchtree","type":"topic","title":"Choosing a search tree","kind":"article"}}}