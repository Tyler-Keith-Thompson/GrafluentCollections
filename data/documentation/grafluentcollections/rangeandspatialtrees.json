{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The range trees keep a sequence of values and answer questions about a contiguous range of it;","type":"text"},{"text":" ","type":"text"},{"text":"the interval tree keeps ranges and answers which of them meet a point or another range; the","type":"text"},{"text":" ","type":"text"},{"text":"spatial trees keep points and answer which of them are near a point or inside a box.","type":"text"}],"type":"paragraph"},{"anchor":"Prefix-sums-FenwickTree","text":"Prefix sums: FenwickTree","type":"heading","level":3},{"inlineContent":[{"text":"A ","type":"text"},{"code":"FenwickTree","type":"codeVoice"},{"text":" keeps prefix sums of a sequence under point updates, each in O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), in one","type":"text"},{"text":" ","type":"text"},{"text":"array the size of the sequence. Use it for running totals, ranks and counts:","type":"text"}],"type":"paragraph"},{"code":["var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)    \/\/ 9","scores.sum(in: 2 ..< 6)         \/\/ 19"],"type":"codeListing","syntax":"swift"},{"anchor":"Any-associative-combination-SegmentTree","text":"Any associative combination: SegmentTree","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SegmentTree"},{"type":"text","text":" combines any range under a monoid ("},{"type":"codeVoice","code":"Sum"},{"type":"text","text":", "},{"type":"codeVoice","code":"Minimum"},{"type":"text","text":", "},{"type":"codeVoice","code":"Maximum"},{"type":"text","text":", or one of your"},{"type":"text","text":" "},{"type":"text","text":"own), not only sums, and need not be commutative:"}],"type":"paragraph"},{"code":["var tree = SegmentTree<Minimum<Int>>([5, 3, 8, 6, 1, 9])","tree.combined(in: 0 ..< 4)      \/\/ 3","tree.update(at: 2, to: 0)","tree.combined(in: 0 ..< 4)      \/\/ 0"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"LazySegmentTree"},{"type":"text","text":" adds updates that apply to a whole range at once, such as adding to every"},{"type":"text","text":" "},{"type":"text","text":"value in a range or setting each one, with the update and its effect on the monoid named by a"},{"type":"text","text":" "},{"type":"codeVoice","code":"MonoidAction"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Intervals-IntervalTree","text":"Intervals: IntervalTree","type":"heading","level":3},{"inlineContent":[{"text":"An ","type":"text"},{"code":"IntervalTree","type":"codeVoice"},{"type":"text","text":" keeps half-open ranges with a value each and finds those that contain a point,"},{"type":"text","text":" "},{"type":"text","text":"overlap a range or lie inside one:"}],"type":"paragraph"},{"code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]"],"type":"codeListing","syntax":"swift"},{"anchor":"Points-KDTree-Quadtree-and-Octree","text":"Points: KDTree, Quadtree and Octree","type":"heading","level":3},{"inlineContent":[{"text":"A ","type":"text"},{"code":"KDTree","type":"codeVoice"},{"text":" is built once from a set of points of any dimension and answers nearest-neighbor,","type":"text"},{"text":" ","type":"text"},{"text":"radius and box queries. It suits points that rarely change:","type":"text"}],"type":"paragraph"},{"code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                                    \/\/ 4: the point [8, 1]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))      \/\/ [0, 1]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Quadtree","type":"codeVoice"},{"type":"text","text":" (in the plane) and an "},{"code":"Octree","type":"codeVoice"},{"type":"text","text":" (in space) divide a fixed bounding box into buckets"},{"type":"text","text":" "},{"type":"text","text":"and take insertions and removals as they come, which suits points that move or arrive over time:"}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"library\", at: [12, 22])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element              \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count        \/\/ 2"],"type":"codeListing","syntax":"swift"},{"anchor":"Boxes-MXCIFQuadtree-and-MXCIFOctree","text":"Boxes: MXCIFQuadtree and MXCIFOctree","type":"heading","level":3},{"inlineContent":[{"text":"An ","type":"text"},{"code":"MXCIFQuadtree","type":"codeVoice"},{"text":" (in the plane) and an ","type":"text"},{"code":"MXCIFOctree","type":"codeVoice"},{"text":" (in space) hold elements that cover a","type":"text"},{"text":" ","type":"text"},{"text":"region rather than sit at a point. Each box hangs on the smallest cell that wholly contains it,","type":"text"},{"text":" ","type":"text"},{"text":"so the tree finds the boxes containing a point, those overlapping a box, and every pair that","type":"text"},{"text":" ","type":"text"},{"text":"overlaps, as for collision detection or map labels:","type":"text"}],"type":"paragraph"},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)    \/\/ [\"hall\"]","plan.overlappingPairs().count                      \/\/ 1"],"type":"codeListing","syntax":"swift"},{"anchor":"Choosing","text":"Choosing","type":"heading","level":3},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Question"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Prefix and range sums under point updates"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FenwickTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Any associative combination of a range"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"SegmentTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"The same, with updates to whole ranges"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LazySegmentTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Which intervals meet a point or a range","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"IntervalTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Nearest points in a fixed set, any dimension"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"KDTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Points that change, in two or three dimensions","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Quadtree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Octree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Boxes that overlap, in two or three dimensions","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MXCIFQuadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"MXCIFOctree"}],"type":"paragraph"}]]],"header":"row"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"GrafluentCollections"}],"title":"Range and spatial trees","role":"article"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/rangeandspatialtrees"]}],"abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"seeAlsoSections":[{"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"generated":true,"anchor":"Guides","title":"Guides"}],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","references":{"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"url":"\/documentation\/grafluentcollections\/decisiondiagrams","type":"topic","kind":"article","title":"Decision diagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"title":"Seeing a collection as a graph","url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","role":"article","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","type":"topic","title":"Tries and suffix structures","kind":"article","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"url":"\/documentation\/grafluentcollections","type":"topic","kind":"symbol","title":"GrafluentCollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","role":"collection"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"url":"\/documentation\/grafluentcollections\/choosingasearchtree","type":"topic","title":"Choosing a search tree","kind":"article","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","role":"article"}}}