{"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"anchor":"Guides","title":"Guides"}],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"The range trees keep a sequence of values and answer questions about a contiguous range of it;","type":"text"},{"text":" ","type":"text"},{"text":"the interval tree keeps ranges and answers which of them meet a point or another range; the","type":"text"},{"text":" ","type":"text"},{"text":"spatial trees keep points and answer which of them are near a point or inside a box.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Prefix-sums-FenwickTree","type":"heading","text":"Prefix sums: FenwickTree"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"FenwickTree"},{"type":"text","text":" keeps prefix sums of a sequence under point updates, each in O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), in one"},{"type":"text","text":" "},{"type":"text","text":"array the size of the sequence. Use it for running totals, ranks and counts:"}],"type":"paragraph"},{"code":["var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)    \/\/ 9","scores.sum(in: 2 ..< 6)         \/\/ 19"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Any-associative-combination-SegmentTree","type":"heading","text":"Any associative combination: SegmentTree"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"SegmentTree","type":"codeVoice"},{"text":" combines any range under a monoid (","type":"text"},{"code":"Sum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Minimum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Maximum","type":"codeVoice"},{"text":", or one of your","type":"text"},{"text":" ","type":"text"},{"text":"own), not only sums, and need not be commutative:","type":"text"}],"type":"paragraph"},{"code":["var tree = SegmentTree<Minimum<Int>>([5, 3, 8, 6, 1, 9])","tree.combined(in: 0 ..< 4)      \/\/ 3","tree.update(at: 2, to: 0)","tree.combined(in: 0 ..< 4)      \/\/ 0"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"LazySegmentTree"},{"text":" adds updates that apply to a whole range at once, such as adding to every","type":"text"},{"text":" ","type":"text"},{"text":"value in a range or setting each one, with the update and its effect on the monoid named by a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MonoidAction"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Intervals-IntervalTree","type":"heading","text":"Intervals: IntervalTree"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"IntervalTree"},{"text":" keeps half-open ranges with a value each and finds those that contain a point,","type":"text"},{"text":" ","type":"text"},{"text":"overlap a range or lie inside one:","type":"text"}],"type":"paragraph"},{"code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Points-KDTree-Quadtree-and-Octree","type":"heading","text":"Points: KDTree, Quadtree and Octree"},{"inlineContent":[{"type":"text","text":"A "},{"code":"KDTree","type":"codeVoice"},{"type":"text","text":" is built once from a set of points of any dimension and answers nearest-neighbor,"},{"type":"text","text":" "},{"type":"text","text":"radius and box queries. It suits points that rarely change:"}],"type":"paragraph"},{"code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                                    \/\/ 4: the point [8, 1]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))      \/\/ [0, 1]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Quadtree"},{"text":" (in the plane) and an ","type":"text"},{"type":"codeVoice","code":"Octree"},{"text":" (in space) divide a fixed bounding box into buckets","type":"text"},{"text":" ","type":"text"},{"text":"and take insertions and removals as they come, which suits points that move or arrive over time:","type":"text"}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"library\", at: [12, 22])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element              \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count        \/\/ 2"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Choosing","type":"heading","text":"Choosing"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Question","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefix and range sums under point updates"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FenwickTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any associative combination of a range"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SegmentTree"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"The same, with updates to whole ranges","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"LazySegmentTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which intervals meet a point or a range"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IntervalTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nearest points in a fixed set, any dimension"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"KDTree"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Points that change, in two or three dimensions","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Quadtree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Octree","type":"codeVoice"}]}]]]}],"kind":"content"}],"abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/rangeandspatialtrees"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"GrafluentCollections"}],"title":"Range and spatial trees"},"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"kind":"article","sections":[],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"title":"Seeing a collection as a graph","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","kind":"article","type":"topic","abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"title":"Tries and suffix structures","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","role":"article","type":"topic","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","title":"Choosing a search tree","url":"\/documentation\/grafluentcollections\/choosingasearchtree","kind":"article","type":"topic","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"title":"Decision diagrams","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"url":"\/documentation\/grafluentcollections\/decisiondiagrams","role":"article","kind":"article","type":"topic"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","title":"GrafluentCollections","url":"\/documentation\/grafluentcollections","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"role":"collection"}}}