{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The range trees keep a sequence of values and answer questions about a contiguous range of it;"},{"type":"text","text":" "},{"type":"text","text":"the interval tree keeps ranges and answers which of them meet a point or another range; the"},{"type":"text","text":" "},{"type":"text","text":"spatial trees keep points and answer which of them are near a point or inside a box."}],"type":"paragraph"},{"text":"Prefix sums: FenwickTree","level":3,"anchor":"Prefix-sums-FenwickTree","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"FenwickTree"},{"type":"text","text":" keeps prefix sums of a sequence under point updates, each in O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), in one"},{"type":"text","text":" "},{"type":"text","text":"array the size of the sequence. Use it for running totals, ranks and counts:"}],"type":"paragraph"},{"code":["var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)    \/\/ 9","scores.sum(in: 2 ..< 6)         \/\/ 19"],"syntax":"swift","type":"codeListing"},{"text":"Any associative combination: SegmentTree","level":3,"anchor":"Any-associative-combination-SegmentTree","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"code":"SegmentTree","type":"codeVoice"},{"type":"text","text":" combines any range under a monoid ("},{"code":"Sum","type":"codeVoice"},{"type":"text","text":", "},{"code":"Minimum","type":"codeVoice"},{"type":"text","text":", "},{"code":"Maximum","type":"codeVoice"},{"type":"text","text":", or one of your"},{"type":"text","text":" "},{"type":"text","text":"own), not only sums, and need not be commutative:"}],"type":"paragraph"},{"code":["var tree = SegmentTree<Minimum<Int>>([5, 3, 8, 6, 1, 9])","tree.combined(in: 0 ..< 4)      \/\/ 3","tree.update(at: 2, to: 0)","tree.combined(in: 0 ..< 4)      \/\/ 0"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"LazySegmentTree"},{"type":"text","text":" adds updates that apply to a whole range at once, such as adding to every"},{"type":"text","text":" "},{"type":"text","text":"value in a range or setting each one, with the update and its effect on the monoid named by a"},{"type":"text","text":" "},{"type":"codeVoice","code":"MonoidAction"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Intervals: IntervalTree","level":3,"anchor":"Intervals-IntervalTree","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"IntervalTree"},{"type":"text","text":" keeps half-open ranges with a value each and finds those that contain a point,"},{"type":"text","text":" "},{"type":"text","text":"overlap a range or lie inside one:"}],"type":"paragraph"},{"code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]"],"syntax":"swift","type":"codeListing"},{"text":"Points: KDTree, Quadtree and Octree","level":3,"anchor":"Points-KDTree-Quadtree-and-Octree","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"KDTree","type":"codeVoice"},{"text":" is built once from a set of points of any dimension and answers nearest-neighbor,","type":"text"},{"text":" ","type":"text"},{"text":"radius and box queries. It suits points that rarely change:","type":"text"}],"type":"paragraph"},{"code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                                    \/\/ 4: the point [8, 1]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))      \/\/ [0, 1]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Quadtree"},{"text":" (in the plane) and an ","type":"text"},{"type":"codeVoice","code":"Octree"},{"text":" (in space) divide a fixed bounding box into buckets","type":"text"},{"text":" ","type":"text"},{"text":"and take insertions and removals as they come, which suits points that move or arrive over time:","type":"text"}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"library\", at: [12, 22])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element              \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count        \/\/ 2"],"syntax":"swift","type":"codeListing"},{"text":"Boxes: MXCIFQuadtree and MXCIFOctree","level":3,"anchor":"Boxes-MXCIFQuadtree-and-MXCIFOctree","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"MXCIFQuadtree"},{"type":"text","text":" (in the plane) and an "},{"type":"codeVoice","code":"MXCIFOctree"},{"type":"text","text":" (in space) hold elements that cover a"},{"type":"text","text":" "},{"type":"text","text":"region rather than sit at a point. Each box hangs on the smallest cell that wholly contains it,"},{"type":"text","text":" "},{"type":"text","text":"so the tree finds the boxes containing a point, those overlapping a box, and every pair that"},{"type":"text","text":" "},{"type":"text","text":"overlaps, as for collision detection or map labels:"}],"type":"paragraph"},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)    \/\/ [\"hall\"]","plan.overlappingPairs().count                      \/\/ 1"],"syntax":"swift","type":"codeListing"},{"text":"Choosing","level":3,"anchor":"Choosing","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Question"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefix and range sums under point updates"}]}],[{"type":"paragraph","inlineContent":[{"code":"FenwickTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any associative combination of a range"}]}],[{"type":"paragraph","inlineContent":[{"code":"SegmentTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"The same, with updates to whole ranges","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LazySegmentTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which intervals meet a point or a range"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IntervalTree"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Nearest points in a fixed set, any dimension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"KDTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Points that change, in two or three dimensions","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Quadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Octree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Boxes that overlap, in two or three dimensions"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MXCIFQuadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"MXCIFOctree"}]}]]],"type":"table"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/rangeandspatialtrees"]}],"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"anchor":"Guides"}],"abstract":[{"text":"Answer queries over ranges of a sequence, over intervals, and over points in space.","type":"text"}],"metadata":{"title":"Range and spatial trees","roleHeading":"Article","role":"article","modules":[{"name":"GrafluentCollections"}]},"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","interfaceLanguage":"swift"},"kind":"article","references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"type":"topic","url":"\/documentation\/grafluentcollections","abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,","type":"text"},{"text":" ","type":"text"},{"text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent.","type":"text"}],"role":"collection","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","title":"GrafluentCollections","kind":"symbol"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"type":"topic","url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","title":"Seeing a collection as a graph","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"type":"topic","url":"\/documentation\/grafluentcollections\/decisiondiagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","title":"Decision diagrams","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","url":"\/documentation\/grafluentcollections\/choosingasearchtree","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"type":"topic","role":"article","title":"Choosing a search tree","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"type":"topic","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","title":"Tries and suffix structures","kind":"article"}}}