{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Answer queries over ranges of a sequence, over intervals, and over points in space.","type":"text"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"},"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The range trees keep a sequence of values and answer questions about a contiguous range of it;"},{"type":"text","text":" "},{"type":"text","text":"the interval tree keeps ranges and answers which of them meet a point or another range; the"},{"type":"text","text":" "},{"type":"text","text":"spatial trees keep points and answer which of them are near a point or inside a box."}]},{"type":"heading","anchor":"Prefix-sums-FenwickTree","text":"Prefix sums: FenwickTree","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"FenwickTree"},{"type":"text","text":" keeps prefix sums of a sequence under point updates, each in O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), in one"},{"type":"text","text":" "},{"type":"text","text":"array the size of the sequence. Use it for running totals, ranks and counts:"}]},{"type":"codeListing","code":["var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)    \/\/ 9","scores.sum(in: 2 ..< 6)         \/\/ 19"],"syntax":"swift"},{"type":"heading","anchor":"Any-associative-combination-SegmentTree","text":"Any associative combination: SegmentTree","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SegmentTree"},{"type":"text","text":" combines any range under a monoid ("},{"type":"codeVoice","code":"Sum"},{"type":"text","text":", "},{"type":"codeVoice","code":"Minimum"},{"type":"text","text":", "},{"type":"codeVoice","code":"Maximum"},{"type":"text","text":", or one of your"},{"type":"text","text":" "},{"type":"text","text":"own), not only sums, and need not be commutative:"}]},{"type":"codeListing","code":["var tree = SegmentTree<Minimum<Int>>([5, 3, 8, 6, 1, 9])","tree.combined(in: 0 ..< 4)      \/\/ 3","tree.update(at: 2, to: 0)","tree.combined(in: 0 ..< 4)      \/\/ 0"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"LazySegmentTree"},{"text":" adds updates that apply to a whole range at once, such as adding to every","type":"text"},{"text":" ","type":"text"},{"text":"value in a range or setting each one, with the update and its effect on the monoid named by a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MonoidAction"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Intervals-IntervalTree","text":"Intervals: IntervalTree","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"code":"IntervalTree","type":"codeVoice"},{"type":"text","text":" keeps half-open ranges with a value each and finds those that contain a point,"},{"type":"text","text":" "},{"type":"text","text":"overlap a range or lie inside one:"}]},{"type":"codeListing","code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]"],"syntax":"swift"},{"type":"heading","anchor":"Points-KDTree-Quadtree-and-Octree","text":"Points: KDTree, Quadtree and Octree","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"KDTree","type":"codeVoice"},{"type":"text","text":" is built once from a set of points of any dimension and answers nearest-neighbor,"},{"type":"text","text":" "},{"type":"text","text":"radius and box queries. It suits points that rarely change:"}]},{"type":"codeListing","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                                    \/\/ 4: the point [8, 1]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))      \/\/ [0, 1]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Quadtree","type":"codeVoice"},{"text":" (in the plane) and an ","type":"text"},{"code":"Octree","type":"codeVoice"},{"text":" (in space) divide a fixed bounding box into buckets","type":"text"},{"text":" ","type":"text"},{"text":"and take insertions and removals as they come, which suits points that move or arrive over time:","type":"text"}]},{"type":"codeListing","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"library\", at: [12, 22])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element              \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count        \/\/ 2"],"syntax":"swift"},{"type":"heading","anchor":"Choosing","text":"Choosing","level":3},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Question"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Prefix and range sums under point updates"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FenwickTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Any associative combination of a range"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SegmentTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"The same, with updates to whole ranges","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LazySegmentTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Which intervals meet a point or a range","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"IntervalTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Nearest points in a fixed set, any dimension"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"KDTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Points that change, in two or three dimensions"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Quadtree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Octree","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"}]}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/rangeandspatialtrees"]}],"metadata":{"modules":[{"name":"GrafluentCollections"}],"title":"Range and spatial trees","roleHeading":"Article","role":"article"},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","title":"Seeing a collection as a graph","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","type":"topic","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","role":"article","title":"Tries and suffix structures","type":"topic"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,","type":"text"},{"text":" ","type":"text"},{"text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent.","type":"text"}],"url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","kind":"symbol","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","type":"topic","role":"collection"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"url":"\/documentation\/grafluentcollections\/decisiondiagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","role":"article","type":"topic","title":"Decision diagrams"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"url":"\/documentation\/grafluentcollections\/choosingasearchtree","title":"Choosing a search tree","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","type":"topic","role":"article"}}}