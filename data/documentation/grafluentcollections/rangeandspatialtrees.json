{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"The range trees keep a sequence of values and answer questions about a contiguous range of it;","type":"text"},{"text":" ","type":"text"},{"text":"the interval tree keeps ranges and answers which of them meet a point or another range; the","type":"text"},{"text":" ","type":"text"},{"text":"spatial trees keep points and answer which of them are near a point or inside a box.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Prefix-sums-FenwickTree","level":3,"text":"Prefix sums: FenwickTree"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"FenwickTree","type":"codeVoice"},{"text":" keeps prefix sums of a sequence under point updates, each in O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"), in one","type":"text"},{"text":" ","type":"text"},{"text":"array the size of the sequence. Use it for running totals, ranks and counts:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)    \/\/ 9","scores.sum(in: 2 ..< 6)         \/\/ 19"],"syntax":"swift"},{"type":"heading","anchor":"Any-associative-combination-SegmentTree","level":3,"text":"Any associative combination: SegmentTree"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"SegmentTree","type":"codeVoice"},{"text":" combines any range under a monoid (","type":"text"},{"code":"Sum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Minimum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Maximum","type":"codeVoice"},{"text":", or one of your","type":"text"},{"text":" ","type":"text"},{"text":"own), not only sums, and need not be commutative:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var tree = SegmentTree<Minimum<Int>>([5, 3, 8, 6, 1, 9])","tree.combined(in: 0 ..< 4)      \/\/ 3","tree.update(at: 2, to: 0)","tree.combined(in: 0 ..< 4)      \/\/ 0"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"LazySegmentTree"},{"type":"text","text":" adds updates that apply to a whole range at once, such as adding to every"},{"type":"text","text":" "},{"type":"text","text":"value in a range or setting each one, with the update and its effect on the monoid named by a"},{"type":"text","text":" "},{"type":"codeVoice","code":"MonoidAction"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Intervals-IntervalTree","level":3,"text":"Intervals: IntervalTree"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"IntervalTree"},{"type":"text","text":" keeps half-open ranges with a value each and finds those that contain a point,"},{"type":"text","text":" "},{"type":"text","text":"overlap a range or lie inside one:"}],"type":"paragraph"},{"type":"codeListing","code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]"],"syntax":"swift"},{"type":"heading","anchor":"Points-KDTree-Quadtree-and-Octree","level":3,"text":"Points: KDTree, Quadtree and Octree"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"KDTree"},{"text":" is built once from a set of points of any dimension and answers nearest-neighbor,","type":"text"},{"text":" ","type":"text"},{"text":"radius and box queries. It suits points that rarely change:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                                    \/\/ 4: the point [8, 1]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))      \/\/ [0, 1]"],"syntax":"swift"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Quadtree","type":"codeVoice"},{"text":" (in the plane) and an ","type":"text"},{"code":"Octree","type":"codeVoice"},{"text":" (in space) divide a fixed bounding box into buckets","type":"text"},{"text":" ","type":"text"},{"text":"and take insertions and removals as they come, which suits points that move or arrive over time:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"library\", at: [12, 22])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element              \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count        \/\/ 2"],"syntax":"swift"},{"type":"heading","anchor":"Choosing","level":3,"text":"Choosing"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Question"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Prefix and range sums under point updates","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FenwickTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Any associative combination of a range"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"SegmentTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"The same, with updates to whole ranges","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LazySegmentTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Which intervals meet a point or a range","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"IntervalTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Nearest points in a fixed set, any dimension"}],"type":"paragraph"}],[{"inlineContent":[{"code":"KDTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Points that change, in two or three dimensions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Quadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Octree"}],"type":"paragraph"}]]],"header":"row"}]}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/rangeandspatialtrees"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"generated":true,"anchor":"Guides","title":"Guides"}],"metadata":{"role":"article","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Article","title":"Range and spatial trees"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"kind":"symbol","role":"collection","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"type":"topic","title":"GrafluentCollections","url":"\/documentation\/grafluentcollections"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"kind":"article","role":"article","abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"type":"topic","url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","title":"Seeing a collection as a graph","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"kind":"article","role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"type":"topic","title":"Tries and suffix structures","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"kind":"article","role":"article","abstract":[{"text":"Represent Boolean functions and families of sets as shared, canonical graphs.","type":"text"}],"type":"topic","url":"\/documentation\/grafluentcollections\/decisiondiagrams","title":"Decision diagrams","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"url":"\/documentation\/grafluentcollections\/choosingasearchtree","role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","abstract":[{"text":"Pick a sorted set or sorted dictionary by the workload it will see.","type":"text"}],"title":"Choosing a search tree","type":"topic","kind":"article"}}}