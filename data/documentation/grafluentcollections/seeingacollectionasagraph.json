{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The collections keep their vertices in flat arrays private to each type. To look at a","type":"text"},{"text":" ","type":"text"},{"text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an","type":"text"},{"text":" ","type":"text"},{"text":"initializer on the Grafluent type and costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") once; the result is a snapshot, and later","type":"text"},{"text":" ","type":"text"},{"text":"edits to the collection don’t reach it:","type":"text"}],"type":"paragraph"},{"code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"],"syntax":"swift","type":"codeListing"},{"rows":[[[{"inlineContent":[{"text":"Collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grafluent type"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"AVLTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AVLDictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RedBlackTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Treap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SplayTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BinaryTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"PersistentTreeSet"},{"type":"text","text":", "},{"type":"codeVoice","code":"PersistentTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"BTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"BTreeDictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":", one vertex per node"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"TrieDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"PrefixTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"RadixTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RadixTreeDictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SuffixTree"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SuffixAutomaton","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" (the suffix-link tree)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"FenwickTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" (the update tree)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SegmentTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"LazySegmentTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"IntervalTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KDTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Rope"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BinaryTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Quadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Octree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LRUCache","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" (the recency order, a path)"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the","type":"text"},{"text":" ","type":"text"},{"text":"collection’s own storage, made in O(1). ","type":"text"},{"code":"BinaryDecisionDiagram.graphView","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"ZeroSuppressedDecisionDiagram.graphView","type":"codeVoice"},{"text":" are the diagrams’ tables, ","type":"text"},{"code":"SkipList.layersView","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"skip list’s levels, ","type":"text"},{"code":"AhoCorasickAutomaton.statesView","type":"codeVoice"},{"text":" is the automaton with its failure links,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"SuffixAutomaton.transitionsView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SuffixTree.suffixLinksView","type":"codeVoice"},{"text":" are those structures’","type":"text"},{"text":" ","type":"text"},{"text":"other edges.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Writing the shape","anchor":"Writing-the-shape","type":"heading"},{"inlineContent":[{"text":"Grafluent’s ","type":"text"},{"code":"GraphFormats","type":"codeVoice"},{"text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an","type":"text"},{"text":" ","type":"text"},{"text":"edge list, an adjacency list or Mermaid. An ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":" keeps every edge pointing from parent","type":"text"},{"text":" ","type":"text"},{"text":"to child:","type":"text"}],"type":"paragraph"},{"code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"],"syntax":"swift","type":"codeListing"},{"code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"code":"writeDOT(to:)","type":"codeVoice"},{"text":" gives Graphviz input the same way, with closures for each vertex’s ID and","type":"text"},{"text":" ","type":"text"},{"text":"attributes when the default descriptions won’t do.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Drawing the shape","anchor":"Drawing-the-shape","type":"heading"},{"inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphDrawing"},{"type":"text","text":" module lays out a "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with Reingold and Tilford’s tidy"},{"type":"text","text":" "},{"type":"text","text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its"},{"type":"text","text":" "},{"type":"text","text":"children."}],"type":"paragraph"},{"code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Running an algorithm","anchor":"Running-an-algorithm","type":"heading"},{"inlineContent":[{"type":"text","text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and"},{"type":"text","text":" "},{"type":"text","text":"tree algorithms take it as they would any other:"}],"type":"paragraph"},{"code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"],"syntax":"swift","type":"codeListing"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Seeing a collection as a graph","modules":[{"name":"GrafluentCollections"}]},"abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"],"generated":true,"anchor":"Guides"}],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","interfaceLanguage":"swift"},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"role":"collection","title":"GrafluentCollections","url":"\/documentation\/grafluentcollections","type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"title":"Choosing a search tree","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","kind":"article","type":"topic","role":"article","abstract":[{"text":"Pick a sorted set or sorted dictionary by the workload it will see.","type":"text"}],"url":"\/documentation\/grafluentcollections\/choosingasearchtree"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"role":"article","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","kind":"article","type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","title":"Tries and suffix structures"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"title":"Range and spatial trees","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"url":"\/documentation\/grafluentcollections\/rangeandspatialtrees"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"abstract":[{"text":"Represent Boolean functions and families of sets as shared, canonical graphs.","type":"text"}],"role":"article","title":"Decision diagrams","kind":"article","type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","url":"\/documentation\/grafluentcollections\/decisiondiagrams"}}}