centred over its","type":"text"},{"text":" ","type":"text"},{"text":"children.","type":"text"}]},{"type":"codeListing","code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"],"syntax":"swift"},{"type":"heading","text":"Running an algorithm","anchor":"Running-an-algorithm","level":3},{"type":"paragraph","inlineContent":[{"text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and","type":"text"},{"text":" ","type":"text"},{"text":"tree algorithms take it as they would any other:","type":"text"}]},{"type":"codeListing","code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"],"syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"metadata":{"role":"article","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Article","title":"Seeing a collection as a graph"},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","role":"article","title":"Decision diagrams","url":"\/documentation\/grafluentcollections\/decisiondiagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"type":"topic"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees,