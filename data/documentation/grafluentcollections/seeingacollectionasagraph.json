{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The collections keep their vertices in flat arrays private to each type. To look at a"},{"type":"text","text":" "},{"type":"text","text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an"},{"type":"text","text":" "},{"type":"text","text":"initializer on the Grafluent type and costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") once; the result is a snapshot, and later"},{"type":"text","text":" "},{"type":"text","text":"edits to the collection don’t reach it:"}]},{"syntax":"swift","type":"codeListing","code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Collection"}]}],[{"type":"paragraph","inlineContent":[{"text":"Grafluent type","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AVLTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"AVLDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"RedBlackTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Treap"},{"type":"text","text":", "},{"type":"codeVoice","code":"SplayTree"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BinaryTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PersistentTreeSet"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PersistentTreeDictionary"}]}],[{"type":"paragraph","inlineContent":[{"code":"BinaryTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"BTreeDictionary"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":", one vertex per node"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"TrieDictionary"}]}],[{"type":"paragraph","inlineContent":[{"code":"PrefixTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"RadixTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RadixTreeDictionary","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Arborescence"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"SuffixTree","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"SuffixAutomaton","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" (the suffix-link tree)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"FenwickTree","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" (the update tree)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SegmentTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"LazySegmentTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"IntervalTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KDTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Rope"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BinaryTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Quadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Octree"},{"type":"text","text":", "},{"type":"codeVoice","code":"MXCIFQuadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"MXCIFOctree"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LRUCache"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" (the recency order, a path)"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the"},{"type":"text","text":" "},{"type":"text","text":"collection’s own storage, made in O(1). "},{"type":"codeVoice","code":"BinaryDecisionDiagram.graphView"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram.graphView"},{"type":"text","text":" are the diagrams’ tables, "},{"type":"codeVoice","code":"SkipList.layersView"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"skip list’s levels, "},{"type":"codeVoice","code":"AhoCorasickAutomaton.statesView"},{"type":"text","text":" is the automaton with its failure links,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SuffixAutomaton.transitionsView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SuffixTree.suffixLinksView"},{"type":"text","text":" are those structures’"},{"type":"text","text":" "},{"type":"text","text":"other edges."}]},{"text":"Writing the shape","level":3,"type":"heading","anchor":"Writing-the-shape"},{"type":"paragraph","inlineContent":[{"text":"Grafluent’s ","type":"text"},{"code":"GraphFormats","type":"codeVoice"},{"text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an","type":"text"},{"text":" ","type":"text"},{"text":"edge list, an adjacency list or Mermaid. An ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":" keeps every edge pointing from parent","type":"text"},{"text":" ","type":"text"},{"text":"to child:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"]},{"syntax":null,"type":"codeListing","code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"writeDOT(to:)"},{"text":" gives Graphviz input the same way, with closures for each vertex’s ID and","type":"text"},{"text":" ","type":"text"},{"text":"attributes when the default descriptions won’t do.","type":"text"}]},{"text":"Drawing the shape","level":3,"type":"heading","anchor":"Drawing-the-shape"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphDrawing"},{"type":"text","text":" module lays out a "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with Reingold and Tilford’s tidy"},{"type":"text","text":" "},{"type":"text","text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its"},{"type":"text","text":" "},{"type":"text","text":"children."}]},{"syntax":"swift","type":"codeListing","code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"]},{"text":"Running an algorithm","level":3,"type":"heading","anchor":"Running-an-algorithm"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and"},{"type":"text","text":" "},{"type":"text","text":"tree algorithms take it as they would any other:"}]},{"syntax":"swift","type":"codeListing","code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"]}],"abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"sections":[],"metadata":{"roleHeading":"Article","title":"Seeing a collection as a graph","role":"article","modules":[{"name":"GrafluentCollections"}]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"],"title":"Guides","generated":true,"anchor":"Guides"}],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"type":"topic","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"role":"collection","url":"\/documentation\/grafluentcollections","kind":"symbol","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","title":"GrafluentCollections"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"type":"topic","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"role":"article","url":"\/documentation\/grafluentcollections\/decisiondiagrams","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","title":"Decision diagrams"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"type":"topic","role":"article","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","title":"Tries and suffix structures"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"role":"article","type":"topic","url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","abstract":[{"text":"Answer queries over ranges of a sequence, over intervals, and over points in space.","type":"text"}],"title":"Range and spatial trees","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"role":"article","type":"topic","url":"\/documentation\/grafluentcollections\/choosingasearchtree","abstract":[{"text":"Pick a sorted set or sorted dictionary by the workload it will see.","type":"text"}],"title":"Choosing a search tree","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree"}}}