{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The collections keep their vertices in flat arrays private to each type. To look at a","type":"text"},{"text":" ","type":"text"},{"text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an","type":"text"},{"text":" ","type":"text"},{"text":"initializer on the Grafluent type and costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") once; the result is a snapshot, and later","type":"text"},{"text":" ","type":"text"},{"text":"edits to the collection don’t reach it:","type":"text"}]},{"code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"],"type":"codeListing","syntax":"swift"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Collection","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AVLTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"AVLDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"RedBlackTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Treap"},{"type":"text","text":", "},{"type":"codeVoice","code":"SplayTree"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BinaryTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PersistentTreeSet"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PersistentTreeDictionary"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BinaryTree"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"BTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"BTreeDictionary","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"RootedTree","type":"codeVoice"},{"text":", one vertex per node","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"TrieDictionary"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PrefixTree"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"RadixTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RadixTreeDictionary","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Arborescence"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"SuffixTree","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SuffixAutomaton"}]}],[{"type":"paragraph","inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"text":" (the suffix-link tree)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FenwickTree"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"text":" (the update tree)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"LazySegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"IntervalTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Rope"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BinaryTree"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Quadtree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Octree","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LRUCache"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" (the recency order, a path)"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the"},{"type":"text","text":" "},{"type":"text","text":"collection’s own storage, made in O(1). "},{"type":"codeVoice","code":"BinaryDecisionDiagram.graphView"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram.graphView"},{"type":"text","text":" are the diagrams’ tables, "},{"type":"codeVoice","code":"SkipList.layersView"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"skip list’s levels, "},{"type":"codeVoice","code":"AhoCorasickAutomaton.statesView"},{"type":"text","text":" is the automaton with its failure links,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SuffixAutomaton.transitionsView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SuffixTree.suffixLinksView"},{"type":"text","text":" are those structures’"},{"type":"text","text":" "},{"type":"text","text":"other edges."}]},{"type":"heading","anchor":"Writing-the-shape","level":3,"text":"Writing the shape"},{"type":"paragraph","inlineContent":[{"text":"Grafluent’s ","type":"text"},{"code":"GraphFormats","type":"codeVoice"},{"text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an","type":"text"},{"text":" ","type":"text"},{"text":"edge list, an adjacency list or Mermaid. An ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":" keeps every edge pointing from parent","type":"text"},{"text":" ","type":"text"},{"text":"to child:","type":"text"}]},{"code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"],"type":"codeListing","syntax":"swift"},{"code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"writeDOT(to:)"},{"type":"text","text":" gives Graphviz input the same way, with closures for each vertex’s ID and"},{"type":"text","text":" "},{"type":"text","text":"attributes when the default descriptions won’t do."}]},{"type":"heading","anchor":"Drawing-the-shape","level":3,"text":"Drawing the shape"},{"type":"paragraph","inlineContent":[{"text":"Grafluent’s ","type":"text"},{"code":"GraphDrawing","type":"codeVoice"},{"text":" module lays out a ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with Reingold and Tilford’s tidy","type":"text"},{"text":" ","type":"text"},{"text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its","type":"text"},{"text":" ","type":"text"},{"text":"children.","type":"text"}]},{"code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Running-an-algorithm","level":3,"text":"Running an algorithm"},{"type":"paragraph","inlineContent":[{"text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and","type":"text"},{"text":" ","type":"text"},{"text":"tree algorithms take it as they would any other:","type":"text"}]},{"code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Seeing a collection as a graph","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"],"anchor":"Guides","title":"Guides","generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"type":"topic","url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol","role":"collection"},"doc://Gr