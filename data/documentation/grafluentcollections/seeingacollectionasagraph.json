{"metadata":{"roleHeading":"Article","role":"article","title":"Seeing a collection as a graph","modules":[{"name":"GrafluentCollections"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The collections keep their vertices in flat arrays private to each type. To look at a","type":"text"},{"text":" ","type":"text"},{"text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an","type":"text"},{"text":" ","type":"text"},{"text":"initializer on the Grafluent type and costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") once; the result is a snapshot, and later","type":"text"},{"text":" ","type":"text"},{"text":"edits to the collection don’t reach it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Collection"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grafluent type"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"AVLTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"AVLDictionary","type":"codeVoice"},{"type":"text","text":", "},{"code":"RedBlackTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Treap","type":"codeVoice"},{"type":"text","text":", "},{"code":"SplayTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BinaryTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"PersistentTreeSet"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PersistentTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"BTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"BTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":", one vertex per node"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"TrieDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"PrefixTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"RadixTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RadixTreeDictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Arborescence","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SuffixTree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SuffixAutomaton","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":" (the suffix-link tree)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"FenwickTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"text":" (the update tree)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SegmentTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"LazySegmentTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"IntervalTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"KDTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Rope","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BinaryTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Quadtree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Octree","type":"codeVoice"},{"type":"text","text":", "},{"code":"MXCIFQuadtree","type":"codeVoice"},{"type":"text","text":", "},{"code":"MXCIFOctree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LRUCache","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" (the recency order, a path)"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the"},{"type":"text","text":" "},{"type":"text","text":"collection’s own storage, made in O(1). "},{"type":"codeVoice","code":"BinaryDecisionDiagram.graphView"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram.graphView"},{"type":"text","text":" are the diagrams’ tables, "},{"type":"codeVoice","code":"SkipList.layersView"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"skip list’s levels, "},{"type":"codeVoice","code":"AhoCorasickAutomaton.statesView"},{"type":"text","text":" is the automaton with its failure links,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SuffixAutomaton.transitionsView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SuffixTree.suffixLinksView"},{"type":"text","text":" are those structures’"},{"type":"text","text":" "},{"type":"text","text":"other edges."}]},{"type":"heading","anchor":"Writing-the-shape","text":"Writing the shape","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphFormats"},{"type":"text","text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an"},{"type":"text","text":" "},{"type":"text","text":"edge list, an adjacency list or Mermaid. An "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" keeps every edge pointing from parent"},{"type":"text","text":" "},{"type":"text","text":"to child:"}]},{"type":"codeListing","syntax":"swift","code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"]},{"type":"codeListing","syntax":null,"code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"writeDOT(to:)"},{"type":"text","text":" gives Graphviz input the same way, with closures for each vertex’s ID and"},{"type":"text","text":" "},{"type":"text","text":"attributes when the default descriptions won’t do."}]},{"type":"heading","anchor":"Drawing-the-shape","text":"Drawing the shape","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphDrawing"},{"type":"text","text":" module lays out a "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with Reingold and Tilford’s tidy"},{"type":"text","text":" "},{"type":"text","text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its"},{"type":"text","text":" "},{"type":"text","text":"children."}]},{"type":"codeListing","syntax":"swift","code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"]},{"type":"heading","anchor":"Running-an-algorithm","text":"Running an algorithm","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and"},{"type":"text","text":" "},{"type":"text","text":"tree algorithms take it as they would any other:"}]},{"type":"codeListing","syntax":"swift","code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"]}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","generated":true,"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"role":"collection","type":"topic","url":"\/documentation\/grafluentcollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","title":"GrafluentCollections","kind":"symbol"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","role":"article","type":"topic","title":"Tries and suffix structures","kind":"article","abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}]},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"role":"article","type":"topic","url":"\/documentation\/grafluentcollections\/choosingasearchtree","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"title":"Choosing a search tree","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","role":"article","type":"topic","kind":"article","title":"Range and spatial trees","abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}]},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"role":"article","type":"topic","url":"\/documentation\/grafluentcollections\/decisiondiagrams","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"title":"Decision diagrams","kind":"article"}}}