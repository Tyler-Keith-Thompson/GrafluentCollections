{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The collections keep their vertices in flat arrays private to each type. To look at a"},{"type":"text","text":" "},{"type":"text","text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an"},{"type":"text","text":" "},{"type":"text","text":"initializer on the Grafluent type and costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") once; the result is a snapshot, and later"},{"type":"text","text":" "},{"type":"text","text":"edits to the collection don’t reach it:"}]},{"type":"codeListing","syntax":"swift","code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"]},{"header":"row","rows":[[[{"inlineContent":[{"text":"Collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grafluent type"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"AVLTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"AVLDictionary","type":"codeVoice"},{"type":"text","text":", "},{"code":"RedBlackTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Treap","type":"codeVoice"},{"type":"text","text":", "},{"code":"SplayTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"PersistentTreeSet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PersistentTreeDictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"BTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"BTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":", one vertex per node"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"TrieDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"code":"PrefixTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"RadixTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"RadixTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SuffixTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SuffixAutomaton","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"text":" (the suffix-link tree)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"FenwickTree"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"text":" (the update tree)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"LazySegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"IntervalTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Rope"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BinaryTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Quadtree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Octree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LRUCache","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"text":" (the recency order, a path)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the","type":"text"},{"text":" ","type":"text"},{"text":"collection’s own storage, made in O(1). ","type":"text"},{"type":"codeVoice","code":"BinaryDecisionDiagram.graphView"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram.graphView"},{"text":" are the diagrams’ tables, ","type":"text"},{"type":"codeVoice","code":"SkipList.layersView"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"skip list’s levels, ","type":"text"},{"type":"codeVoice","code":"AhoCorasickAutomaton.statesView"},{"text":" is the automaton with its failure links,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"SuffixAutomaton.transitionsView"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"SuffixTree.suffixLinksView"},{"text":" are those structures’","type":"text"},{"text":" ","type":"text"},{"text":"other edges.","type":"text"}]},{"level":3,"type":"heading","text":"Writing the shape","anchor":"Writing-the-shape"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphFormats"},{"type":"text","text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an"},{"type":"text","text":" "},{"type":"text","text":"edge list, an adjacency list or Mermaid. An "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" keeps every edge pointing from parent"},{"type":"text","text":" "},{"type":"text","text":"to child:"}]},{"type":"codeListing","syntax":"swift","code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"]},{"type":"codeListing","syntax":null,"code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"writeDOT(to:)"},{"text":" gives Graphviz input the same way, with closures for each vertex’s ID and","type":"text"},{"text":" ","type":"text"},{"text":"attributes when the default descriptions won’t do.","type":"text"}]},{"level":3,"type":"heading","text":"Drawing the shape","anchor":"Drawing-the-shape"},{"type":"paragraph","inlineContent":[{"text":"Grafluent’s ","type":"text"},{"code":"GraphDrawing","type":"codeVoice"},{"text":" module lays out a ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with Reingold and Tilford’s tidy","type":"text"},{"text":" ","type":"text"},{"text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its","type":"text"},{"text":" ","type":"text"},{"text":"children.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"]},{"level":3,"type":"heading","text":"Running an algorithm","anchor":"Running-an-algorithm"},{"type":"paragraph","inlineContent":[{"text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and","type":"text"},{"text":" ","type":"text"},{"text":"tree algorithms take it as they would any other:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"]}],"kind":"content"}],"metadata":{"title":"Seeing a collection as a graph","role":"article","roleHeading":"Article","modules":[{"name":"GrafluentCollections"}]},"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"},"kind":"article","abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"],"anchor":"Guides","generated":true,"title":"Guides"}],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"abstract":[{"text":"Represent Boolean functions and families of sets as shared, canonical graphs.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","kind":"article","title":"Decision diagrams","role":"article","type":"topic","url":"\/documentation\/grafluentcollections\/decisiondiagrams"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"type":"topic","role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","kind":"article","url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"title":"Tries and suffix structures"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"abstract":[{"text":"Pick a sorted set or sorted dictionary by the workload it will see.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","kind":"article","title":"Choosing a search tree","role":"article","type":"topic","url":"\/documentation\/grafluentcollections\/choosingasearchtree"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"type":"topic","role":"collection","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol","url":"\/documentation\/grafluentcollections","abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,","type":"text"},{"text":" ","type":"text"},{"text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent.","type":"text"}],"title":"GrafluentCollections"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","kind":"article","title":"Range and spatial trees","role":"article","type":"topic","url":"\/documentation\/grafluentcollections\/rangeandspatialtrees"}}}