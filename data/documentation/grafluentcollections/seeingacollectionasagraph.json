{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"]}],"abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"],"generated":true,"anchor":"Guides"}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The collections keep their vertices in flat arrays private to each type. To look at a","type":"text"},{"text":" ","type":"text"},{"text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an","type":"text"},{"text":" ","type":"text"},{"text":"initializer on the Grafluent type and costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") once; the result is a snapshot, and later","type":"text"},{"text":" ","type":"text"},{"text":"edits to the collection don’t reach it:","type":"text"}],"type":"paragraph"},{"code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"],"syntax":"swift","type":"codeListing"},{"rows":[[[{"inlineContent":[{"text":"Collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Grafluent type","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"AVLTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AVLDictionary"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RedBlackTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Treap"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SplayTree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BinaryTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"PersistentTreeSet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PersistentTreeDictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"BTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"BTreeDictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"text":", one vertex per node","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"TrieDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"code":"PrefixTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"RadixTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RadixTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SuffixTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SuffixAutomaton"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"text":" (the suffix-link tree)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"FenwickTree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" (the update tree)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"LazySegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"IntervalTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Rope"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Quadtree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Octree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MXCIFQuadtree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MXCIFOctree"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"LRUCache"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" (the recency order, a path)"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the"},{"type":"text","text":" "},{"type":"text","text":"collection’s own storage, made in O(1). "},{"type":"codeVoice","code":"BinaryDecisionDiagram.graphView"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram.graphView"},{"type":"text","text":" are the diagrams’ tables, "},{"type":"codeVoice","code":"SkipList.layersView"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"skip list’s levels, "},{"type":"codeVoice","code":"AhoCorasickAutomaton.statesView"},{"type":"text","text":" is the automaton with its failure links,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SuffixAutomaton.transitionsView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SuffixTree.suffixLinksView"},{"type":"text","text":" are those structures’"},{"type":"text","text":" "},{"type":"text","text":"other edges."}],"type":"paragraph"},{"anchor":"Writing-the-shape","text":"Writing the shape","type":"heading","level":3},{"inlineContent":[{"text":"Grafluent’s ","type":"text"},{"type":"codeVoice","code":"GraphFormats"},{"text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an","type":"text"},{"text":" ","type":"text"},{"text":"edge list, an adjacency list or Mermaid. An ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" keeps every edge pointing from parent","type":"text"},{"text":" ","type":"text"},{"text":"to child:","type":"text"}],"type":"paragraph"},{"code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"],"syntax":"swift","type":"codeListing"},{"code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"code":"writeDOT(to:)","type":"codeVoice"},{"text":" gives Graphviz input the same way, with closures for each vertex’s ID and","type":"text"},{"text":" ","type":"text"},{"text":"attributes when the default descriptions won’t do.","type":"text"}],"type":"paragraph"},{"anchor":"Drawing-the-shape","text":"Drawing the shape","type":"heading","level":3},{"inlineContent":[{"text":"Grafluent’s ","type":"text"},{"type":"codeVoice","code":"GraphDrawing"},{"text":" module lays out a ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with Reingold and Tilford’s tidy","type":"text"},{"text":" ","type":"text"},{"text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its","type":"text"},{"text":" ","type":"text"},{"text":"children.","type":"text"}],"type":"paragraph"},{"code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"],"syntax":"swift","type":"codeListing"},{"anchor":"Running-an-algorithm","text":"Running an algorithm","type":"heading","level":3},{"inlineContent":[{"text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and","type":"text"},{"text":" ","type":"text"},{"text":"tree algorithms take it as they would any other:","type":"text"}],"type":"paragraph"},{"code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Seeing a collection as a graph","roleHeading":"Article","role":"article","modules":[{"name":"GrafluentCollections"}]},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"url":"\/documentation\/grafluentcollections\/decisiondiagrams","abstract":[{"text":"Represent Boolean functions and families of sets as shared, canonical graphs.","type":"text"}],"role":"article","title":"Decision diagrams","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","type":"topic"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"url":"\/documentation\/grafluentcollections","role":"collection","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","type":"topic","title":"GrafluentCollections","kind":"symbol"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"type":"topic","kind":"article","title":"Range and spatial trees"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"url":"\/documentation\/grafluentcollections\/choosingasearchtree","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"role":"article","title":"Choosing a search tree","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","type":"topic"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"role":"article","title":"Tries and suffix structures","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","type":"topic"}}}