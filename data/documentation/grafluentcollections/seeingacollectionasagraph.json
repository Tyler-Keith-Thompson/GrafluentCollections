{"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The collections keep their vertices in flat arrays private to each type. To look at a"},{"type":"text","text":" "},{"type":"text","text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an"},{"type":"text","text":" "},{"type":"text","text":"initializer on the Grafluent type and costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") once; the result is a snapshot, and later"},{"type":"text","text":" "},{"type":"text","text":"edits to the collection don’t reach it:"}]},{"type":"codeListing","code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"],"syntax":"swift"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Collection"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grafluent type"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"AVLTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AVLDictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RedBlackTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Treap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SplayTree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"PersistentTreeSet"},{"type":"text","text":", "},{"type":"codeVoice","code":"PersistentTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"BinaryTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"BTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"BTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"},{"text":", one vertex per node","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Trie","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TrieDictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"PrefixTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"RadixTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"RadixTreeDictionary"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Arborescence","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SuffixTree"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SuffixAutomaton"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" (the suffix-link tree)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"FenwickTree"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"text":" (the update tree)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"LazySegmentTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"IntervalTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Rope"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BinaryTree","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Quadtree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Octree","type":"codeVoice"},{"type":"text","text":", "},{"code":"MXCIFQuadtree","type":"codeVoice"},{"type":"text","text":", "},{"code":"MXCIFOctree","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RootedTree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"LRUCache"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" (the recency order, a path)"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the"},{"type":"text","text":" "},{"type":"text","text":"collection’s own storage, made in O(1). "},{"type":"codeVoice","code":"BinaryDecisionDiagram.graphView"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram.graphView"},{"type":"text","text":" are the diagrams’ tables, "},{"type":"codeVoice","code":"SkipList.layersView"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"skip list’s levels, "},{"type":"codeVoice","code":"AhoCorasickAutomaton.statesView"},{"type":"text","text":" is the automaton with its failure links,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SuffixAutomaton.transitionsView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SuffixTree.suffixLinksView"},{"type":"text","text":" are those structures’"},{"type":"text","text":" "},{"type":"text","text":"other edges."}]},{"anchor":"Writing-the-shape","type":"heading","text":"Writing the shape","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphFormats"},{"type":"text","text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an"},{"type":"text","text":" "},{"type":"text","text":"edge list, an adjacency list or Mermaid. An "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" keeps every edge pointing from parent"},{"type":"text","text":" "},{"type":"text","text":"to child:"}]},{"type":"codeListing","code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"],"syntax":"swift"},{"type":"codeListing","code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"],"syntax":null},{"type":"paragraph","inlineContent":[{"code":"writeDOT(to:)","type":"codeVoice"},{"type":"text","text":" gives Graphviz input the same way, with closures for each vertex’s ID and"},{"type":"text","text":" "},{"type":"text","text":"attributes when the default descriptions won’t do."}]},{"anchor":"Drawing-the-shape","type":"heading","text":"Drawing the shape","level":3},{"type":"paragraph","inlineContent":[{"text":"Grafluent’s ","type":"text"},{"code":"GraphDrawing","type":"codeVoice"},{"text":" module lays out a ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with Reingold and Tilford’s tidy","type":"text"},{"text":" ","type":"text"},{"text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its","type":"text"},{"text":" ","type":"text"},{"text":"children.","type":"text"}]},{"type":"codeListing","code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"],"syntax":"swift"},{"anchor":"Running-an-algorithm","type":"heading","text":"Running an algorithm","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and"},{"type":"text","text":" "},{"type":"text","text":"tree algorithms take it as they would any other:"}]},{"type":"codeListing","code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","metadata":{"title":"Seeing a collection as a graph","roleHeading":"Article","modules":[{"name":"GrafluentCollections"}],"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"},"abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"seeAlsoSections":[{"identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"],"anchor":"Guides","generated":true,"title":"Guides"}],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"url":"\/documentation\/grafluentcollections\/decisiondiagrams","type":"topic","kind":"article","title":"Decision diagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"url":"\/documentation\/grafluentcollections","type":"topic","kind":"symbol","title":"GrafluentCollections","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","role":"collection"},"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","type":"topic","title":"Tries and suffix structures","kind":"article","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"url":"\/documentation\/grafluentcollections\/choosingasearchtree","type":"topic","title":"Choosing a search tree","kind":"article","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"title":"Range and spatial trees","url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","abstract":[{"text":"Answer queries over ranges of a sequence, over intervals, and over points in space.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","type":"topic","role":"article","kind":"article"}}}