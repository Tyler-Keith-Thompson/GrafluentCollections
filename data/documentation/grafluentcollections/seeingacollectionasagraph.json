{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees"],"generated":true,"anchor":"Guides"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The collections keep their vertices in flat arrays private to each type. To look at a"},{"type":"text","text":" "},{"type":"text","text":"collection’s shape, convert it to the Grafluent type of that shape. The conversion is an"},{"type":"text","text":" "},{"type":"text","text":"initializer on the Grafluent type and costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") once; the result is a snapshot, and later"},{"type":"text","text":" "},{"type":"text","text":"edits to the collection don’t reach it:"}]},{"code":["import GrafluentCollections","import Trees","","var primes: AVLTree = [2, 3, 5]","let shape = BinaryTree(primes)!   \/\/ nil when the collection is empty","primes.insert(7)","shape.vertexCount                 \/\/ 3"],"type":"codeListing","syntax":"swift"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Collection"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AVLTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"AVLDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"RedBlackTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Treap"},{"type":"text","text":", "},{"type":"codeVoice","code":"SplayTree"}]}],[{"type":"paragraph","inlineContent":[{"code":"BinaryTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"PersistentTreeSet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PersistentTreeDictionary","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BinaryTree"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"BTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"BTreeDictionary","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":", one vertex per node"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Trie","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TrieDictionary","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"PrefixTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RadixTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"RadixTreeDictionary"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Arborescence"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SuffixTree"}]}],[{"type":"paragraph","inlineContent":[{"code":"RootedTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SuffixAutomaton"}]}],[{"type":"paragraph","inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"text":" (the suffix-link tree)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"FenwickTree","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":" (the update tree)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"SegmentTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"LazySegmentTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"IntervalTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"KDTree","type":"codeVoice"},{"type":"text","text":", "},{"code":"Rope","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"BinaryTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Quadtree"},{"type":"text","text":", "},{"type":"codeVoice","code":"Octree"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LRUCache"}]}],[{"type":"paragraph","inlineContent":[{"code":"RootedTree","type":"codeVoice"},{"text":" (the recency order, a path)","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the"},{"type":"text","text":" "},{"type":"text","text":"collection’s own storage, made in O(1). "},{"type":"codeVoice","code":"BinaryDecisionDiagram.graphView"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ZeroSuppressedDecisionDiagram.graphView"},{"type":"text","text":" are the diagrams’ tables, "},{"type":"codeVoice","code":"SkipList.layersView"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"skip list’s levels, "},{"type":"codeVoice","code":"AhoCorasickAutomaton.statesView"},{"type":"text","text":" is the automaton with its failure links,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SuffixAutomaton.transitionsView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SuffixTree.suffixLinksView"},{"type":"text","text":" are those structures’"},{"type":"text","text":" "},{"type":"text","text":"other edges."}]},{"type":"heading","text":"Writing the shape","anchor":"Writing-the-shape","level":3},{"type":"paragraph","inlineContent":[{"text":"Grafluent’s ","type":"text"},{"type":"codeVoice","code":"GraphFormats"},{"text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an","type":"text"},{"text":" ","type":"text"},{"text":"edge list, an adjacency list or Mermaid. An ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" keeps every edge pointing from parent","type":"text"},{"text":" ","type":"text"},{"text":"to child:","type":"text"}]},{"code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"],"type":"codeListing","syntax":"swift"},{"code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"code":"writeDOT(to:)","type":"codeVoice"},{"type":"text","text":" gives Graphviz input the same way, with closures for each vertex’s ID and"},{"type":"text","text":" "},{"type":"text","text":"attributes when the default descriptions won’t do."}]},{"type":"heading","text":"Drawing the shape","anchor":"Drawing-the-shape","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphDrawing"},{"type":"text","text":" module lays out a "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with Reingold and Tilford’s tidy"},{"type":"text","text":" "},{"type":"text","text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its"},{"type":"text","text":" "},{"type":"text","text":"children."}]},{"code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Running an algorithm","anchor":"Running-an-algorithm","level":3},{"type":"paragraph","inlineContent":[{"text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and","type":"text"},{"text":" ","type":"text"},{"text":"tree algorithms take it as they would any other:","type":"text"}]},{"code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"]}],"metadata":{"modules":[{"name":"GrafluentCollections"}],"roleHeading":"Article","role":"article","title":"Seeing a collection as a graph"},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","role":"article","title":"Tries and suffix structures","type":"topic"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,","type":"text"},{"text":" ","type":"text"},{"text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent.","type":"text"}],"url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","kind":"symbol","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","type":"topic","role":"collection"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"url":"\/documentation\/grafluentcollections\/decisiondiagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","role":"article","type":"topic","title":"Decision diagrams"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"url":"\/documentation\/grafluentcollections\/choosingasearchtree","title":"Choosing a search tree","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","type":"topic","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"abstract":[{"text":"Answer queries over ranges of a sequence, over intervals, and over points in space.","type":"text"}],"url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","title":"Range and spatial trees","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","type":"topic","role":"article"}}}