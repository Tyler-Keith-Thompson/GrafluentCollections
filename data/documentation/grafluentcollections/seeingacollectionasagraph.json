"text":", "},{"type":"codeVoice","code":"Rope"}]}],[{"type":"paragraph","inlineContent":[{"code":"BinaryTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Quadtree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Octree","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RootedTree"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LRUCache","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" (the recency order, a path)"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"A structure whose shape is not a tree offers a view instead: a Grafluent graph over the","type":"text"},{"text":" ","type":"text"},{"text":"collection’s own storage, made in O(1). ","type":"text"},{"code":"BinaryDecisionDiagram.graphView","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"ZeroSuppressedDecisionDiagram.graphView","type":"codeVoice"},{"text":" are the diagrams’ tables, ","type":"text"},{"code":"SkipList.layersView","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"skip list’s levels, ","type":"text"},{"code":"AhoCorasickAutomaton.statesView","type":"codeVoice"},{"text":" is the automaton with its failure links,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"SuffixAutomaton.transitionsView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SuffixTree.suffixLinksView","type":"codeVoice"},{"text":" are those structures’","type":"text"},{"text":" ","type":"text"},{"text":"other edges.","type":"text"}]},{"type":"heading","anchor":"Writing-the-shape","level":3,"text":"Writing the shape"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"GraphFormats"},{"type":"text","text":" module writes any graph as DOT, GraphML, GEXF, node-link JSON, an"},{"type":"text","text":" "},{"type":"text","text":"edge list, an adjacency list or Mermaid. An "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" keeps every edge pointing from parent"},{"type":"text","text":" "},{"type":"text","text":"to child:"}]},{"type":"codeListing","syntax":"swift","code":["import GraphFormats","","let primes: AVLTree = [2, 3, 5, 7, 11, 13, 17]","let shape = Arborescence(BinaryTree(primes)!)","var text = \"\"","try shape.writeMermaid(to: &text)","print(text)"]},{"type":"codeListing","syntax":null,"code":["flowchart TD","    7","    3","    13","    2","    5","    11","    17","    7 --> 3","    7 --> 13","    3 --> 2","    3 --> 5","    13 --> 11","    13 --> 17"]},{"type":"paragraph","inlineContent":[{"code":"writeDOT(to:)","type":"codeVoice"},{"text":" gives Graphviz input the same way, with closures for each vertex’s ID and","type":"text"},{"text":" ","type":"text"},{"text":"attributes when the default descriptions won’t do.","type":"text"}]},{"type":"heading","anchor":"Drawing-the-shape","level":3,"text":"Drawing the shape"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grafluent’s "},{"code":"GraphDrawing","type":"codeVoice"},{"type":"text","text":" module lays out a "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with Reingold and Tilford’s tidy"},{"type":"text","text":" "},{"type":"text","text":"drawing: the root at the origin, each depth one unit lower, and every parent centred over its"},{"type":"text","text":" "},{"type":"text","text":"children."}]},{"type":"codeListing","syntax":"swift","code":["import GraphDrawing","","let tree = RootedTree(Arborescence(BinaryTree(primes)!))","let drawing = tree.reingoldTilfordLayout()","drawing.position(of: 7)     \/\/ (0, 0)","drawing.position(of: 3)     \/\/ (-1, 1)","drawing.position(of: 17)    \/\/ (1.5, 2)"]},{"type":"heading","anchor":"Running-an-algorithm","level":3,"text":"Running an algorithm"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A converted shape or a view is an ordinary Grafluent graph, so its traversals, shortest paths and"},{"type":"text","text":" "},{"type":"text","text":"tree algorithms take it as they would any other:"}]},{"type":"codeListing","syntax":"swift","code":["var diagram = BinaryDecisionDiagram(variableCount: 2)","_ = diagram.and(diagram.variable(0), diagram.variable(1))","let view = diagram.graphView      \/\/ a DirectedGraph over the diagram's table","view.vertexCount                  \/\/ 5: two terminals and three decisions","view.edgeCount                    \/\/ 6"]}]}],"abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/seeingacollectionasagraph"]}],"metadata":{"modules":[{"name":"GrafluentCollections"}],"roleHeading":"Article","role":"article","title":"Seeing a collection as a graph"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/TriesAndSuffixStructures":{"url":"\/documentation\/grafluentcollections\/triesandsuffixstructures","abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"role":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","title":"Tries and suffix structures","type":"topic","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"title":"Choosing a search tree","abstract":[{"text":"Pick a sorted set or sorted dictio