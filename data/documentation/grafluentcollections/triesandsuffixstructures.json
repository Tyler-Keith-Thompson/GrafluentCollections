{"variants":[{"paths":["\/documentation\/grafluentcollections\/triesandsuffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures"},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"]}],"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A trie answers questions about many keys: which keys start with this prefix, which key is the"},{"type":"text","text":" "},{"type":"text","text":"longest prefix of this input. A suffix structure answers questions about one text, or a few:"},{"type":"text","text":" "},{"type":"text","text":"where does this pattern occur, what repeats. Both work over any sequence of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols,"},{"type":"text","text":" "},{"type":"text","text":"so a key or a text can be a "},{"type":"codeVoice","code":"String"},{"type":"text","text":", an array of bytes or an array of tokens."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Tries","anchor":"Tries"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Trie"},{"type":"text","text":" stores a set of keys one symbol per edge, and a "},{"type":"codeVoice","code":"TrieDictionary"},{"type":"text","text":" maps each key to a"},{"type":"text","text":" "},{"type":"text","text":"value. A "},{"type":"codeVoice","code":"RadixTree"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"RadixTreeDictionary"},{"type":"text","text":" answer the same queries but merge each chain of"},{"type":"text","text":" "},{"type":"text","text":"single-child vertices into one edge, which keeps them small when keys share long runs, such as"},{"type":"text","text":" "},{"type":"text","text":"paths or URLs:"}],"type":"paragraph"},{"syntax":"swift","code":["var routes: TrieDictionary<Character, String> = [:]","routes[\"\/\"] = \"home\"","routes[\"\/users\"] = \"user list\"","routes.longestPrefix(of: \"\/users\/42\")?.value   \/\/ \"user list\"","routes.elements(withPrefix: \"\/u\").count         \/\/ 1","","let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AhoCorasickAutomaton"},{"type":"text","text":" turns a fixed set of patterns into a trie with failure links, and then"},{"type":"text","text":" "},{"type":"text","text":"finds every occurrence of every pattern in a text in one pass, in time linear in the text plus"},{"type":"text","text":" "},{"type":"text","text":"the matches:"}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]: \"she\", \"he\", \"hers\""],"type":"codeListing"},{"type":"heading","level":3,"text":"Suffix structures","anchor":"Suffix-structures"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"SuffixArray"},{"text":" holds a text’s suffixes in sorted order with their longest-common-prefix array.","type":"text"},{"text":" ","type":"text"},{"text":"It is the most compact of the three, finds a pattern by binary search and answers repeat and","type":"text"},{"text":" ","type":"text"},{"text":"distinct-substring questions from the LCP array:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let banana = SuffixArray(\"banana\")","banana.occurrences(of: \"ana\").map { banana.positions[$0] }   \/\/ [3, 1]","banana.distinctSubstringCount                                \/\/ 15"],"type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"SuffixTree"},{"text":" is the compressed trie of every suffix, built in linear time. It finds a pattern","type":"text"},{"text":" ","type":"text"},{"text":"in time proportional to the pattern, and over several texts it finds their longest common","type":"text"},{"text":" ","type":"text"},{"text":"substring:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SuffixAutomaton"},{"type":"text","text":" is the smallest automaton that accepts every substring of a text. It counts"},{"type":"text","text":" "},{"type":"text","text":"occurrences without listing them and matches another text against this one as it streams by:"}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automaton.occurrenceCount(of: \"bc\")    \/\/ 2","automaton.firstOccurrence(of: \"cb\")    \/\/ 2 ..< 4"],"type":"codeListing"},{"type":"heading","level":3,"text":"Choosing","anchor":"Choosing"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Question"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys by prefix, keys as a set"}]}],[{"type":"paragraph","inlineContent":[{"code":"Trie","type":"codeVoice"},{"type":"text","text":", "},{"code":"RadixTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Values by key or by longest prefix","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TrieDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"RadixTreeDictionary"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Many fixed patterns in a stream of text"}]}],[{"type":"paragraph","inlineContent":[{"code":"AhoCorasickAutomaton","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Occurrences in one text, little memory","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"SuffixArray","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Common substrings of several texts"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SuffixTree"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Occurrence counts, matching a second text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"SuffixAutomaton","type":"codeVoice"}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"Tries convert to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":", radix trees to "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":", the suffix tree to"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" and the suffix automaton’s suffix links to "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":". The Aho–Corasick"},{"type":"text","text":" "},{"type":"text","text":"automaton’s "},{"type":"codeVoice","code":"statesView"},{"type":"text","text":", the suffix automaton’s "},{"type":"codeVoice","code":"transitionsView"},{"type":"text","text":" and the suffix tree’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"suffixLinksView"},{"type":"text","text":" are Grafluent graphs over the rest of their edges."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"GrafluentCollections"}],"title":"Tries and suffix structures"},"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"type":"topic","abstract":[{"text":"Answer queries over ranges of a sequence, over intervals, and over points in space.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","role":"article","url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","title":"Range and spatial trees","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"type":"topic","abstract":[{"text":"Represent Boolean functions and families of sets as shared, canonical graphs.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","role":"article","url":"\/documentation\/grafluentcollections\/decisiondiagrams","title":"Decision diagrams","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"type":"topic","abstract":[{"text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm","type":"text"},{"text":" ","type":"text"},{"text":"over it.","type":"text"}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","role":"article","url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","title":"Seeing a collection as a graph","kind":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"title":"Choosing a search tree","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","url":"\/documentation\/grafluentcollections\/choosingasearchtree"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"type":"topic","abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","role":"collection","url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","kind":"symbol"}}}