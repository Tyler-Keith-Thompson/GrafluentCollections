{"metadata":{"title":"Tries and suffix structures","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Article","role":"article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"A trie answers questions about many keys: which keys start with this prefix, which key is the","type":"text"},{"text":" ","type":"text"},{"text":"longest prefix of this input. A suffix structure answers questions about one text, or a few:","type":"text"},{"text":" ","type":"text"},{"text":"where does this pattern occur, what repeats. Both work over any sequence of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols,","type":"text"},{"text":" ","type":"text"},{"text":"so a key or a text can be a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", an array of bytes or an array of tokens.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Tries","anchor":"Tries","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Trie","type":"codeVoice"},{"text":" stores a set of keys one symbol per edge, and a ","type":"text"},{"code":"TrieDictionary","type":"codeVoice"},{"text":" maps each key to a","type":"text"},{"text":" ","type":"text"},{"text":"value. A ","type":"text"},{"code":"RadixTree","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"RadixTreeDictionary","type":"codeVoice"},{"text":" answer the same queries but merge each chain of","type":"text"},{"text":" ","type":"text"},{"text":"single-child vertices into one edge, which keeps them small when keys share long runs, such as","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs:","type":"text"}],"type":"paragraph"},{"code":["var routes: TrieDictionary<Character, String> = [:]","routes[\"\/\"] = \"home\"","routes[\"\/users\"] = \"user list\"","routes.longestPrefix(of: \"\/users\/42\")?.value   \/\/ \"user list\"","routes.elements(withPrefix: \"\/u\").count         \/\/ 1","","let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AhoCorasickAutomaton"},{"type":"text","text":" turns a fixed set of patterns into a trie with failure links, and then"},{"type":"text","text":" "},{"type":"text","text":"finds every occurrence of every pattern in a text in one pass, in time linear in the text plus"},{"type":"text","text":" "},{"type":"text","text":"the matches:"}],"type":"paragraph"},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]: \"she\", \"he\", \"hers\""],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Suffix structures","anchor":"Suffix-structures","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SuffixArray"},{"type":"text","text":" holds a text’s suffixes in sorted order with their longest-common-prefix array."},{"type":"text","text":" "},{"type":"text","text":"It is the most compact of the three, finds a pattern by binary search and answers repeat and"},{"type":"text","text":" "},{"type":"text","text":"distinct-substring questions from the LCP array:"}],"type":"paragraph"},{"code":["let banana = SuffixArray(\"banana\")","banana.occurrences(of: \"ana\").map { banana.positions[$0] }   \/\/ [3, 1]","banana.distinctSubstringCount                                \/\/ 15"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SuffixTree"},{"type":"text","text":" is the compressed trie of every suffix, built in linear time. It finds a pattern"},{"type":"text","text":" "},{"type":"text","text":"in time proportional to the pattern, and over several texts it finds their longest common"},{"type":"text","text":" "},{"type":"text","text":"substring:"}],"type":"paragraph"},{"code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"SuffixAutomaton"},{"text":" is the smallest automaton that accepts every substring of a text. It counts","type":"text"},{"text":" ","type":"text"},{"text":"occurrences without listing them and matches another text against this one as it streams by:","type":"text"}],"type":"paragraph"},{"code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automaton.occurrenceCount(of: \"bc\")    \/\/ 2","automaton.firstOccurrence(of: \"cb\")    \/\/ 2 ..< 4"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Choosing","anchor":"Choosing","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Question"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Keys by prefix, keys as a set","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"RadixTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Values by key or by longest prefix"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TrieDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"RadixTreeDictionary"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Many fixed patterns in a stream of text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AhoCorasickAutomaton"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Occurrences in one text, little memory"}]}],[{"type":"paragraph","inlineContent":[{"code":"SuffixArray","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Common substrings of several texts","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"SuffixTree","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Occurrence counts, matching a second text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"SuffixAutomaton","type":"codeVoice"}]}]]],"type":"table"},{"inlineContent":[{"text":"Tries convert to Grafluent’s ","type":"text"},{"code":"PrefixTree","type":"codeVoice"},{"text":", radix trees to ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":", the suffix tree to","type":"text"},{"text":" ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" and the suffix automaton’s suffix links to ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":". The Aho–Corasick","type":"text"},{"text":" ","type":"text"},{"text":"automaton’s ","type":"text"},{"code":"statesView","type":"codeVoice"},{"text":", the suffix automaton’s ","type":"text"},{"code":"transitionsView","type":"codeVoice"},{"text":" and the suffix tree’s","type":"text"},{"text":" ","type":"text"},{"code":"suffixLinksView","type":"codeVoice"},{"text":" are Grafluent graphs over the rest of their edges.","type":"text"}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"generated":true,"anchor":"Guides"}],"abstract":[{"type":"text","text":"Search a set of keys by prefix, or a text by substring."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluentcollections\/triesandsuffixstructures"]}],"references":{"doc://GrafluentCollections/documentation/GrafluentCollections":{"abstract":[{"type":"text","text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,"},{"type":"text","text":" "},{"type":"text","text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on"},{"type":"text","text":" "},{"type":"text","text":"Grafluent."}],"role":"collection","title":"GrafluentCollections","url":"\/documentation\/grafluentcollections","type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","kind":"symbol"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"title":"Choosing a search tree","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","kind":"article","type":"topic","role":"article","abstract":[{"text":"Pick a sorted set or sorted dictionary by the workload it will see.","type":"text"}],"url":"\/documentation\/grafluentcollections\/choosingasearchtree"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"title":"Range and spatial trees","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Answer queries over ranges of a sequence, over intervals, and over points in space."}],"url":"\/documentation\/grafluentcollections\/rangeandspatialtrees"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"abstract":[{"text":"Represent Boolean functions and families of sets as shared, canonical graphs.","type":"text"}],"role":"article","title":"Decision diagrams","kind":"article","type":"topic","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","url":"\/documentation\/grafluentcollections\/decisiondiagrams"},"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"title":"Seeing a collection as a graph","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph"}}}