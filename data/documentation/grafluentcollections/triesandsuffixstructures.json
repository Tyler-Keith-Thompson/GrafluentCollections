{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Search a set of keys by prefix, or a text by substring.","type":"text"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/TriesAndSuffixStructures"},"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph"],"title":"Guides"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A trie answers questions about many keys: which keys start with this prefix, which key is the"},{"type":"text","text":" "},{"type":"text","text":"longest prefix of this input. A suffix structure answers questions about one text, or a few:"},{"type":"text","text":" "},{"type":"text","text":"where does this pattern occur, what repeats. Both work over any sequence of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols,"},{"type":"text","text":" "},{"type":"text","text":"so a key or a text can be a "},{"type":"codeVoice","code":"String"},{"type":"text","text":", an array of bytes or an array of tokens."}],"type":"paragraph"},{"level":3,"text":"Tries","type":"heading","anchor":"Tries"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Trie","type":"codeVoice"},{"type":"text","text":" stores a set of keys one symbol per edge, and a "},{"code":"TrieDictionary","type":"codeVoice"},{"type":"text","text":" maps each key to a"},{"type":"text","text":" "},{"type":"text","text":"value. A "},{"code":"RadixTree","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"RadixTreeDictionary","type":"codeVoice"},{"type":"text","text":" answer the same queries but merge each chain of"},{"type":"text","text":" "},{"type":"text","text":"single-child vertices into one edge, which keeps them small when keys share long runs, such as"},{"type":"text","text":" "},{"type":"text","text":"paths or URLs:"}],"type":"paragraph"},{"syntax":"swift","code":["var routes: TrieDictionary<Character, String> = [:]","routes[\"\/\"] = \"home\"","routes[\"\/users\"] = \"user list\"","routes.longestPrefix(of: \"\/users\/42\")?.value   \/\/ \"user list\"","routes.elements(withPrefix: \"\/u\").count         \/\/ 1","","let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""],"type":"codeListing"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"AhoCorasickAutomaton"},{"text":" turns a fixed set of patterns into a trie with failure links, and then","type":"text"},{"text":" ","type":"text"},{"text":"finds every occurrence of every pattern in a text in one pass, in time linear in the text plus","type":"text"},{"text":" ","type":"text"},{"text":"the matches:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]: \"she\", \"he\", \"hers\""],"type":"codeListing"},{"level":3,"text":"Suffix structures","type":"heading","anchor":"Suffix-structures"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SuffixArray"},{"type":"text","text":" holds a text’s suffixes in sorted order with their longest-common-prefix array."},{"type":"text","text":" "},{"type":"text","text":"It is the most compact of the three, finds a pattern by binary search and answers repeat and"},{"type":"text","text":" "},{"type":"text","text":"distinct-substring questions from the LCP array:"}],"type":"paragraph"},{"syntax":"swift","code":["let banana = SuffixArray(\"banana\")","banana.occurrences(of: \"ana\").map { banana.positions[$0] }   \/\/ [3, 1]","banana.distinctSubstringCount                                \/\/ 15"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SuffixTree"},{"type":"text","text":" is the compressed trie of every suffix, built in linear time. It finds a pattern"},{"type":"text","text":" "},{"type":"text","text":"in time proportional to the pattern, and over several texts it finds their longest common"},{"type":"text","text":" "},{"type":"text","text":"substring:"}],"type":"paragraph"},{"syntax":"swift","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"SuffixAutomaton"},{"type":"text","text":" is the smallest automaton that accepts every substring of a text. It counts"},{"type":"text","text":" "},{"type":"text","text":"occurrences without listing them and matches another text against this one as it streams by:"}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automaton.occurrenceCount(of: \"bc\")    \/\/ 2","automaton.firstOccurrence(of: \"cb\")    \/\/ 2 ..< 4"],"type":"codeListing"},{"level":3,"text":"Choosing","type":"heading","anchor":"Choosing"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Question"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys by prefix, keys as a set"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Trie"},{"type":"text","text":", "},{"type":"codeVoice","code":"RadixTree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Values by key or by longest prefix"}]}],[{"type":"paragraph","inlineContent":[{"code":"TrieDictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RadixTreeDictionary","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Many fixed patterns in a stream of text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"AhoCorasickAutomaton","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Occurrences in one text, little memory"}]}],[{"type":"paragraph","inlineContent":[{"code":"SuffixArray","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Common substrings of several texts"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SuffixTree"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Occurrence counts, matching a second text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SuffixAutomaton"}]}]]]},{"inlineContent":[{"type":"text","text":"Tries convert to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":", radix trees to "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":", the suffix tree to"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" and the suffix automaton’s suffix links to "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":". The Aho–Corasick"},{"type":"text","text":" "},{"type":"text","text":"automaton’s "},{"type":"codeVoice","code":"statesView"},{"type":"text","text":", the suffix automaton’s "},{"type":"codeVoice","code":"transitionsView"},{"type":"text","text":" and the suffix tree’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"suffixLinksView"},{"type":"text","text":" are Grafluent graphs over the rest of their edges."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections"]]},"sections":[],"variants":[{"paths":["\/documentation\/grafluentcollections\/triesandsuffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Tries and suffix structures","modules":[{"name":"GrafluentCollections"}],"roleHeading":"Article","role":"article"},"references":{"doc://GrafluentCollections/documentation/GrafluentCollections/SeeingACollectionAsAGraph":{"abstract":[{"type":"text","text":"Convert a collection’s shape to a Grafluent graph, then lay it out, write it or run an algorithm"},{"type":"text","text":" "},{"type":"text","text":"over it."}],"url":"\/documentation\/grafluentcollections\/seeingacollectionasagraph","title":"Seeing a collection as a graph","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/SeeingACollectionAsAGraph","type":"topic","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections":{"abstract":[{"text":"Graph-shaped collections for Swift: search trees, tries, suffix structures, decision diagrams,","type":"text"},{"text":" ","type":"text"},{"text":"range and spatial trees, ropes, persistent trees and caches, with value semantics, built on","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent.","type":"text"}],"url":"\/documentation\/grafluentcollections","title":"GrafluentCollections","kind":"symbol","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections","type":"topic","role":"collection"},"doc://GrafluentCollections/documentation/GrafluentCollections/DecisionDiagrams":{"url":"\/documentation\/grafluentcollections\/decisiondiagrams","abstract":[{"type":"text","text":"Represent Boolean functions and families of sets as shared, canonical graphs."}],"kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/DecisionDiagrams","role":"article","type":"topic","title":"Decision diagrams"},"doc://GrafluentCollections/documentation/GrafluentCollections/ChoosingASearchTree":{"abstract":[{"type":"text","text":"Pick a sorted set or sorted dictionary by the workload it will see."}],"url":"\/documentation\/grafluentcollections\/choosingasearchtree","title":"Choosing a search tree","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/ChoosingASearchTree","type":"topic","role":"article"},"doc://GrafluentCollections/documentation/GrafluentCollections/RangeAndSpatialTrees":{"abstract":[{"text":"Answer queries over ranges of a sequence, over intervals, and over points in space.","type":"text"}],"url":"\/documentation\/grafluentcollections\/rangeandspatialtrees","title":"Range and spatial trees","kind":"article","identifier":"doc:\/\/GrafluentCollections\/documentation\/GrafluentCollections\/RangeAndSpatialTrees","type":"topic","role":"article"}}}