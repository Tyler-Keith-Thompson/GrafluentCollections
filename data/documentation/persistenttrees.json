nserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trees are weight-balanced: neither subtree of a vertex holds more than three times the keys"},{"type":"text","text":" "},{"type":"text","text":"of the other. Union, intersection, difference and symmetric difference split one tree by the"},{"type":"text","text":" "},{"type":"text","text":"other’s root and join the halves, in O("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" log("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" \/ "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" + 1)) for sets of "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" ≤ "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" elements,"},{"type":"text","text":" "},{"type":"text","text":"and a subtree both operands share is kept whole without being visited. Two versions a few edits"},{"type":"text","text":" "},{"type":"text","text":"apart therefore merge in time proportional to those edits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A version converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", its elements or keys as"},{"type":"text","text":" "},{"type":"text","text":"vertices."}]}]}],"variants":[{"paths":["\/documentation\/persistenttrees"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees"},"sections":[],"metadata":{"modules":[{"n