{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistenttrees"]}],"abstract":[{"type":"text","text":"Balanced search trees that keep every version, sharing structure between them."}],"topicSections":[{"title":"Sets and dictionaries","identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary"],"anchor":"Sets-and-dictionaries"},{"title":"Extended Modules","identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees"],"anchor":"Extended-Modules","generated":true}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary"},{"type":"text","text":" never changes a vertex once it is made."},{"type":"text","text":" "},{"type":"text","text":"An edit builds new vertices along the path from the root to the change, O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") of them, and"},{"type":"text","text":" "},{"type":"text","text":"points them at the untouched subtrees of the version it started from. Every earlier version"},{"type":"text","text":" "},{"type":"text","text":"stays as it was, and a history of "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" edits costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") space in all."}],"type":"paragraph"},{"syntax":"swift","code":["import PersistentTrees","","let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The trees are weight-balanced: neither subtree of a vertex holds more than three times the keys"},{"type":"text","text":" "},{"type":"text","text":"of the other. Union, intersection, difference and symmetric difference split one tree by the"},{"type":"text","text":" "},{"type":"text","text":"other’s root and join the halves, in O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" log("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" \/ "},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" + 1)) for sets of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" ≤ "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" elements,"},{"type":"text","text":" "},{"type":"text","text":"and a subtree both operands share is kept whole without being visited. Two versions a few edits"},{"type":"text","text":" "},{"type":"text","text":"apart therefore merge in time proportional to those edits."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A version converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", its elements or keys as"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"}]}],"metadata":{"externalID":"PersistentTrees","role":"collection","symbolKind":"module","title":"PersistentTrees","roleHeading":"Framework","modules":[{"name":"PersistentTrees"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeDictionary":{"kind":"symbol","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeDictionary","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"PersistentTreeDictionary","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A persistent sorted dictionary: unique keys in ascending order, each with a value, where every","type":"text"},{"text":" ","type":"text"},{"text":"version stays usable and versions share all but the vertices their edits touched.","type":"text"}],"title":"PersistentTreeDictionary","url":"\/documentation\/persistenttrees\/persistenttreedictionary"},"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeSet":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeSet","kind":"identifier"}],"title":"PersistentTreeSet","navigatorTitle":[{"text":"PersistentTreeSet","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/persistenttrees\/persistenttreeset","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","abstract":[{"type":"text","text":"A persistent sorted set: unique elements in ascending order, where every version stays usable"},{"type":"text","text":" "},{"type":"text","text":"and versions share all but the vertices their edits touched."}]},"doc://PersistentTrees/documentation/PersistentTrees/Trees":{"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees","role":"collection","url":"\/documentation\/persistenttrees\/trees","kind":"symbol","abstract":[],"title":"Trees","type":"topic"},"doc://PersistentTrees/documentation/PersistentTrees":{"kind":"symbol","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees","type":"topic","role":"collection","abstract":[{"type":"text","text":"Balanced search trees that keep every version, sharing structure between them."}],"title":"PersistentTrees","url":"\/documentation\/persistenttrees"}}}