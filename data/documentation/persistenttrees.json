{"abstract":[{"type":"text","text":"Balanced search trees that keep every version, sharing structure between them."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"topicSections":[{"anchor":"Sets-and-dictionaries","title":"Sets and dictionaries","identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees"]}],"variants":[{"paths":["\/documentation\/persistenttrees"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"PersistentTrees"}],"role":"collection","roleHeading":"Framework","title":"PersistentTrees","externalID":"PersistentTrees","symbolKind":"module"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","isActive":true},{"type":"text","text":" never changes a vertex once it is made."},{"type":"text","text":" "},{"type":"text","text":"An edit builds new vertices along the path from the root to the change, O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") of them, and"},{"type":"text","text":" "},{"type":"text","text":"points them at the untouched subtrees of the version it started from. Every earlier version"},{"type":"text","text":" "},{"type":"text","text":"stays as it was, and a history of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" edits costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") space in all."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import PersistentTrees","","let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"]},{"inlineContent":[{"text":"The trees are weight-balanced: neither subtree of a vertex holds more than three times the keys","type":"text"},{"text":" ","type":"text"},{"text":"of the other. Union, intersection, difference and symmetric difference split one tree by the","type":"text"},{"text":" ","type":"text"},{"text":"other’s root and join the halves, in O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" log(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" \/ ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" + 1)) for sets of ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" ≤ ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" elements,","type":"text"},{"text":" ","type":"text"},{"text":"and a subtree both operands share is kept whole without being visited. Two versions a few edits","type":"text"},{"text":" ","type":"text"},{"text":"apart therefore merge in time proportional to those edits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A version converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", its elements or keys as"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"}]}],"references":{"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeSet":{"type":"topic","role":"symbol","url":"\/documentation\/persistenttrees\/persistenttreeset","title":"PersistentTreeSet","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeSet","kind":"identifier"}],"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","abstract":[{"type":"text","text":"A persistent sorted set: unique elements in ascending order, where every version stays usable"},{"type":"text","text":" "},{"type":"text","text":"and versions share all but the vertices their edits touched."}],"kind":"symbol","navigatorTitle":[{"text":"PersistentTreeSet","kind":"identifier"}]},"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeDictionary":{"url":"\/documentation\/persistenttrees\/persistenttreedictionary","abstract":[{"type":"text","text":"A persistent sorted dictionary: unique keys in ascending order, each with a value, where every"},{"type":"text","text":" "},{"type":"text","text":"version stays usable and versions share all but the vertices their edits touched."}],"type":"topic","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","title":"PersistentTreeDictionary","role":"symbol","navigatorTitle":[{"text":"PersistentTreeDictionary","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeDictionary","kind":"identifier"}]},"doc://PersistentTrees/documentation/PersistentTrees/Trees":{"type":"topic","role":"collection","url":"\/documentation\/persistenttrees\/trees","title":"Trees","abstract":[],"kind":"symbol","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees"},"doc://PersistentTrees/documentation/PersistentTrees":{"type":"topic","role":"collection","url":"\/documentation\/persistenttrees","title":"PersistentTrees","kind":"symbol","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees","abstract":[{"text":"Balanced search trees that keep every version, sharing structure between them.","type":"text"}]}}}