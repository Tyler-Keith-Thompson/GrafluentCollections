{"variants":[{"paths":["\/documentation\/persistenttrees"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","isActive":true},{"type":"text","text":" never changes a vertex once it is made."},{"type":"text","text":" "},{"type":"text","text":"An edit builds new vertices along the path from the root to the change, O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") of them, and"},{"type":"text","text":" "},{"type":"text","text":"points them at the untouched subtrees of the version it started from. Every earlier version"},{"type":"text","text":" "},{"type":"text","text":"stays as it was, and a history of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" edits costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") space in all."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import PersistentTrees","","let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"]},{"inlineContent":[{"text":"The trees are weight-balanced: neither subtree of a vertex holds more than three times the keys","type":"text"},{"text":" ","type":"text"},{"text":"of the other. Union, intersection, difference and symmetric difference split one tree by the","type":"text"},{"text":" ","type":"text"},{"text":"other’s root and join the halves, in O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" log(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" \/ ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" + 1)) for sets of ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" ≤ ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" elements,","type":"text"},{"text":" ","type":"text"},{"text":"and a subtree both operands share is kept whole without being visited. Two versions a few edits","type":"text"},{"text":" ","type":"text"},{"text":"apart therefore merge in time proportional to those edits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A version converts to Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":", its elements or keys as"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees"},"metadata":{"title":"PersistentTrees","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"PersistentTrees"}],"externalID":"PersistentTrees","role":"collection"},"abstract":[{"type":"text","text":"Balanced search trees that keep every version, sharing structure between them."}],"topicSections":[{"anchor":"Sets-and-dictionaries","title":"Sets and dictionaries","identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Persis