{"variants":[{"paths":["\/documentation\/persistenttrees"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","isActive":true},{"type":"text","text":" never changes a vertex once it is made."},{"type":"text","text":" "},{"type":"text","text":"An edit builds new vertices along the path from the root to the change, O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") of them, and"},{"type":"text","text":" "},{"type":"text","text":"points them at the untouched subtrees of the version it started from. Every earlier version"},{"type":"text","text":" "},{"type":"text","text":"stays as it was, and a history of "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" edits costs O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") space in all."}],"type":"paragraph"},{"code":["import PersistentTrees","","let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The trees are weight-balanced: neither subtree of a vertex holds more than three times the keys"},{"type":"text","text":" "},{"type":"text","text":"of the other. Union, intersection, difference and symmetric difference split one tree by the"},{"type":"text","text":" "},{"type":"text","text":"other’s root and join the halves, in O("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" log("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" \/ "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" + 1)) for sets of "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" ≤ "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" elements,"},{"type":"text","text":" "},{"type":"text","text":"and a subtree both operands share is kept whole without being visited. Two versions a few edits"},{"type":"text","text":" "},{"type":"text","text":"apart therefore merge in time proportional to those edits."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A version converts to Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":", its elements or keys as"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"PersistentTrees","roleHeading":"Framework","modules":[{"name":"PersistentTrees"}],"role":"collection","title":"PersistentTrees","symbolKind":"module"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary"],"anchor":"Sets-and-dictionaries","title":"Sets and dictionaries"},{"identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"abstract":[{"text":"Balanced search trees that keep every version, sharing structure between them.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees"},"references":{"doc://PersistentTrees/documentation/PersistentTrees/Trees":{"kind":"symbol","type":"topic","url":"\/documentation\/persistenttrees\/trees","role":"collection","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees","abstract":[],"title":"Trees"},"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeSet":{"role":"symbol","type":"topic","url":"\/documentation\/persistenttrees\/persistenttreeset","kind":"symbol","title":"PersistentTreeSet","navigatorTitle":[{"text":"PersistentTreeSet","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeSet","kind":"identifier"}],"abstract":[{"type":"text","text":"A persistent sorted set: unique elements in ascending order, where every version stays usable"},{"type":"text","text":" "},{"type":"text","text":"and versions share all but the vertices their edits touched."}],"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet"},"doc://PersistentTrees/documentation/PersistentTrees":{"role":"collection","type":"topic","url":"\/documentation\/persistenttrees","kind":"symbol","title":"PersistentTrees","abstract":[{"type":"text","text":"Balanced search trees that keep every version, sharing structure between them."}],"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees"},"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeDictionary":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistentTreeDictionary"}],"kind":"symbol","role":"symbol","title":"PersistentTreeDictionary","navigatorTitle":[{"kind":"identifier","text":"PersistentTreeDictionary"}],"url":"\/documentation\/persistenttrees\/persistenttreedictionary","type":"topic","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","abstract":[{"type":"text","text":"A persistent sorted dictionary: unique keys in ascending order, each with a value, where every"},{"type":"text","text":" "},{"type":"text","text":"version stays usable and versions share all but the vertices their edits touched."}]}}}