{"identifier":{"url":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"sections":[],"abstract":[{"type":"text","text":"Balanced search trees that keep every version, sharing structure between them."}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","type":"reference"},{"text":" never changes a vertex once it is made.","type":"text"},{"text":" ","type":"text"},{"text":"An edit builds new vertices along the path from the root to the change, O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") of them, and","type":"text"},{"text":" ","type":"text"},{"text":"points them at the untouched subtrees of the version it started from. Every earlier version","type":"text"},{"text":" ","type":"text"},{"text":"stays as it was, and a history of ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" edits costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") space in all.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import PersistentTrees","","let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The trees are weight-balanced: neither subtree of a vertex holds more than three times the keys"},{"type":"text","text":" "},{"type":"text","text":"of the other. Union, intersection, difference and symmetric difference split one tree by the"},{"type":"text","text":" "},{"type":"text","text":"other’s root and join the halves, in O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" log("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" \/ "},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" + 1)) for sets of "},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" ≤ "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" elements,"},{"type":"text","text":" "},{"type":"text","text":"and a subtree both operands share is kept whole without being visited. Two versions a few edits"},{"type":"text","text":" "},{"type":"text","text":"apart therefore merge in time proportional to those edits."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A version converts to Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":", its elements or keys as"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","topicSections":[{"title":"Sets and dictionaries","anchor":"Sets-and-dictionaries","identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary"]},{"title":"Extended Modules","anchor":"Extended-Modules","generated":true,"identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees"]}],"metadata":{"externalID":"PersistentTrees","symbolKind":"module","roleHeading":"Framework","title":"PersistentTrees","role":"collection","modules":[{"name":"PersistentTrees"}]},"variants":[{"paths":["\/documentation\/persistenttrees"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://PersistentTrees/documentation/PersistentTrees":{"role":"collection","title":"PersistentTrees","abstract":[{"text":"Balanced search trees that keep every version, sharing structure between them.","type":"text"}],"url":"\/documentation\/persistenttrees","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees","type":"topic","kind":"symbol"},"doc://PersistentTrees/documentation/PersistentTrees/Trees":{"role":"collection","title":"Trees","abstract":[],"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees","url":"\/documentation\/persistenttrees\/trees","type":"topic","kind":"symbol"},"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeSet":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeSet","kind":"identifier"}],"navigatorTitle":[{"text":"PersistentTreeSet","kind":"identifier"}],"title":"PersistentTreeSet","abstract":[{"type":"text","text":"A persistent sorted set: unique elements in ascending order, where every version stays usable"},{"type":"text","text":" "},{"type":"text","text":"and versions share all but the vertices their edits touched."}],"url":"\/documentation\/persistenttrees\/persistenttreeset","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet","type":"topic","kind":"symbol"},"doc://PersistentTrees/documentation/PersistentTrees/PersistentTreeDictionary":{"title":"PersistentTreeDictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeDictionary","kind":"identifier"}],"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary","navigatorTitle":[{"text":"PersistentTreeDictionary","kind":"identifier"}],"url":"\/documentation\/persistenttrees\/persistenttreedictionary","abstract":[{"text":"A persistent sorted dictionary: unique keys in ascending order, each with a value, where every","type":"text"},{"text":" ","type":"text"},{"text":"version stays usable and versions share all but the vertices their edits touched.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol"}}}