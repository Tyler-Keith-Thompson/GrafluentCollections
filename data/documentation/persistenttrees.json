ouched.","type":"text"}],"kind":"symbol","type":"topic","title":"PersistentTreeDictionary"},"doc://PersistentTrees/documentation/PersistentTrees/Trees":{"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/Trees","title":"Trees","abstract":[],"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/persistenttrees\/trees"}}}