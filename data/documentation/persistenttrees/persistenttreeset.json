nce","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/subtracting(_:)","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/symmetricDifference(_:)","isActive":true},{"text":" split","type":"text"},{"text":" ","type":"text"},{"text":"and join trees (Blelloch, Ferizovic and Sun, 2016) in O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" log(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" \/ ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" + 1)) for sets of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" ≤ ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" elements, and a subtree both sets share is kept whole without being visited.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"],"type":"codeListing"},{"inlineContent":[{"text":"The elements are a random-access collection in ascending order whose indices are ranks;","type":"text"},{"text":" ","type":"text"},{"text":"reading one by index costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), and a pass through the whole set O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"anchor":"Sets-and-dictionaries","generated":true,"title":"Sets and dictionaries","identifiers":["doc:\/\/PersistentTrees\/documentatio