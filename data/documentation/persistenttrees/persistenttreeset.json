{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet"},"abstract":[{"type":"text","text":"A persistent sorted set: unique elements in ascending order, where every version stays usable"},{"type":"text","text":" "},{"type":"text","text":"and versions share all but the vertices their edits touched."}],"metadata":{"title":"PersistentTreeSet","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/PersistentTrees\/PersistentTreeSet.swift#L27","fileName":"PersistentTreeSet.swift"},"modules":[{"name":"PersistentTrees"}],"symbolKind":"struct","role":"symbol","externalID":"s:15PersistentTrees0A7TreeSetV","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeSet","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PersistentTreeSet"}]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/PersistentTrees\/SK","doc:\/\/PersistentTrees\/Sl","doc:\/\/PersistentTrees\/s8CopyableP","doc:\/\/PersistentTrees\/s23CustomStringConvertibleP","doc:\/\/PersistentTrees\/Se","doc:\/\/PersistentTrees\/SE","doc:\/\/PersistentTrees\/SQ","doc:\/\/PersistentTrees\/s9EscapableP","doc:\/\/PersistentTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/PersistentTrees\/SH","doc:\/\/PersistentTrees\/Sk","doc:\/\/PersistentTrees\/s8SendableP","doc:\/\/PersistentTrees\/s16SendableMetatypeP","doc:\/\/PersistentTrees\/ST","doc:\/\/PersistentTrees\/s10SetAlgebraP"],"type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistenttrees\/persistenttreeset"]}],"hierarchy":{"paths":[["doc:\/\/PersistentTrees\/documentation\/PersistentTrees"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@fro