ery version of a history"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" edits costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") space rather than the O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"²) of copying a whole tree for each."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/union(_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/intersection(_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/subtracting(_:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/symmetricDifference(_:)"},{"type":"text","text":" split"},{"type":"text","text":" "},{"type":"text","text":"and join trees (Blelloch, Ferizovic and Sun, 2016) in O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" log("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" \/ "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" + 1)) for sets of"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" ≤ "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" elements, and a subtree both sets share is kept whole without being visited."}],"type":"paragraph"},{"syntax":"swift","type":"c