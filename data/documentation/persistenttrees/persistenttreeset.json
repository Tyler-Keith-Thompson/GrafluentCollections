{"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A persistent sorted set: unique elements in ascending order, where every version stays usable"},{"type":"text","text":" "},{"type":"text","text":"and versions share all but the vertices their edits touched."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistentTreeSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements live in a weight-balanced search tree of immutable vertices (Adams, 1993). An"},{"type":"text","text":" "},{"type":"text","text":"insertion or removal makes new vertices only along the path to the change, O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") of them,"},{"type":"text","text":" "},{"type":"text","text":"and shares the rest with the version it started from, so keeping every version of a history"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" edits costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") space rather than the O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"²) of copying a whole tree for each."},{"type":"text","text":" "},{"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/union(_:)","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/intersection(_:)","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/subtracting(_:)","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/symmetricDifference(_:)","type":"reference","isActive":true},{"type":"text","text":" split"},{"type":"text","text":" "},{"type":"text","text":"and join trees (Blelloch, Ferizovic and Sun, 2016) in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" log("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" \/ "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" + 1)) for sets of"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" ≤ "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" elements, and a subtree both sets share is kept whole without being visited."}]},{"type":"codeListing","syntax":"swift","code":["let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"]},{"type":"paragraph","inlineContent":[{"text":"The elements are a random-access collection in ascending order whose indices are ranks;","type":"text"},{"text":" ","type":"text"},{"text":"reading one by index costs O(log ","type":"text"},{"inline