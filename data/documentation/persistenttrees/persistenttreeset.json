erence","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/subtracting(_:)"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeSet\/symmetricDifference(_:)"},{"text":" split","type":"text"},{"text":" ","type":"text"},{"text":"and join trees (Blelloch, Ferizovic and Sun, 2016) in O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" log(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" \/ ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" + 1)) for sets of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" ≤ ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" elements, and a subtree both sets share is kept whole without being visited.","type":"text"}]},{"code":["let empty = PersistentTreeSet<Int>()","let one = empty.inserting(5)","let two = one.inserting(3)","let three = two.removing(5)","Array(one)                         \/\/ [5]","Array(two)                         \/\/ [3, 5]","Array(three)                       \/\/ [3]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements are a random-access collection in ascending order whose indices are ranks;"},{"type":"text","text":" "},{"type":"text","text":"reading one by index costs O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), and a pass through the whole set O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}]}]}],"kind":"symbol","seeAlsoSections":[{"title":"Sets and dictionaries","identifiers":["doc:\/\/PersistentTrees\/documentation\/PersistentTrees\/PersistentTreeDictionary"],"anchor":"Sets-and-