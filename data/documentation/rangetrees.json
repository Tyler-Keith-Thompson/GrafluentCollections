{"sections":[],"topicSections":[{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"],"title":"Fenwick trees","anchor":"Fenwick-trees"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"],"title":"Segment trees","anchor":"Segment-trees"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"],"title":"Interval trees","anchor":"Interval-trees"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"],"title":"Monoids","anchor":"Monoids"},{"generated":true,"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Trees over a sequence of values or a set of intervals that answer range queries and take updates","type":"text"},{"text":" ","type":"text"},{"text":"in O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","isActive":true},{"text":" keeps the prefix sums of a sequence of values in one flat array of partial","type":"text"},{"text":" ","type":"text"},{"text":"sums. Prefix sums, range sums and point updates each touch O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") cells, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","isActive":true},{"text":" finds where a running total crosses a value by binary","type":"text"},{"text":" ","type":"text"},{"text":"lifting.","type":"text"}],"type":"paragraph"},{"code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,"},{"type":"text","text":" "},{"type":"text","text":"converts to Grafluent’s "},{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":" with "},{"code":"Arborescence(_:)","type":"codeVoice"},{"type":"text","text":" (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true},{"type":"text","text":" combines any range of values under a "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","isActive":true},{"type":"text","text":": an associative operation with"},{"type":"text","text":" "},{"type":"text","text":"an identity, written as a type such as "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","isActive":true},{"type":"text","text":" or one of your own, which need not be"},{"type":"text","text":" "},{"type":"text","text":"commutative. Range queries and point updates take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)","isActive":true},{"type":"text","text":" find how far a"},{"type":"text","text":" "},{"type":"text","text":"range can grow while a monotone condition on it holds."}],"type":"paragraph"},{"code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","isActive":true,"type":"reference"},{"text":" also applies an update to every value in a range in O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), leaving it","type":"text"},{"text":" ","type":"text"},{"text":"pending at the cells that cover the range. A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","isActive":true,"type":"reference"},{"text":" names the monoid, the updates and","type":"text"},{"text":" ","type":"text"},{"text":"how an update changes a combined value; it is told how many values the combination covers, so","type":"text"},{"text":" ","type":"text"},{"text":"adding a constant to a range of sums is ","type":"text"},{"code":"sum + update * count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"},{"type":"text","text":" holds half-open intervals with a value each, in an AVL tree ordered by lower"},{"type":"text","text":" "},{"type":"text","text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that"},{"type":"text","text":" "},{"type":"text","text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early."}],"type":"paragraph"},{"code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees"]}],"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","externalID":"RangeTrees","title":"RangeTrees","role":"collection","symbolKind":"module","modules":[{"name":"RangeTrees"}]},"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees","interfaceLanguage":"swift"},"references":{"doc://RangeTrees/documentation/RangeTrees/Sum":{"kind":"symbol","type":"topic","url":"\/documentation\/rangetrees\/sum","abstract":[{"type":"text","text":"Addition, with identity zero."}],"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","navigatorTitle":[{"kind":"identifier","text":"Sum"}],"title":"Sum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sum"}]},"doc://RangeTrees/documentation/RangeTrees/MonoidAction":{"type":"topic","kind":"symbol","url":"\