{"topicSections":[{"title":"Fenwick trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"],"anchor":"Fenwick-trees"},{"title":"Segment trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"],"anchor":"Segment-trees"},{"title":"Interval trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"],"anchor":"Interval-trees"},{"title":"Monoids","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"],"anchor":"Monoids"},{"title":"Extended Modules","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"],"anchor":"Extended-Modules","generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"RangeTrees","externalID":"RangeTrees","role":"collection","modules":[{"name":"RangeTrees"}],"symbolKind":"module","roleHeading":"Framework"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","isActive":true},{"type":"text","text":" keeps the prefix sums of a sequence of values in one flat array of partial"},{"type":"text","text":" "},{"type":"text","text":"sums. Prefix sums, range sums and point updates each touch O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") cells, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","isActive":true},{"type":"text","text":" finds where a running total crosses a value by binary"},{"type":"text","text":" "},{"type":"text","text":"lifting."}]},{"code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,","type":"text"},{"text":" ","type":"text"},{"text":"converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Arborescence(_:)"},{"text":" (import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Trees"},{"text":" ","type":"text"},{"text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"},{"type":"text","text":" combines any range of values under a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid"},{"type":"text","text":": an associative operation with"},{"type":"text","text":" "},{"type":"text","text":"an identity, written as a type such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum"},{"type":"text","text":" or one of your own, which need not be"},{"type":"text","text":" "},{"type":"text","text":"commutative. Range queries and point updates take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)"},{"type":"text","text":" find how far a"},{"type":"text","text":" "},{"type":"text","text":"range can grow while a monotone condition on it holds."}]},{"code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","isActive":true},{"type":"text","text":" also applies an update to every value in a range in O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), leaving it"},{"type":"text","text":" "},{"type":"text","text":"pending at the cells that cover the range. A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","isActive":true},{"type":"text","text":" names the monoid, the updates and"},{"type":"text","text":" "},{"type":"text","text":"how an update changes a combined value; it is told how many values the combination covers, so"},{"type":"text","text":" "},{"type":"text","text":"adding a constant to a range of sums is "},{"type":"codeVoice","code":"sum + update * count"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","isActive":true},{"type":"text","text":" holds half-open intervals with a value each, in an AVL tree ordered by lower"},{"type":"text","text":" "},{"type":"text","text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that"},{"type":"text","text":" "},{"type":"text","text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early."}]},{"code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BinaryTree(_:)"},{"text":".","type":"text"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Trees over a sequence of values or a set of intervals that answer range queries and take updates","type":"text"},{"text":" ","type":"text"},{"text":"in O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":").","type":"text"}],"variants":[{"paths":["\/documentation\/rangetrees"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees","interfaceLanguage":"swift"},"sections":[],"references":{"doc://RangeTrees/documentation/RangeTrees/Trees":{"abstract":[],"title":"Trees","role":"collection","url":"\/documentation\/rangetrees\/trees","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees","kind":"symbol","type":"topic"},"doc://RangeTrees/documentation/RangeTrees/Monoid":{"role":"symbol","navigatorTitle":[{"text":"Monoid","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/rangetrees\/monoid","abstract":[{"type":"text","text":"An associative operation with an identity element, written as a type so generic co