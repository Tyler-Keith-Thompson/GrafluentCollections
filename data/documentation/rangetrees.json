{"sections":[],"abstract":[{"type":"text","text":"Trees over a sequence of values or a set of intervals that answer range queries and take updates"},{"type":"text","text":" "},{"type":"text","text":"in O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":")."}],"variants":[{"paths":["\/documentation\/rangetrees"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"RangeTrees"}],"roleHeading":"Framework","title":"RangeTrees","externalID":"RangeTrees","role":"collection","symbolKind":"module"},"topicSections":[{"title":"Fenwick trees","anchor":"Fenwick-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"]},{"title":"Segment trees","anchor":"Segment-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"]},{"title":"Interval trees","anchor":"Interval-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"]},{"title":"Monoids","anchor":"Monoids","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","type":"reference","isActive":true},{"text":" keeps the prefix sums of a sequence of values in one flat array of partial","type":"text"},{"text":" ","type":"text"},{"text":"sums. Prefix sums, range sums and point updates each touch O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") cells, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","type":"reference","isActive":true},{"text":" finds where a running total crosses a value by binary","type":"text"},{"text":" ","type":"text"},{"text":"lifting.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"]},{"inlineContent":[{"text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,","type":"text"},{"text":" ","type":"text"},{"text":"converts to Grafluent’s ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":" (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true,"type":"reference"},{"text":" combines any range of values under a ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","isActive":true,"type":"reference"},{"text":": an associative operation with","type":"text"},{"text":" ","type":"text"},{"text":"an identity, written as a type such as ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","isActive":true,"type":"reference"},{"text":" or one of your own, which need not be","type":"text"},{"text":" ","type":"text"},{"text":"commutative. Range queries and point updates take O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)","isActive":true,"type":"reference"},{"text":" find how far a","type":"text"},{"text":" ","type":"text"},{"text":"range can grow while a monotone condition on it holds.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"]},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},{"type":"text","text":" also applies an update to every value in a range in O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), leaving it"},{"type":"text","text":" "},{"type":"text","text":"pending at the cells that cover the range. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"type":"text","text":" names the monoid, the updates and"},{"type":"text","text":" "},{"type":"text","text":"how an update changes a combined value; it is told how many values the combination covers, so"},{"type":"text","text":" "},{"type":"text","text":"adding a constant to a range of sums is "},{"type":"codeVoice","code":"sum + update * count"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"},{"text":" holds half-open intervals with a value each, in an AVL tree ordered by lower","type":"text"},{"text":" ","type":"text"},{"text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that","type":"text"},{"text":" ","type":"text"},{"text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"]},{"inlineContent":[{"type":"text","text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees"},"references":{"doc://RangeTrees/documentation/RangeTrees/Maximum":{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","url":"\/documentation\/rangetrees\/maximum","abstract":[{"type":"text","text":"The larger of two integers, with identity "},{"type":"codeVoice","code":"Value.min"},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Maximum"}],"title":"Maximum","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Maxim