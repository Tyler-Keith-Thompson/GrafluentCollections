{"metadata":{"roleHeading":"Framework","title":"RangeTrees","externalID":"RangeTrees","symbolKind":"module","role":"collection","modules":[{"name":"RangeTrees"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Trees over a sequence of values or a set of intervals that answer range queries and take updates"},{"type":"text","text":" "},{"type":"text","text":"in O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Fenwick-trees","title":"Fenwick trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"]},{"anchor":"Segment-trees","title":"Segment trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"]},{"anchor":"Interval-trees","title":"Interval trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"]},{"anchor":"Monoids","title":"Monoids","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"]},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","type":"reference","isActive":true},{"text":" keeps the prefix sums of a sequence of values in one flat array of partial","type":"text"},{"text":" ","type":"text"},{"text":"sums. Prefix sums, range sums and point updates each touch O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") cells, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","type":"reference","isActive":true},{"text":" finds where a running total crosses a value by binary","type":"text"},{"text":" ","type":"text"},{"text":"lifting.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"]},{"type":"paragraph","inlineContent":[{"text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,","type":"text"},{"text":" ","type":"text"},{"text":"converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Arborescence(_:)"},{"text":" (import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Trees"},{"text":" ","type":"text"},{"text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true},{"type":"text","text":" combines any range of values under a "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","isActive":true},{"type":"text","text":": an associative operation with"},{"type":"text","text":" "},{"type":"text","text":"an identity, written as a type such as "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","isActive":true},{"type":"text","text":" or one of your own, which need not be"},{"type":"text","text":" "},{"type":"text","text":"commutative. Range queries and point updates take O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)","isActive":true},{"type":"text","text":" find how far a"},{"type":"text","text":" "},{"type":"text","text":"range can grow while a monotone condition on it holds."}]},{"syntax":"swift","type":"codeListing","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},{"type":"text","text":" also applies an update to every value in a range in O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), leaving it"},{"type":"text","text":" "},{"type":"text","text":"pending at the cells that cover the range. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"type":"text","text":" names the monoid, the updates and"},{"type":"text","text":" "},{"type":"text","text":"how an update changes a combined value; it is told how many values the combination covers, so"},{"type":"text","text":" "},{"type":"text","text":"adding a constant to a range of sums is "},{"type":"codeVoice","code":"sum + update * count"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","type":"reference"},{"text":" holds half-open intervals with a value each, in an AVL tree ordered by lower","type":"text"},{"text":" ","type":"text"},{"text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that","type":"text"},{"text":" ","type":"text"},{"text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"]},{"type":"paragraph","inlineContent":[{"text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"references":{"doc://RangeTrees/documentation/RangeTrees/Minimum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Minimum","kind":"identifier"}],"navigatorTitle":[{"text":"Minimum","kind":"identifier"}],"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","abstract":[{"type":"text","text":"The smaller of two integers, with identity "},{"type":"codeVoice","code":"Value.max"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/rangetrees\/minimum","role":"symbol","type":"topic","title":"Mi