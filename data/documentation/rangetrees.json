{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"},{"type":"text","text":" keeps the prefix sums of a sequence of values in one flat array of partial"},{"type":"text","text":" "},{"type":"text","text":"sums. Prefix sums, range sums and point updates each touch O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") cells, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)"},{"type":"text","text":" finds where a running total crosses a value by binary"},{"type":"text","text":" "},{"type":"text","text":"lifting."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"]},{"inlineContent":[{"type":"text","text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,"},{"type":"text","text":" "},{"type":"text","text":"converts to Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true},{"type":"text","text":" combines any range of values under a "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","isActive":true},{"type":"text","text":": an associative operation with"},{"type":"text","text":" "},{"type":"text","text":"an identity, written as a type such as "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","isActive":true},{"type":"text","text":" or one of your own, which need not be"},{"type":"text","text":" "},{"type":"text","text":"commutative. Range queries and point updates take O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)","isActive":true},{"type":"text","text":" find how far a"},{"type":"text","text":" "},{"type":"text","text":"range can grow while a monotone condition on it holds."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"]},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},{"text":" also applies an update to every value in a range in O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":"), leaving it","type":"text"},{"text":" ","type":"text"},{"text":"pending at the cells that cover the range. A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"text":" names the monoid, the updates and","type":"text"},{"text":" ","type":"text"},{"text":"how an update changes a combined value; it is told how many values the combination covers, so","type":"text"},{"text":" ","type":"text"},{"text":"adding a constant to a range of sums is ","type":"text"},{"code":"sum + update * count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both trees’ shapes convert to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"RangeTrees"}],"title":"RangeTrees","role":"collection","externalID":"RangeTrees","symbolKind":"module","roleHeading":"Framework"},"sections":[],"topicSections":[{"anchor":"Fenwick-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"],"title":"Fenwick trees"},{"anchor":"Segment-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"],"title":"Segment trees"},{"anchor":"Monoids","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"],"title":"Monoids"},{"generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"],"title":"Extended Modules"}],"abstract":[{"text":"Trees over a sequen