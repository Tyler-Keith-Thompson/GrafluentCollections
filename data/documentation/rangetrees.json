{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Fenwick-trees","title":"Fenwick trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"]},{"anchor":"Segment-trees","title":"Segment trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"]},{"anchor":"Interval-trees","title":"Interval trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"]},{"anchor":"Monoids","title":"Monoids","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"]},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"],"generated":true}],"abstract":[{"text":"Trees over a sequence of values or a set of intervals that answer range queries and take updates","type":"text"},{"text":" ","type":"text"},{"text":"in O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","isActive":true},{"type":"text","text":" keeps the prefix sums of a sequence of values in one flat array of partial"},{"type":"text","text":" "},{"type":"text","text":"sums. Prefix sums, range sums and point updates each touch O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") cells, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","isActive":true},{"type":"text","text":" finds where a running total crosses a value by binary"},{"type":"text","text":" "},{"type":"text","text":"lifting."}],"type":"paragraph"},{"syntax":"swift","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,"},{"type":"text","text":" "},{"type":"text","text":"converts to Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","type":"reference","isActive":true},{"type":"text","text":" combines any range of values under a "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","type":"reference","isActive":true},{"type":"text","text":": an associative operation with"},{"type":"text","text":" "},{"type":"text","text":"an identity, written as a type such as "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","type":"reference","isActive":true},{"type":"text","text":" or one of your own, which need not be"},{"type":"text","text":" "},{"type":"text","text":"commutative. Range queries and point updates take O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)","type":"reference","isActive":true},{"type":"text","text":" find how far a"},{"type":"text","text":" "},{"type":"text","text":"range can grow while a monotone condition on it holds."}],"type":"paragraph"},{"syntax":"swift","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"],"type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},{"text":" also applies an update to every value in a range in O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), leaving it","type":"text"},{"text":" ","type":"text"},{"text":"pending at the cells that cover the range. A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"text":" names the monoid, the updates and","type":"text"},{"text":" ","type":"text"},{"text":"how an update changes a combined value; it is told how many values the combination covers, so","type":"text"},{"text":" ","type":"text"},{"text":"adding a constant to a range of sums is ","type":"text"},{"type":"codeVoice","code":"sum + update * count"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"},{"text":" holds half-open intervals with a value each, in an AVL tree ordered by lower","type":"text"},{"text":" ","type":"text"},{"text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that","type":"text"},{"text":" ","type":"text"},{"text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"],"type":"codeListing"},{"inlineContent":[{"text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BinaryTree(_:)"},{"text":".","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"RangeTrees","symbolKind":"module","role":"collection","externalID":"RangeTrees","modules":[{"name":"RangeTrees"}],"roleHeading":"Framework"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://RangeTrees/documentation/RangeTrees/SegmentTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentTree","kind":"identifier"}],"title":"SegmentTree","url":"\/documentation\/rangetrees\/segmenttree","kind":"symbol","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","abstract":[{"type":"text","text":"A segment tree: a sequence of values that combines any range of them under a monoid and takes"},{"type":"text","text":" "},{"type":"text","text":"point updates in O(log "},{"