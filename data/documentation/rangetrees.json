{"metadata":{"externalID":"RangeTrees","symbolKind":"module","role":"collection","title":"RangeTrees","modules":[{"name":"RangeTrees"}],"roleHeading":"Framework"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","isActive":true,"type":"reference"},{"text":" keeps the prefix sums of a sequence of values in one flat array of partial","type":"text"},{"text":" ","type":"text"},{"text":"sums. Prefix sums, range sums and point updates each touch O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") cells, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","isActive":true,"type":"reference"},{"text":" finds where a running total crosses a value by binary","type":"text"},{"text":" ","type":"text"},{"text":"lifting.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"]},{"inlineContent":[{"type":"text","text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,"},{"type":"text","text":" "},{"type":"text","text":"converts to Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true,"type":"reference"},{"text":" combines any range of values under a ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","isActive":true,"type":"reference"},{"text":": an associative operation with","type":"text"},{"text":" ","type":"text"},{"text":"an identity, written as a type such as ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","isActive":true,"type":"reference"},{"text":" or one of your own, which need not be","type":"text"},{"text":" ","type":"text"},{"text":"commutative. Range queries and point updates take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)","isActive":true,"type":"reference"},{"text":" find how far a","type":"text"},{"text":" ","type":"text"},{"text":"range can grow while a monotone condition on it holds.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"]},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},{"type":"text","text":" also applies an update to every value in a range in O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), leaving it"},{"type":"text","text":" "},{"type":"text","text":"pending at the cells that cover the range. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"type":"text","text":" names the monoid, the updates and"},{"type":"text","text":" "},{"type":"text","text":"how an update changes a combined value; it is told how many values the combination covers, so"},{"type":"text","text":" "},{"type":"text","text":"adding a constant to a range of sums is "},{"type":"codeVoice","code":"sum + update * count"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","isActive":true},{"type":"text","text":" holds half-open intervals with a value each, in an AVL tree ordered by lower"},{"type":"text","text":" "},{"type":"text","text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that"},{"type":"text","text":" "},{"type":"text","text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"]},{"inlineContent":[{"type":"text","text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees"},"