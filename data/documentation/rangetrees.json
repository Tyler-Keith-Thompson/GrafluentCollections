{"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"],"title":"Fenwick trees","anchor":"Fenwick-trees"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"],"title":"Segment trees","anchor":"Segment-trees"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"],"title":"Interval trees","anchor":"Interval-trees"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"],"title":"Monoids","anchor":"Monoids"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees"]}],"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","isActive":true,"type":"reference"},{"text":" keeps the prefix sums of a sequence of values in one flat array of partial","type":"text"},{"text":" ","type":"text"},{"text":"sums. Prefix sums, range sums and point updates each touch O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") cells, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","isActive":true,"type":"reference"},{"text":" finds where a running total crosses a value by binary","type":"text"},{"text":" ","type":"text"},{"text":"lifting.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"]},{"type":"paragraph","inlineContent":[{"text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,","type":"text"},{"text":" ","type":"text"},{"text":"converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Arborescence(_:)"},{"text":" (import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Trees"},{"text":" ","type":"text"},{"text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"},{"text":" combines any range of values under a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid"},{"text":": an associative operation with","type":"text"},{"text":" ","type":"text"},{"text":"an identity, written as a type such as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum"},{"text":" or one of your own, which need not be","type":"text"},{"text":" ","type":"text"},{"text":"commutative. Range queries and point updates take O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)"},{"text":" find how far a","type":"text"},{"text":" ","type":"text"},{"text":"range can grow while a monotone condition on it holds.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","type":"reference"},{"text":" also applies an update to every value in a range in O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), leaving it","type":"text"},{"text":" ","type":"text"},{"text":"pending at the cells that cover the range. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","type":"reference"},{"text":" names the monoid, the updates and","type":"text"},{"text":" ","type":"text"},{"text":"how an update changes a combined value; it is told how many values the combination covers, so","type":"text"},{"text":" ","type":"text"},{"text":"adding a constant to a range of sums is ","type":"text"},{"code":"sum + update * count","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","type":"reference","isActive":true},{"text":" holds half-open intervals with a value each, in an AVL tree ordered by lower","type":"text"},{"text":" ","type":"text"},{"text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that","type":"text"},{"text":" ","type":"text"},{"text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"externalID":"RangeTrees","role":"collection","modules":[{"name":"RangeTrees"}],"roleHeading":"Framework","title":"RangeTrees","symbolKind":"module"},"abstract":[{"type":"text","text":"Trees over a sequence of values or a set of intervals that answer range queries and take updates"},{"type":"text","text":" "},{"type":"text","text":"in O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":")."}],"references":{"doc://RangeTrees/documentation/RangeTrees/SegmentTree":{"navigatorTitle":[{"kind":"identifier","text":"SegmentTree"}],"kind":"symbol","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","title":"SegmentTree","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentTree"}],"abstract":[{"text":"A segment tree: a sequence of values that combines any range of them under a monoid and takes","type":"text"},{"text":" ","type":"text"},{"text"