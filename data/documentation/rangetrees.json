":"topic","role":"symbol","title":"IntervalTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"}],"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","kind":"symbol","navigatorTitle":[{"text":"IntervalTree","kind":"identifier"}],"abstract":[{"type":"text","text":"An interval tree: a sorted collection of half-open intervals with a value each, which finds the"},{"type":"text","text":" "},{"type":"text","text":"intervals overlapping a range, containing a point, or lying within a range in"},{"type":"text","text":" "},{"type":"text","text":"O(("},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" + 1) log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" results."}]},"doc://RangeTrees/documentation/RangeTrees/SegmentTree":{"role":"symbol","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","navigatorTitle":[{"text":"SegmentTree","kind":"identifier"}],"kind":"symbol","type":"topic","title":"SegmentTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A segment tree: a sequence of values that combines any range of them under a monoid and takes"},{"type":"text","text":" "},{"type":"text","text":"point updates in O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") each."}],"url":"\/documentation\/rangetrees\/segmenttree"},"doc://RangeTrees/documentation/RangeTrees/MonoidAction":{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","kind":"symbol","abstract":[{"type":"text","text":"Updates that act on the values of a monoid, for "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","type":