:" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"prefixSum(through: i) >= value"},{"type":"text","text":", or "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":" when the total is below "},{"type":"codeVoice","code":"value"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","kind":"symbol","url":"\/documentation\/rangetrees\/fenwicktree\/lowerbound(ofprefixsum:)","conformance":{"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"AdditiveArithmetic","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}},"doc://RangeTrees/documentation/RangeTrees/LazySegmentTree":{"type":"topic","navigatorTitle":[{"text":"LazySegmentTree","kind":"identifier"}],"abstract":[{"text":"A segment tree with lazy propagation: a sequence of values that combines any range of them","type":"text"},{"text":" ","type":"text"},{"text":"under a monoid and applies an update to every value in a range, each in O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":").","type":"text"}],"title":"LazySegmentTree","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/rangetrees\/lazysegmenttree"},"doc://RangeTrees/documentation/RangeTrees/Product":{"navigatorTitle":[{"kind":"identifier","text":"Product"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Product"}],"type":"topic","title":"Product","identifier":"doc:\/\/RangeTrees\/documentation