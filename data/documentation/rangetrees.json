{"metadata":{"modules":[{"name":"RangeTrees"}],"role":"collection","externalID":"RangeTrees","symbolKind":"module","roleHeading":"Framework","title":"RangeTrees"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","isActive":true,"type":"reference"},{"type":"text","text":" keeps the prefix sums of a sequence of values in one flat array of partial"},{"type":"text","text":" "},{"type":"text","text":"sums. Prefix sums, range sums and point updates each touch O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") cells, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","isActive":true,"type":"reference"},{"type":"text","text":" finds where a running total crosses a value by binary"},{"type":"text","text":" "},{"type":"text","text":"lifting."}]},{"type":"codeListing","syntax":"swift","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,"},{"type":"text","text":" "},{"type":"text","text":"converts to Grafluent’s "},{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":" with "},{"code":"Arborescence(_:)","type":"codeVoice"},{"type":"text","text":" (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true,"type":"reference"},{"text":" combines any range of values under a ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","isActive":true,"type":"reference"},{"text":": an associative operation with","type":"text"},{"text":" ","type":"text"},{"text":"an identity, written as a type such as ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","isActive":true,"type":"reference"},{"text":" or one of your own, which need not be","type":"text"},{"text":" ","type":"text"},{"text":"commutative. Range queries and point updates take O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)","isActive":true,"type":"reference"},{"text":" find how far a","type":"text"},{"text":" ","type":"text"},{"text":"range can grow while a monotone condition on it holds.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},{"text":" also applies an update to every value in a range in O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), leaving it"