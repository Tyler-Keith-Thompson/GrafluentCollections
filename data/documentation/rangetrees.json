rees/Minimum":{"title":"Minimum","navigatorTitle":[{"text":"Minimum","kind":"identifier"}],"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","abstract":[{"type":"text","text":"The smaller of two integers, with identity "},{"type":"codeVoice","code":"Value.max"},{"type":"text","text":"."}],"url":"\/documentation\/rangetrees\/minimum","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Minimum","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://RangeTrees/documentation/RangeTrees/Monoid":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Monoid","kind":"identifier"}],"navigatorTitle":[{"text":"Monoid","kind":"identifier"}],"kind":"symbol","title":"Monoid","role":"symbol","type":"topic","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","abstract":[{"type":"text","text":"An associative operation with an identity element, written as a type so generic code"},{"type":"text","text":" "},{"type":"text","text":"specializes on it: "},{"code":"SegmentTree<Sum<Int>>","type":"codeVoice"},{"type":"text","text":" combines with "},{"code":"+","type":"codeVoice"},{"type":"text","text":", "},{"code":"SegmentTree<Minimum<Int>>","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":"min","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/rangetrees\/monoid"},"doc://RangeTrees/documentation/RangeTrees/Sum":{"abstract":[{"type":"text","text":"Addition, with identity zero."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sum"}],"title":"Sum","url":"\/documentation\/rangetrees\/sum","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","navigatorTitle":[{"kind":"identifier","text":"Sum"}],"role":"symbol","kind":"symbol","type":"topic"}}}