{"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Trees over a sequence of values or a set of intervals that answer range queries and take updates"},{"type":"text","text":" "},{"type":"text","text":"in O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}],"metadata":{"roleHeading":"Framework","title":"RangeTrees","symbolKind":"module","role":"collection","externalID":"RangeTrees","modules":[{"name":"RangeTrees"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","isActive":true},{"type":"text","text":" keeps the prefix sums of a sequence of values in one flat array of partial"},{"type":"text","text":" "},{"type":"text","text":"sums. Prefix sums, range sums and point updates each touch O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") cells, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","isActive":true},{"type":"text","text":" finds where a running total crosses a value by binary"},{"type":"text","text":" "},{"type":"text","text":"lifting."}],"type":"paragraph"},{"syntax":"swift","code":["import RangeTrees","","var scores: FenwickTree = [3, 1, 4, 1, 5, 9, 2, 6]","scores.prefixSum(through: 3)        \/\/ 9","scores.sum(in: 2 ..< 6)             \/\/ 19","scores.add(10, at: 1)","scores.lowerBound(ofPrefixSum: 15)  \/\/ 2"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A Fenwick tree’s update tree, in which each cell’s parent is the next cell an add reaches,"},{"type":"text","text":" "},{"type":"text","text":"converts to Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one), so Grafluent’s tree algorithms and drawings run over it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"},{"type":"text","text":" combines any range of values under a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid"},{"type":"text","text":": an associative operation with"},{"type":"text","text":" "},{"type":"text","text":"an identity, written as a type such as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum"},{"type":"text","text":" or one of your own, which need not be"},{"type":"text","text":" "},{"type":"text","text":"commutative. Range queries and point updates take O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/maxRight(from:where:)"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree\/minLeft(upTo:where:)"},{"type":"text","text":" find how far a"},{"type":"text","text":" "},{"type":"text","text":"range can grow while a monotone condition on it holds."}],"type":"paragraph"},{"syntax":"swift","code":["var heights = SegmentTree<Maximum<Int>>([3, 1, 4, 1, 5, 9, 2, 6])","heights.combined(in: 0 ..< 4)        \/\/ 4","heights.update(at: 1, to: 7)","heights.maxRight(from: 0) { $0 < 9 } \/\/ 5"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","isActive":true},{"type":"text","text":" also applies an update to every value in a range in O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), leaving it"},{"type":"text","text":" "},{"type":"text","text":"pending at the cells that cover the range. A "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","isActive":true},{"type":"text","text":" names the monoid, the updates and"},{"type":"text","text":" "},{"type":"text","text":"how an update changes a combined value; it is told how many values the combination covers, so"},{"type":"text","text":" "},{"type":"text","text":"adding a constant to a range of sums is "},{"code":"sum + update * count","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"},{"type":"text","text":" holds half-open intervals with a value each, in an AVL tree ordered by lower"},{"type":"text","text":" "},{"type":"text","text":"bound whose vertices also record the largest upper bound below them. It finds the intervals that"},{"type":"text","text":" "},{"type":"text","text":"contain a point, overlap a range or lie within one, skipping every subtree that ends too early."}],"type":"paragraph"},{"syntax":"swift","code":["var bookings = IntervalTree<Int, String>()","bookings.insert(9 ..< 11, value: \"Ada\")","bookings.insert(10 ..< 12, value: \"Grace\")","bookings.containing(10).map(\\.value)          \/\/ [\"Ada\", \"Grace\"]","bookings.overlapping(11 ..< 13).map(\\.value)  \/\/ [\"Grace\"]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The segment trees’ and the interval tree’s shapes convert to Grafluent’s "},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/rangetrees"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees"},"topicSections":[{"title":"Fenwick trees","anchor":"Fenwick-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree"]},{"title":"Segment trees","anchor":"Segment-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"]},{"title":"Interval trees","anchor":"Interval-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"]},{"title":"Monoids","anchor":"Monoids","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Monoid","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Sum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Product","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/Maximum","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/Trees"]}],"references":{"doc://RangeTrees/documentation/RangeTrees/Minimum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Minimum","kind":"identifier"}],"url":"\/documentation\/rangetrees\/minimum","navigatorTitle":[{"text":"Minimum","kind":"identifier"}],"abstract":[{"text":"The smaller of two integers, with identity ","type":"text"},{"code":"Value.max","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/Minimum","kind":"symbol","role":"symbol","title":"Mi