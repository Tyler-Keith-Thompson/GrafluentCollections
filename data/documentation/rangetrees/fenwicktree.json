se and O(1) amortized over a pass through the"},{"type":"text","text":" "},{"type":"text","text":"collection."}],"type":"paragraph"}]}],"references":{"doc://RangeTrees/documentation/RangeTrees/FenwickTree/init()":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"abstract":[{"type":"text","text":"An empty tree."}],"type":"topic","role":"symbol","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/init()","title":"init()","url":"\/documentation\/rangetrees\/fenwicktree\/init()","kind":"symbol"},"doc://RangeTrees/documentation/RangeTrees/FenwickTree":{"kind":"symbol","abstract":[{"text":"A Fenwick tree (binary indexed tree): a sequence of values that answers prefix sums and takes","type":"text"},{"text":" ","type":"text"},{"text":"point updates in O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") each.","type":"text"}],"url":"\/documentation\/rangetrees\/fenwicktree","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FenwickTree","kind":"identifier"}],"navigatorTitle":[{"text":"FenwickTree","kind":"identifier"}],"role":"symbol","title":"FenwickTree"},"doc://RangeTrees/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/RangeTrees\/Se","type":"unresolvable"},"doc://RangeTrees/Sl":{"title":"Swift.Collection","identifier":"doc:\/\/RangeTrees\/Sl","type":"unresolvable"},"doc://RangeTrees/documentation/RangeTrees/FenwickTree/sum(checkedIn:)":{"type":"topic","role":"symbol","url":"\/documentation\/rangetrees\/fenwicktree\/sum(checkedin:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"sum","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Range","kind":"typeIdentifier","preciseIdentifier":"s:Sn"},{"text":"<","kind":"text"},{"text":"Int","kind":