lue costs O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") in the worst case and O(1) amortized over a pass through the"},{"type":"text","text":" "},{"type":"text","text":"collection."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/Se","doc:\/\/RangeTrees\/SE","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s9EscapableP","doc:\/\/RangeTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/RangeTrees\/SH","doc:\/\/RangeTrees\/Sk","doc:\/\/RangeTrees\/s8SendableP","doc:\/\/RangeTrees\/s16SendableMetatypeP","doc:\/\/RangeTrees\/ST"],"type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/init(_:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/add(_:at:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/add(_:checkedAt:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/lowerBound(ofPrefixSum:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/prefixSum(checkedThrough:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/prefixSum(through:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/sum(checkedIn:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/FenwickTree\/sum(in:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Subscripts","iden