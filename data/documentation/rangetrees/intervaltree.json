{"abstract":[{"text":"An interval tree: a sorted collection of half-open intervals with a value each, which finds the","type":"text"},{"text":" ","type":"text"},{"text":"intervals overlapping a range, containing a point, or lying within a range in","type":"text"},{"text":" ","type":"text"},{"text":"O((","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" + 1) log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" results.","type":"text"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Entry","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Iterator","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/SearchView"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(checked:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/contained(in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/containing(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(_:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(checked:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/overlapping(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/remove(_:)"],"anchor":"Instance-Methods","generated":true},{"title":"Subscripts","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/subscript(checked:)"],"anchor":"Subscripts","generated":true},{"title":"Default Implementations","identif