he query begins (Cormen, Leiserson, Rivest and"},{"type":"text","text":" "},{"type":"text","text":"Stein, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Introduction to Algorithms"}]},{"type":"text","text":", §14.3). The same interval may be stored more than once,"},{"type":"text","text":" "},{"type":"text","text":"with different values."}]},{"type":"codeListing","syntax":"swift","code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]","meetings.overlapping(9 ..< 11).map(\\.value)   \/\/ [\"stand-up\", \"design review\"]","meetings.contained(in: 9 ..< 12).map(\\.range) \/\/ [9 ..< 10, 10 ..< 12]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Intervals are half-open, so "},{"type":"codeVoice","code":"9 ..< 10"},{"type":"text","text":" and "},{"type":"codeVoice","code":"10 ..< 12"},{"type":"text","text":" touch without overlapping. As a"},{"type":"text","text":" "},{"type":"text","text":"collection, the tree’s elements are its entries in that order, read by in-order position."}]}],"kind":"content"}],"metadata":{"title":"IntervalTree","symbolKind":"struct","navigatorTitle":[{"text":"IntervalTree","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/IntervalTree.swift#L26","fileName":"IntervalTree.swift"},"externalID":"s:10RangeTrees12IntervalTreeV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntervalTree"}],"role":"symbol","modules":[{"name":"RangeTrees"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees\/intervaltree"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[