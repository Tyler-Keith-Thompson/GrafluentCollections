{"abstract":[{"text":"An interval tree: a sorted collection of half-open intervals with a value each, which finds the","type":"text"},{"text":" ","type":"text"},{"text":"intervals overlapping a range, containing a point, or lying within a range in","type":"text"},{"text":" ","type":"text"},{"text":"O((","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" + 1) log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" results.","type":"text"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s9EscapableP","doc:\/\/RangeTrees\/Sk","doc:\/\/RangeTrees\/s8SendableP","doc:\/\/RangeTrees\/s16SendableMetatypeP","doc:\/\/RangeTrees\/ST"]}],"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Structure","remoteSource":{"fileName":"IntervalTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/IntervalTree.swift#L26"},"externalID":"s:10RangeTrees12IntervalTreeV","navigatorTitle":[{"kind":"identifier","text":"IntervalTree"}],"role":"symbol","symbolKind":"struct","modules":[{"name":"RangeTrees"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"}],"title":"IntervalTree"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Bound","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bound","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The intervals are kept in an AVL tree ordered by lower bound, then upper bound, then the order"},{"type":"text","text":" "},{"type":"text","text":"they were inserted in, and each vertex also records the largest upper bound in its subtree, so"},{"type":"text","text":" "},{"type":"text","text":"a search skips every subtree that ends before the query begins (Cormen, Leiserson, Rivest and"},{"type":"text","text":" "},{"type":"text","text":"Stein, "},{"type":"emphasis","inlineContent":[{"text":"Introduction to Algorithms","type":"text"}]},{"type":"text","text":", §14.3). The same interval may be stored more than once,"},{"type":"text","text":" "},{"type":"text","text":"with different values."}]},{"type":"codeListing","syntax":"swift","code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]","meetings.overlapping(9 ..< 11).map(\\.value)   \/\/ [\"stand-up\", \"design review\"]","meetings.contained(in: 9 ..< 12).map(\\.range) \/\/ [9 ..< 10, 10 ..< 12]"]},{"type":"paragraph","inlineContent":[{"text":"Intervals are half-open, so ","type":"text"},{"code":"9 ..< 10","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"10 ..< 12","type":"codeVoice"},{"text":" touch without overlapping. As a","type":"text"},{"text":" ","type":"text"},{"text":"collection, the tree’s elements are its entries in that order, read by in-order position.","type":"text"}]}]}],"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Entry","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Iterator","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/SearchView"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(checked:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/contained(in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/containing(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(_:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(checked:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/overlapping(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/remove(_:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Subscripts","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/subscript(checked:)"],"anchor":"Subscripts"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/BidirectionalCollection-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Collection-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/CustomStringConvertible-Implementations","doc:\/\/RangeTrees\/d