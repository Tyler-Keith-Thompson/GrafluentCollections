:"Default-Implementations","generated":true,"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/BidirectionalCollection-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Collection-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/CustomStringConvertible-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Equatable-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/RandomAccessCollection-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Sequence-Implementations"]}],"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","interfaceLanguage":"swift"},"metadata":{"title":"IntervalTree","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/IntervalTree.swift#L26","fileName":"IntervalTree.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"}],"externalID":"s:10RangeTrees12IntervalTreeV","role":"symbol","symbolKind":"struct","modules":[{"name":"RangeTrees"}],"navigatorTitle":[{"text":"IntervalTree","kind":"identifier"}],"roleHeading":"Structure"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Bound","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bound","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The intervals are kept in an AVL tree ordered by lower bound, then upper bound, then the order"},{"type":"text","text":" "},{"type":"text","text":"they were inserted in, and each vertex also records the largest upper bound in its subtree, so"},{"type":"text","text":" "},{"type":"text","text":"a search skips every subtree that ends before the query begins (Cormen, Leiserson, Rivest and"},{"type":"text","text":" "},{"type":"text","text":"Stein, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Introduction to Algorithms"}]},{"type":"text","text":", §14.3). The same interval may be stored more than once,"},{"type":"text","text":" "},{"type":"text","text":"with different values."}]},{"code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]","meetings.overlapping(9 ..< 11).map(\\.value)   \/\/ [\"stand-up\", \"design review\"]","meetings.contained(in: 9 ..< 12).map(\\.range) \/\/ [9 ..< 10, 10 ..< 12]"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Intervals are half-open, so "},{"code":"9 ..< 10","type":"codeVoice"},{"type":"text","text":" and "},{"code":"10 ..< 12","type":"codeVoice"},{"type":"text","text":" touch without overlapping. As a"},{"type":"text","text":" "},{"type":"text","text":"collection, the tree’s elements are its entries in that order, read by in-order position."}]}]}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"abstract":[{"type":"text","text":"An interval tree: a sorted collection of half-open intervals with a value each, which finds the"},{"type":"text","text":" "},{"type":"text","text":"intervals overlapping a range,