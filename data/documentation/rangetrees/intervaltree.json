mparable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The intervals are kept in an AVL tree ordered by lower bound, then upper bound, then the order"},{"type":"text","text":" "},{"type":"text","text":"they were inserted in, and each vertex also records the largest upper bound in its subtree, so"},{"type":"text","text":" "},{"type":"text","text":"a search skips every subtree that ends before the query begins (Cormen, Leiserson, Rivest and"},{"type":"text","text":" "},{"type":"text","text":"Stein, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Introduction to Algorithms"}]},{"type":"text","text":", §14.3). The same interval may be stored more than once,"},{"type":"text","text":" "},{"type":"text","text":"with different values."}]},{"code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]","meetings.overlapping(9 ..< 11).map(\\.value)   \/\/ [\"stand-up\", \"design review\"]","meetings.contained(in: 9 ..< 12).map(\\.range) \/\/ [9 ..< 10, 10 ..< 12]"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Intervals are half-open, so "},{"type":"codeVoice","code":"9 ..< 10"},{"type":"text","text":" and "},{"type":"codeVoice","code":"10 ..< 12"},{"type":"text","text":" touch without overlapping. As a"},{"type":"text","text":" "},{"type":"text","text":"collection, the tree’s elements are its entries in that order, read by in-order position."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees\/intervaltree"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[