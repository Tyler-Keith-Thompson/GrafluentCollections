kind":"text"},{"text":"IntervalTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Bound","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bound","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The intervals are kept in an AVL tree ordered by lower bound, then upper bound, then the order"},{"type":"text","text":" "},{"type":"text","text":"they were inserted in, and each vertex also records the largest upper bound in its subtree, so"},{"type":"text","text":" "},{"type":"text","text":"a search skips every subtree that ends before the query begins (Cormen, Leiserson, Rivest and"},{"type":"text","text":" "},{"type":"text","text":"Stein, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Introduction to Algorithms"}]},{"type":"text","text":", §14.3). The same interval may be stored more than once,"},{"type":"text","text":" "},{"type":"text","text":"with different values."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]","meetings.overlapping(9 ..< 11).map(\\.value)   \/\/ [\"stand-up\", \"design review\"]","meetings.contained(in: 9 ..< 12).map(\\.range) \/\/ [9 ..< 10, 10 ..< 12]"]},{"inlineContent":[{"type":"text","text":"Intervals are half-open, so "},{"code":"9 ..< 10","type":"codeVoice"},{"type":"text","text":" and "},{"code":"10 ..< 12","type":"codeVoice"},{"type":"text","text":" touch without overlapping. As a"},{"type":"text","text":" "},{"type":"text","text":"collection, the tree’s elements are its entries in that order, read by in-order position."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/rangetrees\/intervaltree"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://RangeTrees/s8SendableP":{"identifier":"doc:\/\/RangeTrees\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://RangeTrees/documentation/RangeTrees/IntervalTree/init()":{"abstract":[{"text":"An empty tree.","type":"text"}],"title":"init()","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/rangetrees\/intervaltree\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init()"},"doc://RangeTrees/documentation/RangeTrees/IntervalTree/Equatable-Implementations":{"kind":"article","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Equatable-Implementations","abstract":[],"type":"topic","url":"\/documentation\/rangetrees\/intervaltree\/equatable-implementations","title":"Equatable Implementations","role":"collectionGroup"},"doc://RangeTrees/documentation/RangeTrees/IntervalTree/SearchView":{"abstract":[{"type":"text","text":"The entries of a search, read lazily from the tree; see "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/overlapping(_:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/containing(_:)","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/contained(in:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"IntervalTre