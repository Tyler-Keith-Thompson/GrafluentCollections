eyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntervalTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Bound"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Bound"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The intervals are kept in an AVL tree ordered by lower bound, then upper bound, then the order"},{"type":"text","text":" "},{"type":"text","text":"they were inserted in, and each vertex also records the largest upper bound in its subtree, so"},{"type":"text","text":" "},{"type":"text","text":"a search skips every subtree that ends before the query begins (Cormen, Leiserson, Rivest and"},{"type":"text","text":" "},{"type":"text","text":"Stein, "},{"inlineContent":[{"type":"text","text":"Introduction to Algorithms"}],"type":"emphasis"},{"type":"text","text":", §14.3). The same interval may be stored more than once,"},{"type":"text","text":" "},{"type":"text","text":"with different values."}],"type":"paragraph"},{"code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]","meetings.overlapping(9 ..< 11).map(\\.value)   \/\/ [\"stand-up\", \"design review\"]","meetings.contained(in: 9 ..< 12).map(\\.range) \/\/ [9 ..< 10, 10 ..< 12]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Intervals are half-open, so ","type":"text"},{"type":"codeVoice","code":"9 ..< 10"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"10 ..< 12"},{"text":" touch without overlapping. As a","type":"text"},{"text":" ","type":"text"},{"text":"collection, the tree’s elements are its entries in that order, read by in-order position.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/rangetrees\/intervaltree"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://RangeTrees/documentation/RangeTrees/IntervalTree":{"url":"\/documentation\/rangetrees\/intervaltree","type":"topic","role":"symbol","title":"IntervalTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"}],"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree","kind":"symbol","navigatorTitle":[{"text":"IntervalTree","kind":"identifier"}],"abstract":[{"type":"text","text":"An interval tree: a sorted collection of half-open intervals with a value each, which finds the"},{"type":"text","text":" "},{"type":"text","text":"intervals overlapping a range, containing a point, or lying within a range in"},{"type":"text","text":" "},{"type":"text","text":"O(("},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" + 1) log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" results."}]},"doc://RangeTrees/s8SendableP":{"identifier":"doc:\/\/RangeTrees\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://RangeTrees/documentation/RangeTrees/IntervalTree/insert(_:value:)":{"kind":"symbol","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(_:value:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Sn","text":"Range"},{"kind":"