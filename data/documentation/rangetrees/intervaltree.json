{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree"},"abstract":[{"text":"An interval tree: a sorted collection of half-open intervals with a value each, which finds the","type":"text"},{"text":" ","type":"text"},{"text":"intervals overlapping a range, containing a point, or lying within a range in","type":"text"},{"text":" ","type":"text"},{"text":"O((","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" + 1) log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" results.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"topicSections":[{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Entry","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Iterator","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/SearchView"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(checked:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/contained(in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/containing(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(_:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(checked:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/overlapping(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/remove(_:)"],"title":"Insta