{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","remoteSource":{"fileName":"IntervalTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/IntervalTree.swift#L26"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"}],"externalID":"s:10RangeTrees12IntervalTreeV","title":"IntervalTree","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"IntervalTree"}],"modules":[{"name":"RangeTrees"}],"roleHeading":"Structure"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s9EscapableP","doc:\/\/RangeTrees\/Sk","doc:\/\/RangeTrees\/s8SendableP","doc:\/\/RangeTrees\/s16SendableMetatypeP","doc:\/\/RangeTrees\/ST"],"type":"conformsTo"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntervalTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Bound","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bound","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The intervals are kept in an AVL tree ordered by lower bound, then upper bound, then the order"},{"type":"text","text":" "},{"type":"text","text":"they were inserted in, and each vertex also records the largest upper bound in its subtree, so"},{"type":"text","text":" "},{"type":"text","text":"a search skips every subtree that ends before the query begins (Cormen, Leiserson, Rivest and"},{"type":"text","text":" "},{"type":"text","text":"Stein, "},{"type":"emphasis","inlineContent":[{"text":"Introduction to Algorithms","type":"text"}]},{"type":"text","text":", §14.3). The same interval may be stored more than once,"},{"type":"text","text":" "},{"type":"text","text":"with different values."}],"type":"paragraph"},{"syntax":"swift","code":["var meetings = IntervalTree<Int, String>()","meetings.insert(9 ..< 10, value: \"stand-up\")","meetings.insert(10 ..< 12, value: \"design review\")","meetings.insert(11 ..< 13, value: \"lunch\")","meetings.containing(11).map(\\.value)          \/\/ [\"design review\", \"lunch\"]","meetings.overlapping(9 ..< 11).map(\\.value)   \/\/ [\"stand-up\", \"design review\"]","meetings.contained(in: 9 ..< 12).map(\\.range) \/\/ [9 ..< 10, 10 ..< 12]"],"type":"codeListing"},{"inlineContent":[{"text":"Intervals are half-open, so ","type":"text"},{"code":"9 ..< 10","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"10 ..< 12","type":"codeVoice"},{"text":" touch without overlapping. As a","type":"text"},{"text":" ","type":"text"},{"text":"collection, the tree’s elements are its entries in that order, read by in-order position.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"An interval tree: a sorted collection of half-open intervals with a value each, which finds the"},{"type":"text","text":" "},{"type":"text","text":"intervals overlapping a range, containing a point, or lying within a range in"},{"type":"text","text":" "},{"type":"text","text":"O(("},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" + 1) log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" results."}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Entry","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Iterator","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/SearchView"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/init(checked:)"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/contained(in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/containing(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(_:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/insert(checked:value:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/overlapping(_:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/remove(_:)"],"generated":true},{"title":"Subscripts","anchor":"Subscripts","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/subscript(checked:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/BidirectionalCollection-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Collection-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/CustomStringConvertible-Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/IntervalTree\/Equatable-Implementations","doc:\/\/RangeTrees\/docum