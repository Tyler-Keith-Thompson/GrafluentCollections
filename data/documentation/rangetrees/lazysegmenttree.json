{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"MonoidAction","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","preciseIdentifier":"s:10RangeTrees12MonoidActionP","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout is "},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","type":"reference","isActive":true},{"type":"text","text":"‘s: a perfect binary tree over the values padded to a power of"},{"type":"text","text":" "},{"type":"text","text":"two, in one flat array of cells. Beside each internal cell sits a pending update, applied to"},{"type":"text","text":" "},{"type":"text","text":"that cell’s value but not yet to the cells below it. A range update applies itself to the"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") cells that cover the range and leaves it pending there, pushing older pending"},{"type":"text","text":" "},{"type":"text","text":"updates down one level on the way so that updates reach each cell in the order they were made."},{"type":"text","text":" "},{"type":"text","text":"A query reads without changing the tree, composing the pending updates of the cells it"},{"type":"text","text":" "},{"type":"text","text":"passes through."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","isActive":true},{"text":" names the monoid and the updates:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update"},{"type":"text","text":" "},{"type":"text","text":"applied."}]}]}],"variants":[{"paths":["\/documentation\/rangetrees\/lazysegmenttree"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s9EscapableP","doc:\/\/RangeTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/RangeTrees\/SH","doc:\/\/RangeTrees\/Sk","doc:\/\/RangeTrees\/s8SendableP","doc:\/\/RangeTrees\/s16SendableMetatypeP","doc:\/\/RangeTrees\/ST"],"type":"conformsTo"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/init(_:)"],"