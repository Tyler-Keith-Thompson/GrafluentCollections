/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","isActive":true,"type":"reference"},{"text":" names the monoid and the updates:","type":"text"}]},{"syntax":"swift","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update","type":"text"},{"text":" ","type":"text"},{"text":"applied.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/rangetrees\/lazysegmenttree"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://RangeTrees/ST":{"identifier":"doc:\/\/RangeTrees\/ST","title":"Swift.Sequence","type":"unresolvable"},"doc://RangeTrees/SK":{"type":"unresolvable","identifier":"doc:\/\/RangeTrees\/SK","title":"Swift.BidirectionalCollection"},"doc://RangeTrees/documentation/RangeTrees/LazySegmentTree/Collection-Implementations":{"kind":"article","type":"topic","abstract":[],"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/Collection-Implementations","title":"Collection Implementations","url":"\/documentation\/rangetrees\/lazysegmenttree\/collection-implementations","role":"collectionGroup"},"doc://RangeTrees/documentation/RangeTrees/LazySegmentTree/apply(_:in:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"apply"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"LazySegmentTree","preciseIdentifier":"s:10RangeTrees15LazySegmentTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","