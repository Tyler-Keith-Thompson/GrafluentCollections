text":" names the monoid and the updates:"}],"type":"paragraph"},{"syntax":"swift","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"],"type":"codeListing"},{"inlineContent":[{"text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update","type":"text"},{"text":" ","type":"text"},{"text":"applied.","type":"text"}],"type":"paragraph"}]}],"sections":[],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/init(_:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/apply(_:checkedIn:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/apply(_:in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/combined(checkedIn:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/combined(in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/update(at:to:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/update(checkedAt:to:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Subscripts","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/subscript(checked:)"],"generated":true,"title":"Subscripts"},{"anchor":"Type-Aliases","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/Element","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/Update"],"generated":t