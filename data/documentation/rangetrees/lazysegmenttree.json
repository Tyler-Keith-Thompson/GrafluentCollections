{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"role":"symbol","remoteSource":{"fileName":"LazySegmentTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/LazySegmentTree.swift#L31"},"title":"LazySegmentTree","symbolKind":"struct","navigatorTitle":[{"text":"LazySegmentTree","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"RangeTrees"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"}],"externalID":"s:10RangeTrees15LazySegmentTreeV"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},"abstract":[{"text":"A segment tree with lazy propagation: a sequence of values that combines any range of them","type":"text"},{"text":" ","type":"text"},{"text":"under a monoid and applies an update to every value in a range, each in O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":").","type":"text"}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"kind":"symbol","seeAlsoSections":[{"anchor":"Segment-trees","generated":true,"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"],"title":"Segment trees"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s9EscapableP","doc:\/\/RangeTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/RangeTrees\/SH","doc:\/\/RangeTrees\/Sk","doc:\/\/RangeTrees\/s8SendableP","doc:\/\/RangeTrees\/s16SendableMetatypeP","doc:\/\/RangeTrees\/ST"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazySegmentTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:10RangeTrees12MonoidActionP","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","kind":"typeIdentifier","text":"MonoidAction"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The layout is ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","type":"reference","isActive":true},{"text":"‘s: a perfect binary tree over the values padded to a power of","type":"text"},{"text":" ","type":"text"},{"text":"two, in one flat array of cells. Beside each internal cell sits a pending update, applied to","type":"text"},{"text":" ","type":"text"},{"text":"that cell’s value but not yet to the cells below it. A range update applies itself to the","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") cells that cover the range and leaves it pending there, pushing older pending","type":"text"},{"text":" ","type":"text"},{"text":"updates down one level on the way so that updates reach each cell in the order they were made.","type":"text"},{"text":" ","type":"text"},{"text":"A query reads without changing the tree, composing the pending updates of the cells it","type":"text"},{"text":" ","type":"text"},{"text":"passes through.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"text":" names the monoid and the updates:","type":"text"}]},{"type":"codeListing","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update","type":"text"},{"text":" ","type":"text"},{"text":"applied.","type":"text"}]}]}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/init()","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/init(_:)"],"title":"Initializers"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/apply(_:checkedIn:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/apply(_:in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/combined(checkedIn:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/combined(in:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/update(at:to:)","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/update(checkedAt:to:)"],"title":"Instance Methods"},{"anchor":"Subscripts","generated":true,"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/subscript(checked:)"],"title":"Subscripts"},{"anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/Element","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/Update"],"title":"Type Aliases"},{"anchor":"