{"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A segment tree with lazy propagation: a sequence of values that combines any range of them"},{"type":"text","text":" "},{"type":"text","text":"under a monoid and applies an update to every value in a range, each in O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":")."}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"],"title":"Segment trees","generated":true,"anchor":"Segment-trees"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazySegmentTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:10RangeTrees12MonoidActionP","kind":"typeIdentifier","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","text":"MonoidAction"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout is "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true},{"type":"text","text":"‘s: a perfect binary tree over the values padded to a power of"},{"type":"text","text":" "},{"type":"text","text":"two, in one flat array of cells. Beside each internal cell sits a pending update, applied to"},{"type":"text","text":" "},{"type":"text","text":"that cell’s value but not yet to the cells below it. A range update applies itself to the"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") cells that cover the range and leaves it pending there, pushing older pending"},{"type":"text","text":" "},{"type":"text","text":"updates down one level on the way so that updates reach each cell in the order they were made."},{"type":"text","text":" "},{"type":"text","text":"A query reads without changing the tree, composing the pending updates of the cells it"},{"type":"text","text":" "},{"type":"text","text":"passes through."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"type":"text","text":" names the monoid and the updates:"}]},{"type":"codeListing","syntax":"swift","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update"},{"type":"text","text":" "},{"type":"text","text":"applied."}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s9EscapableP","doc:\/\/RangeTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/RangeTrees\/SH","doc:\