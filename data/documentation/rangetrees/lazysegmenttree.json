Implementations","doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/Sequence-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s9EscapableP","doc:\/\/RangeTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/RangeTrees\/SH","doc:\/\/RangeTrees\/Sk","doc:\/\/RangeTrees\/s8SendableP","doc:\/\/RangeTrees\/s16SendableMetatypeP","doc:\/\/RangeTrees\/ST"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"MonoidAction","kind":"typeIdentifier","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","preciseIdentifier":"s:10RangeTrees12MonoidActionP"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout is "},{"isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","type":"reference"},{"type":"text","text":"‘s: a perfect binary tree over the values padded to a power of"},{"type":"text","text":" "},{"type":"text","text":"two, in one flat array of cells. Beside each internal cell sits a pending update, applied to"},{"type":"text","text":" "},{"type":"text","text":"that cell’s value but not yet to the cells below it. A range update applies itself to the"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") cells that cover the range and leaves it pending there, pushing older pending"},{"type":"text","text":" "},{"type":"text","text":"updates down one level on the way so that updates reach each cell in the order they were made."},{"type":"text","text":" "},{"type":"text","text":"A query reads without changing the tree, composing the pending updates of the cells it"},{"type":"text","text":" "},{"type":"text","text":"passes through."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","isActive":true},{"type":"text","text":" names the monoid and the updates:"}]},{"type":"codeListing","syntax":"swift","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update"},{"type":"text","text":" "},{"type":"text","text":"applied."}]}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"anchor":"Segment-trees","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"],"title":"Segment trees"}],"variants":[{"paths":["\/documentation\/rangetrees\/lazysegmenttree"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"A segment tree with lazy propagation: a sequence of values that combines any range of them"},{"type":"text","text":" "},{"type":"text","text":"under a monoid and applies an update to every value in a range, each in O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}],"metadata":{"remoteSource":{"fileName":"LazySegmentTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/LazySegmentTree.swift#L31"},"modules":[{"name":"RangeTrees"}],"role":"symbol","externalID":"s:10RangeTrees15LazySegmentTreeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"LazySegmentTree"}],"title":"LazySegmentTree"},"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","interfaceLanguage":"swift"},"references":{"doc://RangeTrees/documentation/RangeTrees/LazySegmentTree/combined(checkedIn:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/combined(checkedIn:)","title":"combined(checkedIn:)","abstract":[{"text":"The values whose indices lie in ","type":"text"},{"code":"range","type":"codeVoice"},{"text":", combined in index order, throwing instead of","type":"text"},{"text":" ","type":"text"},{"text":"trapping on an invalid range.","type":"text"}],"kind":"symbol","url":"\/documentation\/rangetrees\/lazysegmenttree\/combined(checkedin:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"combined","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Range","kind":"typeIdentifier","preciseIdentifier":"s:Sn"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"kind":"text","te