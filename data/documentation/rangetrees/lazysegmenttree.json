ySegmentTree\/Sequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","text":"MonoidAction","preciseIdentifier":"s:10RangeTrees12MonoidActionP","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The layout is ","type":"text"},{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree","isActive":true,"type":"reference"},{"text":"‘s: a perfect binary tree over the values padded to a power of","type":"text"},{"text":" ","type":"text"},{"text":"two, in one flat array of cells. Beside each internal cell sits a pending update, applied to","type":"text"},{"text":" ","type":"text"},{"text":"that cell’s value but not yet to the cells below it. A range update applies itself to the","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") cells that cover the range and leaves it pending there, pushing older pending","type":"text"},{"text":" ","type":"text"},{"text":"updates down one level on the way so that updates reach each cell in the order they were made.","type":"text"},{"text":" ","type":"text"},{"text":"A query reads without changing the tree, composing the pending updates of the cells it","type":"text"},{"text":" ","type":"text"},{"text":"passes through.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction","type":"reference"},{"text":" names the monoid and the updates:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update"},{"type":"text","text":" "},{"type":"text","text":"applied."}]}]}],"metadata":{"modules":[{"name":"RangeTrees"}],"symbolKind":"struct","title":"LazySegmentTree","externalID":"s:10RangeTrees15LazySegmentTreeV","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"}],"remoteSource":{"fileName":"LazySegmentTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/LazySegmentTree.swift#L31"},"role":"symbol","navigatorTitle":[{"text":"LazySegmentTree","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"abstract":[{"text":"A segment tree with lazy propagation: a sequence of values that combines any range of them","type":"text"},{"text":" ","type":"text"},{"text":"under