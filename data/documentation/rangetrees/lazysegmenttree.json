{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree"},"sections":[],"variants":[{"paths":["\/documentation\/rangetrees\/lazysegmenttree"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazySegmentTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"MonoidAction","preciseIdentifier":"s:10RangeTrees12MonoidActionP","kind":"typeIdentifier","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"},{"type":"text","text":"‘s: a perfect binary tree over the values padded to a power of"},{"type":"text","text":" "},{"type":"text","text":"two, in one flat array of cells. Beside each internal cell sits a pending update, applied to"},{"type":"text","text":" "},{"type":"text","text":"that cell’s value but not yet to the cells below it. A range update applies itself to the"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") cells that cover the range and leaves it pending there, pushing older pending"},{"type":"text","text":" "},{"type":"text","text":"updates down one level on the way so that updates reach each cell in the order they were made."},{"type":"text","text":" "},{"type":"text","text":"A query reads without changing the tree, composing the pending updates of the cells it"},{"type":"text","text":" "},{"type":"text","text":"passes through."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"type":"text","text":" names the monoid and the updates:"}]},{"type":"codeListing","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update","type":"text"},{"text":" ","type":"text"},{"text":"applied.","type":"text"}]}]}],"metadata":{"externalID":"s:10RangeTrees15LazySegmentTreeV","symbolKind":"struct","title":"LazySegmentTree","roleHeading":"Structure","navigatorTitle":[{"text":"LazySegmentTree","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/LazySegmentTree.swift#L31","fileName":"LazySegmentTree.swift"},"role":"symbol","modules":[{"name":"RangeTrees"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazySegmentTree"}]},"relationshipsSections":[{"identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23Custo