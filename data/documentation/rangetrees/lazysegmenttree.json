umentation\/rangetrees\/lazysegmenttree"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazySegmentTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"MonoidAction","preciseIdentifier":"s:10RangeTrees12MonoidActionP","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The layout is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/SegmentTree"},{"type":"text","text":"‘s: a perfect binary tree over the values padded to a power of"},{"type":"text","text":" "},{"type":"text","text":"two, in one flat array of cells. Beside each internal cell sits a pending update, applied to"},{"type":"text","text":" "},{"type":"text","text":"that cell’s value but not yet to the cells below it. A range update applies itself to the"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") cells that cover the range and leaves it pending there, pushing older pending"},{"type":"text","text":" "},{"type":"text","text":"updates down one level on the way so that updates reach each cell in the order they were made."},{"type":"text","text":" "},{"type":"text","text":"A query reads without changing the tree, composing the pending updates of the cells it"},{"type":"text","text":" "},{"type":"text","text":"passes through."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction"},{"type":"text","text":" names the monoid and the updates:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}","","var tree = LazySegmentTree<AddToSum>([1, 2, 3, 4, 5])","tree.apply(10, in: 1 ..< 4)","tree.combined(in: 0 ..< 5)   \/\/ 45","tree[2]                      \/\/ 13"]},{"inlineContent":[{"type":"text","text":"As a collection, a lazy segment tree’s elements are the values, in order, with every update"},{"type":"text","text":" "},{"type":"text","text":"applied."}],"type":"paragraph"}]}],"references":{"doc://RangeTrees/documentation/RangeTrees/LazySegmentTree/combined(checkedIn:)":{"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree\/combined(checkedIn:)","type":"topic","url":"\/documentation\/rangetrees\/lazysegmenttree\/combined(checkedin:)","role":"symbol","abstract":[{"type":"text","text":"The values whose indices lie in "},{"type":"codeVoice","code":"range"},{"type":"text","text":", combined in index order, throwing instead of"},{"type":"text","text":" "},{"type":"text","text":"trapping on an invalid range."}],"kind":"symbol","title":"combined(checkedIn:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"combined"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checkedIn"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sn","kind":"typeIdentifier","text":"Range"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","te