{"abstract":[{"type":"text","text":"Updates that act on the values of a monoid, for "},{"type":"reference","identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","isActive":true},{"type":"text","text":": a monoid of updates"},{"type":"text","text":" "},{"type":"text","text":"under composition, each mapping a combined value of a run of elements to the combined value"},{"type":"text","text":" "},{"type":"text","text":"after the update is applied to every element of the run."}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MonoidAction","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["\/\/ Add a constant to every value in a range, reading back sums.","enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The laws, for updates "},{"type":"codeVoice","code":"f"},{"type":"text","text":", "},{"type":"codeVoice","code":"g"},{"type":"text","text":", combined values "},{"type":"codeVoice","code":"x"},{"type":"text","text":", "},{"type":"codeVoice","code":"y"},{"type":"text","text":" of runs of "},{"type":"codeVoice","code":"m"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n"},{"type":"text","text":" elements:"},{"type":"text","text":" "},{"type":"codeVoice","code":"apply(identity, to: x, count: m) == x"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"apply(compose(f, g), to: x, count: m) == apply(f, to: apply(g, to: x, count: m), count: m)"},{"type":"text","text"