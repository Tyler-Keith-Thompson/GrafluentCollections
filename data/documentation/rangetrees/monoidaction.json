 range, reading back sums.","enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The laws, for updates "},{"code":"f","type":"codeVoice"},{"type":"text","text":", "},{"code":"g","type":"codeVoice"},{"type":"text","text":", combined values "},{"code":"x","type":"codeVoice"},{"type":"text","text":", "},{"code":"y","type":"codeVoice"},{"type":"text","text":" of runs of "},{"code":"m","type":"codeVoice"},{"type":"text","text":" and "},{"code":"n","type":"codeVoice"},{"type":"text","text":" elements:"},{"type":"text","text":" "},{"code":"apply(identity, to: x, count: m) == x","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"code":"apply(compose(f, g), to: x, count: m) == apply(f, to: apply(g, to: x, count: m), count: m)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"code":"apply(f, to: combine(x, y), count: m + n) == combine(apply(f, to: x, count: m), apply(f, to: y, count: n))","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees\/monoidaction"]}],"topicSections":[{"generated":true,"title":"Associated Types","anchor":"Associated-Types","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction\/Update","doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction\/Values"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/MonoidAction\/identity"]},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTree