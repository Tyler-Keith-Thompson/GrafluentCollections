,{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"codeListing","syntax":"swift","code":["\/\/ Add a constant to every value in a range, reading back sums.","enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}"]},{"type":"paragraph","inlineContent":[{"text":"The laws, for updates ","type":"text"},{"code":"f","type":"codeVoice"},{"text":", ","type":"text"},{"code":"g","type":"codeVoice"},{"text":", combined values ","type":"text"},{"code":"x","type":"codeVoice"},{"text":", ","type":"text"},{"code":"y","type":"codeVoice"},{"text":" of runs of ","type":"text"},{"code":"m","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" elements:","type":"text"},{"text":" ","type":"text"},{"code":"apply(identity, to: x, count: m) == x","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"apply(compose(f, g), to: x, count: m) == apply(f, to: apply(g, to: x, count: m), count: m)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"apply(f, to: combine(x, y), count: m + n) == combine(apply(f, to: x, count: m), apply(f, to: y, count: n))","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees\/monoidaction"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Updates that act on the values of a monoid, for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/RangeTrees\/documentation\/RangeTrees\/LazySegmentTree","type":"reference"},{"text":": a monoid of updates","type":"text"},{"text":" ","type":"text"},{"text":"under composition, each mapping a combined value of a run of elements to the combined v