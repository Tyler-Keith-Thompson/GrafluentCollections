ages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"code":["\/\/ Add a constant to every value in a range, reading back sums.","enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The laws, for updates ","type":"text"},{"type":"codeVoice","code":"f"},{"text":", ","type":"text"},{"type":"codeVoice","code":"g"},{"text":", combined values ","type":"text"},{"type":"codeVoice","code":"x"},{"text":", ","type":"text"},{"type":"codeVoice","code":"y"},{"text":" of runs of ","type":"text"},{"type":"codeVoice","code":"m"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"n"},{"text":" elements:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"apply(identity, to: x, count: m) == x"},{"text":";","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"apply(compose(f, g), to: x, count: m) == apply(f, to: apply(g, to: x, count: m), count: m)"},{"text":";","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"apply(f, to: combine(x, y), count: m + n) == combine(apply(f, to: x, count: m), apply(f, to: y, count: n))"},{"text":".","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rangetrees\/monoidaction"]}],"metadata":{"externalID":"s:10RangeTrees12MonoidActionP","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MonoidAction"}],"remoteSource":{"fileName":"Monoid.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/RangeTrees\/Monoid.swift#L72"},"roleHeading":"Protocol","title