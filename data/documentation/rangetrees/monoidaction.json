{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MonoidAction","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"code":["\/\/ Add a constant to every value in a range, reading back sums.","enum AddToSum: MonoidAction {","    typealias Values = Sum<Int>","    static var identity: Int { 0 }","    static func compose(_ outer: Int, _ inner: Int) -> Int { outer + inner }","    static func apply(_ update: Int, to sum: Int, count: Int) -> Int { sum + update * count }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The laws, for updates ","type":"text"},{"code":"f","type":"codeVoice"},{"text":", ","type":"text"},{"code":"g","type":"codeVoice"},{"text":", combined values ","type":"text"},{"code":"x","type":"codeVoice"},{"text":", ","type":"text"},{"code":"y","type":"codeVoice"},{"text":" of runs of ","type":"text"},{"code":"m","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" elements:","type":"text"},{"text":" ","type":"text"},{"code":"apply(identity, to: x, count: m) == x","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"apply(compose(f, g), to: x, count: m) == apply(f, to: apply(g, to: x, count: m), count: m)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"apply(f, to: combine(x, y), count: m + n) == combine(apply(f, to: x, count: m), apply(f, to: y, count: n))","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/RangeTrees\/documentation\/RangeTrees"]]},"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MonoidAction","kind":"identifier"}],"roleHeading":"Protocol","symbolKind":"protocol","externalID":"s:10RangeTrees12MonoidActi