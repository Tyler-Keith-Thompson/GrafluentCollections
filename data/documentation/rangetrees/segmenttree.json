 ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":"’s children are 2","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"and 2","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" + 1, and the values are the leaves at ","type":"text"},{"inlineContent":[{"text":"s","type":"text"}],"type":"emphasis"},{"text":" through ","type":"text"},{"inlineContent":[{"text":"s","type":"text"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" − 1. Each cell holds the","type":"text"},{"text":" ","type":"text"},{"text":"combination of the leaves below it (Bentley, 1977). A range query combines the O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"cells that cover it, from both ends upward, keeping the left and right parts apart, so the","type":"text"},{"text":" ","type":"text"},{"text":"operation need not be commutative.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var tree = SegmentTree<Minimum<Int>>([5, 3, 8, 6, 1, 9])","tree.combined(in: 0 ..< 4)                           \/\/ 3","tree.update(at: 2, to: 0)","tree.combined(in: 0 ..< 4)                           \/\/ 0","tree.maxRight(from: 0) { $0 >= 3 }                   \/\/ 2: the minimum of 0 ..< 3 is 0"],"type":"codeListing"},{"inlineContent":[{"text":"As a collection, a segment tree’s elements are the values themselves, in order.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/RangeTrees\/SK","doc:\/\/RangeTrees\/Sl","doc:\/\/RangeTrees\/s8CopyableP","doc:\/\/RangeTrees\/s23CustomStringConvertibleP","doc:\/\/RangeTrees\/Se","doc:\/\/RangeTrees\/SE","doc:\/\/RangeTrees\/SQ","doc:\/\/RangeTrees\/s