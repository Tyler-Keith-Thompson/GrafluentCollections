ower of two,"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":", stored in one flat array of 2"},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" cells: cell 1 is the root, cell "},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":"’s children are 2"},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"and 2"},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" + 1, and the values are the leaves at "},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" through "},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" − 1. Each cell holds the"},{"type":"text","text":" "},{"type":"text","text":"combination of the leaves below it (Bentley, 1977). A range query combines the O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"cells that cover it, from both ends upward, keeping the left and right parts apart, so the"},{"type":"text","text":" "},{"type":"text","text":"operation need not be commutative."}]},{"type":"codeListing","code":["var tree = SegmentTree<Minimum<Int>>([5, 3, 8, 6, 1, 9])","tree.combined(in: 0 ..< 4)                           \/\/ 3","tree.update(at: 2, to: 0)","tree.combined(in: 0 ..< 4)                           \/\/ 0","tree.maxRight(from: 0) { $0 >= 3 }                   \/\/ 2: the minimum of 0 ..< 3 is 0"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a collection, a segment tree’s elements are the values themselves, in order."}]}]}],"topicSections":[{"identifiers":["doc:\/\/RangeTrees\/documentation\/RangeTrees\/