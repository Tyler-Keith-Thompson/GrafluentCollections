{"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Rope","kind":"identifier"}],"externalID":"s:5Ropes4RopeV","modules":[{"name":"Ropes"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Ropes\/Rope.swift#L26","fileName":"Rope.swift"},"role":"symbol","title":"Rope","symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Rope"}]},"sections":[],"abstract":[{"type":"text","text":"A rope: a sequence stored as a balanced tree of chunks, so inserting, removing or replacing"},{"type":"text","text":" "},{"type":"text","text":"elements anywhere costs O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") plus the elements moved within one chunk, rather than the"},{"type":"text","text":" "},{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") an array spends shifting everything after the edit."}],"hierarchy":{"paths":[["doc:\/\/Ropes\/documentation\/Ropes"]]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ropes\/documentation\/Ropes\/Rope"},"topicSections":[{"anchor":"Operators","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/+(_:_:)"],"generated":true,"title":"Operators"},{"anchor":"Initializers","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/init()"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/count"],"generated":true,"title":"Instance Properties"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/append(contentsOf:)-35700","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/extracting(_:)","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/insert(_:at:)","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/insert(contentsOf:at: