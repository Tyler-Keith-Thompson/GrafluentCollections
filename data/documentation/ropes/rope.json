{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ropes\/documentation\/Ropes\/Rope"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"A rope: a sequence stored as a balanced tree of chunks, so inserting, removing or replacing"},{"type":"text","text":" "},{"type":"text","text":"elements anywhere costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") plus the elements moved within one chunk, rather than the"},{"type":"text","text":" "},{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") an array spends shifting everything after the edit."}],"kind":"symbol","topicSections":[{"anchor":"Operators","title":"Operators","generated":true,"identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/+(_:_:)"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/init()"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/count"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/append(contentsOf:)-35700","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/extracting(_:)","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/insert(_:at:)","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/insert(contentsOf:at:)","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/removeSubrange(_:)"]},{"anchor":"Subscripts","title":"Subscripts","generated":true,"identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/subscript(checked:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/BidirectionalCollection-Implementations","doc:\/\/Ropes\/documentation\/Ropes\/Rope\/Collection-Implementations","doc:\/\/Ropes\/documentation\/Ropes\/R