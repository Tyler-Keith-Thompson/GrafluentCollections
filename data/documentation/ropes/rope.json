(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") (Boehm, Atkinson and Plass, “Ropes: an Alternative"},{"type":"text","text":" "},{"type":"text","text":"to Strings”, 1995). Each chunk is its own copy-on-write buffer: a copy of a rope shares every"},{"type":"text","text":" "},{"type":"text","text":"chunk with the original until one of them edits it, and appending one rope to another shares"},{"type":"text","text":" "},{"type":"text","text":"the appended rope’s chunks."}]},{"type":"codeListing","syntax":"swift","code":["var text = Rope(\"Hello, world!\")","text.insert(contentsOf: \"brave new \", at: 7)","String(text)                       \/\/ \"Hello, brave new world!\"","text.removeSubrange(5 ..< 16)","String(text)                       \/\/ \"Hello world!\"","text[6]                            \/\/ \"w\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Indices are offsets from the start, "},{"type":"codeVoice","code":"0 ..< count"},{"type":"text","text":". Reading an element costs O(log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"O(1) amortized over a pass through the rope."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Ropes\/documentation\/Ropes\/Rope","interfaceLanguage":"swift"},"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Ropes\/Rope.swift#L26","fileName":"Rope.swift"},"title":"Rope","roleHeading":"Structure","modules":[{"name":"Ropes"}],"navigatorTitle":[{"text":"Rope","kind":"identifier"}],"symbolKind":"struct","externalID":"s:5Ropes4RopeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Rope","kind":"identifier"}]},"kind":"symbol","references":{"doc://Ropes/SK":{"title":"Swift.BidirectionalCollection","identifier":"doc:\/\/Ropes\/SK","type":"unresolvable"},"do