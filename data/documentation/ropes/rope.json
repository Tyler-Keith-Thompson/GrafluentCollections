ext":"), and"},{"type":"text","text":" "},{"type":"text","text":"O(1) amortized over a pass through the rope."}]}],"kind":"content"}],"metadata":{"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Rope"}],"externalID":"s:5Ropes4RopeV","title":"Rope","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Rope","kind":"identifier"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Ropes\/Rope.swift#L26","fileName":"Rope.swift"},"modules":[{"name":"Ropes"}],"symbolKind":"struct"},"abstract":[{"type":"text","text":"A rope: a sequence stored as a balanced tree of chunks, so inserting, removing or replacing"},{"type":"text","text":" "},{"type":"text","text":"elements anywhere costs O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") plus the elements moved within one chunk, rather than the"},{"type":"text","text":" "},{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") an array spends shifting everything after the edit."}],"identifier":{"url":"doc:\/\/Ropes\/documentation\/Ropes\/Rope","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Ropes\/documentation\/Ropes"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","topicSections":[{"title":"Operators","anchor":"Operators","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/+(_:_:)"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/init()"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/count"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Ropes\/documentation\/Ropes\/Rope\/append(contentsOf:)-35700","doc:\/\/Ropes\/document