":"text"}],"type":"emphasis"},{"text":") (Boehm, Atkinson and Plass, “Ropes: an Alternative","type":"text"},{"text":" ","type":"text"},{"text":"to Strings”, 1995). Each chunk is its own copy-on-write buffer: a copy of a rope shares every","type":"text"},{"text":" ","type":"text"},{"text":"chunk with the original until one of them edits it, and appending one rope to another shares","type":"text"},{"text":" ","type":"text"},{"text":"the appended rope’s chunks.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var text = Rope(\"Hello, world!\")","text.insert(contentsOf: \"brave new \", at: 7)","String(text)                       \/\/ \"Hello, brave new world!\"","text.removeSubrange(5 ..< 16)","String(text)                       \/\/ \"Hello world!\"","text[6]                            \/\/ \"w\""]},{"inlineContent":[{"text":"Indices are offsets from the start, ","type":"text"},{"code":"0 ..< count","type":"codeVoice"},{"text":". Reading an element costs O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"O(1) amortized over a pass through the rope.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"text":"A rope: a sequence stored as a balanced tree of chunks, so inserting, removing or replacing","type":"text"},{"text":" ","type":"text"},{"text":"elements anywhere costs O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") plus the elements moved within one chunk, rather than the","type":"text"},{"text":" ","type":"text"},{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") an array spends shifting everything after the edit.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Ropes/documentation/Ropes/Rope/RangeReplaceableCollection-Implementations":{"title":"RangeReplaceableCollectio