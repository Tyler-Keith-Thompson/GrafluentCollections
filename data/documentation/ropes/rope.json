text":"the appended rope’s chunks."}]},{"code":["var text = Rope(\"Hello, world!\")","text.insert(contentsOf: \"brave new \", at: 7)","String(text)                       \/\/ \"Hello, brave new world!\"","text.removeSubrange(5 ..< 16)","String(text)                       \/\/ \"Hello world!\"","text[6]                            \/\/ \"w\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Indices are offsets from the start, "},{"type":"codeVoice","code":"0 ..< count"},{"type":"text","text":". Reading an element costs O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"O(1) amortized over a pass through the rope."}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Ropes\/documentation\/Ropes\/Rope","interfaceLanguage":"swift"},"metadata":{"title":"Rope","navigatorTitle":[{"text":"Rope","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Ropes\/Rope.swift#L26","fileName":"Rope.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Rope"}],"modules":[{"name":"Ropes"}],"roleHeading":"Structure","symbolKind":"struct","role":"symbol","externalID":"s:5Ropes4RopeV"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Ropes\/SK","doc:\/\/Ropes\/Sl","doc:\/\/Ropes\/s8CopyableP","doc:\/\/Ropes\/s23CustomStringConvertibleP","doc:\/\/Ropes\/SQ","doc:\/\/Ropes\/s9EscapableP","doc:\/\/Ropes\/s25ExpressibleByArrayLiteralP","doc:\/\/Ropes\/SH","doc:\/\/Ropes\/SM","doc:\/\/Ropes\/Sk","doc:\/\/Ropes\/Sm","doc:\/\/Ropes\/s8SendableP","doc:\/\/Ropes\/s16SendableMetatypeP","doc:\/\/Ropes\/ST"]}],"references":{"doc://Ropes/Sm":{"identifier":"doc:\/\/Ropes\/Sm","type":"unresolvable","title":"Swift.RangeReplaceableCollection"},