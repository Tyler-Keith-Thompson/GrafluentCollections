{"variants":[{"paths":["\/documentation\/skiplists"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/SkipLists\/documentation\/SkipLists","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","isActive":true,"type":"reference"},{"text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in","type":"text"},{"text":" ","type":"text"},{"text":"levels, each level a random sample of the one below, searched from the top level down. Each","type":"text"},{"text":" ","type":"text"},{"text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") expected time with no rebalancing. Its elements are a random-access collection in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the API matches the sorted sets of ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation; a seeded one makes every"},{"type":"text","text":" "},{"type":"text","text":"list reproducible. The list’s levels are a directed acyclic graph, which"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","isActive":true},{"type":"text","text":" exposes to Grafluent’s algorithms and drawings as a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" "},{"type":"text","text":"(import Grafluent’s "},{"type":"codeVoice","code":"GraphProtocols"},{"type":"text","text":" module beside this one): a vertex for each element on each"},{"type":"text","text":" "},{"type":"text","text":"level of its tower, an edge along each level and an edge down each tower."}]}],"kind":"content"}],"metadata":{"externalID":"SkipLists","role":"collection","symbolKind":"module","modules":[{"name":"SkipLists"}],"roleHeading":"Framework","title":"SkipLists"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"topicSections":[{"anchor":"Sorted-sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"],"title":"Sorted sets"}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"role":"symbol","type":"topic","url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"layersView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9SkipLists0A4ListV","text":"SkipList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","text":"LayersView","kind":"typeIdentifier"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","abstract":[{"text":"The list’s levels as a directed graph: a vertex for each element on each level of its","type":"text"},{"text":" ","type":"text"},{"text":"tower, an edge from each to the next element on the same level, and an edge from each down","type":"text"},{"text":" ","type":"text"},{"text":"to the same element on the level below. The head is not a vertex.","type":"text"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","title":"layersView"},"doc://SkipLists/documentation/SkipLists":{"kind":"symbol","abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"type":"topic","url":"\/documentation\/skiplists","role":"collection","title":"SkipLists","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists"},"doc://SkipLists/documentation/SkipLists/SkipList":{"navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"title":"SkipList","abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","url":"\/documentation\/skiplists\/skiplist","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}]}}}