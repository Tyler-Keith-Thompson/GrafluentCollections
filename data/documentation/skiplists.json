{"abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"sections":[],"metadata":{"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"SkipLists","externalID":"SkipLists","modules":[{"name":"SkipLists"}]},"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"],"anchor":"Sorted-sets"}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"},{"type":"text","text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in"},{"type":"text","text":" "},{"type":"text","text":"levels, each level a random sample of the one below, searched from the top level down. Each"},{"type":"text","text":" "},{"type":"text","text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected time with no rebalancing. Its elements are a random-access collection in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"the API matches the sorted sets of "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"]},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation; a seeded one makes every","type":"text"},{"text":" ","type":"text"},{"text":"list reproducible. The list’s levels are a directed acyclic graph, which","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},{"text":" exposes to Grafluent’s algorithms and drawings as a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":" ","type":"text"},{"text":"(import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"GraphProtocols"},{"text":" module beside this one): a vertex for each element on each","type":"text"},{"text":" ","type":"text"},{"text":"level of its tower, an edge along each level and an edge down each tower.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/skiplists"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SkipLists\/documentation\/SkipLists","interfaceLanguage":"swift"},"references":{"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"title":"layersView","kind":"symbol","abstract":[{"type":"text","text":"The list’s levels as a directed graph: a vertex for each element on each level of its"},{"type":"text","text":" "},{"type":"text","text":"tower, an edge from each to the next element on the same level, and an edge from each down"},{"type":"text","text":" "},{"type":"text","text":"to the same element on the level below. The head is not a vertex."}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"role":"symbol","url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"layersView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListV","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","text":"LayersView"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},"doc://SkipLists/documentation/SkipLists/SkipList":{"type":"topic","abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"kind":"symbol","title":"SkipList","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","url":"\/documentation\/skiplists\/skiplist","navigatorTitle":[{"text":"SkipList","kind":"identifier"}]},"doc://SkipLists/documentation/SkipLists":{"title":"SkipLists","kind":"symbol","abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"role":"collection","url":"\/documentation\/skiplists","type":"topic","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists"}}}