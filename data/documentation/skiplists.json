{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists"},"variants":[{"paths":["\/documentation\/skiplists"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Sorted sets","anchor":"Sorted-sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"]}],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"modules":[{"name":"SkipLists"}],"roleHeading":"Framework","role":"collection","title":"SkipLists","symbolKind":"module","externalID":"SkipLists"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","type":"reference"},{"text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in","type":"text"},{"text":" ","type":"text"},{"text":"levels, each level a random sample of the one below, searched from the top level down. Each","type":"text"},{"text":" ","type":"text"},{"text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") expected time with no rebalancing. Its elements are a random-access collection in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the API matches the sorted sets of ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation; a seeded one makes every"},{"type":"text","text":" "},{"type":"text","text":"list reproducible. The list’s levels are a directed acyclic graph, which"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},{"type":"text","text":" exposes to Grafluent’s algorithms and drawings as a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(import Grafluent’s "},{"code":"GraphProtocols","type":"codeVoice"},{"type":"text","text":" module beside this one): a vertex for each element on each"},{"type":"text","text":" "},{"type":"text","text":"level of its tower, an edge along each level and an edge down each tower."}]}]}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"title":"layersView","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]},"url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"layersView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SkipList","kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"LayersView","kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV"}],"abstract":[{"text":"The list’s levels as a directed graph: a vertex for each element on each level of its","type":"text"},{"text":" ","type":"text"},{"text":"tower, an edge from each to the next element on the same level, and an edge from each down","type":"text"},{"text":" ","type":"text"},{"text":"to the same element on the level below. The head is not a vertex.","type":"text"}]},"doc://SkipLists/documentation/SkipLists/SkipList":{"role":"symbol","navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"kind":"symbol","title":"SkipList","url":"\/documentation\/skiplists\/skiplist","abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}]},"doc://SkipLists/documentation/SkipLists":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","title":"SkipLists","role":"collection","url":"\/documentation\/skiplists","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}]}}}