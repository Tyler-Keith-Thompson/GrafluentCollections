{"sections":[],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"],"title":"Sorted sets","anchor":"Sorted-sets"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","isActive":true,"type":"reference"},{"text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in","type":"text"},{"text":" ","type":"text"},{"text":"levels, each level a random sample of the one below, searched from the top level down. Each","type":"text"},{"text":" ","type":"text"},{"text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") expected time with no rebalancing. Its elements are a random-access collection in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the API matches the sorted sets of ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation; a seeded one makes every"},{"type":"text","text":" "},{"type":"text","text":"list reproducible. The list’s levels are a directed acyclic graph, which"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},{"type":"text","text":" exposes to Grafluent’s algorithms and drawings as a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(import Grafluent’s "},{"code":"GraphProtocols","type":"codeVoice"},{"type":"text","text":" module beside this one): a vertex for each element on each"},{"type":"text","text":" "},{"type":"text","text":"level of its tower, an edge along each level and an edge down each tower."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skiplists"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists"},"kind":"symbol","metadata":{"role":"collection","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"SkipLists"}],"title":"SkipLists","externalID":"SkipLists"},"references":{"doc://SkipLists/documentation/SkipLists":{"role":"collection","abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","kind":"symbol","title":"SkipLists","type":"topic","url":"\/documentation\/skiplists"},"doc://SkipLists/documentation/SkipLists/SkipList":{"role":"symbol","navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","fragmen