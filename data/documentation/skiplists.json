{"abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"topicSections":[{"anchor":"Sorted-sets","title":"Sorted sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"]}],"sections":[],"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"},{"type":"text","text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in"},{"type":"text","text":" "},{"type":"text","text":"levels, each level a random sample of the one below, searched from the top level down. Each"},{"type":"text","text":" "},{"type":"text","text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected time with no rebalancing. Its elements are a random-access collection in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"the API matches the sorted sets of "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"]},{"inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation; a seeded one makes every"},{"type":"text","text":" "},{"type":"text","text":"list reproducible. The list’s levels are a directed acyclic graph, which"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","isActive":true},{"type":"text","text":" exposes to Grafluent’s algorithms and drawings as a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" "},{"type":"text","text":"(import Grafluent’s "},{"type":"codeVoice","code":"GraphProtocols"},{"type":"text","text":" module beside this one): a vertex for each element on each"},{"type":"text","text":" "},{"type":"text","text":"level of its tower, an edge along each level and an edge down each tower."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skiplists"]}],"metadata":{"roleHeading":"Framework","externalID":"SkipLists","modules":[{"name":"SkipLists"}],"role":"collection","title":"SkipLists","symbolKind":"module"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SkipLists/documentation/SkipLists":{"url":"\/documentation\/skiplists","title":"SkipLists","abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"role":"collection","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","kind":"symbol","type":"topic"},"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"layersView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9SkipLists0A4ListV","text":"SkipList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","text":"LayersView","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"The list’s levels as a directed graph: a vertex for each element on each level of its"},{"type":"text","text":" "},{"type":"text","text":"tower, an edge from each to the next element on the same level, and an edge from each down"},{"type":"text","text":" "},{"type":"text","text":"to the same element on the level below. The head is not a vertex."}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","kind":"symbol","title":"layersView","role":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}]}},"doc://SkipLists/documentation/SkipLists/SkipList":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}],"navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"url":"\/documentation\/skiplists\/skiplist","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","role":"symbol","title":"SkipList","abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}]}}}