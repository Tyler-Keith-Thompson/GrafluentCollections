{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","type":"reference","isActive":true},{"text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in","type":"text"},{"text":" ","type":"text"},{"text":"levels, each level a random sample of the one below, searched from the top level down. Each","type":"text"},{"text":" ","type":"text"},{"text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time with no rebalancing. Its elements are a random-access collection in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, indexed by rank, with ","type":"text"},{"type":"codeVoice","code":"lowerBound(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"upperBound(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"elements(in:)"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the API matches the sorted sets of ","type":"text"},{"type":"codeVoice","code":"BinarySearchTrees"},{"text":".","type":"text"}]},{"type":"codeListing","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation; a seeded one makes every"},{"type":"text","text":" "},{"type":"text","text":"list reproducible. The list’s levels are a directed acyclic graph, which"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},{"type":"text","text":" exposes to Grafluent’s algorithms and drawings as a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(import Grafluent’s "},{"code":"GraphProtocols","type":"codeVoice"},{"type":"text","text":" module beside this one): a vertex for each element on each"},{"type":"text","text":" "},{"type":"text","text":"level of its tower, an edge along each level and an edge down each tower."}]}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"],"anchor":"Sorted-sets"}],"variants":[{"paths":["\/documentation\/skiplists"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SkipLists\/documentation\/SkipLists","interfaceLanguage":"swift"},"metadata":{"title":"SkipLists","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"SkipLists"}],"role":"collection","externalID":"SkipLists"},"hierarchy":{"paths":[[]]},"references":{"doc://SkipLists/documentation/SkipLists/SkipList":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","title":"SkipList","role":"symbol","kind":"symbol","url":"\/documentation\/skiplists\/skiplist","abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SkipList"}]},"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","title":"layersView","role":"symbol","kind":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}]},"url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","abstract":[{"type":"text","text":"The list’s levels as a directed graph: a vertex for each element on each level of its"},{"type":"text","text":" "},{"type":"text","text":"tower, an edge from each to the next element on the same level, and an edge from each down"},{"type":"text","text":" "},{"type":"text","text":"to the same element on the level below. The head is not a vertex."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"layersView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListV","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","text":"LayersView"}],"type":"topic"},"doc://SkipLists/documentation/SkipLists":{"type":"topic","role":"collection","abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"title":"SkipLists","url":"\/documentation\/skiplists","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","kind":"symbol"}}}