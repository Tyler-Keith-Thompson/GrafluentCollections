{"identifier":{"url":"doc:\/\/SkipLists\/documentation\/SkipLists","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"anchor":"Sorted-sets","title":"Sorted sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"]}],"metadata":{"modules":[{"name":"SkipLists"}],"title":"SkipLists","role":"collection","externalID":"SkipLists","roleHeading":"Framework","symbolKind":"module"},"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/skiplists"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","isActive":true},{"type":"text","text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in"},{"type":"text","text":" "},{"type":"text","text":"levels, each level a random sample of the one below, searched from the top level down. Each"},{"type":"text","text":" "},{"type":"text","text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected time with no rebalancing. Its elements are a random-access collection in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"the API matches the sorted sets of "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation; a seeded one makes every"},{"type":"text","text":" "},{"type":"text","text":"list reproducible. The list’s levels are a directed acyclic graph, which"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},{"type":"text","text":" exposes to Grafluent’s algorithms and drawings as a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" "},{"type":"text","text":"(import Grafluent’s "},{"type":"codeVoice","code":"GraphProtocols"},{"type":"text","text":" module beside this one): a vertex for each element on each"},{"type":"text","text":" "},{"type":"text","text":"level of its tower, an edge along each level and an edge down each tower."}]}]}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","title":"SkipList","role":"symbol","url":"\/documentation\/skiplists\/skiplist","type":"topic","kind":"symbol","abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"navigatorTitle":[{"text":"SkipList","kind":"identifier"}]},"doc://SkipLists/documentation/SkipLists":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","title":"SkipLists","role":"collection","url":"\/documentation\/skiplists","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}]},"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"layersView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SkipList","preciseIdentifier":"s:9SkipLists0A4ListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"LayersView","preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The list’s levels as a directed graph: a vertex for each element on each level of its"},{"type":"text","text":" "},{"type":"text","text":"tower, an edge from each to the next element on the same level, and an edge from each down"},{"type":"text","text":" "},{"type":"text","text":"to the same element on the level below. The head is not a vertex."}],"url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","title":"layersView","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}]},"kind":"symbol","type":"topic","role":"symbol"}}}