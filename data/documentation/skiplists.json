{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists"},"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"],"anchor":"Sorted-sets"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","type":"reference"},{"text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in","type":"text"},{"text":" ","type":"text"},{"text":"levels, each level a random sample of the one below, searched from the top level down. Each","type":"text"},{"text":" ","type":"text"},{"text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") expected time with no rebalancing. Its elements are a random-access collection in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the API matches the sorted sets of ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation; a seeded one makes every","type":"text"},{"text":" ","type":"text"},{"text":"list reproducible. The list’s levels are a directed acyclic graph, which","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","type":"reference"},{"text":" exposes to Grafluent’s algorithms and drawings as a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":" ","type":"text"},{"text":"(import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"GraphProtocols"},{"text":" module beside this one): a vertex for each element on each","type":"text"},{"text":" ","type":"text"},{"text":"level of its tower, an edge along each level and an edge down each tower.","type":"text"}]}]}],"sections":[],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skiplists"]}],"kind":"symbol","abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"collection","symbolKind":"module","modules":[{"name":"SkipLists"}],"title":"SkipLists","externalID":"SkipLists","roleHeading":"Framework"},"references":{"doc://SkipLists/documentation/SkipLists":{"kind":"symbol","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","type":"topic","url":"\/documentation\/skiplists","title":"SkipLists","role":"collection","abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}]},"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","title":"layersView","abstract":[{"type":"text","text":"The list’s levels as a directed graph: a vertex for each element on each level of its"},{"type":"text","text":" "},{"type":"text","text":"tower, an edge from each to the next element on the same level, and an edge from each down"},{"type":"text","text":" "},{"type":"text","text":"to the same element on the level below. The head is not a vertex."}],"role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"layersView"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9SkipLists0A4ListV","kind":"typeIdentifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":">."},{"preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","kind":"typeIdentifier","text":"LayersView"}],"conformance":{"constraints":[{"code":"Element","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}},"doc://SkipLists/documentation/SkipLists/SkipList":{"kind":"symbol","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","navigatorTitle":[{"kind":"identifier","text":"SkipList"}],"type":"topic","url":"\/documentation\/skiplists\/skiplist","title":"SkipList","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"}],"abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}]}}}