nsert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation; a seeded one makes every"},{"type":"text","text":" "},{"type":"text","text":"list reproducible. The list’s levels are a directed acyclic graph, which"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},{"type":"text","text":" exposes to Grafluent’s algorithms and drawings as a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" "},{"type":"text","text":"(import Grafluent’s "},{"type":"codeVoice","code":"GraphProtocols"},{"type":"text","text":" module beside this one): a vertex for each element on each"},{"type":"text","text":" "},{"type":"text","text":"level of its tower, an edge along each level and an edge down each tower."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"externalID":"SkipLists","modules":[{"name":"SkipLists"}],"roleHeading":"Framework","symbolKind":"module","title":"SkipLists","role":"collection"},"references":{"doc://SkipLists/documentation/SkipLists/SkipList":{"navigatorTitle":[{"kind":"identifier","text":"SkipList"}],"kind":"symbol","url":"\/documentation\/skiplists\/skiplist","type":"topic","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"role":"symbol","title":"SkipList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"}]},"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"layersView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SkipList","preciseIdentifier":"s:9SkipLists0A4ListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"LayersView","preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","kind":"typeIdentifier"}],"abstract":[{"text":"The list’s levels as a directed graph: a vertex for each element on each level of its","type":"text"},{"text":" ","type":"text"},{"text":"tower, an edge from each to the next element on the same level, and an edge from each down","type":"text"},{"text":" ","type":"text"},{"text":"to the same element on the level below. The head is not a vertex.","type":"text"}],"title":"layersView","conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","type":"topic"},"doc://SkipLists/documentation/SkipLists":{"kind":"symbol","url":"\/documentation\/skiplists","type":"topic","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"role":"collection","title":"SkipLists"}}}