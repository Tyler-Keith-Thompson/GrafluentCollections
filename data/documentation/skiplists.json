"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"]},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation; a seeded one makes every","type":"text"},{"text":" ","type":"text"},{"text":"list reproducible. The list’s levels are a directed acyclic graph, which","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","isActive":true},{"text":" exposes to Grafluent’s algorithms and drawings as a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(import Grafluent’s ","type":"text"},{"code":"GraphProtocols","type":"codeVoice"},{"text":" module beside this one): a vertex for each element on each","type":"text"},{"text":" ","type":"text"},{"text":"level of its tower, an edge along each level and an edge down each tower.","type":"text"}]}],"kind":"content"}],"references":{"doc://SkipLists/documentation/SkipLists":{"url":"\/documentation\/skiplists","kind":"symbol","type":"topic","role":"collection","abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","title":"SkipLists"},"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"layersView"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9SkipLists0A4ListV","kind":"typeIdentifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":">."},{"preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","kind":"typeIdentifier","text":"LayersView"}],"abstract":[{"type":"text","text":"The list’s levels as a directed graph: a vertex for each element on each level of its"},{"type":"text","text":" "},{"type":"text","text":"tower, an edge from each to the next element on the same level, and an edge from each down"},{"type":"text","text":" "},{"type":"text","text":"to the same element on the level below. The head is not a vertex."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"title":"layersView","role":"symbol"},"doc://SkipLists/documentation/SkipLists/SkipList":{"url":"\/documentation\/skiplists\/skiplist","kind":"symbol","type":"topic","navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","title":"SkipList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}]}}}