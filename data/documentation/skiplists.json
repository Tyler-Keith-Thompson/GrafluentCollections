{"topicSections":[{"title":"Sorted sets","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"],"anchor":"Sorted-sets"}],"metadata":{"symbolKind":"module","roleHeading":"Framework","title":"SkipLists","externalID":"SkipLists","role":"collection","modules":[{"name":"SkipLists"}]},"variants":[{"paths":["\/documentation\/skiplists"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SkipLists\/documentation\/SkipLists","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"},{"type":"text","text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in"},{"type":"text","text":" "},{"type":"text","text":"levels, each level a random sample of the one below, searched from the top level down. Each"},{"type":"text","text":" "},{"type":"text","text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected time with no rebalancing. Its elements are a random-access collection in"},{"type":"text","text":" "},{"type":"text","text":"ascending order, indexed by rank, with "},{"type":"codeVoice","code":"lowerBound(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"upperBound(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"elements(in:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"the API matches the sorted sets of "},{"type":"codeVoice","code":"BinarySearchTrees"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"]},{"inlineContent":[{"text":"The tower heights come from a random number generator given at creation; a seeded one makes every","type":"text"},{"text":" ","type":"text"},{"text":"list reproducible. The list’s levels are a directed acyclic graph, which","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","type":"reference","isActive":true},{"text":" exposes to Grafluent’s algorithms and drawings as a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(import Grafluent’s ","type":"text"},{"code":"GraphProtocols","type":"codeVoice"},{"text":" module beside this one): a vertex for each element on each","type":"text"},{"text":" ","type":"text"},{"text":"level of its tower, an edge along each level and an edge down each tower.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","kind":"symbol","title":"SkipList","navigatorTitle":[{"kind":"identifier","text":"SkipList"}],"url":"\/documentation\/skiplists\/skiplist","type":"topic","abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}]},"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","abstract":[{"text":"The list’s levels as a directed graph: a vertex for each element on each level of its","type":"text"},{"text":" ","type":"text"},{"text":"tower, an edge from each to the next element on the same level, and an edge from each down","type":"text"},{"text":" ","type":"text"},{"text":"to the same element on the level below. The head is not a vertex.","type":"text"}],"title":"layersView","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"layersView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListV","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","text":"LayersView"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Element","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property"},"doc://SkipLists/documentation/SkipLists":{"role":"collection","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","title":"SkipLists","kind":"symbol","type":"topic","url":"\/documentation\/skiplists","abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}]}}}