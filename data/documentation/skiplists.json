{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists"},"topicSections":[{"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"],"anchor":"Sorted-sets","title":"Sorted sets"}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"symbolKind":"module","modules":[{"name":"SkipLists"}],"roleHeading":"Framework","title":"SkipLists","role":"collection","externalID":"SkipLists"},"abstract":[{"text":"Skip lists as sorted sets, with their levels as a directed graph.","type":"text"}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","isActive":true,"type":"reference"},{"text":" is a sorted set kept in a skip list (Pugh, 1990): sorted linked lists stacked in","type":"text"},{"text":" ","type":"text"},{"text":"levels, each level a random sample of the one below, searched from the top level down. Each","type":"text"},{"text":" ","type":"text"},{"text":"element’s tower gains a level with probability 1\/4, so lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time with no rebalancing. Its elements are a random-access collection in","type":"text"},{"text":" ","type":"text"},{"text":"ascending order, indexed by rank, with ","type":"text"},{"code":"lowerBound(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"upperBound(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elements(in:)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the API matches the sorted sets of ","type":"text"},{"code":"BinarySearchTrees","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SkipLists","","var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","numbers.contains(2)     \/\/ false","numbers.lowerBound(5)   \/\/ 3, the index of 5"]},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation; a seeded one makes every","type":"text"},{"text":" ","type":"text"},{"text":"list reproducible. The list’s levels are a directed acyclic graph, which","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","type":"reference","isActive":true},{"text":" exposes to Grafluent’s algorithms and drawings as a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(import Grafluent’s ","type":"text"},{"code":"GraphProtocols","type":"codeVoice"},{"text":" module beside this one): a vertex for each element on each","type":"text"},{"text":" ","type":"text"},{"text":"level of its tower, an edge along each level and an edge down each tower.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/skiplists"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/layersView-swift.property":{"url":"\/documentation\/skiplists\/skiplist\/layersview-swift.property","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"type":"topic","kind":"symbol","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"layersView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SkipList","preciseIdentifier":"s:9SkipLists0A4ListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"LayersView","preciseIdentifier":"s:9SkipLists0A4ListVAASHRzrlE10LayersViewV","kind":"typeIdentifier"}],"abstract":[{"text":"The list’s levels as a directed graph: a vertex for each element on each level of its","type":"text"},{"text":" ","type":"text"},{"text":"tower, an edge from each to the next element on the same level, and an edge from each down","type":"text"},{"text":" ","type":"text"},{"text":"to the same element on the level below. The head is not a vertex.","type":"text"}],"title":"layersView","role":"symbol"},"doc://SkipLists/documentation/SkipLists":{"abstract":[{"type":"text","text":"Skip lists as sorted sets, with their levels as a directed graph."}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/skiplists","title":"SkipLists"},"doc://SkipLists/documentation/SkipLists/SkipList":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","role":"symbol","type":"topic","navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"url":"\/documentation\/skiplists\/skiplist","abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"kind":"symbol","title":"SkipList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}]}}}