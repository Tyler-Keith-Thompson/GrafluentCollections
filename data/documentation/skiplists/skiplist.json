":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"heights as its original."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}]}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/SkipLists\/SK","doc:\/\/SkipLists\/Sl","doc:\/\/SkipLists\/s8CopyableP","doc:\/\/SkipLists\/s23CustomStringConvertibleP","doc:\/\/SkipLists\/Se","doc:\/\/SkipLists\/SE","doc:\/\/SkipLists\/SQ","doc:\/\/SkipLists\/s9EscapableP","doc:\/\/SkipLists\/s25ExpressibleByArrayLiteralP","doc:\/\/SkipLists\/SH","doc:\/\/SkipLists\/Sk","doc:\/\/SkipLists\/s8SendableP","doc:\/\/SkipLists\/s16SendableMetatypeP","doc:\/\/SkipLists\/ST","doc:\/\/SkipLists\/s10SetAlgebraP"],"kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skiplists\/skiplist"]}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/upperBound(_:)":{"role":"symbol","type":"topic","url":"\/documentation\/skiplists\/skiplist\/upperbound(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"upperBound"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"text":"The index of the first element greater than ","type":"text