23CustomStringConvertibleP","doc:\/\/SkipLists\/Se","doc:\/\/SkipLists\/SE","doc:\/\/SkipLists\/SQ","doc:\/\/SkipLists\/s9EscapableP","doc:\/\/SkipLists\/s25ExpressibleByArrayLiteralP","doc:\/\/SkipLists\/SH","doc:\/\/SkipLists\/Sk","doc:\/\/SkipLists\/s8SendableP","doc:\/\/SkipLists\/s16SendableMetatypeP","doc:\/\/SkipLists\/ST","doc:\/\/SkipLists\/s10SetAlgebraP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips","type":"text"},{"text":" ","type":"text"},{"text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time, with no rebalancing. Every link also records how many elements it","type":"text"},{"text":" ","type":"text"},{"text":"passes, so the elements are a random-access collection in ascending order, indexed by rank","type":"text"},{"text":" ","type":"text"},{"text":"like an array: ","type":"text"},{"code":"list[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The elements and their towers live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the list holds fewer","type":"text"},{"text":" ","type":"text"},{"text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/init(_:)":{"abstract":[{"type":"text","text":"The skip list holding the distinct elements of "},{"type":"codeVoice","code":"elements"},{"type":"text","text":", with heights from"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":"; of equal elements, the first is kept."}],"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(_:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"identifi