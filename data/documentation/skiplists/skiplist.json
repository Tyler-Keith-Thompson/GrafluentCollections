tringConvertible-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Decodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Encodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Equatable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Hashable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/RandomAccessCollection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Sequence-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/SetAlgebra-Implementations"],"title":"Default Implementations","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips"},{"type":"text","text":" "},{"type":"text","text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected time, with no rebalancing. Every link also records how many elements it"},{"type":"text","text":" "},{"type":"text","text":"passes, so the elements are a random-access collection in ascending order, indexed by rank"},{"type":"text","text":" "},{"type":"text","text":"like an array: "},{"type":"codeVoice","code":"list[0]"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}]},{"code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"heights as its original."}]},{"type":"paragraph","inlineContent":[{"text":"The elements and their towers live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the list holds fewer","type":"text"},{"text":" ","type":"text"},{"text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SkipLists\/documentation\/SkipLists"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/SkipLists\/SK","doc:\/\/Skip