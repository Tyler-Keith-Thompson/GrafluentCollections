pList\/Decodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Encodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Equatable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Hashable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/RandomAccessCollection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Sequence-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/SetAlgebra-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","externalID":"s:9SkipLists0A4ListV","title":"SkipList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"SkipList"}],"modules":[{"name":"SkipLists"}],"remoteSource":{"fileName":"SkipList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29"}},"identifier":{"url":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips","type":"text"},{"text":" ","type":"text"},{"text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") expected time, with no rebalancing. Every link also records how many elements it","type":"text"},{"text":" ","type":"text"},{"text":"passes, so the elements are a random-access collection in ascending order, indexed by rank","type":"text"},{"text":" ","type":"text"},{"text":"like an array: ","type":"text"},{"code":"list[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"expected, and a pass through the whole collection costs O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":").","type":"text"}]},{"code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/skiplists\/skiplist"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SkipLists\/documentation\/SkipLists"]]},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/SkipLists\/SK","doc:\/\/SkipLists\/Sl","doc:\/\/SkipLists\/s8CopyableP","doc:\/\/SkipLists\/s23CustomStringConvertibleP","doc:\/\/SkipLists\/Se","doc:\/\/SkipLists\/SE","doc:\/\/SkipLists\/SQ","doc:\/\/SkipLists\/s9EscapableP","doc:\/\/SkipLists\/s25ExpressibleByArrayLiteralP","doc:\/\/SkipLists\/SH","doc:\/\/SkipLists\/Sk","doc:\/\/SkipLists\/s8SendableP","doc:\/\/SkipLists\/s16SendableMetatypeP","doc:\/\/SkipLists\/ST","doc:\/\/SkipLists\/s10SetAlgebraP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SkipLists/documentation/SkipLists/SkipList/remove(checkedAt:)":{"abstract":[{"type":"text","text":"Removes and returns the element at "},{"type":"codeVoice","code":"index"},{"type":"text","text":", throwing instead of trapping on an invalid"},{"type":"text","text":" "},{"type":"text","text":"index."}],"type":"topic","title":"remove(checkedAt:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remove","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedAt","kind":"externalParam"},{