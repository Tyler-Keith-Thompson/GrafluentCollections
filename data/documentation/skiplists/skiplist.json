{"sections":[],"metadata":{"modules":[{"name":"SkipLists"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29","fileName":"SkipList.swift"},"navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"symbolKind":"struct","role":"symbol","externalID":"s:9SkipLists0A4ListV","title":"SkipList"},"abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SkipLists\/documentation\/SkipLists"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips"},{"type":"text","text":" "},{"type":"text","text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") expected time, with no rebalancing. Every link also records how many elements it"},{"type":"text","text":" "},{"type":"text","text":"passes, so the elements are a random-access collection in ascending order, indexed by rank"},{"type":"text","text":" "},{"type":"text","text":"like an array: "},{"type":"codeVoice","code":"list[0]"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"expected, and a pass through the whole collection costs O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":")."}],"type":"paragraph"},{"code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/SkipLists\/documentation\/Ski