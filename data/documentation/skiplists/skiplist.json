omStringConvertible-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Decodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Encodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Equatable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Hashable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/RandomAccessCollection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Sequence-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/SetAlgebra-Implementations"]}],"variants":[{"paths":["\/documentation\/skiplists\/skiplist"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SkipLists\/documentation\/SkipLists"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/SkipLists\/SK","doc:\/\/SkipLists\/Sl","doc:\/\/SkipLists\/s8CopyableP","doc:\/\/SkipLists\/s23CustomStringConvertibleP","doc:\/\/SkipLists\/Se","doc:\/\/SkipLists\/SE","doc:\/\/SkipLists\/SQ","doc:\/\/SkipLists\/s9EscapableP","doc:\/\/SkipLists\/s25ExpressibleByArrayLiteralP","doc:\/\/SkipLists\/SH","doc:\/\/SkipLists\/Sk","doc:\/\/SkipLists\/s8SendableP","doc:\/\/SkipLists\/s16SendableMetatypeP","doc:\/\/SkipLists\/ST","doc:\/\/SkipLists\/s10SetAlgebraP"]}],"abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"},"metadata":{"role":"symbol","navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29","fileName":"SkipList.swift"},"externalID":"s:9SkipLists0A4ListV","modules":[{"name":"SkipLists"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}],"title":"SkipList","roleHeading":"Structure"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips"},{"type":"text","text":" "},{"type":"text","text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected time, with no rebalancing. Every link also records how many elements it"},{"type":"text","text":" "},{"type":"text","text":"passes, so the elements are a random-access collection in ascending order, indexed by rank"},{"type":"text","text":" "},{"type":"text","text":"like an array: "},{"code":"list[0]","type":"codeVoice"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}]},{"type":"codeListing","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"heights as its original."}]},{"type":"paragraph","inlineContent":[{"text":"The elements and their towers live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the list holds fewer","type":"text"},{"text":" ","type":"text"},{"text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}]}],"kind":"content"}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/remove(checkedAt:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remove","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:16CollectionErrors15IndexOutOfRangeV","text":"IndexOutOfRang