pLists\/SkipList\/remove(at:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/remove(checkedAt:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/upperBound(_:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/subscript(checked:)"],"anchor":"Subscripts","title":"Subscripts","generated":true},{"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/BidirectionalCollection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Collection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/CustomStringConvertible-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Decodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Encodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Equatable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Hashable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/RandomAccessCollection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Sequence-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/SetAlgebra-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"relationshipsSections":[{"identifiers":["doc:\/\/SkipLists\/SK","doc:\/\/SkipLists\/Sl","doc:\/\/SkipLists\/s8CopyableP","doc:\/\/SkipLists\/s23CustomStringConvertibleP","doc:\/\/SkipLists\/Se","doc:\/\/SkipLists\/SE","doc:\/\/SkipLists\/SQ","doc:\/\/SkipLists\