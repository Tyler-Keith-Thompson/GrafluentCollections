":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"]},{"inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The elements and their towers live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the list holds fewer","type":"text"},{"text":" ","type":"text"},{"text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/elements(in:)-6536s":{"role":"symbol","abstract":[{"text":"The elements in ","type":"text"},{"type":"codeVoice","code":"range"},{"text":", in ascending order. O(log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") expected.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"elements"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": 