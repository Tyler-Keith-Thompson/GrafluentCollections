:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/level"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/contains(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/elements(in:)-2aybd","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/elements(in:)-6536s","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/lowerBound(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/max()","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/min()","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/remove(at:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/remove(checkedAt:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/upperBound(_:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/subscript(checked:)"],"anchor":"Subscripts","generated":true,"title":"Subscripts"},{"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/BidirectionalCollection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Collection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/CustomStringConvertible-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Decodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Encodable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Equatable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Hashable-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/RandomAccessCollection-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/Sequence-Implementations","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/SetAlgebra-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips","type":"text"},{"text":" ","type":"text"},{"text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time, with no rebalancing. Every link also records how many elements it","type":"text"},{"text":" ","type":"text"},{"text":"passes, so the elements are a random-access collection in ascending order, indexed by rank","type":"text"},{"text":" ","type":"text"},{"text":"like an array: ","type":"text"},{"code":"list[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"]},{"inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/remove(checkedAt:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remove","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"IndexOutOfRange","kind":"typeIdentifier","preciseIdentifier":"s:16CollectionErrors15IndexOu