text":"expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"]},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"},"sections":[],"references":{"doc://SkipLists/documentation/SkipLists/SkipList/lowerBound(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowerBound","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","role":"symbol","url":"\/documentation\/skiplists\/skiplist\/lowerbound(_:)","kind":"symbol","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/lowerBound