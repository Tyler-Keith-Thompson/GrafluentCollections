{"abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SkipLists\/SK","doc:\/\/SkipLists\/Sl","doc:\/\/SkipLists\/s8CopyableP","doc:\/\/SkipLists\/s23CustomStringConvertibleP","doc:\/\/SkipLists\/Se","doc:\/\/SkipLists\/SE","doc:\/\/SkipLists\/SQ","doc:\/\/SkipLists\/s9EscapableP","doc:\/\/SkipLists\/s25ExpressibleByArrayLiteralP","doc:\/\/SkipLists\/SH","doc:\/\/SkipLists\/Sk","doc:\/\/SkipLists\/s8SendableP","doc:\/\/SkipLists\/s16SendableMetatypeP","doc:\/\/SkipLists\/ST","doc:\/\/SkipLists\/s10SetAlgebraP"],"title":"Conforms To"}],"variants":[{"paths":["\/documentation\/skiplists\/skiplist"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SkipLists\/documentation\/SkipLists"]]},"sections":[],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29","fileName":"SkipList.swift"},"role":"symbol","modules":[{"name":"SkipLists"}],"externalID":"s:9SkipLists0A4ListV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SkipList"}],"roleHeading":"Structure","title":"SkipList"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips","type":"text"},{"text":" ","type":"text"},{"text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time, with no rebalancing. Every link also records how many elements it","type":"text"},{"text":" ","type":"text"},{"text":"passes, so the elements are a random-access collection in ascending order, indexed by rank","type":"text"},{"text":" ","type":"text"},{"text":"like an array: ","type":"text"},{"type":"codeVoice","code":"list[0]"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"heights as its original."}],"type":"paragraph"},{"inlineContent":[{"text":"The elements and their towers live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the list holds fewer","type":"text"},{"text":" ","type":"text"},{"text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"anchor":"Structures","generated":true,"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/LayersView-swift.struct"],"title":"Structures"},{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init()","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(_:using:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(using:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/level"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/contains(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/elements(in:)-2aybd","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/elements(in:)-6536s","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/lowerBound(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/max()","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/min()","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/remove(at:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/remove(checkedAt:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipL