:[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips","type":"text"},{"text":" ","type":"text"},{"text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") expected time, with no rebalancing. Every link also records how many elements it","type":"text"},{"text":" ","type":"text"},{"text":"passes, so the elements are a random-access collection in ascending order, indexed by rank","type":"text"},{"text":" ","type":"text"},{"text":"like an array: ","type":"text"},{"code":"list[0]","type":"codeVoice"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"]},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}]}]}],"metadata":{"symbolKind":"struct","title":"SkipList","roleHeading":"Structure","modules":[{"name":"SkipLists"}],"remoteSource":{"fileName":"SkipList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29"},"navigatorTitle":[{"kind":"identifier","text":"SkipList"}],"externalID":"s:9SkipLists0A4ListV","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}]},"references":{"doc://SkipLists/s10SetAlgebraP":{"identifier":"doc:\/\/SkipLists\/s10SetAlgebraP","title":"Swift.SetAlgebra","type":"unresolvable"},"doc://SkipLists/documentation/SkipLists/SkipList/init(using:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(using:)","kind":"symbol","url":"\/documentation\/skiplists\/skiplist\/init(using:)","abstract":[{"text":"An empty skip list whose heights come from ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":".","type":"text"}],"