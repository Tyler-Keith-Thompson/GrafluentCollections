{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList"},"hierarchy":{"paths":[["doc:\/\/SkipLists\/documentation\/SkipLists"]]},"metadata":{"symbolKind":"struct","externalID":"s:9SkipLists0A4ListV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29","fileName":"SkipList.swift"},"role":"symbol","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkipList","kind":"identifier"}],"title":"SkipList","modules":[{"name":"SkipLists"}],"navigatorTitle":[{"text":"SkipList","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/SkipLists\/SK","doc:\/\/SkipLists\/Sl","doc:\/\/SkipLists\/s8CopyableP","doc:\/\/SkipLists\/s23CustomStringConvertibleP","doc:\/\/SkipLists\/Se","doc:\/\/SkipLists\/SE","doc:\/\/SkipLists\/SQ","doc:\/\/SkipLists\/s9EscapableP","doc:\/\/SkipLists\/s25ExpressibleByArrayLiteralP","doc:\/\/SkipLists\/SH","doc:\/\/SkipLists\/Sk","doc:\/\/SkipLists\/s8SendableP","doc:\/\/SkipLists\/s16SendableMetatypeP","doc:\/\/SkipLists\/ST","doc:\/\/SkipLists\/s10SetAlgebraP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips"},{"type":"text","text":" "},{"type":"text","text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") expected time, with no rebalancing. Every link also records how many elements it"},{"type":"text","text":" "},{"type":"text","text":"passes, so the elements are a random-access collection in ascending order, indexed by rank"},{"type":"text","text":" "},{"type":"text","text":"like an array: "},{"type":"codeVoice","code":"list[0]"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}]},{"type":"codeListing","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skiplists\/skiplist"]}],"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/LayersView-swift.struct"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init()","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(_:using:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/init(using:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/layersView-swift.property","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/level"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/contains(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/elements(in:)-2aybd","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/elements(in:)-6536s","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/lowerBound(_:)","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/max()","doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/min()",