kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips"},{"type":"text","text":" "},{"type":"text","text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take"},{"type":"text","text":" "},{"type":"text","text":"O(log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") expected time, with no rebalancing. Every link also records how many elements it"},{"type":"text","text":" "},{"type":"text","text":"passes, so the elements are a random-access collection in ascending order, indexed by rank"},{"type":"text","text":" "},{"type":"text","text":"like an array: "},{"type":"codeVoice","code":"list[0]"},{"type":"text","text":" is the smallest element. Reading an element by index costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"expected, and a pass through the whole collection costs O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"]},{"type":"paragraph","inlineContent":[{"text":"The tower heights come from a random number generator given at creation,","type":"text"},{"text":" ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" by default; a seeded generator makes every shape reproducible.","type":"text"},{"text":" ","type":"text"},{"text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same","type":"text"},{"text":" ","type":"text"},{"text":"heights as its original.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The elements and their towers live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, so the list holds fewer"},{"type":"text","text":" "},{"type":"text","text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"}],"title":"SkipList","roleHeading":"Structure","modules":[{"name":"SkipLists"}],"navigatorTitle":[{"kind":"identifier","text":"SkipList"}],"externalID":"s:9SkipLists0A4ListV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29","fileName":"SkipList.swift"},"role":"symbol","symbolKind":"struct"},"abstract":[{"type":"text","text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random"},{"type":"text","text":" "},{"type":"text","text":"sample of the one below, searched from the top level down (Pugh, 1990)."}],"hierarchy":{"paths":[["doc:\/\/SkipLists\/documentation\/SkipLists"]]},"references":{"doc://SkipLists/documentation/SkipLists/SkipList/BidirectionalCollection-Implementations":{"identifier":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList\/BidirectionalCollection-Implementations","title":"BidirectionalCollection Implementations","type":"topic","role":"collectionGroup","kind":"article","url":"\/documentation\/skiplists\/skiplist\/bidirectionalcollection-implementations","abstract":[]},"doc://SkipLists/s25ExpressibleByArrayLiteralP":{"type":"unresolvable","identifier":"doc:\/\/SkipLists\/s25ExpressibleByArrayLi