":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Each element stands in a tower of levels, one more with probability 1\/4, so a search skips","type":"text"},{"text":" ","type":"text"},{"text":"ahead on the upper levels and finishes on the bottom one. Lookup, insertion and removal take","type":"text"},{"text":" ","type":"text"},{"text":"O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") expected time, with no rebalancing. Every link also records how many elements it","type":"text"},{"text":" ","type":"text"},{"text":"passes, so the elements are a random-access collection in ascending order, indexed by rank","type":"text"},{"text":" ","type":"text"},{"text":"like an array: ","type":"text"},{"type":"codeVoice","code":"list[0]"},{"text":" is the smallest element. Reading an element by index costs O(log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"expected, and a pass through the whole collection costs O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var numbers: SkipList = [8, 3, 5, 1, 9]","numbers.insert(4)","Array(numbers)                \/\/ [1, 3, 4, 5, 8, 9]","numbers.lowerBound(5)         \/\/ 3, the index of 5","numbers[1]                    \/\/ 3"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The tower heights come from a random number generator given at creation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" by default; a seeded generator makes every shape reproducible."},{"type":"text","text":" "},{"type":"text","text":"The list draws one seed from it and keeps its own generator state, so a copy draws the same"},{"type":"text","text":" "},{"type":"text","text":"heights as its original."}],"type":"paragraph"},{"inlineContent":[{"text":"The elements and their towers live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, so the list holds fewer","type":"text"},{"text":" ","type":"text"},{"text":"than 2³¹ − 1 elements, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"SkipLists"}],"externalID":"s:9SkipLists0A4ListV","title":"SkipList","role":"symbol","navigatorTitle":[{"text":"SkipList","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkipList"}],"remoteSource":{"fileName":"SkipList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SkipLists\/SkipList.swift#L29"}},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"text":"A sorted set kept in a skip list: sorted linked lists stacked in levels, each level a random","type":"text"},{"text":" ","type":"text"},{"text":"sample of the one below, searched from the top level down (Pugh, 1990).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skiplists\/skiplist"]}],"identifier":{"url":"doc:\/\/SkipLists\/documentation\/SkipLists\/SkipList","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://SkipLists/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/SkipLists\/s8CopyableP"},"doc://SkipLists/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/SkipLists\/SH"},"doc://SkipLists/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/SkipLists\/SQ"},"doc://SkipLists/documentation/SkipLists/SkipList/ExpressibleByArrayLiteral-Implementations":{"role":"collectionGroup","kind":"article","type":"topic","abstract":[],"title":"ExpressibleByArrayLiter