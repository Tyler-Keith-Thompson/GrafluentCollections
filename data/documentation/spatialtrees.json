{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Framework","symbolKind":"module","externalID":"SpatialTrees","modules":[{"name":"SpatialTrees"}],"role":"collection","title":"SpatialTrees"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}],"type":"paragraph"},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The six points split first on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" at the median [7, 2], then each side on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Vertex","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Splits on"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Left subtree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Right subtree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[7, 2]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[5, 4], [2, 3], [4, 7]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[9, 6], [8, 1]"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[5, 4]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"text":" = 4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[2, 3]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[4, 7]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[9, 6]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"text":" = 6","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[8, 1]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]]},{"inlineContent":[{"text":"A search for the point nearest [9, 2] starts on the right of ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"text":" = 7, finds [8, 1] at distance","type":"text"},{"text":" ","type":"text"},{"text":"√2, and skips the whole left side, since the plane ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"text":" = 7 is 2 away, farther than that. Searches answer","type":"text"},{"text":" ","type":"text"},{"text":"with the indices the points were given at, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"},{"text":" describes a box for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":", whose vertices are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true},{"type":"text","text":" and an "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Their cells convert to Grafluent’s ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", so Grafluent draws the","type":"text"},{"text":" ","type":"text"},{"text":"subdivision.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","isActive":true},{"text":" and an ","type":"text"},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","isActive":true},{"text":" hold elements over boxes. Each element hangs on the","type":"text"},{"text":" ","type":"text"},{"text":"smallest cell that wholly contains its box, so a box straddling a cell’s centre line stays at","type":"text"},{"text":" ","type":"text"},{"text":"that cell, and cells are made on the way down and freed when they empty. Searches find the","type":"text"},{"text":" ","type":"text"},{"text":"boxes containing a point, those overlapping a box, and every overlapping pair, as","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","isActive":true},{"text":" values. Boxes include their faces, so touching boxes","type":"text"},{"text":" ","type":"text"},{"text":"overlap.","type":"text"}],"type":"paragraph"},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)   \/\/ [\"hall\"]","plan.overlappingPairs().count                     \/\/ 1"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap."}],"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees","title":"k-d trees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"],"anchor":"Boxes","title":"Boxes"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"variants":[{"paths":["\/documentation\/spatialtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","url":"\/documentation\/spatialtrees\/quadtree","navigatorTitle":[{"text":"Quadtree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"title":"Quadtree"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialBoxItem":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialBoxItem","kind":"identifier"}],"navigatorTitle":[{"text":"SpatialBoxItem","kind":"identifier"}],"type":"topic","title":"SpatialBoxItem","abstract":[{"type":"text","text":"An item of an MX-CIF quadtree or octree: a box and the element stored over it."}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","role":"symbol","url":"\/documentation\/spatialtrees\/spatialboxitem"},"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/spatialtrees\/overlappingpair","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","navigatorTitle":[{"text":"OverlappingPair","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OverlappingPair","kind":"identifier"}],"abstract":[{"type":"text","text":"Two items of an MX-CIF quadtree or octree whose boxes overlap."}],"title":"OverlappingPair"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFOctree":{"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","url":"\/documentation\/spatialtrees\/mxcifoctree","title":"MXCIFOctree","abstract":[{"text":"An MX-CIF octree: elements over boxes in a box in space, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"navigatorTitle":[{"text":"MXCIFOctree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFOctree","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"kind":"symbol","abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}],"url":"\/documentation\/spatialtrees\/kdtree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","title":"KDTree","navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"type":"topic","role":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"type":"topic","title":"Trees","abstract":[],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","role":"collection","url":"\/documentation\/spatialtrees\/trees"},"doc://SpatialTrees/documentation/SpatialTrees":{"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","url":"\/documentation\/spatialtrees","title":"SpatialTrees","abstract":[{"type":"text","text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap."}],"type":"topic","role":"collection"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SpatialTrees11BoundingBoxV","kind":"typeIdentifier","text":"BoundingBox"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":">) -> ["},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"title":"indices(in:)"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXCIFQuadtree"}],"navigatorTitle":[{"kind":"identifier","text":"MXCIFQuadtree"}],"type":"topic","title":"MXCIFQuadtree","abstract":[{"text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","role":"symbol","url":"\/documentation\/spatialtrees\/mxcifquadtree"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"kind":"symbol","role":"symbol","title":"Octree","url":"\/documentation\/spatialtrees\/octree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}],"navigatorTitle":[{"text":"Octree","kind":"identifier"}],"type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"type":"topic","title":"SpatialItem","abstract":[{"text":"An item of a quadtree or octree: a point and the element stored at it.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","role":"symbol","url":"\/documentation\/spatialtrees\/spatialitem"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}],"type":"topic","title":"BoundingBox","abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","role":"symbol","url":"\/documentation\/spatialtrees\/boundingbox"}}}