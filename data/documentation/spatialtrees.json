{"abstract":[{"type":"text","text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"text":" holds a fixed set of points, SIMD vectors such as ","type":"text"},{"type":"codeVoice","code":"SIMD2<Double>"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SIMD3<Float>"},{"text":". It splits them at the median of the first coordinate, then each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the second, cycling through the dimensions, and keeps the result in one flat array","type":"text"},{"text":" ","type":"text"},{"text":"with no links: every subtree is a contiguous run with its median in the middle.","type":"text"}],"type":"paragraph"},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The six points split first on ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" at the median [7, 2], then each side on ","type":"text"},{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":":","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Vertex","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Splits on"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Left subtree"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Right subtree","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[7, 2]"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" = 7","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[5, 4]"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":" = 4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[2, 3]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[4, 7]"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[9, 6]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"type":"text","text":" = 6"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[8, 1]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"A search for the point nearest [9, 2] starts on the right of ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"text":" = 7, finds [8, 1] at distance","type":"text"},{"text":" ","type":"text"},{"text":"√2, and skips the whole left side, since the plane ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"text":" = 7 is 2 away, farther than that. Searches answer","type":"text"},{"text":" ","type":"text"},{"text":"with the indices the points were given at, and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"},{"text":" describes a box for","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"BinaryTree(_:)"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree"},{"type":"text","text":" and an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree"},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree"},{"type":"text","text":" and an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree"},{"type":"text","text":" hold elements over boxes. Each element hangs on the"},{"type":"text","text":" "},{"type":"text","text":"smallest cell that wholly contains its box, so a box straddling a cell’s centre line stays at"},{"type":"text","text":" "},{"type":"text","text":"that cell, and cells are made on the way down and freed when they empty. Searches find the"},{"type":"text","text":" "},{"type":"text","text":"boxes containing a point, those overlapping a box, and every overlapping pair, as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"},{"type":"text","text":" values. Boxes include their faces, so touching boxes"},{"type":"text","text":" "},{"type":"text","text":"overlap."}],"type":"paragraph"},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)   \/\/ [\"hall\"]","plan.overlappingPairs().count                     \/\/ 1"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"symbolKind":"module","modules":[{"name":"SpatialTrees"}],"roleHeading":"Framework","role":"collection","externalID":"SpatialTrees","title":"SpatialTrees"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees","title":"k-d trees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"],"anchor":"Boxes","title":"Boxes"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"sections":[],"references":{"doc://SpatialTrees/documentation/SpatialTrees/MXCIFOctree":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFOctree","kind":"identifier"}],"type":"topic","abstract":[{"text":"An MX-CIF octree: elements over boxes in a box in space, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","url":"\/documentation\/spatialtrees\/mxcifoctree","navigatorTitle":[{"text":"MXCIFOctree","kind":"identifier"}],"title":"MXCIFOctree"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"kind":"symbol","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/spatialtrees\/trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","title":"Trees"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialBoxItem":{"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","title":"SpatialBoxItem","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialBoxItem"}],"abstract":[{"text":"An item of an MX-CIF quadtree or octree: a box and the element stored over it.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpatialBoxItem"}],"url":"\/documentation\/spatialtrees\/spatialboxitem"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SpatialTrees11BoundingBoxV","kind":"typeIdentifier","text":"BoundingBox"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":">) -> ["},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"type":"topic","title":"indices(in:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)"},"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"kind":"symbol","abstract":[{"type":"text","text":"Two items of an MX-CIF quadtree or octree whose boxes overlap."}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OverlappingPair"}],"url":"\/documentation\/spatialtrees\/overlappingpair","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OverlappingPair"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","title":"OverlappingPair"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoundingBox","kind":"identifier"}],"abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"BoundingBox","kind":"identifier"}],"title":"BoundingBox","url":"\/documentation\/spatialtrees\/boundingbox"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"url":"\/documentation\/spatialtrees\/kdtree","title":"KDTree"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"kind":"symbol","abstract":[{"text":"An item of a quadtree or octree: a point and the element stored at it.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"url":"\/documentation\/spatialtrees\/spatialitem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"title":"SpatialItem","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","title":"Quadtree","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"url":"\/documentation\/spatialtrees\/quadtree"},"doc://SpatialTrees/documentation/SpatialTrees":{"kind":"symbol","abstract":[{"text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap.","type":"text"}],"type":"topic","role":"collection","url":"\/documentation\/spatialtrees","title":"SpatialTrees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Octree"}],"type":"topic","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","kind":"symbol","url":"\/documentation\/spatialtrees\/octree","navigatorTitle":[{"kind":"identifier","text":"Octree"}],"title":"Octree"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXCIFQuadtree"}],"type":"topic","abstract":[{"type":"text","text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,"},{"type":"text","text":" "},{"type":"text","text":"those containing a point, and every pair that overlaps, and takes insertions and removals as"},{"type":"text","text":" "},{"type":"text","text":"the boxes move."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","kind":"symbol","url":"\/documentation\/spatialtrees\/mxcifquadtree","navigatorTitle":[{"kind":"identifier","text":"MXCIFQuadtree"}],"title":"MXCIFQuadtree"}}}