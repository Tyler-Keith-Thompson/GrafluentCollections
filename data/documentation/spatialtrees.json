{"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","isActive":true},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}]},{"type":"codeListing","syntax":"swift","code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"]},{"type":"paragraph","inlineContent":[{"text":"The six points split first on ","type":"text"},{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" at the median [7, 2], then each side on ","type":"text"},{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"text":":","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertex"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Splits on"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Left subtree"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Right subtree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[9, 6], [8, 1]"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"text":" = 4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[2, 3]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[4, 7]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[9, 6]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"text":" = 6","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[8, 1]","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","isActive":true},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"BinaryTree(_:)"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true},{"type":"text","text":" and an "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}]},{"type":"codeListing","syntax":"swift","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"]},{"type":"paragraph","inlineContent":[{"text":"Their cells convert to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", so Grafluent draws the","type":"text"},{"text":" ","type":"text"},{"text":"subdivision.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"sections":[],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"metadata":{"role":"collection","title":"SpatialTrees","externalID":"SpatialTrees","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"SpatialTrees"}]},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"topicSections":[{"anchor":"k-d-trees","title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"]},{"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Octree"}],"url":"\/documentation\/spatialtrees\/octree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Octree"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","title":"Octree"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SpatialTrees11BoundingBoxV","kind":"typeIdentifier","text":"BoundingBox"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":">) -> ["},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"]"}],"abstract":[{"text":"The indices of the points in ","type":"text"},{"type":"codeVoice","code":"box"},{"text":", its faces included, ascending.","type":"text"}],"title":"indices(in:)","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","navigatorTitle":[{"text":"Quadtree","kind":"identifier"}],"type":"topic","abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"url":"\/documentation\/spatialtrees\/quadtree","title":"Quadtree","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"type":"topic","kind":"symbol","abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"title":"BoundingBox","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoundingBox","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","url":"\/documentation\/spatialtrees\/boundingbox","role":"symbol","navigatorTitle":[{"text":"BoundingBox","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees":{"title":"SpatialTrees","abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"url":"\/documentation\/spatialtrees","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"url":"\/documentation\/spatialtrees\/spatialitem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","title":"SpatialItem"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"title":"Trees","abstract":[],"url":"\/documentation\/spatialtrees\/trees","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"type":"topic","abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}],"url":"\/documentation\/spatialtrees\/kdtree","title":"KDTree","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}]}}}