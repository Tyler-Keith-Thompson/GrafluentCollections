{"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"metadata":{"title":"SpatialTrees","roleHeading":"Framework","symbolKind":"module","role":"collection","externalID":"SpatialTrees","modules":[{"name":"SpatialTrees"}]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","isActive":true},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}]},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The six points split first on ","type":"text"},{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" at the median [7, 2], then each side on ","type":"text"},{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":":","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertex"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Splits on"}]}],[{"type":"paragraph","inlineContent":[{"text":"Left subtree","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Right subtree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" = 7","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[9, 6], [8, 1]"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4]"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":" = 4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[2, 3]"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[4, 7]"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[9, 6]"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":" = 6"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[8, 1]"}]}],[{"type":"paragraph","inlineContent":[]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","isActive":true},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", whose vertices are"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","type":"reference"},{"text":" and an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"reference"},{"text":" hold elements at points, and unlike a k-d tree take insertions","type":"text"},{"text":" ","type":"text"},{"text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each","type":"text"},{"text":" ","type":"text"},{"text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"children holding no more than a bucket merges them back. Searches return ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","type":"reference"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"an element with its point.","type":"text"}]},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}]}]}],"topicSections":[{"title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees"},{"title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees"},{"title":"Extended Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"anchor":"Extended-Modules","generated":true}],"abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"kind":"symbol","references":{"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"kind":"symbol","title":"Quadtree","abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/spatialtrees\/quadtree","navigatorTitle":[{"text":"Quadtree","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"kind":"symbol","url":"\/documentation\/spatialtrees\/octree","title":"Octree","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}],"navigatorTitle":[{"text":"Octree","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"kind":"symbol","type":"topic","title":"Trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","abstract":[],"url":"\/documentation\/spatialtrees\/trees","role":"collection"},"doc://SpatialTrees/documentation/SpatialTrees":{"kind":"symbol","type":"topic","title":"SpatialTrees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"url":"\/documentation\/spatialtrees","role":"collection"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"title":"BoundingBox","navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}],"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","role":"symbol","url":"\/documentation\/spatialtrees\/boundingbox","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","title":"SpatialItem","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}],"role":"symbol","url":"\/documentation\/spatialtrees\/spatialitem","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"kind":"symbol","title":"KDTree","abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/spatialtrees\/kdtree","navigatorTitle":[{"text":"KDTree","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","role":"symbol","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BoundingBox","kind":"typeIdentifier","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV"},{"text":"<","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"title":"indices(in:)"}}}