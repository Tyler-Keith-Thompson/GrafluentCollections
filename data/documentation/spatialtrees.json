{"topicSections":[{"anchor":"k-d-trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"title":"k-d trees"},{"anchor":"Quadtrees-and-octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"title":"Quadtrees and octrees"},{"generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"title":"Extended Modules"}],"kind":"symbol","metadata":{"modules":[{"name":"SpatialTrees"}],"roleHeading":"Framework","symbolKind":"module","title":"SpatialTrees","externalID":"SpatialTrees","role":"collection"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","isActive":true,"type":"reference"},{"text":" holds a fixed set of points, SIMD vectors such as ","type":"text"},{"type":"codeVoice","code":"SIMD2<Double>"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SIMD3<Float>"},{"text":". It splits them at the median of the first coordinate, then each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the second, cycling through the dimensions, and keeps the result in one flat array","type":"text"},{"text":" ","type":"text"},{"text":"with no links: every subtree is a contiguous run with its median in the middle.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The six points split first on "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" at the median [7, 2], then each side on "},{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"type":"text","text":":"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Vertex"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Splits on"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Left subtree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Right subtree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[7, 2]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"text":" = 7","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[9, 6], [8, 1]"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[5, 4]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"type":"text","text":" = 4"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[2, 3]"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[4, 7]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[9, 6]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"type":"text","text":" = 6"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[8, 1]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true,"type":"reference"},{"type":"text","text":" and an "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true,"type":"reference"},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true,"type":"reference"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}],"type":"paragraph"},{"syntax":"swift","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/spatialtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SpatialTrees/documentation/SpatialTrees":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","url":"\/documentation\/spatialtrees","abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"role":"collection","title":"SpatialTrees","kind":"symbol","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"title":"Trees","url":"\/documentation\/spatialtrees\/trees","kind":"symbol","role":"collection","abstract":[],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","title":"KDTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/spatialtrees\/kdtree","role":"symbol","abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}]},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"title":"BoundingBox","kind":"symbol","url":"\/documentation\/spatialtrees\/boundingbox","role":"symbol","abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoundingBox","kind":"identifier"}],"navigatorTitle":[{"text":"BoundingBox","kind":"identifier"}],"type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","url":"\/documentation\/spatialtrees\/quadtree","abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"title":"Quadtree","navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"kind":"symbol","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"type":"topic","identifier":"doc:\/\/SpatialTrees\/d