{"metadata":{"roleHeading":"Framework","title":"SpatialTrees","symbolKind":"module","externalID":"SpatialTrees","modules":[{"name":"SpatialTrees"}],"role":"collection"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"variants":[{"paths":["\/documentation\/spatialtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"anchor":"k-d-trees","title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"]},{"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"]},{"anchor":"Extended-Modules","title":"Extended Modules","generated":true,"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"]}],"kind":"symbol","abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"text":" holds a fixed set of points, SIMD vectors such as ","type":"text"},{"code":"SIMD2<Double>","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"SIMD3<Float>","type":"codeVoice"},{"text":". It splits them at the median of the first coordinate, then each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the second, cycling through the dimensions, and keeps the result in one flat array","type":"text"},{"text":" ","type":"text"},{"text":"with no links: every subtree is a contiguous run with its median in the middle.","type":"text"}]},{"syntax":"swift","code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The six points split first on "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" at the median [7, 2], then each side on "},{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Vertex"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Splits on","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Left subtree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Right subtree"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[7, 2]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" = 7","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[5, 4]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"text":" = 4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[2, 3]"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[4, 7]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[9, 6]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"text":" = 6","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[8, 1]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", whose vertices are"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","type":"reference","isActive":true},{"type":"text","text":" and an "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"reference","isActive":true},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","type":"reference","isActive":true},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}]},{"syntax":"swift","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}]}]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}],"kind":"symbol","url":"\/documentation\/spatialtrees\/boundingbox","title":"BoundingBox","abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}]},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"title":"SpatialItem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"abstract":[{"text":"An item of a quadtree or octree: a point and the element stored at it.","type":"text"}],"kind":"symbol","url":"\/documentation\/spatialtrees\/spatialitem","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"role":"symbol","navigatorTitle":[{"text":"Octree","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","url":"\/documentation\/spatialtrees\/octree","kind":"symbol","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"type":"topic","title":"Octree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","abstract":[],"role":"collection","url":"\/documentation\/spatialtrees\/trees","title":"Trees","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"title":"KDTree","url":"\/documentation\/spatialtrees\/kdtree","kind":"symbol","abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}]},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"type":"topic","abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","role":"symbol","url":"\/documentation\/spatialtrees\/quadtree","title":"Quadtree","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","role":"collection","title":"SpatialTrees","abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"kind":"symbol","url":"\/documentation\/spatialtrees","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BoundingBox","kind":"typeIdentifier","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV"},{"text":"<","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","role":"symbol","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","title":"indices(in:)","kind":"symbol"}}}