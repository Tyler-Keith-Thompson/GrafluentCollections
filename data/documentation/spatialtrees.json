{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","isActive":true},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}]},{"syntax":"swift","type":"codeListing","code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"]},{"type":"paragraph","inlineContent":[{"text":"The six points split first on ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"text":" at the median [7, 2], then each side on ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"text":":","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Vertex","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Splits on"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Left subtree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Right subtree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[7, 2]"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" = 7","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[5, 4], [2, 3], [4, 7]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[5, 4]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"type":"text","text":" = 4"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[2, 3]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[4, 7]"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[9, 6]"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":" = 6","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[8, 1]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","isActive":true},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", whose vertices are"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true},{"text":" and an ","type":"text"},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true},{"text":" hold elements at points, and unlike a k-d tree take insertions","type":"text"},{"text":" ","type":"text"},{"text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each","type":"text"},{"text":" ","type":"text"},{"text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"children holding no more than a bucket merges them back. Searches return ","type":"text"},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"an element with its point.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"SpatialTrees"}],"title":"SpatialTrees","role":"collection","roleHeading":"Framework","externalID":"SpatialTrees","symbolKind":"module"},"abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"topicSections":[{"anchor":"k-d-trees","title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"]},{"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"]},{"anchor":"Extended-Modules","generated":true,"title":"Extended Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees":{"title":"SpatialTrees","abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"role":"collection","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","url":"\/documentation\/spatialtrees","kind":"symbol","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"url":"\/documentation\/spatialtrees\/kdtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}],"type":"topic","title":"KDTree","navigatorTitle":[{"text":"KDTree","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BoundingBox","kind":"typeIdentifier","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV"},{"text":"<","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"type":"topic","title":"indices(in:)"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"url":"\/documentation\/spatialtrees\/trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","kind":"symbol","role":"collection","abstract":[],"type":"topic","title":"Trees"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoundingBox","kind":"identifier"}],"title":"BoundingBox","abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"BoundingBox","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","url":"\/documentation\/spatialtrees\/boundingbox","type":"topic","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"title":"Quadtree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","url":"\/documentation\/spatialtrees\/quadtree","role":"symbol","navigatorTitle":[{"text":"Quadtree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}]},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialItem","kind":"identifier"}],"title":"SpatialItem","abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}],"role":"symbol","navigatorTitle":[{"text":"SpatialItem","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","url":"\/documentation\/spatialtrees\/spatialitem","type":"topic","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"url":"\/documentation\/spatialtrees\/octree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","kind":"symbol","role":"symbol","abstract":[{"text":"An octree: elements at points in a box in space, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"type":"topic","title":"Octree","navigatorTitle":[{"text":"Octree","kind":"identifier"}]}}}