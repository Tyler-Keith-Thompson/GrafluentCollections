{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","isActive":true},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}],"type":"paragraph"},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The six points split first on ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"text":" at the median [7, 2], then each side on ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"text":":","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Vertex","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Splits on","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Left subtree"}]}],[{"type":"paragraph","inlineContent":[{"text":"Right subtree","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" = 7","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[5, 4]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":" = 4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[2, 3]"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[4, 7]"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[9, 6]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"type":"text","text":" = 6"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[8, 1]"}]}],[{"type":"paragraph","inlineContent":[]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","isActive":true,"type":"reference"},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true},{"type":"text","text":" and an "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees","title":"k-d trees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"anchor":"Extended-Modules","generated":true,"title":"Extended Modules"}],"abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Framework","role":"collection","title":"SpatialTrees","symbolKind":"module","externalID":"SpatialTrees","modules":[{"name":"SpatialTrees"}]},"kind":"symbol","references":{"doc://SpatialTrees/documentation/SpatialTrees":{"abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","url":"\/documentation\/spatialtrees","title":"SpatialTrees","kind":"symbol","role":"collection"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"An item of a quadtree or octree: a point and the element stored at it.","type":"text"}],"title":"SpatialItem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialItem","kind":"identifier"}],"navigatorTitle":[{"text":"SpatialItem","kind":"identifier"}],"url":"\/documentation\/spatialtrees\/spatialitem","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}],"navigatorTitle":[{"text":"Octree","kind":"identifier"}],"abstract":[{"text":"An octree: elements at points in a box in space, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"type":"topic","title":"Octree","url":"\/documentation\/spatialtrees\/octree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","kind":"symbol","role":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","role":"symbol","title":"indices(in:)","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BoundingBox","kind":"typeIdentifier","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV"},{"text":"<","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The indices of the points in "},{"type":"codeVoice","code":"box"},{"type":"text","text":", its faces included, ascending."}],"kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}],"url":"\/documentation\/spatialtrees\/boundingbox","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"type":"topic","kind":"symbol","title":"BoundingBox","navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}],"role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"title":"Quadtree","type":"topic","navigatorTitle":[{"text":"Quadtree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"url":"\/documentation\/spatialtrees\/quadtree"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"role":"collection","type":"topic","title":"Trees","abstract":[],"url":"\/documentation\/spatialtrees\/trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"title":"KDTree","type":"topic","navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"url":"\/documentation\/spatialtrees\/kdtree"}}}