{"hierarchy":{"paths":[[]]},"abstract":[{"text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap.","type":"text"}],"topicSections":[{"title":"k-d trees","anchor":"k-d-trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"]},{"title":"Quadtrees and octrees","anchor":"Quadtrees-and-octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"]},{"title":"Boxes","anchor":"Boxes","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"]},{"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}]},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The six points split first on "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" at the median [7, 2], then each side on "},{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"type":"text","text":":"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertex"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Splits on"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Left subtree"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Right subtree"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[7, 2]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" = 7"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[5, 4]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":" = 4"}]}],[{"type":"paragraph","inlineContent":[{"text":"[2, 3]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[4, 7]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[9, 6]"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"text":" = 6","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[8, 1]"}]}],[{"type":"paragraph","inlineContent":[]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"A search for the point nearest [9, 2] starts on the right of ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"text":" = 7, finds [8, 1] at distance","type":"text"},{"text":" ","type":"text"},{"text":"√2, and skips the whole left side, since the plane ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"text":" = 7 is 2 away, farther than that. Searches answer","type":"text"},{"text":" ","type":"text"},{"text":"with the indices the points were given at, and ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","type":"reference","isActive":true},{"text":" describes a box for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true,"type":"reference"},{"text":" and an ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true,"type":"reference"},{"text":" hold elements at points, and unlike a k-d tree take insertions","type":"text"},{"text":" ","type":"text"},{"text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each","type":"text"},{"text":" ","type":"text"},{"text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"children holding no more than a bucket merges them back. Searches return ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true,"type":"reference"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"an element with its point.","type":"text"}]},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","isActive":true},{"type":"text","text":" and an "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","isActive":true},{"type":"text","text":" hold elements over boxes. Each element hangs on the"},{"type":"text","text":" "},{"type":"text","text":"smallest cell that wholly contains its box, so a box straddling a cell’s centre line stays at"},{"type":"text","text":" "},{"type":"text","text":"that cell, and cells are made on the way down and freed when they empty. Searches find the"},{"type":"text","text":" "},{"type":"text","text":"boxes containing a point, those overlapping a box, and every overlapping pair, as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","isActive":true},{"type":"text","text":" values. Boxes include their faces, so touching boxes"},{"type":"text","text":" "},{"type":"text","text":"overlap."}]},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)   \/\/ [\"hall\"]","plan.overlappingPairs().count                     \/\/ 1"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"metadata":{"roleHeading":"Framework","role":"collection","title":"SpatialTrees","externalID":"SpatialTrees","modules":[{"name":"SpatialTrees"}],"symbolKind":"module"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","references":{"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXCIFQuadtree"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","title":"MXCIFQuadtree","role":"symbol","abstract":[{"type":"text","text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,"},{"type":"text","text":" "},{"type":"text","text":"those containing a point, and every pair that overlaps, and takes insertions and removals as"},{"type":"text","text":" "},{"type":"text","text":"the boxes move."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXCIFQuadtree"}],"url":"\/documentation\/spatialtrees\/mxcifquadtree","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","url":"\/documentation\/spatialtrees\/boundingbox","type":"topic","title":"BoundingBox","abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}]},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","url":"\/documentation\/spatialtrees\/spatialitem","title":"SpatialItem","abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}]},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"topic","url":"\/documentation\/spatialtrees\/octree","title":"Octree","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Octree"}],"navigatorTitle":[{"kind":"identifier","text":"Octree"}]},"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"url":"\/document