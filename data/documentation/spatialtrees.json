{"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"title":"k-d trees","anchor":"k-d-trees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"title":"Quadtrees and octrees","anchor":"Quadtrees-and-octrees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"kind":"symbol","sections":[],"abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SpatialTrees"}],"title":"SpatialTrees","roleHeading":"Framework","role":"collection","externalID":"SpatialTrees","symbolKind":"module"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}],"type":"paragraph"},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The six points split first on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" at the median [7, 2], then each side on "},{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Vertex","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Splits on","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Left subtree"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Right subtree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[7, 2]"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"type":"text","text":" = 7"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[5, 4], [2, 3], [4, 7]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[5, 4]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"text":" = 4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[2, 3]"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[4, 7]","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"[9, 6]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"type":"text","text":" = 6"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[8, 1]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"BinaryTree(_:)"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree"},{"type":"text","text":" and an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree"},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}],"role":"symbol","url":"\/documentation\/spatialtrees\/boundingbox","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","title":"BoundingBox","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"abstract":[{"text":"The indices of the points in ","type":"text"},{"code":"box","type":"codeVoice"},{"text":", its faces included, ascending.","type":"text"}],"role":"symbol","title":"indices(in:)","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SpatialTrees11BoundingBoxV","kind":"typeIdentifier","text":"BoundingBox"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":">) -> ["},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"]"}]},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"url":"\/documentation\/spatialtrees\/quadtree","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"type":"topic","title":"Quadtree"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"kind":"symbol","url":"\/documentation\/spatialtrees\/spatialitem","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","abstract":[{"text":"An item of a quadtree or octree: a point and the element stored at it.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"title":"SpatialItem"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"kind":"symbol","url":"\/documentation\/spatialtrees\/octree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Octree","kind":"identifier"}],"title":"Octree"},"doc://SpatialTrees/documentation/SpatialTrees":{"abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"role":"collection","title":"SpatialTrees","url":"\/documentation\/spatialtrees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","type":"topic","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"kind":"symbol","title":"KDTree","url":"\/documentation\/spatialtrees\/kdtree","role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"kind":"symbol","url":"\/documentation\/spatialtrees\/trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","abstract":[],"role":"collection","type":"topic","title":"Trees"}}}