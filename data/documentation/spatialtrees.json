{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"role":"collection","title":"SpatialTrees","externalID":"SpatialTrees","symbolKind":"module","modules":[{"name":"SpatialTrees"}],"roleHeading":"Framework"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","type":"reference","isActive":true},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"code":"SIMD2<Double>","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"code":"SIMD3<Float>","type":"codeVoice"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}]},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The six points split first on ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" at the median [7, 2], then each side on ","type":"text"},{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":":","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Vertex","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Splits on","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Left subtree"}]}],[{"type":"paragraph","inlineContent":[{"text":"Right subtree","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[7, 2]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7"}]}],[{"type":"paragraph","inlineContent":[{"text":"[5, 4], [2, 3], [4, 7]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[9, 6], [8, 1]"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":" = 4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[2, 3]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[4, 7]"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[9, 6]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"text":" = 6","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[8, 1]","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","type":"reference","isActive":true},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","type":"reference"},{"type":"text","text":" and an "},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"reference"},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","type":"reference"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}]},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}]}]}],"topicSections":[{"title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees"},{"title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees"},{"title":"Extended Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"generated":true,"anchor":"Extended-Modules"}],"abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"type":"topic","title":"Quadtree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","url":"\/documentation\/spatialtrees\/quadtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Quadtree","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"role":"symbol","url":"\/documentation\/spatialtrees\/boundingbox","title":"BoundingBox","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}],"abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"navigatorTitle":[{"kind":"identifier","text":"Octree"}],"type":"topic","kind":"symbol","title":"Octree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Octree"}],"role":"symbol","url":"\/documentation\/spatialtrees\/octree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","abstract":[{"text":"An octree: elements at points in a box in space, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"url":"\/documentation\/spatialtrees\/kdtree","abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"type":"topic","title":"KDTree"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"navigatorTitle":[{"text":"SpatialItem","kind":"identifier"}],"type":"topic","kind":"symbol","title":"SpatialItem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialItem","kind":"identifier"}],"role":"symbol","url":"\/documentation\/spatialtrees\/spatialitem","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}]},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"url":"\/documentation\/spatialtrees\/trees","abstract":[],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","role":"collection","type":"topic","title":"Trees"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","abstract":[{"type":"text","text":"The indices of the points in "},{"type":"codeVoice","code":"box"},{"type":"text","text":", its faces included, ascending."}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BoundingBox","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"role":"symbol","type":"topic","title":"indices(in:)"},"doc://SpatialTrees/documentation/SpatialTrees":{"role":"collection","url":"\/documentation\/spatialtrees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","title":"SpatialTrees","kind":"symbol","abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"type":"topic"}}}