{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"]},{"inlineContent":[{"type":"text","text":"The six points split first on "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" at the median [7, 2], then each side on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Vertex","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Splits on"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Left subtree"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Right subtree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" = 7","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[5, 4]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":" = 4"}]}],[{"type":"paragraph","inlineContent":[{"text":"[2, 3]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[4, 7]"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[9, 6]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"type":"text","text":" = 6"}]}],[{"type":"paragraph","inlineContent":[{"text":"[8, 1]","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]]]},{"inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"type":"emphasis","inlineContent":[{"type":"text","text":"x"}]},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","isActive":true},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tree’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", whose vertices are"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true,"type":"reference"},{"text":" and an ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true,"type":"reference"},{"text":" hold elements at points, and unlike a k-d tree take insertions","type":"text"},{"text":" ","type":"text"},{"text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each","type":"text"},{"text":" ","type":"text"},{"text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"children holding no more than a bucket merges them back. Searches return ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true,"type":"reference"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"an element with its point.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"]},{"inlineContent":[{"text":"Their cells convert to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", so Grafluent draws the","type":"t