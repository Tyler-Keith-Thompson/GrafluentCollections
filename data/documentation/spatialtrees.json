{"metadata":{"symbolKind":"module","roleHeading":"Framework","modules":[{"name":"SpatialTrees"}],"role":"collection","title":"SpatialTrees","externalID":"SpatialTrees"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"text":" holds a fixed set of points, SIMD vectors such as ","type":"text"},{"type":"codeVoice","code":"SIMD2<Double>"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SIMD3<Float>"},{"text":". It splits them at the median of the first coordinate, then each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the second, cycling through the dimensions, and keeps the result in one flat array","type":"text"},{"text":" ","type":"text"},{"text":"with no links: every subtree is a contiguous run with its median in the middle.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"]},{"inlineContent":[{"type":"text","text":"The six points split first on "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" at the median [7, 2], then each side on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":":"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Vertex","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Splits on","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Left subtree","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Right subtree","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" = 7","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[5, 4]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"text":" = 4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[2, 3]"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[4, 7]"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[9, 6]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"text":" = 6","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[8, 1]"}]}],[{"type":"paragraph","inlineContent":[]}]]],"type":"table"},{"inlineContent":[{"text":"A search for the point nearest [9, 2] starts on the right of ","type":"text"},{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" = 7, finds [8, 1] at distance","type":"text"},{"text":" ","type":"text"},{"text":"√2, and skips the whole left side, since the plane ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" = 7 is 2 away, farther than that. Searches answer","type":"text"},{"text":" ","type":"text"},{"text":"with the indices the points were given at, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","type":"reference"},{"text":" describes a box for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tree’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":", whose vertices are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","type":"reference","isActive":true},{"type":"text","text":" and an "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"reference","isActive":true},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","type":"reference","isActive":true},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"]},{"inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree"},{"text":" and an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree"},{"text":" hold elements over boxes. Each element hangs on the","type":"text"},{"text":" ","type":"text"},{"text":"smallest cell that wholly contains its box, so a box straddling a cell’s centre line stays at","type":"text"},{"text":" ","type":"text"},{"text":"that cell, and cells are made on the way down and freed when they empty. Searches find the","type":"text"},{"text":" ","type":"text"},{"text":"boxes containing a point, those overlapping a box, and every overlapping pair, as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"},{"text":" values. Boxes include their faces, so touching boxes","type":"text"},{"text":" ","type":"text"},{"text":"overlap.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)   \/\/ [\"hall\"]","plan.overlappingPairs().count                     \/\/ 1"]}]}],"variants":[{"paths":["\/documentation\/spatialtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees"},"kind":"symbol","hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap."}],"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"title":"k-d trees","anchor":"k-d-trees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"title":"Quadtrees and octrees","anchor":"Quadtrees-and-octrees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"],"title":"Boxes","anchor":"Boxes"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"title":"Extended Modules","generated":true,"anchor":"Extended-Modules"}],"sections":[],"references":{"doc://SpatialTrees/documentation/SpatialTrees/SpatialBoxItem":{"title":"SpatialBoxItem","role":"symbol","kind":"symbol","url":"\/documentation\/spatialtrees\/spatialboxitem","type":"topic","abstract":[{"type":"text","text":"An item of an MX-CIF quadtree or octree: a box and the element stored over it."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialBoxItem","kind":"identifier"}],"navigatorTitle":[{"text":"SpatialBoxItem","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"role":"symbol","navigatorTitle":[{"text":"SpatialItem","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialItem","kind":"identifier"}],"abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}],"url":"\/documentation\/spatialtrees\/spatialitem","title":"SpatialItem"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFOctree":{"abstract":[{"type":"text","text":"An MX-CIF octree: elements over boxes in a box in space, which finds those overlapping a box,"},{"type":"text","text":" "},{"type":"text","text":"those containing a point, and every pair that overlaps, and takes insertions and removals as"},{"type":"text","text":" "},{"type":"text","text":"the boxes move."}],"url":"\/documentation\/spatialtrees\/mxcifoctree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXCIFOctree"}],"navigatorTitle":[{"kind":"identifier","text":"MXCIFOctree"}],"kind":"symbol","role":"symbol","title":"MXCIFOctree","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"title":"BoundingBox","role":"symbol","kind":"symbol","url":"\/documentation\/spatialtrees\/boundingbox","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"title":"indices(in:)","role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BoundingBox","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"title":"KDTree","role":"symbol","abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"url":"\/documentation\/spatialtrees\/kdtree","kind":"symbol","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"navigatorTitle":[{"kind":"identifier","text":"KDTree"}]},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Octree"}],"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Octree"}],"abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"url":"\/documentation\/spatialtrees\/octree","title":"Octree"},"doc://SpatialTrees/documentation/SpatialTrees":{"abstract":[{"text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap.","type":"text"}],"title":"SpatialTrees","kind":"symbol","type":"topic","url":"\/documentation\/spatialtrees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","role":"collection"},"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OverlappingPair"}],"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OverlappingPair"}],"abstract":[{"type":"text","text":"Two items of an MX-CIF quadtree or octree whose boxes overlap."}],"url":"\/documentation\/spatialtrees\/overlappingpair","title":"OverlappingPair"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXCIFQuadtree"}],"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXCIFQuadtree"}],"abstract":[{"text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"url":"\/documentation\/spatialtrees\/mxcifquadtree","title":"MXCIFQuadtree"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"title":"Trees","role":"collection","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/spatialtrees\/trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"kind":"symbol","title":"Quadtree","type":"topic","url":"\/documentation\/spatialtrees\/quadtree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","role":"symbol"}}}