{"topicSections":[{"title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees"},{"title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees"},{"title":"Boxes","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"],"anchor":"Boxes"},{"title":"Extended Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"anchor":"Extended-Modules","generated":true}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/spatialtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap."}],"sections":[],"metadata":{"role":"collection","externalID":"SpatialTrees","modules":[{"name":"SpatialTrees"}],"roleHeading":"Framework","symbolKind":"module","title":"SpatialTrees"},"kind":"symbol","primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","isActive":true},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}],"type":"paragraph"},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The six points split first on "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" at the median [7, 2], then each side on "},{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"type":"text","text":":"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Vertex"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Splits on","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Left subtree","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Right subtree"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[7, 2]"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" = 7"}],"type":"paragraph"}],[{"inlineContent":[{"text":"[5, 4], [2, 3], [4, 7]","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[9, 6], [8, 1]"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[5, 4]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"text":" = 4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[2, 3]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[4, 7]"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"[9, 6]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":" = 6"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"[8, 1]"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"A search for the point nearest [9, 2] starts on the right of ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" = 7, finds [8, 1] at distance","type":"text"},{"text":" ","type":"text"},{"text":"√2, and skips the whole left side, since the plane ","type":"text"},{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" = 7 is 2 away, farther than that. Searches answer","type":"text"},{"text":" ","type":"text"},{"text":"with the indices the points were given at, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","type":"reference"},{"text":" describes a box for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"BinaryTree(_:)","type":"codeVoice"},{"type":"text","text":", whose vertices are"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","isActive":true,"type":"reference"},{"text":" and an ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","isActive":true,"type":"reference"},{"text":" hold elements at points, and unlike a k-d tree take insertions","type":"text"},{"text":" ","type":"text"},{"text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each","type":"text"},{"text":" ","type":"text"},{"text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"children holding no more than a bucket merges them back. Searches return ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","isActive":true,"type":"reference"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"an element with its point.","type":"text"}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","isActive":true},{"type":"text","text":" and an "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","isActive":true},{"type":"text","text":" hold elements over boxes. Each element hangs on the"},{"type":"text","text":" "},{"type":"text","text":"smallest cell that wholly contains its box, so a box straddling a cell’s centre line stays at"},{"type":"text","text":" "},{"type":"text","text":"that cell, and cells are made on the way down and freed when they empty. Searches find the"},{"type":"text","text":" "},{"type":"text","text":"boxes containing a point, those overlapping a box, and every overlapping pair, as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","isActive":true},{"type":"text","text":" values. Boxes include their faces, so touching boxes"},{"type":"text","text":" "},{"type":"text","text":"overlap."}],"type":"paragraph"},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)   \/\/ [\"hall\"]","plan.overlappingPairs().count                     \/\/ 1"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"abstract":[{"type":"text","text":"Two items of an MX-CIF quadtree or octree whose boxes overlap."}],"type":"topic","title":"OverlappingPair","role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","navigatorTitle":[{"kind":"identifier","text":"OverlappingPair"}],"url":"\/documentation\/spatialtrees\/overlappingpair","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OverlappingPair"}],"kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"kind":"symbol","type":"topic","url":"\/documentation\/spatialtrees\/trees","abstract":[],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","title":"Trees","role":"collection"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SpatialTrees11BoundingBoxV","kind":"typeIdentifier","text":"BoundingBox"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":">) -> ["},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"]"}],"title":"indices(in:)","role":"symbol","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","kind":"symbol","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","abstract":[{"text":"The indices of the points in ","type":"text"},{"code":"box","type":"codeVoice"},{"text":", its faces included, ascending.","type":"text"}]},"doc://SpatialTrees/documentation/SpatialTrees":{"role":"collection","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","type":"topic","abstract":[{"text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap.","type":"text"}],"url":"\/documentation\/spatialtrees","title":"SpatialTrees","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"url":"\/documentation\/spatialtrees\/quadtree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"type":"topic","abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"kind":"symbol","role":"symbol","title":"Quadtree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","kind":"symbol","title":"SpatialItem","url":"\/documentation\/spatialtrees\/spatialitem","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"abstract":[{"text":"An item of a quadtree or octree: a point and the element stored at it.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}]},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"kind":"symbol","url":"\/documentation\/spatialtrees\/boundingbox","type":"topic","abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","navigatorTitle":[{"text":"BoundingBox","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoundingBox","kind":"identifier"}],"title":"BoundingBox","role":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialBoxItem":{"abstract":[{"type":"text","text":"An item of an MX-CIF quadtree or octree: a box and the element stored over it."}],"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","role":"symbol","url":"\/documentation\/spatialtrees\/spatialboxitem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialBoxItem","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"SpatialBoxItem","kind":"identifier"}],"title":"SpatialBoxItem"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"title":"KDTree","navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"role":"symbol","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","kind":"symbol","url":"\/documentation\/spatialtrees\/kdtree","abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}]},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"navigatorTitle":[{"kind":"identifier","text":"Octree"}],"role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"topic","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"url":"\/documentation\/spatialtrees\/octree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Octree"}],"kind":"symbol","title":"Octree"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree":{"navigatorTitle":[{"text":"MXCIFQuadtree","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","type":"topic","abstract":[{"type":"text","text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,"},{"type":"text","text":" "},{"type":"text","text":"those containing a point, and every pair that overlaps, and takes insertions and removals as"},{"type":"text","text":" "},{"type":"text","text":"the boxes move."}],"url":"\/documentation\/spatialtrees\/mxcifquadtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFQuadtree","kind":"identifier"}],"kind":"symbol","title":"MXCIFQuadtree"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFOctree":{"abstract":[{"type":"text","text":"An MX-CIF octree: elements over boxes in a box in space, which finds those overlapping a box,"},{"type":"text","text":" "},{"type":"text","text":"those containing a point, and every pair that overlaps, and takes insertions and removals as"},{"type":"text","text":" "},{"type":"text","text":"the boxes move."}],"type":"topic","title":"MXCIFOctree","role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","navigatorTitle":[{"text":"MXCIFOctree","kind":"identifier"}],"url":"\/documentation\/spatialtrees\/mxcifoctree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFOctree","kind":"identifier"}],"kind":"symbol"}}}