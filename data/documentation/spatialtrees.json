{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","isActive":true,"type":"reference"},{"text":" holds a fixed set of points, SIMD vectors such as ","type":"text"},{"code":"SIMD2<Double>","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"SIMD3<Float>","type":"codeVoice"},{"text":". It splits them at the median of the first coordinate, then each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the second, cycling through the dimensions, and keeps the result in one flat array","type":"text"},{"text":" ","type":"text"},{"text":"with no links: every subtree is a contiguous run with its median in the middle.","type":"text"}]},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The six points split first on "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" at the median [7, 2], then each side on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":":"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertex"}]}],[{"type":"paragraph","inlineContent":[{"text":"Splits on","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Left subtree"}]}],[{"type":"paragraph","inlineContent":[{"text":"Right subtree","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7"}]}],[{"type":"paragraph","inlineContent":[{"text":"[5, 4], [2, 3], [4, 7]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[5, 4]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":" = 4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[2, 3]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[4, 7]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[9, 6]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"text":" = 6","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[8, 1]"}]}],[{"type":"paragraph","inlineContent":[]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","type":"reference","isActive":true},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"BinaryTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"BinaryTree(_:)"},{"type":"text","text":", whose vertices are"},{"type":"text","text":" "},{"type":"text","text":"the points’ indices."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree"},{"text":" and an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree"},{"text":" hold elements at points, and unlike a k-d tree take insertions","type":"text"},{"text":" ","type":"text"},{"text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each","type":"text"},{"text":" ","type":"text"},{"text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"children holding no more than a bucket merges them back. Searches return ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"an element with its point.","type":"text"}]},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Their cells convert to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", so Grafluent draws the"},{"type":"text","text":" "},{"type":"text","text":"subdivision."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","isActive":true},{"type":"text","text":" and an "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","isActive":true},{"type":"text","text":" hold elements over boxes. Each element hangs on the"},{"type":"text","text":" "},{"type":"text","text":"smallest cell that wholly contains its box, so a box straddling a cell’s centre line stays at"},{"type":"text","text":" "},{"type":"text","text":"that cell, and cells are made on the way down and freed when they empty. Searches find the"},{"type":"text","text":" "},{"type":"text","text":"boxes containing a point, those overlapping a box, and every overlapping pair, as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","isActive":true},{"type":"text","text":" values. Boxes include their faces, so touching boxes"},{"type":"text","text":" "},{"type":"text","text":"overlap."}]},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.items(containing: [20, 15]).map(\\.element)   \/\/ [\"hall\"]","plan.overlappingPairs().count                     \/\/ 1"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/spatialtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","modules":[{"name":"SpatialTrees"}],"role":"collection","title":"SpatialTrees","externalID":"SpatialTrees","roleHeading":"Framework"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees"},{"title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees"},{"title":"Boxes","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"],"anchor":"Boxes"},{"title":"Extended Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"generated":true,"anchor":"Extended-Modules"}],"abstract":[{"type":"text","text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap."}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"title":"Trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/spatialtrees\/trees","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree":{"url":"\/documentation\/spatialtrees\/mxcifquadtree","abstract":[{"text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXCIFQuadtree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXCIFQuadtree","kind":"identifier"}],"title":"MXCIFQuadtree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialBoxItem":{"url":"\/documentation\/spatialtrees\/spatialboxitem","abstract":[{"type":"text","text":"An item of an MX-CIF quadtree or octree: a box and the element stored over it."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialBoxItem"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SpatialBoxItem"}],"title":"SpatialBoxItem","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"url":"\/documentation\/spatialtrees\/quadtree","role":"symbol","abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"title":"Quadtree","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"title":"OverlappingPair","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","url":"\/documentation\/spatialtrees\/overlappingpair","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Two items of an MX-CIF quadtree or octree whose boxes overlap."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OverlappingPair"}],"navigatorTitle":[{"kind":"identifier","text":"OverlappingPair"}]},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFOctree":{"url":"\/documentation\/spatialtrees\/mxcifoctree","abstract":[{"text":"An MX-CIF octree: elements over boxes in a box in space, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXCIFOctree"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXCIFOctree"}],"title":"MXCIFOctree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"url":"\/documentation\/spatialtrees\/kdtree","abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"title":"KDTree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"url":"\/documentation\/spatialtrees\/octree","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Octree","kind":"identifier"}],"title":"Octree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree"},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"url":"\/documentation\/spatialtrees\/spatialitem","abstract":[{"text":"An item of a quadtree or octree: a point and the element stored at it.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"title":"SpatialItem","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"},"doc://SpatialTrees/documentation/SpatialTrees":{"url":"\/documentation\/spatialtrees","role":"collection","abstract":[{"text":"Trees over points and boxes in space that find the points nearest a query or within a radius or a box, and the boxes that overlap.","type":"text"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","title":"SpatialTrees","kind":"symbol","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"url":"\/documentation\/spatialtrees\/boundingbox","role":"symbol","abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"kind":"symbol","title":"BoundingBox","navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}],"type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"title":"indices(in:)","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","abstract":[{"text":"The indices of the points in ","type":"text"},{"code":"box","type":"codeVoice"},{"text":", its faces included, ascending.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BoundingBox","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"}}}