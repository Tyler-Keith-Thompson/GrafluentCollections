{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","type":"reference"},{"text":" holds a fixed set of points, SIMD vectors such as ","type":"text"},{"code":"SIMD2<Double>","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"SIMD3<Float>","type":"codeVoice"},{"text":". It splits them at the median of the first coordinate, then each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the second, cycling through the dimensions, and keeps the result in one flat array","type":"text"},{"text":" ","type":"text"},{"text":"with no links: every subtree is a contiguous run with its median in the middle.","type":"text"}]},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The six points split first on ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" at the median [7, 2], then each side on ","type":"text"},{"inlineContent":[{"text":"y","type":"text"}],"type":"emphasis"},{"text":":","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertex"}]}],[{"type":"paragraph","inlineContent":[{"text":"Splits on","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Left subtree","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Right subtree"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" = 7","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[5, 4], [2, 3], [4, 7]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[5, 4]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"type":"text","text":" = 4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[2, 3]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[4, 7]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[9, 6]"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"y"}]},{"type":"text","text":" = 6"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[8, 1]"}]}],[{"type":"paragraph","inlineContent":[]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A search for the point nearest [9, 2] starts on the right of ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" = 7, finds [8, 1] at distance","type":"text"},{"text":" ","type":"text"},{"text":"√2, and skips the whole left side, since the plane ","type":"text"},{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"text":" = 7 is 2 away, farther than that. Searches answer","type":"text"},{"text":" ","type":"text"},{"text":"with the indices the points were given at, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","type":"reference"},{"text":" describes a box for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"code":"BinaryTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"BinaryTree(_:)","type":"codeVoice"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","type":"reference"},{"type":"text","text":" and an "},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"reference"},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","type":"reference"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}]},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Their cells convert to Grafluent’s ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", so Grafluent draws the","type":"text"},{"text":" ","type":"text"},{"text":"subdivision.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"sections":[],"topicSections":[{"title":"k-d trees","anchor":"k-d-trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"]},{"title":"Quadtrees and octrees","anchor":"Quadtrees-and-octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"]},{"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"generated":true}],"metadata":{"title":"SpatialTrees","externalID":"SpatialTrees","roleHeading":"Framework","role":"collection","symbolKind":"module","modules":[{"name":"SpatialTrees"}]},"hierarchy":{"paths":[[]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees"]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"title":"Trees","url":"\/documentation\/spatialtrees\/trees","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","role":"collection","type":"topic","kind":"symbol","abstract":[]},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"abstract":[{"text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and","type":"text"},{"text":" ","type":"text"},{"text":"the upper corner’s, both included.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}],"url":"\/documentation\/spatialtrees\/boundingbox","type":"topic","kind":"symbol","title":"BoundingBox","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"title":"Quadtree","url":"\/documentation\/spatialtrees\/quadtree","abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees":{"role":"collection","title":"SpatialTrees","url":"\/documentation\/spatialtrees","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"role":"symbol","title":"Octree","url":"\/documentation\/spatialtrees\/octree","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","abstract":[{"text":"An octree: elements at points in a box in space, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"navigatorTitle":[{"text":"Octree","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"title":"indices(in:)","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":"("},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BoundingBox","kind":"typeIdentifier","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV"},{"text":"<","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"kind":"symbol","url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"title":"KDTree","url":"\/documentation\/spatialtrees\/kdtree","navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}]},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"url":"\/documentation\/spatialtrees\/spatialitem","title":"SpatialItem","navigatorTitle":[{"kind":"identifier","text":"SpatialItem"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialItem"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}],"kind":"symbol"}}}