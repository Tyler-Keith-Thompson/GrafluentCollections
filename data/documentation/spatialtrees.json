{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},{"type":"text","text":" holds a fixed set of points, SIMD vectors such as "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":". It splits them at the median of the first coordinate, then each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the second, cycling through the dimensions, and keeps the result in one flat array"},{"type":"text","text":" "},{"type":"text","text":"with no links: every subtree is a contiguous run with its median in the middle."}],"type":"paragraph"},{"code":["import SpatialTrees","","let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])              \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)  \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])        \/\/ [1, 3]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The six points split first on ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" at the median [7, 2], then each side on ","type":"text"},{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":":","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Vertex","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Splits on"}]}],[{"type":"paragraph","inlineContent":[{"text":"Left subtree","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Right subtree","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[7, 2]"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"type":"text","text":" = 7"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4], [2, 3], [4, 7]"}]}],[{"type":"paragraph","inlineContent":[{"text":"[9, 6], [8, 1]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"[5, 4]"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"y"}],"type":"emphasis"},{"text":" = 4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[2, 3]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"[4, 7]","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"[9, 6]","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"y","type":"text"}]},{"text":" = 6","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"[8, 1]"}]}],[{"type":"paragraph","inlineContent":[]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"A search for the point nearest [9, 2] starts on the right of "},{"inlineContent":[{"text":"x","type":"text"}],"type":"emphasis"},{"type":"text","text":" = 7, finds [8, 1] at distance"},{"type":"text","text":" "},{"type":"text","text":"√2, and skips the whole left side, since the plane "},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" = 7 is 2 away, farther than that. Searches answer"},{"type":"text","text":" "},{"type":"text","text":"with the indices the points were given at, and "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","isActive":true},{"type":"text","text":" describes a box for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The tree’s shape converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"BinaryTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"BinaryTree(_:)"},{"text":", whose vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the points’ indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","type":"reference","isActive":true},{"type":"text","text":" and an "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"reference","isActive":true},{"type":"text","text":" hold elements at points, and unlike a k-d tree take insertions"},{"type":"text","text":" "},{"type":"text","text":"and removals as the points move. Each splits its region into four (eight) equal cells, and each"},{"type":"text","text":" "},{"type":"text","text":"cell again, until every leaf holds at most a bucket of elements; a removal that leaves a cell’s"},{"type":"text","text":" "},{"type":"text","text":"children holding no more than a bucket merges them back. Searches return "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","type":"reference","isActive":true},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"an element with its point."}],"type":"paragraph"},{"code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element   \/\/ \"café\"","map.remove(\"café\", at: [10, 20])"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Their cells convert to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", so Grafluent draws the","type":"text"},{"text":" ","type":"text"},{"text":"subdivision.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"modules":[{"name":"SpatialTrees"}],"roleHeading":"Framework","role":"collection","title":"SpatialTrees","symbolKind":"module","externalID":"SpatialTrees"},"variants":[{"paths":["\/documentation\/spatialtrees"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[[]]},"abstract":[{"text":"Trees over points in space that find the points nearest a query, or within a radius or a box.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees","title":"k-d trees"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees"},{"generated":true,"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees"],"anchor":"Extended-Modules","title":"Extended Modules"}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","type":"topic","role":"symbol","title":"Octree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Octree","kind":"identifier"}],"abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"url":"\/documentation\/spatialtrees\/octree"},"doc://SpatialTrees/documentation/SpatialTrees/Trees":{"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Trees","role":"collection","title":"Trees","kind":"symbol","abstract":[],"url":"\/documentation\/spatialtrees\/trees"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"title":"KDTree","navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","url":"\/documentation\/spatialtrees\/kdtree","abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}]},"doc://SpatialTrees/documentation/SpatialTrees/SpatialItem":{"url":"\/documentation\/spatialtrees\/spatialitem","title":"SpatialItem","kind":"symbol","navigatorTitle":[{"text":"SpatialItem","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem","abstract":[{"type":"text","text":"An item of a quadtree or octree: a point and the element stored at it."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpatialItem","kind":"identifier"}]},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"title":"Quadtree","abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","url":"\/documentation\/spatialtrees\/quadtree","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees","title":"SpatialTrees","role":"collection","url":"\/documentation\/spatialtrees","type":"topic","abstract":[{"type":"text","text":"Trees over points in space that find the points nearest a query, or within a radius or a box."}],"kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(in:)":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","type":"topic","role":"symbol","title":"indices(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BoundingBox","preciseIdentifier":"s:12SpatialTrees11BoundingBoxV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"The indices of the points in "},{"code":"box","type":"codeVoice"},{"type":"text","text":", its faces included, ascending."}],"url":"\/documentation\/spatialtrees\/kdtree\/indices(in:)"},"doc://SpatialTrees/documentation/SpatialTrees/BoundingBox":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox","title":"BoundingBox","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"url":"\/documentation\/spatialtrees\/boundingbox","type":"topic","abstract":[{"type":"text","text":"An axis-aligned box: the points whose every coordinate lies between the lower corner’s and"},{"type":"text","text":" "},{"type":"text","text":"the upper corner’s, both included."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}]}}}