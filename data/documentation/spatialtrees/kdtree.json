loat>","type":"codeVoice"},{"text":" one in space; distances are Euclidean. As a collection, a k-d tree’s","type":"text"},{"text":" ","type":"text"},{"text":"elements are its points in the order they were given, and searches answer with their indices.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SpatialTrees/documentation/SpatialTrees/KDTree/Equatable-Implementations":{"role":"collectionGroup","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Equatable-Implementations","kind":"article","abstract":[],"url":"\/documentation\/spatialtrees\/kdtree\/equatable-implementations","title":"Equatable Implementations"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/Collection-Implementations":{"title":"Collection Implementations","role":"collectionGroup","kind":"article","url":"\/documentation\/spatialtrees\/kdtree\/collection-implementations","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Collection-Implementations","abstract":[]},"doc://SpatialTrees/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/SpatialTrees\/s9EscapableP"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/subscript(checked:)":{"title":"subscript(checked:)","role":"symbol","abstract":[{"text":"The point at ","type":"text"},{"type":"codeVoice","code":"position"},{"text":", the index it was given at, throwing instead of trapping on an","type":"text"},{"text":" ","type":"text"},{"text":"invalid index.","type":"text"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/subscript(checked:)","type":"topic","url":"\/documentation\/spatialtrees\/kdtree\/subscript(checked:)","kind":"symbol","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"checked"},{"kind":"text","text":" _: "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kin