{"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"kind":"symbol","metadata":{"title":"KDTree","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/KDTree.swift#L25","fileName":"KDTree.swift"},"navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"modules":[{"name":"SpatialTrees"}],"symbolKind":"struct","roleHeading":"Structure","role":"symbol","externalID":"s:12SpatialTrees6KDTreeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}]},"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(_:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(checked:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(within:of:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndices(to:count:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/subscript(checked:)"],"generated":true,"anchor":"Subscripts","title":"Subscripts"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/Sp