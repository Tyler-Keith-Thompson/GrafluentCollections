{"metadata":{"roleHeading":"Structure","remoteSource":{"fileName":"KDTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/KDTree.swift#L25"},"externalID":"s:12SpatialTrees6KDTreeV","title":"KDTree","navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"symbolKind":"struct","modules":[{"name":"SpatialTrees"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"kind":"symbol","identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","interfaceLanguage":"swift"},"abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(_:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(checked:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(within:of:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndices(to:count:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/subscript(checked:)"],"anchor":"Subscripts","generated":true,"title":"Subscripts"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/BidirectionalCollection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Collection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/CustomStringConvertible-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Equatable-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/RandomAccessCollection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Sequence-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/SpatialTrees\/SK","doc:\/\/SpatialTrees\/Sl","doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s23CustomStringConvertibleP","doc:\/\/SpatialTrees\/SQ","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/SpatialTrees\/Sk","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"title":"Conforms To","kind":"relationships"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees","generated":true,"title":"k-d trees"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/kdtree"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Point"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SIMD","preciseIdentifier":"s:s4SIMDP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Scalar","preciseIdentifier":"s:s11SIMDStorageP6ScalarQa"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"FloatingPoint","preciseIdentifier":"s:SF"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The tree splits the points at the median of one coordinate, then splits each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the next coordinate, cycling through the dimensions (Bentley, “Multidimensional","type":"text"},{"text":" ","type":"text"},{"text":"Binary Search Trees Used for Associative Searching”, 1975). It is stored with no links: the","type":"text"},{"text":" ","type":"text"},{"text":"points are permuted so that every subtree is a contiguous run with its median in the middle.","type":"text"},{"text":" ","type":"text"},{"text":"A search descends toward the query and visits the far side of a split only when the","type":"text"},{"text":" ","type":"text"},{"text":"splitting plane is closer than what it has found (Friedman, Bentley and Finkel, 1977).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                    \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)        \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])              \/\/ [1, 3]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))   \/\/ [0, 1]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Points are SIMD vectors of floating-point scalars, so "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" is a point in the"},{"type":"text","text":" "},{"type":"text","text":"plane and "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":" one in space; distances are Euclidean. As a collection, a k-d tree’s"},{"type":"text","text":" "},{"type":"text","text":"elements are its points in the order they were given, and searches answer with their indices."}]}],"kind":"content"}],"references":{"doc://SpatialTrees/Sl":{"title":"Swift.Collection","identifier":"doc:\/\/SpatialTrees\/Sl","type":"unresolvable"},"doc://SpatialTrees/SK":{"identifier":"doc:\/\/SpatialTrees\/SK","title":"Swift.BidirectionalCollection","type":"unresolvable"},"doc://SpatialTrees/s23CustomStringConvertibleP":{"title":"Swift.CustomStringConvertible","identifier":"doc:\/\/SpatialTrees\/s23CustomStringConvertibleP","type":"unresolvable"},"doc://SpatialTrees/s8SendableP":{"identifier":"doc:\/\/SpatialTrees\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/nearestIndices(to:count:)":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/spatialtrees\/kdtree\/nearestindices(to:count:)","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndices(to:count:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nearestIndices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":", "},{"kind":"externalParam","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"]"}],"abstract":[{"text":"The indices of the ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" points nearest ","type":"text"},{"code":"query","type":"codeVoice"},{"text":", nearest first, ties by smaller index;","type":"text"},{"text":" ","typ