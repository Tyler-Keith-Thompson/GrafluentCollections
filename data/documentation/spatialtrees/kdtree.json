{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/kdtree"]}],"abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"kind":"symbol","metadata":{"role":"symbol","symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"remoteSource":{"fileName":"KDTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/KDTree.swift#L25"},"title":"KDTree","externalID":"s:12SpatialTrees6KDTreeV","modules":[{"name":"SpatialTrees"}]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(_:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(checked:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(within:of:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndices(to:count:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Subscripts","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/subscript(checked:)"],"anchor":"Subscripts"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/BidirectionalCollection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Collection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/CustomStringConvertible-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Equatable-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/RandomAccessCollection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Sequence-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/SpatialTrees\/SK","doc:\/\/SpatialTrees\/Sl","doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s23CustomStringConvertibleP","doc:\/\/SpatialTrees\/SQ","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/SpatialTrees\/Sk","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Point","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s4SIMDP","text":"SIMD","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:s11SIMDStorageP6ScalarQa","text":"Scalar","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SF","text":"FloatingPoint","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The tree splits the points at the median of one coordinate, then splits each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the next coordinate, cycling through the dimensions (Bentley, “Multidimensional"},{"type":"text","text":" "},{"type":"text","text":"Binary Search Trees Used for Associative Searching”, 1975). It is stored with no links: the"},{"type":"text","text":" "},{"type":"text","text":"points are permuted so that every subtree is a contiguous run with its median in the middle."},{"type":"text","text":" "},{"type":"text","text":"A search descends toward the query and visits the far side of a split only when the"},{"type":"text","text":" "},{"type":"text","text":"splitting plane is closer than what it has found (Friedman, Bentley and Finkel, 1977)."}],"type":"paragraph"},{"code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                    \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)        \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])              \/\/ [1, 3]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))   \/\/ [0, 1]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Points are SIMD vectors of floating-point scalars, so ","type":"text"},{"code":"SIMD2<Double>","type":"codeVoice"},{"text":" is a point in the","type":"text"},{"text":" ","type":"text"},{"text":"plane and ","type":"text"},{"code":"SIMD3<Float>","type":"codeVoice"},{"text":" one in space; distances are Euclidean. As a collection, a k-d tree’s","type":"text"},{"text":" ","type":"text"},{"text":"elements are its points in the order they were given, and searches answer with their indices.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"anchor":"k-d-trees"}],"references":{"doc://SpatialTrees/Sl":{"title":"Swift.Collection","type":"unresolvable","identifier":"doc:\/\/SpatialTrees\/Sl"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/RandomAccessCollection-Implementations":{"role":"collectionGroup","url":"\/documentation\/spatialtrees\/kdtree\/randomaccesscollection-implementations","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/RandomAccessCollection-Implementations","title":"RandomAccessCollection Implementations","kind":"article","abstract":[]},"doc://SpatialTrees/documentation/SpatialTrees/KDTree":{"url":"\/documentation\/spatialtrees\/kdtree","abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"KDTree"}],"title":"KDTree","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/nearestIndex(to:)":{"url":"\/documentation\/spatialtrees\/kdtree\/nearestindex(to:)","role":"symbol","abstract":[{"text":"The index of the point nearest ","type":"text"},{"code":"query","type":"codeVoice"},{"text":", the smallest index among equally near points, or","type":"text"},{"text":" ","type":"text"},{"text":"