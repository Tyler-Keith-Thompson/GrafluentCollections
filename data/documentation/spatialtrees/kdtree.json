earest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"symbolKind":"struct","title":"KDTree","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/KDTree.swift#L25","fileName":"KDTree.swift"},"roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"modules":[{"name":"SpatialTrees"}],"externalID":"s:12SpatialTrees6KDTreeV"},"variants":[{"paths":["\/documentation\/spatialtrees\/kdtree"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Point","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SIMD","kind":"typeIdentifier","preciseIdentifier":"s:s4SIMDP"},{"text":", ","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Scalar","kind":"typeIdentifier","preciseIdentifier":"s:s11SIMDStorageP6ScalarQa"},{"text":" : ","kind":"text"},{"text":"FloatingPoint","kind":"typeIdentifier","preciseIdentifier":"s:SF"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree splits the points at the median of one coordinate, then splits each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the next coordinate, cycling through the dimensions (Bentley, “Multidimensional"},{"type":"text","text":" "},{"type":"text","text":"Binary Search Trees Used for Associative Searching”, 1975). It is stored with no links: the"},{"type":"text","text":" "},{"type":"text","text":"points are permuted so that every subtree is a contiguous run with its median in the middle."},{"type":"text","text":" "},{"type":"text","text":"A search descends toward the query and visits the far side of a split only when the"},{"type":"text","text":" "},{"type":"text","text":"splitting plane is closer than what it has found (Friedman, Bentley and Finkel, 1977)."}]},{"type":"codeListing","syntax":"swift","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                    \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)        \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])              \/\/ [1, 3]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))   \/\/ [0, 1]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Points are SIMD vectors of floating-point scalars, so "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" is a point in the"},{"type":"text","text":" "},{"type":"text","text":"plane and "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":" one in space; distances are Euclidean. As a collection, a k-d tree’s"},{"type":"text","text":" "},{"type":"text","text":"elements are its points in the order they were given, and searches answer with their indices."}]}]}],"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SpatialTrees\/SK","doc:\/\/SpatialTrees\/Sl","doc:\/\/SpatialTrees\/s8CopyableP