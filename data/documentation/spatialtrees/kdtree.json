{"metadata":{"navigatorTitle":[{"text":"KDTree","kind":"identifier"}],"role":"symbol","remoteSource":{"fileName":"KDTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/KDTree.swift#L25"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"}],"title":"KDTree","modules":[{"name":"SpatialTrees"}],"symbolKind":"struct","roleHeading":"Structure","externalID":"s:12SpatialTrees6KDTreeV"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/kdtree"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"generated":true,"anchor":"k-d-trees","title":"k-d trees"}],"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Point"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SIMDP","text":"SIMD"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:s11SIMDStorageP6ScalarQa","text":"Scalar"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SF","text":"FloatingPoint"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The tree splits the points at the median of one coordinate, then splits each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the next coordinate, cycling through the dimensions (Bentley, “Multidimensional","type":"text"},{"text":" ","type":"text"},{"text":"Binary Search Trees Used for Associative Searching”, 1975). It is stored with no links: the","type":"text"},{"text":" ","type":"text"},{"text":"points are permuted so that every subtree is a contiguous run with its median in the middle.","type":"text"},{"text":" ","type":"text"},{"text":"A search descends toward the query and visits the far side of a split only when the","type":"text"},{"text":" ","type":"text"},{"text":"splitting plane is closer than what it has found (Friedman, Bentley and Finkel, 1977).","type":"text"}]},{"type":"codeListing","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                    \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)        \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])              \/\/ [1, 3]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))   \/\/ [0, 1]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Points are SIMD vectors of floating-point scalars, so "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" is a point in the"},{"type":"text","text":" "},{"type":"text","text":"plane and "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":" one in space; distances are Euclidean. As a collection, a k-d tree’s"},{"type":"text","text":" "},{"type":"text","text":"elements are its points in the order they were given, and searches answer with their indices."}]}]}],"abstract":[{"type":"text","text":"A k-d tree: a fixed set of points in "},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" dimensions that finds the points nearest a query, or"},{"type":"text","text":" "},{"type":"text","text":"within a radius or a box of it, without testing every point."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SpatialTrees\/SK","doc:\/\/SpatialTrees\/Sl","doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s23CustomStringConvertibleP","doc:\/\/SpatialTrees\/SQ","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/SpatialTrees\/Sk","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"title":"Conforms To","type":"conformsTo"}],"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(_:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(checked:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(within:of:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndices(to:count:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/subscript(checked:)"],"generated":true,"anchor":"Subscripts","title":"Subscripts"},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/BidirectionalCollection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Collection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/CustomStringConvertible-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Equatable-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SpatialTrees\/documentation\/Spatia