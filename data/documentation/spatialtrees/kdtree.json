ree.swift"},"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"}],"role":"symbol"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/SpatialTrees\/SK","doc:\/\/SpatialTrees\/Sl","doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s23CustomStringConvertibleP","doc:\/\/SpatialTrees\/SQ","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s25ExpressibleByArrayLiteralP","doc:\/\/SpatialTrees\/Sk","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"]}],"seeAlsoSections":[{"title":"k-d trees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"generated":true,"anchor":"k-d-trees"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KDTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Point","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s4SIMDP","text":"SIMD","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:s11SIMDStorageP6ScalarQa","text":"Scalar","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SF","text":"FloatingPoint","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The tree splits the points at the median of one coordinate, then splits each half at the"},{"type":"text","text":" "},{"type":"text","text":"median of the next coordinate, cycling through the dimensions (Bentley, “Multidimensional"},{"type":"text","text":" "},{"type":"text","text":"Binary Search Trees Used for Associative Searching”, 1975). It is stored with no links: the"},{"type":"text","text":" "},{"type":"text","text":"points are permuted so that every subtree is a contiguous run with its median in the middle."},{"type":"text","text":" "},{"type":"text","text":"A search descends toward the query and visits the far side of a split only when the"},{"type":"text","text":" "},{"type":"text","text":"splitting plane is closer than what it has found (Friedman, Bentley and Finkel, 1977)."}],"type":"paragraph"},{"syntax":"swift","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                    \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)        \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])              \/\/ [1, 3]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))   \/\/ [0, 1]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Points are SIMD vectors of floating-point scalars, so "},{"type":"codeVoice","code":"SIMD2<Double>"},{"type":"text","text":" is a point in the"},{"type":"text","text":" "},{"type":"text","text":"plane and "},{"type":"codeVoice","code":"SIMD3<Float>"},{"type":"text","text":" one in space; distances are Euclidean. As a collection, a k-d tree’s"},{"type":"text","text":" "},{"type":"text","text":"elements are its points in the order they were given, and searches answer with their indices."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/spatialtrees\/kdtree"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SpatialTrees/documentation/SpatialTrees/KDTree/RandomAccessCollection-Implementations":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/RandomAccessCollection-Implementations","kind":"article","title":"RandomAccessCollection Implementations","abstract":[],"url":"\/documentation\/spatialtrees\/kdtree\/randomaccesscollection-implementations","type":"topic","role":"collectionGroup"},"doc://SpatialTrees/s8CopyableP":{"identifier":"doc:\/\/SpatialTrees\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/nearestIndex(to:)":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","url":"\/documentation\/spatialtrees\/kdtree\/nearestindex(to:)","abstract":[{"type":"text","text":"The index of the point nearest "},{"code":"query","type":"codeVoice"},{"type":"text","text":", the smallest index among equally near points, or"},{"type":"text","text":" "},{"type":"text","text":"nil when the tree is empty or a coordinate of "},{"code":"query","type":"codeVoice"},{"type":"text","text":" is NaN."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestIndex","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Point","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"nearestIndex(to:)","kind":"symbol","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/ExpressibleBy