{"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"abstract":[{"text":"A k-d tree: a fixed set of points in ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" dimensions that finds the points nearest a query, or","type":"text"},{"text":" ","type":"text"},{"text":"within a radius or a box of it, without testing every point.","type":"text"}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(_:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(checked:)"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(within:of:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndices(to:count:)"],"generated":true},{"title":"Subscripts","anchor":"Subscripts","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/subscript(checked:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/BidirectionalCollection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Collection-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/CustomStringConvertible-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/Equatable-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/ExpressibleByArrayLiteral-Implementations","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/RandomAccessCollection-Implementations","doc:\/\/SpatialTrees\/documentation\/Sp