:"s:s4SIMDP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Scalar","preciseIdentifier":"s:s11SIMDStorageP6ScalarQa"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"FloatingPoint","preciseIdentifier":"s:SF"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The tree splits the points at the median of one coordinate, then splits each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the next coordinate, cycling through the dimensions (Bentley, “Multidimensional","type":"text"},{"text":" ","type":"text"},{"text":"Binary Search Trees Used for Associative Searching”, 1975). It is stored with no links: the","type":"text"},{"text":" ","type":"text"},{"text":"points are permuted so that every subtree is a contiguous run with its median in the middle.","type":"text"},{"text":" ","type":"text"},{"text":"A search descends toward the query and visits the far side of a split only when the","type":"text"},{"text":" ","type":"text"},{"text":"splitting plane is closer than what it has found (Friedman, Bentley and Finkel, 1977).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                    \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)        \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])              \/\/ [1, 3]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))   \/\/ [0, 1]"]},{"type":"paragraph","inlineContent":[{"text":"Points are SIMD vectors of floating-point scalars, so ","type":"text"},{"code":"SIMD2<Double>","type":"codeVoice"},{"text":" is a point in the","type":"text"},{"text":" ","type":"text"},{"text":"plane and ","type":"text"},{"code":"SIMD3<Float>","type":"codeVoice"},{"text":" one in space; distances are Euclidean. As a collection, a k-d tree’s","type":"text"},{"text":" ","type":"text"},{"text":"elements are its points in the order they were given, and searches answer with their indices.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/spatialtrees\/kdtree"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/KDTree/CustomStringConvertible-Implementations":{"kind":"article","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/CustomStringConvertible-Implementations","url":"\/documentation\/spatialtrees\/kdtree\/customstringconvertible-implementations","title":"CustomStringConvertible Implementations","abstract":[],"role":"collectionGroup","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/nearestIndex(to:)":{"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","title":"nearestIndex(to:)","abstract":[{"text":"The index of the point nearest ","type":"text"},{"type":"codeVoice","code":"query"},{"text":", the smallest index among equally near points, or","type":"text"},{"text":" ","type":"text"},{"text":"nil when the tree is empty or a coordinate of ","type":"text"},{"type":"codeVoice","code":"query"},{"text":" is NaN.","type":"text"}],"url":"\/documentation\/spatialtrees\/kdtree\/nearestindex(to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nearestIndex"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?"}],"role":"symbol","type":"topic"},"doc://SpatialTrees/documentation/SpatialTrees/KDTree/indices(within:of:)":{"kind":"symbol","type":"topic","title":"indices(within:of:)","identifier":"doc:\/\/SpatialTrees\/documentation\/Spatia