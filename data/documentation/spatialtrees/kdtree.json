{"seeAlsoSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/BoundingBox"],"title":"k-d trees","anchor":"k-d-trees","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KDTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Point"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SIMDP","text":"SIMD"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Point"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:s11SIMDStorageP6ScalarQa","text":"Scalar"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SF","text":"FloatingPoint"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The tree splits the points at the median of one coordinate, then splits each half at the","type":"text"},{"text":" ","type":"text"},{"text":"median of the next coordinate, cycling through the dimensions (Bentley, “Multidimensional","type":"text"},{"text":" ","type":"text"},{"text":"Binary Search Trees Used for Associative Searching”, 1975). It is stored with no links: the","type":"text"},{"text":" ","type":"text"},{"text":"points are permuted so that every subtree is a contiguous run with its median in the middle.","type":"text"},{"text":" ","type":"text"},{"text":"A search descends toward the query and visits the far side of a split only when the","type":"text"},{"text":" ","type":"text"},{"text":"splitting plane is closer than what it has found (Friedman, Bentley and Finkel, 1977).","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let tree = KDTree<SIMD2<Double>>([[2, 3], [5, 4], [9, 6], [4, 7], [8, 1], [7, 2]])","tree.nearestIndex(to: [9, 2])                    \/\/ 4: the point [8, 1]","tree.nearestIndices(to: [9, 2], count: 2)        \/\/ [4, 5]","tree.indices(within: 3, of: [5, 5])              \/\/ [1, 3]","tree.indices(in: BoundingBox(lower: [0, 0], upper: [5, 5]))   \/\/ [0, 1]"]},{"type":"paragraph","inlineContent":[{"text":"Points are SIMD vectors of floating-point scalars, so ","type":"text"},{"code":"SIMD2<Double>","type":"codeVoice"},{"text":" is a point in the","type":"text"},{"text":" ","type":"text"},{"text":"plane and ","type":"text"},{"code":"SIMD3<Float>","type":"codeVoice"},{"text":" one in space; distances are Euclidean. As a collection, a k-d tree’s","type":"text"},{"text":" ","type":"text"},{"text":"elements are its points in the order they were given, and searches answer with their indices.","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/kdtree"]}],"topicSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(_:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/init(checked:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/indices(within:of:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndex(to:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/nearestIndices(to:count:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/KDTree\/subscript(checked:)"],"title":"Subscripts","anchor":"Subscripts","generated":true},{"identifiers":["doc:\/\/Sp