{"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/MXCIFOctree.swift#L23","fileName":"MXCIFOctree.swift"},"modules":[{"name":"SpatialTrees"}],"symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFOctree","kind":"identifier"}],"navigatorTitle":[{"text":"MXCIFOctree","kind":"identifier"}],"externalID":"s:12SpatialTrees11MXCIFOctreeV","title":"MXCIFOctree"},"seeAlsoSections":[{"title":"Boxes","anchor":"Boxes","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"],"generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFOctree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"It is "},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","isActive":true,"type":"reference"},{"type":"text","text":" in three dimensions, with the same storage: the box is split into"},{"type":"text","text":" "},{"type":"text","text":"eight equal octants, and each octant again, and each element hangs on the smallest cell that"},{"type":"text","text":" "},{"type":"text","text":"wholly contains its box, so a box that straddles a cell’s centre plane stays at that cell. A"},{"type":"text","text":" "},{"type":"text","text":"search visits only the cells that meet its region; cells are made on the way down to an"},{"typ