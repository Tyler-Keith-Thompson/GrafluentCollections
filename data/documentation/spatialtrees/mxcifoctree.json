ement and freed when their subtree empties, and cells at depth 24 have no octants."}]},{"code":["var space = MXCIFOctree<Int>(bounds: BoundingBox(lower: [0, 0, 0], upper: [1, 1, 1]))","space.insert(1, in: BoundingBox(lower: [0.1, 0.1, 0.1], upper: [0.6, 0.2, 0.2]))","space.insert(2, in: BoundingBox(lower: [0.5, 0.1, 0.1], upper: [0.9, 0.3, 0.3]))","space.overlappingPairs().count                  \/\/ 1","space.items(containing: [0.55, 0.15, 0.15]).count   \/\/ 2"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Boxes include their faces, so two that touch overlap. A box whose lower face lies on a centre"},{"type":"text","text":" "},{"type":"text","text":"plane belongs to the upper octant. The elements and their boxes are a sequence, in no"},{"type":"text","text":" "},{"type":"text","text":"particular order."}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/mxcifoctree"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SpatialTrees/documentation/SpatialTrees/MXCIFOctree/insert(_:checkedIn:)":{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree\/insert(_:checkedIn:)","kind":"symbol","title":"insert(_:checkedIn:)","url":"\/documentation\/spatialtrees\/mxcifoctree\/insert(_:checkedin:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Inserts "},{"type":"codeVoice","code":"element"},{"type":"text","text":" over "},{"type":"codeVoice","code":"box"},{"type":"text","text":", throwing instead of trapping on a box outside the bounds."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{