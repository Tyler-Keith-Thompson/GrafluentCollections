":0,"minor":3,"major":0},"metadata":{"roleHeading":"Structure","symbolKind":"struct","title":"MXCIFOctree","role":"symbol","modules":[{"name":"SpatialTrees"}],"externalID":"s:12SpatialTrees11MXCIFOctreeV","remoteSource":{"fileName":"MXCIFOctree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/MXCIFOctree.swift#L23"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXCIFOctree"}],"navigatorTitle":[{"text":"MXCIFOctree","kind":"identifier"}]},"abstract":[{"text":"An MX-CIF octree: elements over boxes in a box in space, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFOctree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"It is ","type":"text"},{"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","isActive":true,"type":"reference"},{"text":" in three dimensions, with the same storage: the box is split into","type":"text"},{"text":" ","type":"text"},{"text":"eight equal octants, and each octant again, and each element hangs on the smallest cell that","type":"text"},{"text":" ","type":"text"},{"text":"wholly contains its box, so a box that straddles a cell’s centre plane stays at that cell. A","type":"text"},{"text":" ","type":"text"},{"text":"search visits only the cells that meet its region; cells are made on the way down to an","type":"text"},{"text":" ","type":"text"},{"text":"element and freed when their subtree empties, and cells at depth 24 have no octants.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var space = MXCIFOctree<Int>(bounds: BoundingBox(lower: [0, 0, 0], upper: [1, 1, 1]))","space.insert(1, in: BoundingBox(lower: [0.1, 0.1, 0.1], upper: [0.6, 0.2, 0.2]))","space.insert(2, in: BoundingBox(lower: [0.5, 0.1, 0.1], upper: [0.9, 0.3, 0.3]))","space.overlappingPairs().count                  \/\/ 1","space.items(containing: [0.55, 0.15, 0.15]).count   \/\/ 2"],"type":"codeListing"},{"inlineContent":[{"text":"Boxes include their faces, so two that touch overlap. A box whose lower face lies on a centre","type":"text"},{"text":" ","type":"text"},{"text":"plane belongs to the upper octant. The elements and their boxes are a sequence, in no","type":"text"},{"text":" ","type":"text"},{"text":"particular order.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://SpatialTrees/documentation/SpatialTrees/MXCIFOctree/items(containing:)":{"type":"topic","title":"items(containing:)","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree\/items(containing:)","role":"symbol","abstract":[{"type":"text","text":"The elements and boxes whose box contains "},{"type":"codeVoice","code":"point"},{"type":"text","text":", in no particular order; none when the"},{"type":"text","text":" "},{"type":"text","text":"point lies outside "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree\/bounds"},{"type":"text","text":"."}],"