{"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/init(bounds:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/bounds","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/count","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/isEmpty"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:checkedIn:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(containing:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(overlapping:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/overlappingPairs()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(in:where:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/Sequence-Implementations"]}],"variants":[{"paths":["\/documentation\/spatialtrees\/mxcifquadtree"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,"},{"type":"text","text":" "},{"type":"text","text":"those containing a point, and every pair that overlaps, and takes insertions and removals as"},{"type":"text","text":" "},{"type":"text","text":"the boxes move."}],"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"metadata":{"externalID":"s:12SpatialTrees13MXCIFQuadtreeV","remoteSource":{"fileName":"MXCIFQuadtree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/MXCIFQuadtree.swift#L25"},"role":"symbol","symbolKind":"struct","title":"MXCIFQuadtree","roleHeading":"Structure","modules":[{"name":"SpatialTrees"}],"navigatorTitle":[{"kind":"identifier","text":"MXCIFQuadtree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXCIFQuadtree"}]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"]}],"kind":"symbol","seeAlsoSections":[{"title":"Boxes","generated":true,"anchor":"Boxes","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFQuadtree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The rectangle is split into four equal quadrants, and each quadrant again, and each element"},{"type":"text","text":" "},{"type":"text","text":"hangs on the smallest cell that wholly contains its box, so a box that straddles a cell’s"},{"type":"text","text":" "},{"type":"text","text":"centre line stays at that cell (Kedem, “The Quad-CIF Tree”, 1982). A search visits only the"},{"type":"text","text":" "},{"type":"text","text":"cells that meet its region. Cells are made on the way down to an element and freed when their"},{"type":"text","text":" "},{"type":"text","text":"subtree empties. Cells at depth 24 have no quadrants, so smaller boxes stay there."}],"type":"paragraph"},{"syntax":"swift","code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.insert(\"garden\", in: BoundingBox(lower: [70, 70], upper: [90, 90]))","plan.items(containing: [20, 15]).map(\\.element)          \/\/ [\"hall\"]","plan.items(overlapping: BoundingBox(lower: [25, 18], upper: [35, 25])).count   \/\/ 2","plan.overlappingPairs().count                            \/\/ 1: the hall and the office touch"],"type":"codeListing"},{"inlineContent":[{"text":"Boxes include their faces, so two that touch overlap. A box whose lower edge lies on a centre","type":"text"},{"text":" ","type":"text"},{"text":"line belongs to the upper quadrant. The elements and their boxes are a sequence, in no","type":"text"},{"text":" ","type":"text"},{"text":"particular order.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","interfaceLanguage":"swift"},"references":{"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree/Sequence-Implementations":{"abstract":[],"title":"Sequence Implementations","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/Sequence-Implementations","role":"collectionGroup","type":"topic","url":"\/documentation\/spatialtrees\/mxcifquadtree\/sequence-implementations","kind":"article"},"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree/bounds":{"role":"symbol","type":"topic","identifier":"doc:\/\/SpatialTrees\/do