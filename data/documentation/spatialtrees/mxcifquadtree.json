/documentation\/SpatialTrees\/MXCIFQuadtree\/bounds","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/count","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/isEmpty"],"title":"Instance Properties","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:checkedIn:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(containing:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(overlapping:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/overlappingPairs()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(in:where:)"],"title":"Instance Methods","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/Sequence-Implementations"],"title":"Default Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFQuadtree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The rectangle is split into four equal quadrants, and each quadrant again, and each element","type":"text"},{"text":" ","type":"text"},{"text":"hangs on the smallest cell that wholly contains its box, so a box that straddles a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"centre line stays at that cell (Kedem, “The Quad-CIF Tree”, 1982). A search visits only the","type":"text"},{"text":" ","type":"text"},{"text":"cells that meet its region. Cells are made on the way down to an element and freed when their","type":"text"},{"text":" ","type":"text"},{"text":"subtree empties. Cells at depth 24 have no quadrants, so smaller boxes stay there.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.insert(\"garden\", in: BoundingBox(lower: [70, 70], upper: [90, 90]))","plan.items(containing: [20, 15]).map(\\.element)          \/\/ [\"hall\"]","plan.items(overlapping: BoundingBox(lower: [25, 18], upper: [35, 25])).count   \/\/ 2","plan.overlappingPairs().count                            \/\/ 1: the hall and the office touch"],"type":"codeListing"},{"inlineContent":[{"text":"Boxes include their faces, so two that touch overlap. A box whose lower edge lies on a centre","type":"text"},{"text":" ","type":"text"},{"text":"line belongs to the upper quadrant. The elements and their boxes are a sequence, in no","type":"text"},{"text":" ","type":"text"},{"text":"particular order.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/mxcifquadtree"]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/MXCIFQuadtree/isEmpty":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEmpty","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"isEmpty","role":"symbol","type":"topic","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/isEmpty","kind":"symbol","url":"\/documentation\/spatialtrees\/mxcifquadtree\/isempty","abstract":[{"type":"text