ers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:checkedIn:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(containing:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(overlapping:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/overlappingPairs()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(in:where:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/Sequence-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"abstract":[{"type":"text","text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,"},{"type":"text","text":" "},{"type":"text","text":"those containing a point, and every pair that overlaps, and takes insertions and removals as"},{"type":"text","text":" "},{"type":"text","text":"the boxes move."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXCIFQuadtree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rectangle is split into four equal quadrants, and each quadrant again, and each element"},{"type":"text","text":" "},{"type":"text","text":"hangs on the smallest cell that wholly contains its box, so a box that straddles a cell’s"},{"type":"text","text":" "},{"type":"text","text":"centre line stays at that cell (Kedem, “The Quad-CIF Tree”, 1982). A search visits only the"},{"type":"text","text":" "},{"type":"text","text":"cells that meet its region. Cells are made on the way down to an element and freed when their"},{"type":"text","text":" "},{"type":"text","text":"subtree empties. Cells at depth 24 have no quadrants, so smaller boxes stay there."}]},{"type":"codeListing","syntax":"swift","code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.insert(\"garden\", in: BoundingBox(lower: [70, 70], upper: [90, 90]))","plan.items(containing: [20, 15]).map(\\.element)          \/\/ [\"hall\"]","plan.items(overlapping: BoundingBox(lower: [25, 18], upper: [35, 25])).count   \/\/ 2","plan.overlappingPairs().count                            \/\/ 1: the hall and the office touch"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Boxes include their faces, so two that touch overlap. A box whose lower edge lies on a centre"},{"type":"text","text":" "},{"type":"text","text":"line belongs to the upper quadrant. The elements and their boxes are a sequence, in no"},{"type":"text","text":" "},{"type":"text","text":"particular order."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SpatialTrees/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/SpatialTrees\/s16SendableMetatypeP"},"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"kind":"symbol","abstract":[{"type":"text","text":"Two items of an MX-CIF quadtree or octree whose boxes overlap."}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OverlappingPair"}],"url":"\/documentation\/spatialtrees\/overlappingpair","fragments":[{"kind":"keywor