{"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"abstract":[{"text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/init(bounds:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/bounds","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/count","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/isEmpty"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:checkedIn:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/insert(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(containing:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/items(overlapping:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/overlappingPairs()","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(_:in:)","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/remove(in:where:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/Sequence-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFQuadtree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The rectangle is split into four equal quadrants, and each quadrant again, and each element","type":"text"},{"text":" ","type":"text"},{"text":"hangs on the smallest cell that wholly contains its box, so a box that straddles a cell’s","type":"text"},{"text":" ","type":"text"},{"text":"centre line stays at that cell (Kedem, “The Quad-CIF Tree”, 1982). A search visits only the","type":"text"},{"text":" ","type":"text"},{"text":"cells that meet its region. Cells are made on the way down to an element and freed when their","type":"text"},{"text":" ","type":"text"},{"text":"subtree empties. Cells at depth 24 have no quadrants, so smaller boxes stay there.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.insert(\"garden\", in: BoundingBox(lower: [70, 70], upper: [90, 90]))","plan.items(containing: [20, 15]).map(\\.element)          \/\/ [\"hall\"]","plan.items(overlapping: BoundingBox(lower: [25, 18], upper: [35, 25])).count   \/\/ 2","plan.overlappingPairs().count                            \/\/ 1: the hall and the office touch"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Boxes include their faces, so two that touch overlap. A box whose lower edge lies on a centre"},{"type":"text","text":" "},{"type":"text","text":"line belongs to the upper quadrant. The elements and their boxes are a sequence, in no"},{"type":"text","text":" "},{"type":"text","text":"particular order."}]}]}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/mxcifquadtree"]}],"metadata":{"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXCIFQuadtree","kind":"identifier"}],"navigatorTitle":[{"text":"MXCIFQuadtree","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/MXCIFQuadtree.swift#L25","fileName":"MXCIFQuadtree.swift"},"role":"symbol","externalID":"s:12SpatialTrees13MXCIFQuadtreeV","modules":[{"name":"SpatialTrees"}],"title":"MXCIFQuadtree","roleHeading":"Structure"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"type":"conformsTo"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","seeAlsoSections":[{"title":"Boxes","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFOctree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialBoxItem","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair"],"generated":true,"anchor":"Boxes"}],"references":{"doc://SpatialTrees/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/SpatialTrees\/s8SendableP"},"doc://SpatialTrees/documentation/SpatialTrees/OverlappingPair":{"url":"\/documentation\/spatialtrees\/overlappingpair","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/OverlappingPair","abstract":[{"text":"Two items of an MX-CIF quadtree or octree whose boxes overlap.","type":"text"}],"title":"OverlappingPair","role":"symbol","kind":"symbol","fragments":[{"kind":"keywo