on\/SpatialTrees\/MXCIFQuadtree\/remove(in:where:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree\/Sequence-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"type":"conformsTo","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/spatialtrees\/mxcifquadtree"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/MXCIFQuadtree","interfaceLanguage":"swift"},"abstract":[{"text":"An MX-CIF quadtree: elements over boxes in a rectangle, which finds those overlapping a box,","type":"text"},{"text":" ","type":"text"},{"text":"those containing a point, and every pair that overlaps, and takes insertions and removals as","type":"text"},{"text":" ","type":"text"},{"text":"the boxes move.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXCIFQuadtree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The rectangle is split into four equal quadrants, and each quadrant again, and each element"},{"type":"text","text":" "},{"type":"text","text":"hangs on the smallest cell that wholly contains its box, so a box that straddles a cell’s"},{"type":"text","text":" "},{"type":"text","text":"centre line stays at that cell (Kedem, “The Quad-CIF Tree”, 1982). A search visits only the"},{"type":"text","text":" "},{"type":"text","text":"cells that meet its region. Cells are made on the way down to an element and freed when their"},{"type":"text","text":" "},{"type":"text","text":"subtree empties. Cells at depth 24 have no quadrants, so smaller boxes stay there."}],"type":"paragraph"},{"code":["var plan = MXCIFQuadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","plan.insert(\"hall\", in: BoundingBox(lower: [10, 10], upper: [60, 20]))","plan.insert(\"office\", in: BoundingBox(lower: [10, 20], upper: [30, 40]))","plan.insert(\"garden\", in: BoundingBox(lower: [70, 70], upper: [90, 90]))","plan.items(containing: [20, 15]).map(\\.element)          \/\/ [\"hall\"]","plan.items(overlapping: BoundingBox(lower: [25, 18], upper: [35, 25])).count   \/\/ 2","plan.overlappingPairs().count                            \/\/ 1: the hall and the office touch"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Boxes include their faces, so two that touch overlap. A box whose lower edge lies on a centre","type":"text"},{"text":" ","type":"text"},{"text":"line belongs to the upper quadrant. The elements and their boxes are a sequence, in no","type":"text"},{"text":" ","type":"text"},{"text":"particular order.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/SpatialBoxItem":{"url":"\/documentation\/spatialtrees\/spatialboxitem","abstract":[{"type":"text","text":"An item of an MX-CIF quadtree or octree: a box and the element stored over it."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpatialBoxItem"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SpatialBoxItem"}],"title":"SpatialBoxItem","identifier":"doc:\/\/Spa