rees\/documentation\/SpatialTrees\/Quadtree","isActive":true},{"type":"text","text":" in three"},{"type":"text","text":" "},{"type":"text","text":"dimensions, with the same storage: a search visits only the cells that meet its region, a"},{"type":"text","text":" "},{"type":"text","text":"removal that leaves a cell’s octants holding no more than one bucket merges them back, and"},{"type":"text","text":" "},{"type":"text","text":"cells at depth 24 never split, so any number of elements may share one point."}],"type":"paragraph"},{"code":["var space = Octree<Int>(bounds: BoundingBox(lower: [0, 0, 0], upper: [1, 1, 1]))","space.insert(1, at: [0.1, 0.1, 0.1])","space.insert(2, at: [0.9, 0.9, 0.9])","space.nearest(to: [0.2, 0.2, 0.2])?.element   \/\/ 1"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A point on the plane between two octants belongs to the upper one. The elements and their","type":"text"},{"text":" ","type":"text"},{"text":"points are a sequence, in no particular order.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://SpatialTrees/documentation/SpatialTrees/Quadtree":{"navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"}],"type":"topic","abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","role":"symbol","url":"\/documentation\/spatialtrees\/quadtree","title":"Quadtree","kind":"symbol"},"doc://SpatialTrees/documentation/SpatialTrees/Octree/count":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"count","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","prec