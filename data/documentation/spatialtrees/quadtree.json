\/ [\"station\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A point on the line between two quadrants belongs to the upper one. The elements and their"},{"type":"text","text":" "},{"type":"text","text":"points are a sequence, in no particular order."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/quadtree"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"title":"Quadtrees and octrees","anchor":"Quadtrees-and-octrees"}],"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"metadata":{"modules":[{"name":"SpatialTrees"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Quadtree"}],"remoteSource":{"fileName":"Quadtree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/Quadtree.swift#L24"},"externalID":"s:12SpatialTrees8QuadtreeV","title":"Quadtree","symbolKind":"struct","role":"symbol","roleHeading":"Structure"},"references":{"doc://SpatialTrees/documentation/SpatialTrees/Quadtree/remove(at:where:)":{"kind":"symbol","url":"\/documentation\/spatialtrees\/quadtree\/remove(at:where:)","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree\/remove(at:where:)","abstract":[{"type":"text","text":"Removes an element at "},{"type":"codeVoice","code":"point"},{"type":"text","text":" that satisfies "},{"type":"codeVoice","code":"predicate"},{"type":"text","text":", and returns it, or nil when"},{"type":"text","text":" "},{"type":"text","text":"none does."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text"