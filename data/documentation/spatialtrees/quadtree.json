s holding no"},{"type":"text","text":" "},{"type":"text","text":"more than one bucket merges them back. Cells at depth 24 never split, so any number of"},{"type":"text","text":" "},{"type":"text","text":"elements may share one point."}],"type":"paragraph"},{"syntax":"swift","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"library\", at: [12, 22])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element                          \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count                    \/\/ 2","map.items(in: BoundingBox(lower: [50, 50], upper: [100, 100])).map(\\.element)   \/\/ [\"station\"]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A point on the line between two quadrants belongs to the upper one. The elements and their"},{"type":"text","text":" "},{"type":"text","text":"points are a sequence, in no particular order."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius","type":"text"},{"text":" ","type":"text"},{"text":"of a point, or nearest a point, and takes insertions and removals as the points move.","type":"text"}],"references":{"doc://SpatialTrees/s8CopyableP":{"identifier":"doc:\/\/SpatialTrees\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://SpatialTrees/documentation/SpatialTrees/Quadtree/remove(at:where:)":{"kind":"symbol","identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree\/remove(at:where:)","type":"topic","role":"symbol","title":"remove(at:where:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5SIMD2V","text":"SIMD2"},{"kind":"text","text":"<"},{"kind":"ty