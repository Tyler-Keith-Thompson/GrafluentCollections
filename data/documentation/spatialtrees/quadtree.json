])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element                          \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count                    \/\/ 2","map.items(in: BoundingBox(lower: [50, 50], upper: [100, 100])).map(\\.element)   \/\/ [\"station\"]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A point on the line between two quadrants belongs to the upper one. The elements and their","type":"text"},{"text":" ","type":"text"},{"text":"points are a sequence, in no particular order.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/quadtree"]}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"type":"conformsTo","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees","generated":true,"title":"Quadtrees and octrees"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SpatialTrees/documentation/SpatialTrees/Octree":{"role":"symbol","navigatorTitle":[{"text":"Octree","kind":"identifier"}],"identifier":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","url":"\/documentation\/spatialtrees\/octree","kind":"symbol","abstract":[{"type":"text","text":"An octree: elements at points in a box in space, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"type":"topic","title":"Octree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octree","kind":"identifier"}]},"doc://Spat