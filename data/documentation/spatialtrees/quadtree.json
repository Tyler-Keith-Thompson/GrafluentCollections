{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"]}],"kind":"symbol","metadata":{"symbolKind":"struct","modules":[{"name":"SpatialTrees"}],"title":"Quadtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"role":"symbol","externalID":"s:12SpatialTrees8QuadtreeV","roleHeading":"Structure","remoteSource":{"fileName":"Quadtree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/Quadtree.swift#L24"},"navigatorTitle":[{"text":"Quadtree","kind":"identifier"}]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spatialtrees\/quadtree"]}],"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"identifier":{"url":"doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Quadtree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The rectangle is split into four equal quadrants, and each quadrant again, until every leaf","type":"text"},{"text":" ","type":"text"},{"text":"holds at most ","type":"text"},{"code":"bucketCapacity","type":"codeVoice"},{"text":" elements (Finkel and Bentley, “Quad Trees: A Data Structure for","type":"text"},{"text":" ","type":"text"},{"text":"Retrieval on Composite Keys”, 1974). A search visits only the cells that meet its region.","type":"text"},{"text":" ","type":"text"},{"text":"Cells and elements live in flat arrays; a removal that leaves a cell’s quadrants holding no","type":"text"},{"text":" ","type":"text"},{"text":"more than one bucket merges them back. Cells at depth 24 never split, so any number of","type":"text"},{"text":" ","type":"text"},{"text":"elements may share one point.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var map = Quadtree<String>(bounds: BoundingBox(lower: [0, 0], upper: [100, 100]))","map.insert(\"café\", at: [10, 20])","map.insert(\"library\", at: [12, 22])","map.insert(\"station\", at: [80, 75])","map.nearest(to: [11, 19])?.element                          \/\/ \"café\"","map.items(within: 5, of: [11, 21]).count                    \/\/ 2","map.items(in: BoundingBox(lower: [50, 50], upper: [100, 100])).map(\\.element)   \/\/ [\"station\"]"]},{"type":"paragraph","inlineContent":[{"text":"A point on the line between two quadrants belongs to the upper one. The elements and their","type":"text"},{"text":" ","type":"text"},{"text":"points are a sequence, in no particular order.","type":"text"}]}]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree\/init(bounds:bucketCapacity:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree\/bounds","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree\/bucketCapacity","doc:\/\/SpatialTrees\/docume