 100])).map(\\.element)   \/\/ [\"station\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A point on the line between two quadrants belongs to the upper one. The elements and their"},{"type":"text","text":" "},{"type":"text","text":"points are a sequence, in no particular order."}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/SpatialTrees\/s8CopyableP","doc:\/\/SpatialTrees\/s9EscapableP","doc:\/\/SpatialTrees\/s8SendableP","doc:\/\/SpatialTrees\/s16SendableMetatypeP","doc:\/\/SpatialTrees\/ST"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Octree","doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/SpatialItem"],"anchor":"Quadtrees-and-octrees","title":"Quadtrees and octrees"}],"abstract":[{"type":"text","text":"A quadtree: elements at points in a rectangle, which finds those in a box, within a radius"},{"type":"text","text":" "},{"type":"text","text":"of a point, or nearest a point, and takes insertions and removals as the points move."}],"hierarchy":{"paths":[["doc:\/\/SpatialTrees\/documentation\/SpatialTrees"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Structure","navigatorTitle":[{"text":"Quadtree","kind":"identifier"}],"externalID":"s:12SpatialTrees8QuadtreeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Quadtree","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SpatialTrees\/Quadtree.swift#L24","fileName":"Quadtree.swift"},"symbolKind":"struct","role":"symbol","modules":[{"name":"SpatialTrees"}],"title":"Quadtree"},"kind":"symbol","topicSections":[{"generated":true,"identifiers":["doc:\/\/SpatialTrees\/documentation\/SpatialTrees\/Quadtree\/init(bounds:bucketCapacity:)"],"anchor":"Initializers","title":"Initializers"},{"ge