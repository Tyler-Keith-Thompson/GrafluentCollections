xts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"title":"SuffixTree"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"abstract":[{"type":"text","text":"A text’s suffix array and longest-common-prefix array: the starting positions of its"},{"type":"text","text":" "},{"type":"text","text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before"},{"type":"text","text":" "},{"type":"text","text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990)."}],"navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"kind":"symbol","title":"SuffixArray","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","url":"\/documentation\/suffixstructures\/suffixarray"},"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"url":"\/documentation\/suffixstructures\/trees","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","type":"topic","role":"collection","kind":"symbol","abstract":[],"title":"Trees"}}}