{"metadata":{"symbolKind":"module","role":"collection","roleHeading":"Framework","title":"SuffixStructures","modules":[{"name":"SuffixStructures"}],"externalID":"SuffixStructures"},"variants":[{"paths":["\/documentation\/suffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","type":"reference","isActive":true},{"text":" holds the starting positions of a text’s suffixes in sorted order, with the","type":"text"},{"text":" ","type":"text"},{"text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every","type":"text"},{"text":" ","type":"text"},{"text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the","type":"text"},{"text":" ","type":"text"},{"text":"prefix lengths give the longest repeated substring and the number of distinct substrings.","type":"text"}]},{"type":"codeListing","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The text may be any sequence of "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" symbols. For "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"construction sorts the bytes themselves in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") (induced sorting: Nong, Zhang and Chan, 2009);"},{"type":"text","text":" "},{"type":"text","text":"any other symbol type is first replaced by its rank among the text’s distinct symbols."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","type":"reference"},{"text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithm (1995), over one text or several. A pattern is found in O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":") steps down from the","type":"text"},{"text":" ","type":"text"},{"text":"root; the deepest internal node is the longest repeated substring, and the deepest node with","type":"text"},{"text":" ","type":"text"},{"text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", and its suffix links are a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","type":"reference"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","type":"reference"},{"text":" is the smallest automaton whose paths from its start state spell the","type":"text"},{"text":" ","type":"text"},{"text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" − 1","type":"text"},{"text":" ","type":"text"},{"text":"states. It answers membership, occurrence counts and first occurrences in O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":") transitions, and","type":"text"},{"text":" ","type":"text"},{"text":"finds the longest substring another text shares by walking that text over it. Its transitions","type":"text"},{"text":" ","type":"text"},{"text":"are a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","type":"reference"},{"text":", and its suffix links convert to","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent’s ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"anchor":"Suffix-arrays","title":"Suffix arrays","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"]},{"anchor":"Suffix-trees","title":"Suffix trees","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"]},{"anchor":"Suffix-automata","title":"Suffix automata","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"]}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"A text’s suffix array and longest-common-prefix array: the starting positions of its","type":"text"},{"text":" ","type":"text"},{"text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before","type":"text"},{"text":" ","type":"text"},{"text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990).","type":"text"}],"navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"type":"topic","url":"\/documentation\/suffixstructures\/suffixarray","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","title":"SuffixArray"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"type":"topic","abstract":[{"type":"text","text":"The automaton’s transitions as a directed acyclic graph: a vertex per state, numbered from"},{"type":"text","text":" "},{"type":"text","text":"0 for the start state, and an edge per transition, whose symbol"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","isActive":true},{"type":"text","text":" gives."}],"kind":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"title":"transitionsView","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionsView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SuffixAutomaton","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"TransitionsView","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV15TransitionsViewV"}],"role":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.property"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","title":"suffixLinksView","kind":"symbol","url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","type":"topic","abstract":[{"type":"text","text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each"},{"type":"text","text":" "},{"type":"text","text":"internal node but the root to the node whose path label is its own without the first"},{"type":"text","text":" "},{"type":"text","text":"symbol."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"suffixLinksView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SuffixTree","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"SuffixLinksView","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"abstract":[{"type":"text","text":"The symbol a transition reads."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","title":"symbol(ofEdgeAt:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixAutomaton"}],"kind":"symbol","role":"symbol","abstract":[{"text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix","type":"text"},{"text":" ","type":"text"},{"text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,","type":"text"},{"text":" ","type":"text"},{"text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SuffixAutomaton"}],"type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","url":"\/documentation\/suffixstructures\/suffixautomaton","title":"SuffixAutomaton"},"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"role":"collection","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","title":"Trees","kind":"symbol","url":"\/documentation\/suffixstructures\/trees","type":"topic","abstract":[]},"doc://SuffixStructures/documentation/SuffixStructures":{"kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","url":"\/documentation\/suffixstructures","type":"topic","title":"SuffixStructures"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","url":"\/documentation\/suffixstructures\/suffixtree","type":"topic","title":"SuffixTree"}}}