{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","role":"collection","title":"SuffixStructures","modules":[{"name":"SuffixStructures"}],"roleHeading":"Framework","externalID":"SuffixStructures"},"sections":[],"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"title":"Suffix arrays","anchor":"Suffix-arrays"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"],"title":"Suffix trees","anchor":"Suffix-trees"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"],"title":"Suffix automata","anchor":"Suffix-automata"},{"generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules"}],"variants":[{"paths":["\/documentation\/suffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},{"text":" holds the starting positions of a text’s suffixes in sorted order, with the","type":"text"},{"text":" ","type":"text"},{"text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every","type":"text"},{"text":" ","type":"text"},{"text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the","type":"text"},{"text":" ","type":"text"},{"text":"prefix lengths give the longest repeated substring and the number of distinct substrings.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"]},{"type":"paragraph","inlineContent":[{"text":"The text may be any sequence of ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" symbols. For ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":", such as a string’s ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"construction sorts the bytes themselves in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (induced sorting: Nong, Zhang and Chan, 2009);","type":"text"},{"text":" ","type":"text"},{"text":"any other symbol type is first replaced by its rank among the text’s distinct symbols.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"},{"type":"text","text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm (1995), over one text or several. A pattern is found in O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":") steps down from the"},{"type":"text","text":" "},{"type":"text","text":"root; the deepest internal node is the longest repeated substring, and the deepest node with"},{"type":"text","text":" "},{"type":"text","text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", and its suffix links are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","isActive":true},{"type":"text","text":" is the smallest automaton whose paths from its start state spell the"},{"type":"text","text":" "},{"type":"text","text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" − 1"},{"type":"text","text":" "},{"type":"text","text":"states. It answers membership, occurrence counts and first occurrences in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":") transitions, and"},{"type":"text","text":" "},{"type":"text","text":"finds the longest substring another text shares by walking that text over it. Its transitions"},{"type":"text","text":" "},{"type":"text","text":"are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","isActive":true},{"type":"text","text":", and its suffix links convert to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""]}]}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The symbol a transition reads."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"symbol"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofEdgeAt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"}],"url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","role":"symbol","title":"symbol(ofEdgeAt:)","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","kind":"symbol","url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SuffixTree","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"SuffixLinksView","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV"}],"conformance":{"conformancePref