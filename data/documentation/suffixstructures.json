{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},{"type":"text","text":" holds the starting positions of a text’s suffixes in sorted order, with the"},{"type":"text","text":" "},{"type":"text","text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every"},{"type":"text","text":" "},{"type":"text","text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the"},{"type":"text","text":" "},{"type":"text","text":"prefix lengths give the longest repeated substring and the number of distinct substrings."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"]},{"inlineContent":[{"text":"The text may be any sequence of ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":" symbols. For ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":", such as a string’s ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"construction sorts the bytes themselves in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (induced sorting: Nong, Zhang and Chan, 2009);","type":"text"},{"text":" ","type":"text"},{"text":"any other symbol type is first replaced by its rank among the text’s distinct symbols.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","isActive":true,"type":"reference"},{"type":"text","text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm (1995), over one text or several. A pattern is found in O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":") steps down from the"},{"type":"text","text":" "},{"type":"text","text":"root; the deepest internal node is the longest repeated substring, and the deepest node with"},{"type":"text","text":" "},{"type":"text","text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", and its suffix links are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"]},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"},{"text":" is the smallest automaton whose paths from its start state spell the","type":"text"},{"text":" ","type":"text"},{"text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" − 1","type":"text"},{"text":" ","type":"text"},{"text":"states. It answers membership, occurrence counts and first occurrences in O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":") transitions, and","type":"text"},{"text":" ","type":"text"},{"text":"finds the longest substring another text shares by walking that text over it. Its transitions","type":"text"},{"text":" ","type":"text"},{"text":"are a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"},{"text":", and its suffix links convert to","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Arborescence(_:)"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""]}]}],"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"hierarchy":{"paths":[[]]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"metadata":{"modules":[{"name":"SuffixStructures"}],"roleHeading":"Framework","role":"collection","symbolKind":"module","title":"SuffixStructures","externalID":"SuffixStructures"},"topicSections":[{"title":"Suffix arrays","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"anchor":"Suffix-arrays"},{"title":"Suffix trees","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"],"anchor":"Suffix-trees"},{"title":"Suffix automata","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"],"anchor":"Suffix-automata"},{"title":"Extended Modules","generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"anchor":"Extended-Modules"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/suffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"role":"collection","url":"\/documentation\/suffixstructures\/trees","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","kind":"symbol","abstract":[],"type":"topic","title":"Trees"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"role":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SuffixAutomaton"}],"kind":"symbol","abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,"},{"type":"text","text":" "},{"type":"text","text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985)."}],"title":"SuffixAutomaton","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SuffixAutomaton"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"type":"topic","abstract":[{"text":"A text’s suffix array and longest-common-prefix array: the starting positions of its","type":"text"},{"text":" ","type":"text"},{"text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before","type":"text"},{"text":" ","type":"text"},{"text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990).","type":"text"}],"role":"symbol","url":"\/documentation\/suffixstructures\/suffixarray","kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","title":"SuffixArray","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}]},"doc://SuffixStructures/documentation/SuffixStructures":{"role":"collection","url":"\/documentation\/suffixstructures","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","kind":"symbol","abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"title":"SuffixStructures","type":"topic"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionsView"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16SuffixStructures0A9AutomatonV","kind":"typeIdentifier","text":"SuffixAutomaton"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"preciseIdentifier":"s:16SuffixStructures0A9AutomatonV15TransitionsViewV","kind":"typeIdentifier","text":"TransitionsView"}],"kind":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.property","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","abstract":[{"type":"text","text":"The automaton’s transitions as a directed acyclic graph: a vertex per state, numbered from"},{"type":"text","text":" "},{"type":"text","text":"0 for the start state, and an edge per transition, whose symbol"},{"type":"text","text":" "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","type":"reference","isActive":true},{"type":"text","text":" gives."}],"type":"topic","conformance":{"constraints":[{"type":"codeVoice","code":"Symbol"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"title":"transitionsView"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","abstract":[{"type":"text","text":"The symbol a transition reads."}],"url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","role":"symbol","title":"symbol(ofEdgeAt:)"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"type":"topic","abstract":[{"text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each","type":"text"},{"text":" ","type":"text"},{"text":"internal node but the root to the node whose path label is its own without the first","type":"text"},{"text":" ","type":"text"},{"text":"symbol.","type":"text"}],"role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","title":"suffixLinksView","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16SuffixStructures0A4TreeV","text":"SuffixTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV","text":"SuffixLinksView","kind":"typeIdentifier"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixTree"}],"role":"symbol","title":"SuffixTree","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","navigatorTitle":[{"kind":"identifier","text":"SuffixTree"}],"kind":"symbol","url":"\/documentation\/suffixstructures\/suffixtree","abstract":[{"type":"text","text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to"},{"type":"text","text":" "},{"type":"text","text":"right in O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995)."}],"type":"topic"}}}