{"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Suffix arrays","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"anchor":"Suffix-arrays"},{"title":"Suffix trees","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"],"anchor":"Suffix-trees"},{"title":"Extended Modules","generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"anchor":"Extended-Modules"}],"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/suffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"SuffixStructures"}],"title":"SuffixStructures","role":"collection","roleHeading":"Framework","externalID":"SuffixStructures","symbolKind":"module"},"sections":[],"abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},{"type":"text","text":" holds the starting positions of a text’s suffixes in sorted order, with the"},{"type":"text","text":" "},{"type":"text","text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every"},{"type":"text","text":" "},{"type":"text","text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the"},{"type":"text","text":" "},{"type":"text","text":"prefix lengths give the longest repeated substring and the number of distinct substrings."}],"type":"paragraph"},{"syntax":"swift","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The text may be any sequence of "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" symbols. For "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"construction sorts the bytes themselves in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") (induced sorting: Nong, Zhang and Chan, 2009);"},{"type":"text","text":" "},{"type":"text","text":"any other symbol type is first replaced by its rank among the text’s distinct symbols."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","type":"reference","isActive":true},{"type":"text","text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm (1995), over one text or several. A pattern is found in O("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":") steps down from the"},{"type":"text","text":" "},{"type":"text","text":"root; the deepest internal node is the longest repeated substring, and the deepest node with"},{"type":"text","text":" "},{"type":"text","text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s"},{"type":"text","text":" "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", and its suffix links are a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","abstract":[],"url":"\/documentation\/suffixstructures\/trees","role":"collection","title":"Trees","type":"topic"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"abstract":[{"type":"text","text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each"},{"type":"text","text":" "},{"type":"text","text":"internal node but the root to the node whose path label is its own without the first"},{"type":"text","text":" "},{"type":"text","text":"symbol."}],"type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SuffixTree","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"SuffixLinksView","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV"}],"conformance":{"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","kind":"symbol","title":"suffixLinksView","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},"doc://SuffixStructures/documentation/SuffixStructures":{"type":"topic","role":"collection","abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","title":"SuffixStructures","url":"\/documentation\/suffixstructures"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to"},{"type":"text","text":" "},{"type":"text","text":"right in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995)."}],"kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","title":"SuffixTree","url":"\/documentation\/suffixstructures\/suffixtree","navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"title":"SuffixArray","abstract":[{"type":"text","text":"A text’s suffix array and longest-common-prefix array: the starting positions of its"},{"type":"text","text":" "},{"type":"text","text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before"},{"type":"text","text":" "},{"type":"text","text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990)."}],"role":"symbol","type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","url":"\/documentation\/suffixstructures\/suffixarray","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}]}}}