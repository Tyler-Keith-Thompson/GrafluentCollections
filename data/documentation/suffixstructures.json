{"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","isActive":true,"type":"reference"},{"text":" holds the starting positions of a text’s suffixes in sorted order, with the","type":"text"},{"text":" ","type":"text"},{"text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every","type":"text"},{"text":" ","type":"text"},{"text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the","type":"text"},{"text":" ","type":"text"},{"text":"prefix lengths give the longest repeated substring and the number of distinct substrings.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"]},{"inlineContent":[{"text":"The text may be any sequence of ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" symbols. For ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":", such as a string’s ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"construction sorts the bytes themselves in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (induced sorting: Nong, Zhang and Chan, 2009);","type":"text"},{"text":" ","type":"text"},{"text":"any other symbol type is first replaced by its rank among the text’s distinct symbols.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","type":"reference","isActive":true},{"type":"text","text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm (1995), over one text or several. A pattern is found in O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":") steps down from the"},{"type":"text","text":" "},{"type":"text","text":"root; the deepest internal node is the longest repeated substring, and the deepest node with"},{"type":"text","text":" "},{"type":"text","text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s"},{"type":"text","text":" "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", and its suffix links are a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"]},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","isActive":true,"type":"reference"},{"text":" is the smallest automaton whose paths from its start state spell the","type":"text"},{"text":" ","type":"text"},{"text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" − 1","type":"text"},{"text":" ","type":"text"},{"text":"states. It answers membership, occurrence counts and first occurrences in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"text":") transitions, and","type":"text"},{"text":" ","type":"text"},{"text":"finds the longest substring another text shares by walking that text over it. Its transitions","type":"text"},{"text":" ","type":"text"},{"text":"are a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","isActive":true,"type":"reference"},{"text":", and its suffix links convert to","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Arborescence(_:)"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""]}]}],"metadata":{"externalID":"SuffixStructures","symbolKind":"module","role":"collection","roleHeading":"Framework","title":"SuffixStructures","modules":[{"name":"SuffixStructures"}]},"variants":[{"paths":["\/documentation\/suffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"sections":[],"topicSections":[{"anchor":"Suffix-arrays","title":"Suffix arrays","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"]},{"anchor":"Suffix-trees","title":"Suffix trees","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"]},{"anchor":"Suffix-automata","title":"Suffix automata","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"]},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"generated":true}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"title":"SuffixTree","url":"\/documentation\/suffixstructures\/suffixtree","abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","navigatorTitle":[{"kind":"identifier","text":"SuffixArray"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixArray"}],"title":"SuffixArray","abstract":[{"text":"A text’s suffix array and longest-common-prefix array: the starting positions of its","type":"text"},{"text":" ","type":"text"},{"text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before","type":"text"},{"text":" ","type":"text"},{"text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990).","type":"text"}],"url":"\/documentation\/suffixstructures\/suffixarray"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"}],"title":"SuffixAutomaton","url":"\/documentation\/suffixstructures\/suffixautomaton","abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,"},{"type":"text","text":" "},{"type":"text","text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985)."}],"navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Symbol"}],"title":"symbol(ofEdgeAt:)","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","abstract":[{"type":"text","text":"The symbol a transition reads."}],"role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","type":"topic"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"suffixLinksView","role":"symbol","url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SuffixTree","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"SuffixLinksView","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV"}],"abstract":[{"type":"text","text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each"},{"type":"text","text":" "},{"type":"text","text":"internal node but the root to the node whose path label is its own without the first"},{"type":"text","text":" "},{"type":"text","text":"symbol."}]},"doc://SuffixStructures/documentation/SuffixStructures":{"role":"collection","abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"kind":"symbol","title":"SuffixStructures","type":"topic","url":"\/documentation\/suffixstructures","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"role":"symbol","abstract":[{"type":"text","text":"The automaton’s transitions as a directed acyclic graph: a vertex per state, numbered from"},{"type":"text","text":" "},{"type":"text","text":"0 for the start state, and an edge per transition, whose symbol"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","isActive":true},{"type":"text","text":" gives."}],"kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"title":"transitionsView","type":"topic","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionsView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV","text":"SuffixAutomaton"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV15TransitionsViewV","text":"TransitionsView"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"},"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","title":"Trees","role":"collection","url":"\/documentation\/suffixstructures\/trees","type":"topic","abstract":[]}}}