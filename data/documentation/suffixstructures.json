{"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"title":"Suffix arrays","anchor":"Suffix-arrays"}],"kind":"symbol","metadata":{"externalID":"SuffixStructures","title":"SuffixStructures","modules":[{"name":"SuffixStructures"}],"symbolKind":"module","role":"collection","roleHeading":"Framework"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","isActive":true,"type":"reference"},{"type":"text","text":" holds the starting positions of a text’s suffixes in sorted order, with the"},{"type":"text","text":" "},{"type":"text","text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every"},{"type":"text","text":" "},{"type":"text","text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the"},{"type":"text","text":" "},{"type":"text","text":"prefix lengths give the longest repeated substring and the number of distinct substrings."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"]},{"inlineContent":[{"text":"The text may be any sequence of ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":" symbols. For ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":", such as a string’s ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"construction sorts the bytes themselves in O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") (induced sorting: Nong, Zhang and Chan, 2009);","type":"text"},{"text":" ","type":"text"},{"text":"any other symbol type is first replaced by its rank among the text’s distinct symbols.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/suffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"kind":"symbol","navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}],"title":"SuffixArray","url":"\/documentation\/suffixstructures\/suffixarray","abstract":[{"text":"A text’s suffix array and longest-common-prefix array: the starting positions of its","type":"text"},{"text":" ","type":"text"},{"text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before","type":"text"},{"text":" ","type":"text"},{"text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990).","type":"text"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","role":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures":{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"kind":"symbol","url":"\/documentation\/suffixstructures","type":"topic","title":"SuffixStructures","role":"collection"}}}