{"sections":[],"topicSections":[{"title":"Suffix arrays","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"anchor":"Suffix-arrays"},{"title":"Suffix trees","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"],"anchor":"Suffix-trees"},{"title":"Suffix automata","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"],"anchor":"Suffix-automata"},{"title":"Extended Modules","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"generated":true,"anchor":"Extended-Modules"}],"hierarchy":{"paths":[[]]},"metadata":{"title":"SuffixStructures","role":"collection","symbolKind":"module","modules":[{"name":"SuffixStructures"}],"roleHeading":"Framework","externalID":"SuffixStructures"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/suffixstructures"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","isActive":true},{"type":"text","text":" holds the starting positions of a text’s suffixes in sorted order, with the"},{"type":"text","text":" "},{"type":"text","text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every"},{"type":"text","text":" "},{"type":"text","text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the"},{"type":"text","text":" "},{"type":"text","text":"prefix lengths give the longest repeated substring and the number of distinct substrings."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"]},{"inlineContent":[{"type":"text","text":"The text may be any sequence of "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" symbols. For "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"construction sorts the bytes themselves in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") (induced sorting: Nong, Zhang and Chan, 2009);"},{"type":"text","text":" "},{"type":"text","text":"any other symbol type is first replaced by its rank among the text’s distinct symbols."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","type":"reference","isActive":true},{"text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithm (1995), over one text or several. A pattern is found in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"text":") steps down from the","type":"text"},{"text":" ","type":"text"},{"text":"root; the deepest internal node is the longest repeated substring, and the deepest node with","type":"text"},{"text":" ","type":"text"},{"text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", and its suffix links are a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"]},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","isActive":true},{"type":"text","text":" is the smallest automaton whose paths from its start state spell the"},{"type":"text","text":" "},{"type":"text","text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" − 1"},{"type":"text","text":" "},{"type":"text","text":"states. It answers membership, occurrence counts and first occurrences in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":") transitions, and"},{"type":"text","text":" "},{"type":"text","text":"finds the longest substring another text shares by walking that text over it. Its transitions"},{"type":"text","text":" "},{"type":"text","text":"are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","isActive":true},{"type":"text","text":", and its suffix links convert to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""]}]}],"abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"title":"SuffixAutomaton","navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"url":"\/documentation\/suffixstructures\/suffixautomaton","abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,"},{"type":"text","text":" "},{"type":"text","text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985)."}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"title":"suffixLinksView","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","abstract":[{"type":"text","text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each"},{"type":"text","text":" "},{"type":"text","text":"internal node but the root to the node whose path label is its own without the first"},{"type":"text","text":" "},{"type":"text","text":"symbol."}],"url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SuffixTree","preciseIdentifier":"s:16SuffixStructures0A4TreeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"SuffixLinksView","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV","kind":"typeIdentifier"}],"type":"topic","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"kind":"symbol","role":"collection","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","url":"\/documentation\/suffixstructures\/trees","abstract":[],"title":"Trees","type":"topic"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"title":"symbol(ofEdgeAt:)","abstract":[{"type":"text","text":"The symbol a transition reads."}],"url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Symbol"}],"kind":"symbol","type":"topic"},"doc://SuffixStructures/documentation/SuffixStructures":{"kind":"symbol","url":"\/documentation\/suffixstructures","abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"title":"SuffixStructures","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","type":"topic","role":"collection"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}],"abstract":[{"text":"A text’s suffix array and longest-common-prefix array: the starting positions of its","type":"text"},{"text":" ","type":"text"},{"text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before","type":"text"},{"text":" ","type":"text"},{"text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990).","type":"text"}],"url":"\/documentation\/suffixstructures\/suffixarray","title":"SuffixArray","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"title":"transitionsView","conformance":{"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.property","abstract":[{"text":"The automaton’s transitions as a directed acyclic graph: a vertex per state, numbered from","type":"text"},{"text":" ","type":"text"},{"text":"0 for the start state, and an edge per transition, whose symbol","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","type":"reference","isActive":true},{"text":" gives.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionsView"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16SuffixStructures0A9AutomatonV","kind":"typeIdentifier","text":"SuffixAutomaton"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"preciseIdentifier":"s:16SuffixStructures0A9AutomatonV15TransitionsViewV","kind":"typeIdentifier","text":"TransitionsView"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"url":"\/documentation\/suffixstructures\/suffixtree","abstract":[{"type":"text","text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to"},{"type":"text","text":" "},{"type":"text","text":"right in O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995)."}],"title":"SuffixTree","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"}}}