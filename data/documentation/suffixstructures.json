{"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"anchor":"Suffix-arrays","title":"Suffix arrays"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"],"anchor":"Suffix-trees","title":"Suffix trees"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"],"anchor":"Suffix-automata","title":"Suffix automata"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/suffixstructures"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","type":"reference"},{"type":"text","text":" holds the starting positions of a text’s suffixes in sorted order, with the"},{"type":"text","text":" "},{"type":"text","text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every"},{"type":"text","text":" "},{"type":"text","text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the"},{"type":"text","text":" "},{"type":"text","text":"prefix lengths give the longest repeated substring and the number of distinct substrings."}]},{"syntax":"swift","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The text may be any sequence of "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" symbols. For "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"construction sorts the bytes themselves in O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") (induced sorting: Nong, Zhang and Chan, 2009);"},{"type":"text","text":" "},{"type":"text","text":"any other symbol type is first replaced by its rank among the text’s distinct symbols."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","isActive":true,"type":"reference"},{"type":"text","text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm (1995), over one text or several. A pattern is found in O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":") steps down from the"},{"type":"text","text":" "},{"type":"text","text":"root; the deepest internal node is the longest repeated substring, and the deepest node with"},{"type":"text","text":" "},{"type":"text","text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", and its suffix links are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"syntax":"swift","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","isActive":true},{"type":"text","text":" is the smallest automaton whose paths from its start state spell the"},{"type":"text","text":" "},{"type":"text","text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" − 1"},{"type":"text","text":" "},{"type":"text","text":"states. It answers membership, occurrence counts and first occurrences in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":") transitions, and"},{"type":"text","text":" "},{"type":"text","text":"finds the longest substring another text shares by walking that text over it. Its transitions"},{"type":"text","text":" "},{"type":"text","text":"are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","isActive":true},{"type":"text","text":", and its suffix links convert to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}]},{"syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"symbolKind":"module","role":"collection","externalID":"SuffixStructures","roleHeading":"Framework","title":"SuffixStructures","modules":[{"name":"SuffixStructures"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","navigatorTitle":[{"kind":"identifier","text":"SuffixTree"}],"title":"SuffixTree","url":"\/documentation\/suffixstructures\/suffixtree","type":"topic","abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixTree"}]},"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","abstract":[],"role":"collection","url":"\/documentation\/suffixstructures\/trees","kind":"symbol","type":"topic","title":"Trees"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SuffixArray"}],"role":"symbol","title":"SuffixArray","url":"\/documentation\/suffixstructures\/suffixarray","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixArray"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","abstract":[{"text":"A text’s suffix array and longest-common-prefix array: the starting positions of its","type":"text"},{"text":" ","type":"text"},{"text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before","type":"text"},{"text":" ","type":"text"},{"text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990).","type":"text"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"suffixLinksView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SuffixTree","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"SuffixLinksView","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV"}],"url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","abstract":[{"text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each","type":"text"},{"text":" ","type":"text"},{"text":"internal node but the root to the node whose path label is its own without the first","type":"text"},{"text":" ","type":"text"},{"text":"symbol.","type":"text"}],"kind":"symbol","title":"suffixLinksView","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","conformance":{"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]}},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","abstract":[{"text":"The automaton’s transitions as a directed acyclic graph: a vertex per state, numbered from","type":"text"},{"text":" ","type":"text"},{"text":"0 for the start state, and an edge per transition, whose symbol","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","type":"reference"},{"text":" gives.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitionsView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16SuffixStructures0A9AutomatonV","text":"SuffixAutomaton","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:16SuffixStructures0A9AutomatonV15TransitionsViewV","text":"TransitionsView","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.property","title":"transitionsView"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"kind":"symbol","title":"symbol(ofEdgeAt:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"}],"abstract":[{"text":"The symbol a transition reads.","type":"text"}],"role":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","type":"topic"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","title":"SuffixAutomaton","url":"\/documentation\/suffixstructures\/suffixautomaton","navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,"},{"type":"text","text":" "},{"type":"text","text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures":{"type":"topic","role":"collection","title":"SuffixStructures","url":"\/documentation\/suffixstructures","kind":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}]}}}