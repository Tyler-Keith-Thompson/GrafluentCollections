{"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"metadata":{"title":"SuffixStructures","symbolKind":"module","externalID":"SuffixStructures","modules":[{"name":"SuffixStructures"}],"roleHeading":"Framework","role":"collection"},"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"title":"Suffix arrays","anchor":"Suffix-arrays"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"],"title":"Suffix trees","anchor":"Suffix-trees"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"],"title":"Suffix automata","anchor":"Suffix-automata"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"generated":true,"title":"Extended Modules","anchor":"Extended-Modules"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","isActive":true,"type":"reference"},{"text":" holds the starting positions of a text’s suffixes in sorted order, with the","type":"text"},{"text":" ","type":"text"},{"text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every","type":"text"},{"text":" ","type":"text"},{"text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the","type":"text"},{"text":" ","type":"text"},{"text":"prefix lengths give the longest repeated substring and the number of distinct substrings.","type":"text"}]},{"type":"codeListing","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The text may be any sequence of "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" symbols. For "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"construction sorts the bytes themselves in O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") (induced sorting: Nong, Zhang and Chan, 2009);"},{"type":"text","text":" "},{"type":"text","text":"any other symbol type is first replaced by its rank among the text’s distinct symbols."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"},{"type":"text","text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm (1995), over one text or several. A pattern is found in O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":") steps down from the"},{"type":"text","text":" "},{"type":"text","text":"root; the deepest internal node is the longest repeated substring, and the deepest node with"},{"type":"text","text":" "},{"type":"text","text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", and its suffix links are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"},{"text":" is the smallest automaton whose paths from its start state spell the","type":"text"},{"text":" ","type":"text"},{"text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" − 1","type":"text"},{"text":" ","type":"text"},{"text":"states. It answers membership, occurrence counts and first occurrences in O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"text":") transitions, and","type":"text"},{"text":" ","type":"text"},{"text":"finds the longest substring another text shares by walking that text over it. Its transitions","type":"text"},{"text":" ","type":"text"},{"text":"are a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"},{"text":", and its suffix links convert to","type":"text"},{"text":" ","type":"text"},{"text":"Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Arborescence(_:)"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/suffixstructures"]}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees","abstract":[],"role":"collection","kind":"symbol","title":"Trees","url":"\/documentation\/suffixstructures\/trees"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"abstract":[{"type":"text","text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each"},{"type":"text","text":" "},{"type":"text","text":"internal node but the root to the node whose path label is its own without the first"},{"type":"text","text":" "},{"type":"text","text":"symbol."}],"kind":"symbol","role":"symbol","title":"suffixLinksView","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SuffixTree","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"SuffixLinksView","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV"}],"type":"topic","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitionsView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SuffixAutomaton","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"TransitionsView","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV15TransitionsViewV"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","abstract":[{"text":"The automaton’s transitions as a directed acyclic graph: a vertex per state, numbered from","type":"text"},{"text":" ","type":"text"},{"text":"0 for the start state, and an edge per transition, whose symbol","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","isActive":true,"type":"reference"},{"text":" gives.","type":"text"}],"role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"type":"topic","kind":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.property","title":"transitionsView"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix","type":"text"},{"text":" ","type":"text"},{"text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,","type":"text"},{"text":" ","type":"text"},{"text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985).","type":"text"}],"title":"SuffixAutomaton","type":"topic","url":"\/documentation\/suffixstructures\/suffixautomaton","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"}]},"doc://SuffixStructures/documentation/SuffixStructures":{"role":"collection","title":"SuffixStructures","url":"\/documentation\/suffixstructures","abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"role":"symbol","url":"\/documentation\/suffixstructures\/suffixarray","title":"SuffixArray","abstract":[{"type":"text","text":"A text’s suffix array and longest-common-prefix array: the starting positions of its"},{"type":"text","text":" "},{"type":"text","text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before"},{"type":"text","text":" "},{"type":"text","text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990)."}],"type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The symbol a transition reads."}],"title":"symbol(ofEdgeAt:)","type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}],"abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"kind":"symbol","type":"topic","title":"SuffixTree","url":"\/documentation\/suffixstructures\/suffixtree","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}]}}}