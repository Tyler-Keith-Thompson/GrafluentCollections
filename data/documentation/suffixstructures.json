{"kind":"symbol","metadata":{"externalID":"SuffixStructures","symbolKind":"module","modules":[{"name":"SuffixStructures"}],"title":"SuffixStructures","role":"collection","roleHeading":"Framework"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/suffixstructures"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"sections":[],"abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"],"anchor":"Suffix-arrays","title":"Suffix arrays"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"],"anchor":"Suffix-trees","title":"Suffix trees"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"],"anchor":"Suffix-automata","title":"Suffix automata"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"anchor":"Extended-Modules","generated":true,"title":"Extended Modules"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","type":"reference","isActive":true},{"text":" holds the starting positions of a text’s suffixes in sorted order, with the","type":"text"},{"text":" ","type":"text"},{"text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every","type":"text"},{"text":" ","type":"text"},{"text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the","type":"text"},{"text":" ","type":"text"},{"text":"prefix lengths give the longest repeated substring and the number of distinct substrings.","type":"text"}],"type":"paragraph"},{"code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The text may be any sequence of "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":" symbols. For "},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":", such as a string’s "},{"code":"utf8","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"construction sorts the bytes themselves in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") (induced sorting: Nong, Zhang and Chan, 2009);"},{"type":"text","text":" "},{"type":"text","text":"any other symbol type is first replaced by its rank among the text’s distinct symbols."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","type":"reference","isActive":true},{"text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithm (1995), over one text or several. A pattern is found in O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":") steps down from the","type":"text"},{"text":" ","type":"text"},{"text":"root; the deepest internal node is the longest repeated substring, and the deepest node with","type":"text"},{"text":" ","type":"text"},{"text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", and its suffix links are a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"},{"type":"text","text":" is the smallest automaton whose paths from its start state spell the"},{"type":"text","text":" "},{"type":"text","text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" − 1"},{"type":"text","text":" "},{"type":"text","text":"states. It answers membership, occurrence counts and first occurrences in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":") transitions, and"},{"type":"text","text":" "},{"type":"text","text":"finds the longest substring another text shares by walking that text over it. Its transitions"},{"type":"text","text":" "},{"type":"text","text":"are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"},{"type":"text","text":", and its suffix links convert to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"type":"topic","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}]},"abstract":[{"text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each","type":"text"},{"text":" ","type":"text"},{"text":"internal node but the root to the node whose path label is its own without the first","type":"text"},{"text":" ","type":"text"},{"text":"symbol.","type":"text"}],"kind":"symbol","url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16SuffixStructures0A4TreeV","text":"SuffixTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV","text":"SuffixLinksView","kind":"typeIdentifier"}],"title":"suffixLinksView","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixA