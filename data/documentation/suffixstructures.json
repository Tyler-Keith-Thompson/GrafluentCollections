{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"topicSections":[{"title":"Suffix arrays","anchor":"Suffix-arrays","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"]},{"title":"Suffix trees","anchor":"Suffix-trees","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"]},{"title":"Suffix automata","anchor":"Suffix-automata","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"]},{"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"],"generated":true}],"metadata":{"role":"collection","externalID":"SuffixStructures","roleHeading":"Framework","title":"SuffixStructures","symbolKind":"module","modules":[{"name":"SuffixStructures"}]},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","type":"reference","isActive":true},{"text":" holds the starting positions of a text’s suffixes in sorted order, with the","type":"text"},{"text":" ","type":"text"},{"text":"length of the prefix each shares with the one before it (Manber and Myers, 1990). Every","type":"text"},{"text":" ","type":"text"},{"text":"occurrence of a pattern is a run of neighbouring suffixes, found by binary search, and the","type":"text"},{"text":" ","type":"text"},{"text":"prefix lengths give the longest repeated substring and the number of distinct substrings.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SuffixStructures","","let banana = SuffixArray(\"banana\")","let found = banana.occurrences(of: \"ana\")","found.map { banana.positions[$0] }   \/\/ [3, 1]","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The text may be any sequence of "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" symbols. For "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"construction sorts the bytes themselves in O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") (induced sorting: Nong, Zhang and Chan, 2009);"},{"type":"text","text":" "},{"type":"text","text":"any other symbol type is first replaced by its rank among the text’s distinct symbols."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"},{"type":"text","text":" is the compressed trie of the same suffixes, built left to right by Ukkonen’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm (1995), over one text or several. A pattern is found in O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":") steps down from the"},{"type":"text","text":" "},{"type":"text","text":"root; the deepest internal node is the longest repeated substring, and the deepest node with"},{"type":"text","text":" "},{"type":"text","text":"suffixes of every text below it the longest common substring. Its nodes convert to Grafluent’s"},{"type":"text","text":" "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", and its suffix links are a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring?.range.count   \/\/ 4, \"abxa\"","both.occurrences(of: \"ab\").count           \/\/ 4"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"},{"type":"text","text":" is the smallest automaton whose paths from its start state spell the"},{"type":"text","text":" "},{"type":"text","text":"text’s substrings (Blumer et al., 1985), built one symbol at a time with at most 2"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" − 1"},{"type":"text","text":" "},{"type":"text","text":"states. It answers membership, occurrence counts and first occurrences in O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":") transitions, and"},{"type":"text","text":" "},{"type":"text","text":"finds the longest substring another text shares by walking that text over it. Its transitions"},{"type":"text","text":" "},{"type":"text","text":"are a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"},{"type":"text","text":", and its suffix links convert to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.occurrenceCount(of: \"bc\")                         \/\/ 2","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""]}],"kind":"content"}],"abstract":[{"text":"Structures over a text’s suffixes that answer substring queries.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/suffixstructures"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://SuffixStructures/documentation/SuffixStructures":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures","title":"SuffixStructures","abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"url":"\/documentation\/suffixstructures"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/suffixLinksView-swift.property":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"suffixLinksView","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffixLinksView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SuffixTree","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"SuffixLinksView","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV0A9LinksViewV"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The tree’s suffix links as a directed graph: a vertex per node, and an edge from each"},{"type":"text","text":" "},{"type":"text","text":"internal node but the root to the node whose path label is its own without the first"},{"type":"text","text":" "},{"type":"text","text":"symbol."}],"url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.property","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"title":"symbol(ofEdgeAt:)","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"symbol"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofEdgeAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Symbol"}],"role":"symbol","type":"topic","abstract":[{"text":"The symbol a transition reads.","type":"text"}],"url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","kind":"symbol"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/transitionsView-swift.property":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"transitionsView","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionsView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV","text":"SuffixAutomaton"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A9AutomatonV15TransitionsViewV","text":"TransitionsView"}],"url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.property","abstract":[{"text":"The automaton’s transitions as a directed acyclic graph: a vertex per state, numbered from","type":"text"},{"text":" ","type":"text"},{"text":"0 for the start state, and an edge per transition, whose symbol","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","type":"reference"},{"text":" gives.","type":"text"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"title":"SuffixAutomaton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"}],"url":"\/documentation\/suffixstructures\/suffixautomaton","abstract":[{"text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix","type":"text"},{"text":" ","type":"text"},{"text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,","type":"text"},{"text":" ","type":"text"},{"text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985).","type":"text"}]},"doc://SuffixStructures/documentation/SuffixStructures/Trees":{"url":"\/documentation\/suffixstructures\/trees","type":"topic","role":"collection","title":"Trees","kind":"symbol","abstract":[],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixArray":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixArray","kind":"identifier"}],"abstract":[{"text":"A text’s suffix array and longest-common-prefix array: the starting positions of its","type":"text"},{"text":" ","type":"text"},{"text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before","type":"text"},{"text":" ","type":"text"},{"text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990).","type":"text"}],"navigatorTitle":[{"text":"SuffixArray","kind":"identifier"}],"title":"SuffixArray","kind":"symbol","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","url":"\/documentation\/suffixstructures\/suffixarray"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}],"title":"SuffixTree","kind":"symbol","role":"symbol","url":"\/documentation\/suffixstructures\/suffixtree","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"}}}