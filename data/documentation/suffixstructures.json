mmon-prefix array: the starting positions of its"},{"type":"text","text":" "},{"type":"text","text":"suffixes in sorted order, and the length of the prefix each suffix shares with the one before"},{"type":"text","text":" "},{"type":"text","text":"it (Manber and Myers, “Suffix Arrays: A New Method for On-Line String Searches”, 1990)."}],"title":"SuffixArray","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixArray"}],"url":"\/documentation\/suffixstructures\/suffixarray","navigatorTitle":[{"kind":"identifier","text":"SuffixArray"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton/TransitionsView-swift.struct/symbol(ofEdgeAt:)":{"kind":"symbol","url":"\/documentation\/suffixstructures\/suffixautomaton\/transitionsview-swift.struct\/symbol(ofedgeat:)","role":"symbol","title":"symbol(ofEdgeAt:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct\/symbol(ofEdgeAt:)","abstract":[{"type":"text","text":"The symbol a transition reads."}]}}}