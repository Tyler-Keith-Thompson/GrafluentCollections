es/Trees":{"type":"topic","abstract":[],"kind":"symbol","url":"\/documentation\/suffixstructures\/trees","title":"Trees","role":"collection","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/Trees"},"doc://SuffixStructures/documentation/SuffixStructures":{"type":"topic","abstract":[{"type":"text","text":"Structures over a text’s suffixes that answer substring queries."}],"kind":"symbol","url":"\/documentation\/suffixstructures","title":"SuffixStructures","role":"collection","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures"},"doc://SuffixStructures/documentation/SuffixStructures/SuffixAutomaton":{"abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,"},{"type":"text","text":" "},{"type":"text","text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985)."}],"navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","role":"symbol","title":"SuffixAutomaton","url":"\/documentation\/suffixstructures\/suffixautomaton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"}],"kind":"symbol","type":"topic"}}}