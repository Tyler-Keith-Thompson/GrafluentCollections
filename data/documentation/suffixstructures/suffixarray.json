{"kind":"symbol","topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/LongestCommonPrefixes-swift.struct","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/Positions-swift.struct"],"title":"Structures","generated":true},{"anchor":"Initializers","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/init(_:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/count","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/distinctSubstringCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/longestCommonPrefixes-swift.property","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/longestRepeatedSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/positions-swift.property","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/text"],"title":"Instance Properties","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray\/occurrences(of:)"],"title":"Instance Methods","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixArray"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Together the two arrays answer what a suffix tree answers, in a fraction of the space:"},{"type":"text","text":" "},{"type":"text","text":"where a pattern occurs, in O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") for a pattern of "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" symbols; the longest substring"},{"type":"text","text":" "},{"type":"text","text":"that occurs twice; the number of distinct substrings."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let banana = SuffixArray(\"banana\")","Array(banana.positions)              \/\/ [5, 3, 1, 0, 4, 2]","Array(banana.longestCommonPrefixes)  \/\/ [0, 1, 3, 0, 0, 2]","banana.occurrences(of: \"ana\")        \/\/ 1 ..< 3, so positions 3 and 1","banana.longestRepeatedSubstring      \/\/ 1 ..< 4, \"ana\"","banana.distinctSubstringCount        \/\/ 15"]},{"inlineContent":[{"type":"text","text":"A suffix array is immutable: it holds a copy of its text and is built once, in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for a"},{"type":"text","text":" "},{"type":"text","text":"byte text and O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log σ) for a text of σ distinct symbols of any other type, which are first"},{"type":"text","text":" "},{"type":"text","text":"replaced by their ranks. Positions and prefix lengths are stored in 32 bits when the text has"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"code":"Int32.max","type":"codeVoice"},{"type":"text","text":" symbols."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"remoteSource":{"fileName":"SuffixArray.swift","url"