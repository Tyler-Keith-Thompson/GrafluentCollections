{"metadata":{"role":"symbol","title":"SuffixAutomaton","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixAutomaton"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"SuffixAutomaton"}],"modules":[{"name":"SuffixStructures"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixAutomaton.swift#L24","fileName":"SuffixAutomaton.swift"},"externalID":"s:16SuffixStructures0A9AutomatonV","symbolKind":"struct"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is built one symbol at a time in O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") expected steps, with at most 2"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" − 1 states and"},{"type":"text","text":" "},{"type":"text","text":"3"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" − 4 transitions. Each state stands for the substrings that end at the same set of places"},{"type":"text","text":" "},{"type":"text","text":"in the text; its suffix link leads to the state of the longest of their suffixes that ends at"},{"type":"text","text":" "},{"type":"text","text":"more places. A pattern is checked in O("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":") transitions."}]},{"code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automaton.occurrenceCount(of: \"bc\")    \/\/ 2","automaton.firstOccurrence(of: \"cb\")    \/\/ 2 ..< 4","automaton.distinctSubstringCount       \/\/ 12","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transitions from a state come in the order of their symbols: sorted when "},{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", otherwise in the order the symbols first occur in the text. The automaton is a"},{"type":"text","text":" "},{"type":"text","text":"directed graph, "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","isActive":true},{"type":"text","text":", and its suffix links are a tree that converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/CommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomat