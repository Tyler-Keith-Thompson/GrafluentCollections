aton\/init(_:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/count","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/distinctSubstringCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/stateCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/firstOccurrence(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/hasSuffix(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/longestCommonSubstring(with:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/occurrenceCount(of:)"],"anchor":"Instance-Methods"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is built one symbol at a time in O("},{"type":"emphasis","inlin