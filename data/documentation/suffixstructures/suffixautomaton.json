ype":"text"},{"text":" ","type":"text"},{"text":"more places. A pattern is checked in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"text":") transitions.","type":"text"}]},{"code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automaton.occurrenceCount(of: \"bc\")    \/\/ 2","automaton.firstOccurrence(of: \"cb\")    \/\/ 2 ..< 4","automaton.distinctSubstringCount       \/\/ 12","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transitions from a state come in the order of their symbols: sorted when "},{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", otherwise in the order the symbols first occur in the text. The automaton is a"},{"type":"text","text":" "},{"type":"text","text":"directed graph, "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","isActive":true},{"type":"text","text":", and its suffix links are a tree that converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}]}]}],"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"title":"SuffixAutomaton","role":"symbol","remoteSource":{"fileName":"SuffixAutomaton.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixAutomaton.swift#L24"},"roleHeading":"Structure","externalID":"s:16SuffixStructures0A9AutomatonV","modules":[{"name":"SuffixStructures"}],"fragments":[{"kind":"keyword","text":"struct"},{"kin