{"metadata":{"roleHeading":"Structure","navigatorTitle":[{"text":"SuffixAutomaton","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"SuffixStructures"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixAutomaton.swift#L24","fileName":"SuffixAutomaton.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixAutomaton"}],"title":"SuffixAutomaton","externalID":"s:16SuffixStructures0A9AutomatonV"},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/SuffixStructures\/s8SendableP","doc:\/\/SuffixStructures\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"It is built one symbol at a time in O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") expected steps, with at most 2","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" − 1 states and","type":"text"},{"text":" ","type":"text"},{"text":"3","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" − 4 transitions. Each state stands for the substrings that end at the same set of places","type":"text"},{"text":" ","type":"text"},{"text":"in the text; its suffix link leads to the state of the longest of their suffixes that ends at","type":"text"},{"text":" ","type":"text"},{"text":"more places. A pattern is checked in O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":") transitions.","type":"text"}],"type":"paragraph"},{"code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automaton.occurrenceCount(of: \"bc\")    \/\/ 2","automaton.firstOccurrence(of: \"cb\")    \/\/ 2 ..< 4","automaton.distinctSubstringCount       \/\/ 12","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Transitions from a state come in the order of their symbols: sorted when "},{"code":"Symbol","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":", otherwise in the order the symbols first occur in the text. The automaton is a"},{"type":"text","text":" "},{"type":"text","text":"directed graph, "},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property","type":"reference","isActive":true},{"type":"text","text":", and its suffix links are a tree that converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":" with "},{"code":"Arborescence(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (