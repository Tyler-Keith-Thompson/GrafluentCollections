{"abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,"},{"type":"text","text":" "},{"type":"text","text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985)."}],"sections":[],"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/CommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/init(_:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/count","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/distinctSubstringCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/stateCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/firstOccurrence(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/hasSuffix(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/longestCommonSubstring(with:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/occurrenceCount(of:)"],