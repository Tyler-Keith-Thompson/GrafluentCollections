{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixAutomaton"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"It is built one symbol at a time in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") expected steps, with at most 2","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" − 1 states and","type":"text"},{"text":" ","type":"text"},{"text":"3","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" − 4 transitions. Each state stands for the substrings that end at the same set of places","type":"text"},{"text":" ","type":"text"},{"text":"in the text; its suffix link leads to the state of the longest of their suffixes that ends at","type":"text"},{"text":" ","type":"text"},{"text":"more places. A pattern is checked in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"text":") transitions.","type":"text"}]},{"syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automaton.occurrenceCount(of: \"bc\")    \/\/ 2","automaton.firstOccurrence(of: \"cb\")    \/\/ 2 ..< 4","automaton.distinctSubstringCount       \/\/ 12","automaton.longestCommonSubstring(with: \"xbcbz\")?.textRange  \/\/ 1 ..< 4, \"bcb\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transitions from a state come in the order of their symbols: sorted when "},{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", otherwise in the order the symbols first occur in the text. The automaton is a"},{"type":"text","text":" "},{"type":"text","text":"directed graph, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"},{"type":"text","text":", and its suffix links are a tree that converts to"},{"type":"text","text":" "},{"type":"text","text":"Grafluent’s "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":"."}]}],"kind":"content"}],"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/CommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/init(_:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/count","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/distinctSubstringCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/stateCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Metho