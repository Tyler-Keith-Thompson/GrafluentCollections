{"abstract":[{"type":"text","text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix"},{"type":"text","text":" "},{"type":"text","text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,"},{"type":"text","text":" "},{"type":"text","text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985)."}],"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/CommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/init(_:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/count","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/distinctSubstringCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/stateCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/firstOccurrence(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/hasSuffix(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/longestCommonSubstring(with:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/occurrenceCount(of:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"sections":[],"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"It is built one symbol at a time in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") expected steps, with at most 2","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" − 1 states and","type":"text"},{"text":" ","type":"text"},{"text":"3","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" − 4 transitions. Each state stands for the substrings that end at the same set of places","type":"text"},{"text":" ","type":"text"},{"text":"in the text; its suffix link leads to the state of the longest of their suffixes that ends at","type":"text"},{"text":" ","type":"text"},{"text":"more places. A pattern is checked in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"text":") transitions.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let automaton = SuffixAutomaton(\"abcbc\")","automaton.contains(\"cbc\")              \/\/ true","automat