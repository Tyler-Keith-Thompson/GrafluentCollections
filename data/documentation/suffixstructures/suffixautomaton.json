{"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"abstract":[{"text":"The suffix automaton of a text: the smallest deterministic automaton that accepts every suffix","type":"text"},{"text":" ","type":"text"},{"text":"of it, whose paths from the start state spell exactly the text’s substrings (Blumer et al.,","type":"text"},{"text":" ","type":"text"},{"text":"“The Smallest Automaton Recognizing the Subwords of a Text”, 1985).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/suffixstructures\/suffixautomaton"]}],"relationshipsSections":[{"identifiers":["doc:\/\/SuffixStructures\/s8SendableP","doc:\/\/SuffixStructures\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/CommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/TransitionsView-swift.struct"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/init(_:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/count","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/distinctSubstringCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/stateCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixAutomaton\/transitionsView-swift.property"],"anchor":"Instance-Properties","generated":true,"title":"Instance 