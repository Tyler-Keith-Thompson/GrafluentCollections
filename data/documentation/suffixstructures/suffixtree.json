operty","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/textCount"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/children(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/edgeLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/isLeaf(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/occurrences(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/parent(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/pathLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/stringDepth(of:)"],"generated":true}],"variants":[{"paths":["\/documentation\/suffixstructures\/suffixtree"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Every suffix of every text ends at a leaf, the empty suffix included, and every internal node"},{"type":"text","text":" "},{"type":"text","text":"is a point where suffixes that agree so far go different ways, so the tree has at most 2"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + 1"},{"type":"text","text":" "},{"type":"text","text":"nodes. A pattern is found in O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":") steps down from the root, and the leaves below where it"},{"type":"text","text":" "},{"type":"text","text":"ends are its occurrences."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tree = SuffixTree(\"banana\")","tree.occurrences(of: \"ana\").map(\\.range)   \/\/ [3 ..< 6, 1 ..< 4]","tree.longestRepeatedSubstring?.range       \/\/ 3 ..< 6, \"ana\"","","let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""]},{"inlineContent":[{"type":"text","text":"Nodes are numbered in preorder from the root at 0, so a node’s subtree is the nodes from it to"},{"type":"text","text":" "},{"type":"text","text":"just before the next node that is not its descendant. Children come in the order of the symbol"},{"type":"text","text":" "},{"type":"text","text":"that starts their edge: sorted when "},{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", so the leaves are in the order of"},{"type":"text","text":" "},{"type":"text","text":"their suffixes and match a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},{"type":"text","text":" of the same text; otherwise in the order the"},{"type":"text","text":" "},{"type":"text","text":"symbols first occur in the texts. Each text ends in a terminator of its own that sorts before"},{"type":"text","text":" "},{"type":"text","text":"every symbol and belongs to no label."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tree converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", and its suffix links are"},{"type":"text","text":" "},{"type":"text","text":"a directed graph, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},{"type":"text","text":". Each node takes 32 bytes and each symbol 4 more, the"},{"type":"text","text":" "},{"type":"text","text":"texts’ codes, which the tree keeps."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"abstract":[{"type":"text","text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to"},{"type":"text","text":" "},{"type":"text","text":"right in O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995)."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/root":{"url":"\/documentation\/suffixstructures\/suffixtree\/root","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"root","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/root","type":"topic","role":"symbol","kind":"symbol","title":"root","abstract":[{"type":"text","text":"The root, node 0."}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/init(_:)":{"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">)"}],"identifier":"doc:\/\/