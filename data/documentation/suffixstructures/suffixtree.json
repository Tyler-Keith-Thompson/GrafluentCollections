{"sections":[],"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"},"metadata":{"symbolKind":"struct","modules":[{"name":"SuffixStructures"}],"externalID":"s:16SuffixStructures0A4TreeV","role":"symbol","title":"SuffixTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"remoteSource":{"fileName":"SuffixTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixTree.swift#L29"},"navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}],"roleHeading":"Structure"},"abstract":[{"type":"text","text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to"},{"type":"text","text":" "},{"type":"text","text":"right in O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995)."}],"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/Occurrence","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/SuffixLinksView-swift.struct"]},{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(texts:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestCommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestRepeatedSubstring","doc:\/