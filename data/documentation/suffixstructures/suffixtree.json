{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/Occurrence","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/SuffixLinksView-swift.struct"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(texts:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestCommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestRepeatedSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodeCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodes","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/root","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/textCount"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/children(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/edgeLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/isLeaf(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/occurrences(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/parent(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/pathLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/stringDepth(of:)"],"anchor":"Instance-Methods","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree"},"kind":"symbol","variants":[{"paths":["\/documentation\/suffixstructures\/suffixtree"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:16SuffixStructures0A4TreeV","modules":[{"name":"SuffixStructures"}],"remoteSource":{"fileName":"SuffixTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixTree.swift#L29"},"title":"SuffixTree","navigatorTitle":[{"kind":"identifier","text":"SuffixTree"}],"role":"symbol","symbolKind":"struct"},"sections":[],"abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SuffixStructures\/s8SendableP","doc:\/\/SuffixStructures\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every suffix of every text ends at a leaf, the empty suffix included, and every internal node","type":"text"},{"text":" ","type":"text"},{"text":"is a point where suffixes that agree so far go different ways, so the tree has at most 2","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" + 1","type":"text"},{"text":" ","type":"text"},{"text":"nodes. A pattern is found in O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":") steps down from the root, and the leaves below where it","type":"text"},{"text":" ","type":"text"},{"text":"ends are its occurrences.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tree = SuffixTree(\"banana\")","tree.occurrences(of: \"ana\").map(\\.range)   \/\/ [3 ..< 6, 1 ..< 4]","tree.longestRepeatedSubstring?.range       \/\/ 3 ..< 6, \"ana\"","","let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nodes are numbered in preorder from the root at 0, so a node’s subtree is the nodes from it to"},{"type":"text","text":" "},{"type":"text","text":"just before the next node that is not its descendant. Children come in the order of the symbol"},{"type":"text","text":" "},{"type":"text","text":"that starts their edge: sorted when "},{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", so the leaves are in the order of"},{"type":"text","text":" "},{"type":"text","text":"their suffixes and match a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},{"type":"text","text":" of the same text; otherwise in the order the"},{"type":"text","text":" "},{"type":"text","text":"symbols first occur in the texts. Each text ends in a terminator of its own that sorts before"},{"type":"text","text":" "},{"type":"text","text":"every symbol and belongs to no label."}]},{"type":"paragraph","inlineContent":[{"text":"The tree converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"RootedTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"RootedTree(_:)"},{"text":", and its suffix links are","type":"text"},{"text":" ","type":"text"},{"text":"a directed graph, ","type":"text"},{"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","type":"reference","isActive":true},{"text":". Each node takes 32 bytes and each symbol 4 more, the","type":"text"},{"text":" ","type":"text"},{"text":"texts’ codes, which the tree keeps.","type":"text"}]}]}],"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/SuffixLinksView-swift.struct":{"url":"\/documentation\/suffixstructures\/suffixtree\/suffixlinksview-swift.struct","conformance":{"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"navigatorTitle":[{"kind":"identifier","text":"SuffixLinksView"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/SuffixLinksView-swift.struct","title":"SuffixTree.SuffixLinksView","abstract":[{"text":"A suffix tree’s suffix links as a directed graph; see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},{"text":".","type":"tex