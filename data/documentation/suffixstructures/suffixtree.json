chor":"Instance-Methods","title":"Instance Methods"}],"metadata":{"externalID":"s:16SuffixStructures0A4TreeV","role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixTree"}],"title":"SuffixTree","remoteSource":{"fileName":"SuffixTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixTree.swift#L29"},"navigatorTitle":[{"kind":"identifier","text":"SuffixTree"}],"symbolKind":"struct","modules":[{"name":"SuffixStructures"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every suffix of every text ends at a leaf, the empty suffix included, and every internal node"},{"type":"text","text":" "},{"type":"text","text":"is a point where suffixes that agree so far go different ways, so the tree has at most 2"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" + 1"},{"type":"text","text":" "},{"type":"text","text":"nodes. A pattern is found in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":") steps down from the root, and the leaves below where it"},{"type":"text","text":" "},{"type":"text","text":"ends are its occurrences."}]},{"type":"codeListing","syntax":"swift","code":["let tree = SuffixTree(\"banana\")","tree.occurrences(of: \"ana\").map(\\.range)   \/\/ [3 ..< 6, 1 ..< 4]","tree.longestRepeatedSubstring?.range       \/\/ 3 ..< 6, \"ana\"","","let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nodes are numbered in preorder from the root at 0, so a node’s subtree is the nodes from it to"},{"type":"text","text":" "},{"type":"text","text":"just before the next node that is not its descendant. Children come in the order of the symbol"},{"type":"text","text":" "},{"type":"text","text":"that starts their edge: sorted when "},{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", so the leaves are in the order of"},{"type":"text","text":" "},{"type":"text","text":"their suffixes and match a "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","isActive":true},{"type":"text","text":" of the same text; otherwise in the order the"},{"type":"text","text":" "},{"type":"text","text":"symbols first occur in the texts. Each text ends in a terminator of its own that sorts before"},{"type":"text","text":" "},{"type":"text","text":"every symbol and belongs to no label."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", and its suffix links are"},{"type":"text","text":" "},{"type":"text","text":"a directed graph, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},{"type":"text","text":". Each node takes 32 bytes and each symbol 4 more, the"},{"type":"text","t