{"metadata":{"roleHeading":"Structure","remoteSource":{"fileName":"SuffixTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixTree.swift#L29"},"role":"symbol","title":"SuffixTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"SuffixStructures"}],"externalID":"s:16SuffixStructures0A4TreeV","navigatorTitle":[{"kind":"identifier","text":"SuffixTree"}]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SuffixStructures\/s8SendableP","doc:\/\/SuffixStructures\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/Occurrence","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/SuffixLinksView-swift.struct"],"generated":true,"anchor":"Structures"},{"title":"Initializers","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(texts:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestCommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestRepeatedSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodeCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodes","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/root","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/textCount"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/children(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/edgeLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/isLeaf(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/occurrences(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/parent(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/pathLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/stringDepth(of:)"],"generated":true,"anchor":"Instance-Methods"}],"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every suffix of every text ends at a leaf, the empty suffix included, and every internal node"},{"type":"text","text":" "},{"type":"text","text":"is a point where suffixes that agree so far go different ways, so the tree has at most 2"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" + 1"},{"type":"text","text":" "},{"type":"text","text":"nodes. A pattern is found in O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":") steps down from the root, and the leaves below where it"},{"type":"text","text":" "},{"type":"text","text":"ends are its occurrences."}]},{"code":["let tree = SuffixTree(\"banana\")","tree.occurrences(of: \"ana\").map(\\.range)   \/\/ [3 ..< 6, 1 ..< 4]","tree.longestRepeatedSubstring?.range       \/\/ 3 ..< 6, \"ana\"","","let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nodes are numbered in preorder from the root at 0, so a node’s subtree is the nodes from it to"},{"type":"text","text":" "},{"type":"text","text":"just before the next node that is not its descendant. Children come in the order of the symbol"},{"type":"text","text":" "},{"type":"text","text":"that starts their edge: sorted when "},{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", so the leaves are in the order of"},{"type":"text","text":" "},{"type":"text","text":"their suffixes and match a "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray","isActive":true},{"type":"text","text":" of the same text; otherwise in the order the"},{"type":"text","text":" "},{"type":"text","text":"symbols first occur in the texts. Each text ends in a terminator of its own that sorts before"},{"type":"text","text":" "},{"type":"text","text":"every symbol and belongs to no label."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree converts to Grafluent’s "},{"code":"RootedTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"RootedTree(_:)","type":"codeVoice"},{"type":"text","text":", and its suffix links are"},{"type":"text","text":" "},{"type":"text","text":"a directed graph, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property"},{"type":"text","text":". Each node takes 32 bytes and each symbol 4 more, the"},{"type":"text","text":" "},{"type":"text","text":"texts’ codes, which the tree keeps."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/suffixstructures\/suffixtree"]}],"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"sections":[],"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/occurrences(of:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"occurrences","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"SuffixTree","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Occurrence","kind":"typeIdentifier","preciseIdentifier":"s:16SuffixStructures0A4TreeV10OccurrenceV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/occurre