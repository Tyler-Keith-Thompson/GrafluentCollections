{"metadata":{"symbolKind":"struct","title":"SuffixTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixTree"}],"navigatorTitle":[{"text":"SuffixTree","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixTree.swift#L29","fileName":"SuffixTree.swift"},"externalID":"s:16SuffixStructures0A4TreeV","modules":[{"name":"SuffixStructures"}],"role":"symbol","roleHeading":"Structure"},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/SuffixStructures\/s8SendableP","doc:\/\/SuffixStructures\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/suffixstructures\/suffixtree"]}],"sections":[],"abstract":[{"text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to","type":"text"},{"text":" ","type":"text"},{"text":"right in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995).","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every suffix of every text ends at a leaf, the empty suffix included, and every internal node"},{"type":"text","text":" "},{"type":"text","text":"is a point where suffixes that agree so far go different ways, so the tree has at most 2"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" + 1"},{"type":"text","text":" "},{"type":"text","text":"nodes. A pattern is found in O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":") steps down from the root, and the leaves below where it"},{"type":"text","text":" "},{"type":"text","text":"ends are its occurrences."}]},{"code":["let tree = SuffixTree(\"banana\")","tree.occurrences(of: \"ana\").map(\\.range)   \/\/ [3 ..< 6, 1 ..< 4]","tree.longestRepeatedSubstring?.range       \/\/ 3 ..< 6, \"ana\"","","let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nodes are numbered in preorder from the root at 0, so a node’s subtree is the nodes from it to"},{"type":"text","text":" "},{"type":"text","text":"just before the next node that is not its descendant. Children come in the order of the symbol"},{"type":"text","text":" "},{"type":"text","text":"that starts their edge: sorted when "},{"code":"Symbol","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":", so the leaves are in the order of"},{"type":"text","text":" "},{"type":"text","text":"their suffixes and match a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},{"type":"text","text":" of the same text; otherwise in the order the"},{"type":"text","text":" "},{"type":"text","text":"symbols first occur in the texts. Each text ends in a terminator of its own that sorts before"},{"type":"text","text":" "},{"type":"text","text":"every symbol and belongs to no label."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree converts to Grafluent’s "},{"type":"codeVoice","code":"RootedTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"RootedTree(_:)"},{"type":"text","text":", and its suffix links are"},{"type":"text","text":" "},{"type":"text","text":"a directed graph, "},{"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","isActive":true},{"type":"text","text":". Each node takes 32 bytes and each symbol 4 more, the"},{"type":"text","text":" "},{"type":"text","text":"texts’ codes, which the tree keeps."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/Occurrence","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/SuffixLinksView-swift.struct"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(texts:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestCommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestRepeatedSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodeCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodes","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/root","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","doc:\/\/SuffixStructures\/documen