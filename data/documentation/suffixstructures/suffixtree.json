{"abstract":[{"type":"text","text":"The suffix tree of one or more texts: the compressed trie of all their suffixes, built left to"},{"type":"text","text":" "},{"type":"text","text":"right in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") (Ukkonen, “On-Line Construction of Suffix Trees”, 1995)."}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/Occurrence","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/SuffixLinksView-swift.struct"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(texts:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestCommonSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/longestRepeatedSubstring","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodeCount","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/nodes","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/root","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/textCount"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/children(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/contains(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/edgeLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/isLeaf(_:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/occurrences(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/parent(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/pathLabel(of:)","doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/stringDepth(of:)"],"anchor":"Instance-Methods","generated":true}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SuffixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every suffix of every text ends at a leaf, the empty suffix included, and every internal node","type":"text"},{"text":" ","type":"text"},{"text":"is a point where suffixes that agree so far go different ways, so the tree has at most 2","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + 1","type":"text"},{"text":" ","type":"text"},{"text":"nodes. A pattern is found in O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":") steps down from the root, and the leaves below where it","type":"text"},{"text":" ","type":"text"},{"text":"ends are its occurrences.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let tree = SuffixTree(\"banana\")","tree.occurrences(of: \"ana\").map(\\.range)   \/\/ [3 ..< 6, 1 ..< 4]","tree.longestRepeatedSubstring?.range       \/\/ 3 ..< 6, \"ana\"","","let both = SuffixTree(texts: [\"xabxac\", \"abcabxabcd\"])","both.longestCommonSubstring                \/\/ text 1, 3 ..< 7: \"abxa\""]},{"type":"paragraph","inlineContent":[{"text":"Nodes are numbered in preorder from the root at 0, so a node’s subtree is the nodes from it to","type":"text"},{"text":" ","type":"text"},{"text":"just before the next node that is not its descendant. Children come in the order of the symbol","type":"text"},{"text":" ","type":"text"},{"text":"that starts their edge: sorted when ","type":"text"},{"code":"Symbol","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", so the leaves are in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their suffixes and match a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixArray"},{"text":" of the same text; otherwise in the order the","type":"text"},{"text":" ","type":"text"},{"text":"symbols first occur in the texts. Each text ends in a terminator of its own that sorts before","type":"text"},{"text":" ","type":"text"},{"text":"every symbol and belongs to no label.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tree converts to Grafluent’s ","type":"text"},{"code":"RootedTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"RootedTree(_:)","type":"codeVoice"},{"text":", and its suffix links are","type":"text"},{"text":" ","type":"text"},{"text":"a directed graph, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/suffixLinksView-swift.property","type":"reference"},{"text":". Each node takes 32 bytes and each symbol 4 more, the","type":"text"},{"text":" ","type":"text"},{"text":"texts’ codes, which the tree keeps.","type":"text"}]}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/SuffixStructures\/s8SendableP","doc:\/\/SuffixStructures\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"externalID":"s:16SuffixStructures0A4TreeV","navigatorTitle":[{"kind":"identifier","text":"SuffixTree"}],"title":"SuffixTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SuffixTree"}],"symbolKind":"struct","remoteSource":{"fileName":"SuffixTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/SuffixStructures\/SuffixTree.swift#L29"},"role":"symbol","modules":[{"name":"SuffixStructures"}],"roleHeading":"Structure"},"variants":[{"paths":["\/documentation\/suffixstructures\/suffixtree"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SuffixStructures\/documentation\/SuffixStructures"]]},"identifier":{"url":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree","interfaceLanguage":"swift"},"references":{"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/init(_:)":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/SuffixStructures\/documentation\/SuffixStructures\/SuffixTree\/init(_:)","type":"topic","title":"init(_:)","abstract":[{"type":"text","text":"The suffix tree of "},{"code":"text","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/suffixstructures\/suffixtree\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">)","kind":"text"}]},"doc://SuffixStructures/documentation/SuffixStructures/SuffixTree/nodeCount":{"abstract":[{"type":"text","text":"The number of nodes, the root and every leaf included."}],"title":"nodeCount","role":"symbol","url":"\/documentation\/suffixs