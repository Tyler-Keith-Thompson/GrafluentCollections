{"variants":[{"paths":["\/documentation\/tries"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","isActive":true},{"text":" is a set of sequences and a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","isActive":true},{"text":" a dictionary keyed by them, both kept in","type":"text"},{"text":" ","type":"text"},{"text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the","type":"text"},{"text":" ","type":"text"},{"text":"keys. They answer the queries a hash set cannot: every key with a prefix","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"elements(withPrefix:)","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" is O(1)), whether any key has one (","type":"text"},{"code":"hasPrefix(_:)","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"the longest key that is a prefix of a query (","type":"text"},{"code":"longestPrefix(of:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""]},{"inlineContent":[{"type":"text","text":"Keys are any sequence of the symbol type and are stored as "},{"type":"codeVoice","code":"[Symbol]"},{"type":"text","text":". For text, the symbol"},{"type":"text","text":" "},{"type":"text","text":"type decides what a step is: "},{"type":"codeVoice","code":"Trie<Character>"},{"type":"text","text":" steps by grapheme cluster, "},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"type":"text","text":" "},{"type":"text","text":"by scalar, and "},{"type":"codeVoice","code":"Trie<UInt8>"},{"type":"text","text":" over "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":" by byte, the fastest of the three, because comparing"},{"type":"text","text":" "},{"type":"text","text":"bytes is cheaper than comparing "},{"type":"codeVoice","code":"Character"},{"type":"text","text":"s. When the symbols are "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", each vertex keeps"},{"type":"text","text":" "},{"type":"text","text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order"},{"type":"text","text":" "},{"type":"text","text":"they were added."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true},{"type":"text","text":" and a "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","isActive":true},{"type":"text","text":" hold the same keys and answer the same queries,"},{"type":"text","text":" "},{"type":"text","text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and"},{"type":"text","text":" "},{"type":"text","text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per"},{"type":"text","text":" "},{"type":"text","text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file"},{"type":"text","text":" "},{"type":"text","text":"paths or URLs, and build faster and in less memory than a trie of the same keys."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A trie’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"PrefixTree(_:)"},{"type":"text","text":", and a radix tree’s to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" of its vertices’ prefixes with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one)."}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","type":"reference","isActive":true},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" + ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"z"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" symbols and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"z"}]},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","type":"reference","isActive":true},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"]}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"kind":"symbol","metadata":{"modules":[{"name":"Tries"}],"roleHeading":"Framework","externalID":"Tries","role":"collection","title":"Tries","symbolKind":"module"},"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"topicSections":[{"title":"Sets of sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"anchor":"Sets-of-sequences"},{"title":"Dictionaries keyed by sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"anchor":"Dictionaries-keyed-by-sequences"},{"title":"Pattern matching","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"anchor":"Pattern-matching"},{"title":"Extended Modules","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"anchor":"Extended-Modules","generated":true}],"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"title":"statesView","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statesView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"typeIdentifier","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"StatesView","kind":"typeIdentifier","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the"},{"type":"text","text":" "},{"type":"text","text":"root, a goto edge from each state to each of its trie children, and a failure edge from"},{"type":"text","text":" "},{"type":"text","text":"each state but the root to its failure state. "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","isActive":true,"type":"reference"},{"type":"text","text":" tells the two"},{"type":"text","text":" "},{"type":"text","text":"apart."}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"url":"\/documentation\/tries\/ahocorasickautomaton","title":"AhoCorasickAutomaton","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}]},"doc://Tries/documentation/Tries/RadixTree":{"type":"topic","role":"symbol","url":"\/documentation\/tries\/radixtree","navigatorTitle":[{"text":"RadixTree","kind":"identifier"}],"abstract":[{"text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of","type":"text"},{"text":" ","type":"text"},{"text":"vertices with one child and no key is merged into one edge labelled with all its symbols.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"}],"title":"RadixTree","kind":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/StatesView-swift.struct/symbol(ofEdgeAt:)":{"abstract":[{"text":"The symbol a goto edge reads, or nil for a failure edge.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","type":"topic","title":"symbol(ofEdgeAt:)","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.struct\/symbol(ofedgeat:)","kind":"symbol","role":"symbol"},"doc://Tries/documentation/Tries":{"abstract":[{"type":"text","text":"Tries over sequences of any "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}],"identifier":"doc:\/\/Tries\/documentation\/Tries","url":"\/documentation\/tries","type":"topic","title":"Tries","kind":"symbol","role":"collection"},"doc://Tries/documentation/Tries/RadixTreeDictionary":{"title":"RadixTreeDictionary","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTreeDictionary","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A dictionary keyed by sequences, kept in a radix tree (Morrison, 1968): a trie in which every"},{"type":"text","text":" "},{"type":"text","text":"chain of vertices with one child and no key is merged into one edge labelled with all its"},{"type":"text","text":" "},{"type":"text","text":"symbols, each key’s vertex holding its value."}],"url":"\/documentation\/tries\/radixtreedictionary","navigatorTitle":[{"text":"RadixTreeDictionary","kind":"identifier"}]},"doc://Tries/documentation/Tries/Trie":{"abstract":[{"text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex","type":"text"},{"text":" ","type":"text"},{"text":"paths spell the keys (Fredkin, 1960).","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}],"type":"topic","url":"\/documentation\/tries\/trie","title":"Trie","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","navigatorTitle":[{"text":"Trie","kind":"identifier"}]},"doc://Tries/documentation/Tries/Trees":{"abstract":[],"type":"topic","title":"Trees","url":"\/documentation\/tries\/trees","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trees","kind":"symbol","role":"collection"},"doc://Tries/documentation/Tries/TrieDictionary":{"title":"TrieDictionary","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrieDictionary"}],"kind":"symbol","abstract":[{"text":"A dictionary keyed by sequences, kept in a trie: a tree whose edges carry symbols and whose","type":"text"},{"text":" ","type":"text"},{"text":"root-to-vertex paths spell the keys, each key’s vertex holding its value (Fredkin, 1960).","type":"text"}],"url":"\/documentation\/tries\/triedictionary","navigatorTitle":[{"kind":"identifier","text":"TrieDictionary"}]}}}