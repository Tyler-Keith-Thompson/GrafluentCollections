and no key is merged into one edge labelled with all its","type":"text"},{"text":" ","type":"text"},{"text":"symbols, each key’s vertex holding its value.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTreeDictionary","kind":"identifier"}],"title":"RadixTreeDictionary","navigatorTitle":[{"text":"RadixTreeDictionary","kind":"identifier"}],"url":"\/documentation\/tries\/radixtreedictionary","type":"topic"},"doc://Tries/documentation/Tries/Trees":{"url":"\/documentation\/tries\/trees","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trees","title":"Trees","abstract":[],"role":"collection","type":"topic","kind":"symbol"},"doc://Tries/documentation/Tries/Trie":{"url":"\/documentation\/tries\/trie","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","title":"Trie","navigatorTitle":[{"text":"Trie","kind":"identifier"}],"abstract":[{"text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex","type":"text"},{"text":" ","type":"text"},{"text":"paths spell the keys (Fredkin, 1960).","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"type":"topic","url":"\/documentation\/tries\/ahocorasickautomaton","kind":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","title":"AhoCorasickAutomaton","abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}]},"doc://Tries/documentation/Tries/AhoCorasickAu