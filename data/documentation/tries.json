 1960).","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrieDictionary","kind":"identifier"}],"title":"TrieDictionary","type":"topic","navigatorTitle":[{"text":"TrieDictionary","kind":"identifier"}]},"doc://Tries/documentation/Tries/RadixTreeDictionary":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTreeDictionary"}],"type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","kind":"symbol","role":"symbol","title":"RadixTreeDictionary","abstract":[{"type":"text","text":"A dictionary keyed by sequences, kept in a radix tree (Morrison, 1968): a trie in which every"},{"type":"text","text":" "},{"type":"text","text":"chain of vertices with one child and no key is merged into one edge labelled with all its"},{"type":"text","text":" "},{"type":"text","text":"symbols, each key’s vertex holding its value."}],"url":"\/documentation\/tries\/radixtreedictionary","navigatorTitle":[{"kind":"identifier","text":"RadixTreeDictionary"}]},"doc://Tries/documentation/Tries/Trie":{"type":"topic","navigatorTitle":[{"text":"Trie","kind":"identifier"}],"title":"Trie","role":"symbol","kind":"symbol","url":"\/documentation\/tries\/trie","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","abstract":[{"type":"text","text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex"},{"type":"text","text":" "},{"type":"text","text":"paths spell the keys (Fredkin, 1960)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}]}}}