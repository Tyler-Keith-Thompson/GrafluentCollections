{"metadata":{"roleHeading":"Framework","modules":[{"name":"Tries"}],"role":"collection","title":"Tries","externalID":"Tries","symbolKind":"module"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries"]}],"topicSections":[{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"title":"Sets of sequences","anchor":"Sets-of-sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"title":"Dictionaries keyed by sequences","anchor":"Dictionaries-keyed-by-sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"title":"Pattern matching","anchor":"Pattern-matching"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"title":"Extended Modules","generated":true,"anchor":"Extended-Modules"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"abstract":[{"type":"text","text":"Tries over sequences of any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie"},{"type":"text","text":" is a set of sequences and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary"},{"type":"text","text":" a dictionary keyed by them, both kept in"},{"type":"text","text":" "},{"type":"text","text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the"},{"type":"text","text":" "},{"type":"text","text":"keys. They answer the queries a hash set cannot: every key with a prefix"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"elements(withPrefix:)","type":"codeVoice"},{"type":"text","text":", whose "},{"code":"count","type":"codeVoice"},{"type":"text","text":" is O(1)), whether any key has one ("},{"code":"hasPrefix(_:)","type":"codeVoice"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"the longest key that is a prefix of a query ("},{"code":"longestPrefix(of:)","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing"},{"inlineContent":[{"text":"Keys are any sequence of the symbol type and are stored as ","type":"text"},{"type":"codeVoice","code":"[Symbol]"},{"text":". For text, the symbol","type":"text"},{"text":" ","type":"text"},{"text":"type decides what a step is: ","type":"text"},{"type":"codeVoice","code":"Trie<Character>"},{"text":" steps by grapheme cluster, ","type":"text"},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"text":" ","type":"text"},{"text":"by scalar, and ","type":"text"},{"type":"codeVoice","code":"Trie<UInt8>"},{"text":" over ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" by byte, the fastest of the three, because comparing","type":"text"},{"text":" ","type":"text"},{"text":"bytes is cheaper than comparing ","type":"text"},{"type":"codeVoice","code":"Character"},{"text":"s. When the symbols are ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":", each vertex keeps","type":"text"},{"text":" ","type":"text"},{"text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true,"type":"reference"},{"text":" and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","isActive":true,"type":"reference"},{"text":" hold the same keys and answer the same queries,","type":"text"},{"text":" ","type":"text"},{"text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and","type":"text"},{"text":" ","type":"text"},{"text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per","type":"text"},{"text":" ","type":"text"},{"text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs, and build faster and in less memory than a trie of the same keys.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A trie’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"PrefixTree(_:)"},{"type":"text","text":", and a radix tree’s to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" of its vertices’ prefixes with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one)."}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","type":"reference","isActive":true},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"z"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" symbols and ","type":"text"},{"inlineContent":[{"type":"text","text":"z"}],"type":"emphasis"},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","type":"reference","isActive":true},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"kind":"symbol","references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"title":"AhoCorasickAutomaton","url":"\/documentation\/tries\/ahocorasickautomaton","kind":"symbol","abstract":[{"text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text","type":"text"},{"text":" ","type":"text"},{"text":"(Aho and Corasick, 1975).","type":"text"}],"type":"topic","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"},"doc://Tries/documentation/Tries/TrieDictionary":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","type":"topic","role":"symbol","navigatorTitle":[{"text":"TrieDictionary","kind":"identifier"}],"title":"TrieDictionary","kind":"symbol","url":"\/documentation\/tries\/triedictionary","abstract":[{"text":"A dictionary keyed by sequences, kept in a trie: a tree whose edges carry symbols and whose","type":"text"},{"text":" ","type":"text"},{"text":"root-to-vertex paths spell the keys, each key’s vertex holding its value (Fredkin, 1960).","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrieDictionary","kind":"identifier"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/StatesView-swift.struct/symbol(ofEdgeAt:)":{"abstract":[{"type":"text","text":"The symbol a goto edge reads, or nil for a failure edge."}],"type":"topic","role":"symbol","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.struct\/symbol(ofedgeat:)","kind":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"symbol(ofEdgeAt:)"},"doc://Tries/documentation/Tries/RadixTree":{"url":"\/documentation\/tries\/radixtree","title":"RadixTree","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","navigatorTitle":[{"text":"RadixTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of"},{"type":"text","text":" "},{"type":"text","text":"vertices with one child and no key is merged into one edge labelled with all its symbols."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Tries/documentation/Tries/Trees":{"abstract"