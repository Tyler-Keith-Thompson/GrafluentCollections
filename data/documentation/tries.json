{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries"]}],"metadata":{"externalID":"Tries","modules":[{"name":"Tries"}],"role":"collection","roleHeading":"Framework","title":"Tries","symbolKind":"module"},"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"sections":[],"topicSections":[{"title":"Sets of sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"anchor":"Sets-of-sequences"},{"title":"Dictionaries keyed by sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"anchor":"Dictionaries-keyed-by-sequences"},{"title":"Pattern matching","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"anchor":"Pattern-matching"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"anchor":"Extended-Modules"}],"abstract":[{"type":"text","text":"Tries over sequences of any "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","isActive":true,"type":"reference"},{"text":" is a set of sequences and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","isActive":true,"type":"reference"},{"text":" a dictionary keyed by them, both kept in","type":"text"},{"text":" ","type":"text"},{"text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the","type":"text"},{"text":" ","type":"text"},{"text":"keys. They answer the queries a hash set cannot: every key with a prefix","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"elements(withPrefix:)","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" is O(1)), whether any key has one (","type":"text"},{"code":"hasPrefix(_:)","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"the longest key that is a prefix of a query (","type":"text"},{"code":"longestPrefix(of:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Keys are any sequence of the symbol type and are stored as "},{"code":"[Symbol]","type":"codeVoice"},{"type":"text","text":". For text, the symbol"},{"type":"text","text":" "},{"type":"text","text":"type decides what a step is: "},{"code":"Trie<Character>","type":"codeVoice"},{"type":"text","text":" steps by grapheme cluster, "},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"by scalar, and "},{"code":"Trie<UInt8>","type":"codeVoice"},{"type":"text","text":" over "},{"code":"utf8","type":"codeVoice"},{"type":"text","text":" by byte, the fastest of the three, because comparing"},{"type":"text","text":" "},{"type":"text","text":"bytes is cheaper than comparing "},{"code":"Character","type":"codeVoice"},{"type":"text","text":"s. When the symbols are "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":", each vertex keeps"},{"type":"text","text":" "},{"type":"text","text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order"},{"type":"text","text":" "},{"type":"text","text":"they were added."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true,"type":"reference"},{"type":"text","text":" and a "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","isActive":true,"type":"reference"},{"type":"text","text":" hold the same keys and answer the same queries,"},{"type":"text","text":" "},{"type":"text","text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and"},{"type":"text","text":" "},{"type":"text","text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per"},{"type":"text","text":" "},{"type":"text","text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file"},{"type":"text","text":" "},{"type":"text","text":"paths or URLs, and build faster and in less memory than a trie of the same keys."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A trie’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"PrefixTree(_:)"},{"type":"text","text":", and a radix tree’s to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" of its vertices’ prefixes with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one)."}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","type":"reference"},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"text":"z","type":"text"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" symbols and ","type":"text"},{"inlineContent":[{"text":"z","type":"text"}],"type":"emphasis"},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","type":"reference"},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing"}]}],"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"title":"statesView","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","role":"symbol","type":"topic","kind":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","abstract":[{"text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the","type":"text"},{"text":" ","type":"text"},{"text":"root, a goto edge from each state to each of its trie children, and a failure edge from","type":"text"},{"text":" ","type":"text"},{"text":"each state but the root to its failure state. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","type":"reference"},{"text":" tells the two","type":"text"},{"text":" ","type":"text"},{"text":"apart.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statesView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"typeIdentifier","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"StatesView","kind":"typeIdentifier","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"kind":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","title":"AhoCorasickAutomaton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/tries\/ahocorasickautomaton","abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}]},"doc://Tries/documentation/Tries/RadixTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTree"}],"role":"symbol","url":"\/documentation\/tries\/radixtree","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RadixTree"}],"title":"RadixTree","abstract":[{"type":"text","text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of"},{"type":"text","text":" "},{"type":"text","text":"vertices with one child and no key is merged into one edge labelled with all its symbols."}]},"doc://Tries/documentation/Tries/RadixTreeDictionary":{"type":"topic","role":"symbol","abstract":[{"text":"A dictionary keyed by sequences, kept in a radix tree (Morrison, 1968): a trie in which every","type":"text"},{"text":" ","type":"text"},{"text":"chain of vertices with one child and no key is merged into one edge labelled with all its","type":"text"},{"text":" ","type":"text"},{"text":"symbols, each key’s vertex holding its value.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTreeDictionary"}],"title":"RadixTreeDictionary","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","kind":"symbol","url":"\/documentation\/tries\/radixtreedictionary","navigatorTitle":[{"kind":"identifier","text":"RadixTreeDictionary"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/StatesView-swift.struct/symbol(ofEdgeAt:)":{"title":"symbol(ofEdgeAt:)","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.struct\/symbol(ofedgeat:)","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","abstract":[{"text":"The symbol a goto edge reads, or nil for a failure edge.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://Tries/documentation/Tries":{"role":"collection","url":"\/documentation\/tries","identifier":"doc:\/\/Tries\/documentation\/Tries","kind":"symbol","type":"topic","title":"Tries","abstract":[{"type":"text","text":"Tries over sequences of any "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}]},"doc://Tries/documentation/Tries/Trie":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex"},{"type":"text","text":" "},{"type":"text","text":"paths spell the keys (Fredkin, 1960)."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Trie"}],"title":"Trie","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","kind":"symbol","url":"\/documentation\/tries\/trie","navigatorTitle":[{"kind":"identifier","text":"Trie"}]},"doc://Tries/documentation/Tries/TrieDictionary":{"type":"topic","role":"symbol","abstract":[{"text":"A dictionary keyed by sequences, kept in a trie: a tree whose edges carry symbols and whose","type":"text"},{"text":" ","type":"text"},{"text":"root-to-vertex paths spell the keys, each key’s vertex holding its value (Fredkin, 1960).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrieDictionary"}],"title":"TrieDictionary","identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","kind":"symbol","url":"\/documentation\/tries\/triedictionary","navigatorTitle":[{"kind":"identifier","text":"TrieDictionary"}]},"doc://Tries/documentation/Tries/Trees":{"kind":"symbol","role":"collection","title":"Trees","url":"\/documentation\/tries\/trees","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trees","abstract":[]}}}