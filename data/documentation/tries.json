{"metadata":{"externalID":"Tries","modules":[{"name":"Tries"}],"role":"collection","symbolKind":"module","roleHeading":"Framework","title":"Tries"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"sections":[],"kind":"symbol","topicSections":[{"title":"Sets of sequences","anchor":"Sets-of-sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"]},{"title":"Dictionaries keyed by sequences","anchor":"Dictionaries-keyed-by-sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"]},{"title":"Pattern matching","anchor":"Pattern-matching","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie"},{"type":"text","text":" is a set of sequences and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary"},{"type":"text","text":" a dictionary keyed by them, both kept in"},{"type":"text","text":" "},{"type":"text","text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the"},{"type":"text","text":" "},{"type":"text","text":"keys. They answer the queries a hash set cannot: every key with a prefix"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"elements(withPrefix:)"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is O(1)), whether any key has one ("},{"type":"codeVoice","code":"hasPrefix(_:)"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"the longest key that is a prefix of a query ("},{"type":"codeVoice","code":"longestPrefix(of:)"},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys are any sequence of the symbol type and are stored as "},{"type":"codeVoice","code":"[Symbol]"},{"type":"text","text":". For text, the symbol"},{"type":"text","text":" "},{"type":"text","text":"type decides what a step is: "},{"type":"codeVoice","code":"Trie<Character>"},{"type":"text","text":" steps by grapheme cluster, "},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"type":"text","text":" "},{"type":"text","text":"by scalar, and "},{"type":"codeVoice","code":"Trie<UInt8>"},{"type":"text","text":" over "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":" by byte, the fastest of the three, because comparing"},{"type":"text","text":" "},{"type":"text","text":"bytes is cheaper than comparing "},{"type":"codeVoice","code":"Character"},{"type":"text","text":"s. When the symbols are "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", each vertex keeps"},{"type":"text","text":" "},{"type":"text","text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order"},{"type":"text","text":" "},{"type":"text","text":"they were added."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","type":"reference","isActive":true},{"text":" and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","type":"reference","isActive":true},{"text":" hold the same keys and answer the same queries,","type":"text"},{"text":" ","type":"text"},{"text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and","type":"text"},{"text":" ","type":"text"},{"text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per","type":"text"},{"text":" ","type":"text"},{"text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs, and build faster and in less memory than a trie of the same keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A trie’s shape converts to Grafluent’s ","type":"text"},{"type":"codeVoice","code":"PrefixTree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"PrefixTree(_:)"},{"text":", and a radix tree’s to","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"Arborescence"},{"text":" of its vertices’ prefixes with ","type":"text"},{"type":"codeVoice","code":"Arborescence(_:)"},{"text":" (import Grafluent’s ","type":"text"},{"type":"codeVoice","code":"Trees"},{"text":" ","type":"text"},{"text":"module beside this one).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","isActive":true,"type":"reference"},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"text":"z","type":"text"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" symbols and ","type":"text"},{"inlineContent":[{"text":"z","type":"text"}],"type":"emphasis"},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","isActive":true,"type":"reference"},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"]}]}],"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"references":{"doc://Tries/documentation/Tries/Trees":{"url":"\/documentation\/tries\/trees","role":"collection","title":"Trees","type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trees"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","conformance":{"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"kind":"symbol","type":"topic","title":"statesView","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","abstract":[{"text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the","type":"text"},{"text":" ","type":"text"},{"text":"root, a goto edge from each state to each of its trie children, and a failure edge from","type":"text"},{"text":" ","type":"text"},{"text":"each state but the root to its failure state. ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","isActive":true,"type":"reference"},{"text":" tells the two","type":"text"},{"text":" ","type":"text"},{"text":"apart.","type":"text"}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statesView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AhoCorasickAutomaton","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"StatesView","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV","kind":"typeIdentifier"}]},"doc://Tries/documentation/Tries":{"type":"topic","title":"Tries","role":"collection","kind":"symbol","url":"\/documentation\/tries","identifier":"doc:\/\/Tries\/documentation\/Tries","abstract":[{"type":"text","text":"Tries over sequences of any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"role":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","url":"\/documentation\/tries\/ahocorasickautomaton","abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"title":"AhoCorasickAutomaton","type":"topic","navigatorTitle":[{"text":"AhoCorasic