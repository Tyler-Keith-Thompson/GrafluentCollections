{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"metadata":{"externalID":"Tries","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"Tries"}],"title":"Tries","role":"collection"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","isActive":true},{"type":"text","text":" is a set of sequences and a "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","isActive":true},{"type":"text","text":" a dictionary keyed by them, both kept in"},{"type":"text","text":" "},{"type":"text","text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the"},{"type":"text","text":" "},{"type":"text","text":"keys. They answer the queries a hash set cannot: every key with a prefix"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"elements(withPrefix:)"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is O(1)), whether any key has one ("},{"type":"codeVoice","code":"hasPrefix(_:)"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"the longest key that is a prefix of a query ("},{"type":"codeVoice","code":"longestPrefix(of:)"},{"type":"text","text":")."}],"type":"paragraph"},{"code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Keys are any sequence of the symbol type and are stored as ","type":"text"},{"type":"codeVoice","code":"[Symbol]"},{"text":". For text, the symbol","type":"text"},{"text":" ","type":"text"},{"text":"type decides what a step is: ","type":"text"},{"type":"codeVoice","code":"Trie<Character>"},{"text":" steps by grapheme cluster, ","type":"text"},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"text":" ","type":"text"},{"text":"by scalar, and ","type":"text"},{"type":"codeVoice","code":"Trie<UInt8>"},{"text":" over ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" by byte, the fastest of the three, because comparing","type":"text"},{"text":" ","type":"text"},{"text":"bytes is cheaper than comparing ","type":"text"},{"type":"codeVoice","code":"Character"},{"text":"s. When the symbols are ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":", each vertex keeps","type":"text"},{"text":" ","type":"text"},{"text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","type":"reference"},{"text":" and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","type":"reference"},{"text":" hold the same keys and answer the same queries,","type":"text"},{"text":" ","type":"text"},{"text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and","type":"text"},{"text":" ","type":"text"},{"text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per","type":"text"},{"text":" ","type":"text"},{"text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs, and build faster and in less memory than a trie of the same keys.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A trie’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"PrefixTree(_:)"},{"type":"text","text":", and a radix tree’s to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" of its vertices’ prefixes with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one)."}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" + ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"z"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" symbols and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"z"}]},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"topicSections":[{"anchor":"Sets-of-sequences","title":"Sets of sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"]},{"anchor":"Dictionaries-keyed-by-sequences","title":"Dictionaries keyed by sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"]},{"anchor":"Pattern-matching","title":"Pattern matching","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"]}],"variants":[{"paths":["\/documentation\/tries"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://Tries/documentation/Tries/RadixTreeDictionary":{"type":"topic","title":"RadixTreeDictionary","kind":"symbol","navigatorTitle":[{"text":"RadixTreeDictionary","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","abstract":[{"type":"text","text":"A dictionary keyed by sequences, kept in a radix tree (Morrison, 1968): a trie in which every"},{"type":"text","text":" "},{"type":"text","text":"chain of vertices with one child and no key is merged into one edge labelled with all its"},{"type":"text","text":" "},{"type":"text","text":"symbols, each key’s vertex holding its value."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"RadixTreeDictionary","kind":"identifier"}],"url":"\/documentation\/tries\/radixtreedictionary"},"doc://Tries/documentation/Tries":{"identifier":"doc:\/\/Tries\/documentation\/Tries","url":"\/documentation\/tries","role":"collection","abstract":[{"text":"Tries over sequences of any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"kind":"symbol","type":"topic","title":"Tries"},"doc://Tries/documentation/Tries/TrieDictionary":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","url":"\/documentation\/tries\/triedictionary","role":"symbol","abstract":[{"text":"A dictionary keyed by sequences, kept in a trie: a tree whose edges carry symbols and whose","type":"text"},{"text":" ","type":"text"},{"text":"root-to-vertex paths spell the keys, each key’s vertex holding its value (Fredkin, 1960).","type":"text"}],"kind":"symbol","title":"TrieDictionary","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TrieDictionary"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrieDictionary"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"abstract":[{"type":"text","text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the"},{"type":"text","text":" "},{"type":"text","text":"root, a goto edge from each state to each of its trie children, and a failure edge from"},{"type":"text","text":" "},{"type":"text","text":"each state but the root to its failure state. "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","type":"reference","isActive":true},{"text":" tells the two","type":"text"},{"text":" ","type":"text"},{"text":"apart.","type":"text"}],"type":"topic","title":"statesView","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statesView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV","text":"AhoCorasickAutomaton"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"StatesView","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV","kind":"typeIdentifier"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"title":"AhoCorasickAutomaton","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","url":"\/documentation\/tries\/ahocorasickautomaton","abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}]},"doc://Tries/documentation/Tries/Trie":{"title":"Trie","url":"\/documentation\/tries\/trie","kind":"symbol","navigatorTitle":[{"text":"Trie","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","abstract":[{"text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex","type":"text"},{"text":" ","type":"text"},{"text":"paths spell the keys (Fredkin, 1960).","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}],"type":"topic"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/StatesView-swift.struct