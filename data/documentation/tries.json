ary","role":"symbol","kind":"symbol","abstract":[{"text":"A dictionary keyed by sequences, kept in a radix tree (Morrison, 1968): a trie in which every","type":"text"},{"text":" ","type":"text"},{"text":"chain of vertices with one child and no key is merged into one edge labelled with all its","type":"text"},{"text":" ","type":"text"},{"text":"symbols, each key’s vertex holding its value.","type":"text"}],"title":"RadixTreeDictionary","url":"\/documentation\/tries\/radixtreedictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTreeDictionary","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"RadixTreeDictionary","kind":"identifier"}]},"doc://Tries/documentation/Tries":{"identifier":"doc:\/\/Tries\/documentation\/Tries","title":"Tries","abstract":[{"type":"text","text":"Tries over sequences of any "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}],"type":"topic","kind":"symbol","url":"\/documentation\/tries","role":"collection"},"doc://Tries/documentation/Tries/Trie":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","kind":"symbol","role":"symbol","url":"\/documentation\/tries\/trie","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Trie"}],"abstract":[{"type":"text","text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex"},{"type":"text","text":" "},{"type":"text","text":"paths spell the keys (Fredkin, 1960)."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Trie"}],"title":"Trie"}}}