{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"abstract":[{"type":"text","text":"Tries over sequences of any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}],"kind":"symbol","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","isActive":true,"type":"reference"},{"type":"text","text":" is a set of sequences and a "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","isActive":true,"type":"reference"},{"type":"text","text":" a dictionary keyed by them, both kept in"},{"type":"text","text":" "},{"type":"text","text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the"},{"type":"text","text":" "},{"type":"text","text":"keys. They answer the queries a hash set cannot: every key with a prefix"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"elements(withPrefix:)"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is O(1)), whether any key has one ("},{"type":"codeVoice","code":"hasPrefix(_:)"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"the longest key that is a prefix of a query ("},{"type":"codeVoice","code":"longestPrefix(of:)"},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing"},{"inlineContent":[{"text":"Keys are any sequence of the symbol type and are stored as ","type":"text"},{"type":"codeVoice","code":"[Symbol]"},{"text":". For text, the symbol","type":"text"},{"text":" ","type":"text"},{"text":"type decides what a step is: ","type":"text"},{"type":"codeVoice","code":"Trie<Character>"},{"text":" steps by grapheme cluster, ","type":"text"},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"text":" ","type":"text"},{"text":"by scalar, and ","type":"text"},{"type":"codeVoice","code":"Trie<UInt8>"},{"text":" over ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" by byte, the fastest of the three, because comparing","type":"text"},{"text":" ","type":"text"},{"text":"bytes is cheaper than comparing ","type":"text"},{"type":"codeVoice","code":"Character"},{"text":"s. When the symbols are ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":", each vertex keeps","type":"text"},{"text":" ","type":"text"},{"text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true,"type":"reference"},{"text":" and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","isActive":true,"type":"reference"},{"text":" hold the same keys and answer the same queries,","type":"text"},{"text":" ","type":"text"},{"text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and","type":"text"},{"text":" ","type":"text"},{"text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per","type":"text"},{"text":" ","type":"text"},{"text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs, and build faster and in less memory than a trie of the same keys.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A trie’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"PrefixTree(_:)"},{"type":"text","text":", and a radix tree’s to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" of its vertices’ prefixes with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","isActive":true},{"type":"text","text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of"},{"type":"text","text":" "},{"type":"text","text":"patterns in one pass over a text, in O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"text":"z","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" symbols and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"z"}]},{"type":"text","text":" matches: a trie of the"},{"type":"text","text":" "},{"type":"text","text":"patterns with failure links. Its "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","isActive":true},{"type":"text","text":" is the automaton as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Sets of sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"anchor":"Sets-of-sequences"},{"title":"Dictionaries keyed by sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"anchor":"Dictionaries-keyed-by-sequences"},{"title":"Pattern matching","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"anchor":"Pattern-matching"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"anchor":"Extended-Modules"}],"variants":[{"paths":["\/documentation\/tries"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"roleHeading":"Framework","modules":[{"name":"Tries"}],"externalID":"Tries","symbolKind":"module","role":"collection","title":"Tries"},"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/StatesView-swift.struct/symbol(ofEdgeAt:)":{"title":"symbol(ofEdgeAt:)","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.struct\/symbol(ofedgeat:)","type":"topic","abstract":[{"text":"The symbol a goto edge reads, or nil for a failure edge.","type":"text"}]},"doc://Tries/documentation/Tries/RadixTree":{"title":"RadixTree","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTree"}],"url":"\/documentation\/tries\/radixtree","type":"topic","abstract":[{"text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of","type":"text"},{"text":" ","type":"text"},{"text":"vertices with one child and no key is merged into one edge labelled with all its symbols.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RadixTree"}]},"doc://Tries/documentation/Tries":{"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"title":"Tries","type":"topic","url":"\/documentation\/tries","role":"collection","identifier":"doc:\/\/Tries\/documentation\/Tries","kind":"symbol"},"doc://Tries/documentation/Tries/Trees":{"abstract":[],"role":"collection","kind":"symbol","title":"Trees","type":"topic","url":"\/documentation\/tries\/trees","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trees"},"doc://Tries/documentation/Tries/RadixTreeDictionary":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTreeDictionary"}],"abstract":[{"type":"text","text":"A dictionary keyed by sequences, kept in a radix tree (Morrison, 1968): a trie in which every"},{"type":"text","text":" "},{"type":"text","text":"chain of vertices with one child and no key is merged into one edge labelled with all its"},{"type":"text","text":" "},{"type":"text","text":"symbols, each key’s vertex holding its value."}],"navigatorTitle":[{"kind":"identifier","text":"RadixTreeDictionary"}],"url":"\/documentation\/tries\/radixtreedictionary","type":"topic","title":"RadixTreeDictionary","role":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","kind":"symbol"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"title":"statesView","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statesView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV","text":"AhoCorasickAutomaton"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV","text":"StatesView"}],"url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","type":"topic","abstract":[{"type":"text","text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the"},{"type":"text","text":" "},{"type":"text","text":"root, a goto edge from each state to each of its trie children, and a failure edge from"},{"type":"text","text":" "},{"type":"text","text":"each state but the root to its failure state. "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","isActive":true},{"type":"text","text":" tells the two"},{"type":"text","text":" "},{"type":"text","text":"apart."}],"conformance":{"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"title":"AhoCorasickAutomaton","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"url":"\/documentation\/tries\/ahocorasickautomaton","type":"topic","abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}]},"doc://Tries/documentation/Tries/TrieDictionary":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrieDictionary"}],"kind":"symbol","title":"TrieDictionary","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","abstract":[{"text":"A dictionary keyed by sequences, kept in a trie: a tree whose edges carry symbols and whose","type":"text"},{"text":" ","type":"text"},{"text":"root-to-vertex paths spell the keys, each key’s vertex holding its value (Fredkin, 1960).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TrieDictionary"}],"role":"symbol","url":"\/documentation\/tries\/triedictionary"},"doc://Tries/documentation/Tries/Trie":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Trie"}],"kind":"symbol","title":"Trie","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","abstract":[{"type":"text","text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex"},{"type":"text","text":" "},{"type":"text","text":"paths spell the keys (Fredkin, 1960)."}],"navigatorTitle":[{"kind":"identifier","text":"Trie"}],"role":"symbol","url":"\/documentation\/tries\/trie"}}}