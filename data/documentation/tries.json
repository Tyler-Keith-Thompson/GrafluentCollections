tomaton/statesView-swift.property":{"url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","abstract":[{"type":"text","text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the"},{"type":"text","text":" "},{"type":"text","text":"root, a goto edge from each state to each of its trie children, and a failure edge from"},{"type":"text","text":" "},{"type":"text","text":"each state but the root to its failure state. "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","isActive":true,"type":"reference"},{"type":"text","text":" tells the two"},{"type":"text","text":" "},{"type":"text","text":"apart."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statesView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AhoCorasickAutomaton","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"StatesView","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","title":"statesView"}}}