{"variants":[{"paths":["\/documentation\/tries"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","isActive":true,"type":"reference"},{"type":"text","text":" is a set of sequences and a "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","isActive":true,"type":"reference"},{"type":"text","text":" a dictionary keyed by them, both kept in"},{"type":"text","text":" "},{"type":"text","text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the"},{"type":"text","text":" "},{"type":"text","text":"keys. They answer the queries a hash set cannot: every key with a prefix"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"elements(withPrefix:)","type":"codeVoice"},{"type":"text","text":", whose "},{"code":"count","type":"codeVoice"},{"type":"text","text":" is O(1)), whether any key has one ("},{"code":"hasPrefix(_:)","type":"codeVoice"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"the longest key that is a prefix of a query ("},{"code":"longestPrefix(of:)","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"codeListing","code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Keys are any sequence of the symbol type and are stored as ","type":"text"},{"code":"[Symbol]","type":"codeVoice"},{"text":". For text, the symbol","type":"text"},{"text":" ","type":"text"},{"text":"type decides what a step is: ","type":"text"},{"code":"Trie<Character>","type":"codeVoice"},{"text":" steps by grapheme cluster, ","type":"text"},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"by scalar, and ","type":"text"},{"code":"Trie<UInt8>","type":"codeVoice"},{"text":" over ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":" by byte, the fastest of the three, because comparing","type":"text"},{"text":" ","type":"text"},{"text":"bytes is cheaper than comparing ","type":"text"},{"code":"Character","type":"codeVoice"},{"text":"s. When the symbols are ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", each vertex keeps","type":"text"},{"text":" ","type":"text"},{"text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were added.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A trie’s shape converts to Grafluent’s ","type":"text"},{"code":"PrefixTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"PrefixTree(_:)","type":"codeVoice"},{"text":" (import Grafluent’s","type":"text"},{"text":" ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" module beside this one).","type":"text"}]}],"kind":"content"}],"topicSections":[{"anchor":"Sets-of-sequences","title":"Sets of sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie"]},{"anchor":"Dictionaries-keyed-by-sequences","title":"Dictionaries keyed by sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary"]},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"generated":true}],"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"Tries"}],"role":"collection","roleHeading":"Framework","externalID":"Tries","symbolKind":"module","title":"Tries"},"kind":"symbol","abstract":[{"type":"text","text":"Tries over sequences of any "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, with prefix queries."}],"references":{"doc://Tries/documentation/Tries/Trees":{"title":"Trees","role":"collection","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trees","url":"\/documentation\/tries\/trees","abstract":[],"type":"topic","kind":"symbol"},"doc://Tries/documentation/Tries":{"url":"\/documentation\/tries","kind":"symbol","identifier":"doc:\/\/Tries\/documentation\/Tries","type":"topic","abstract":[{"type":"text","text":"Tries over sequences of any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, with prefix queries."}],"title":"Tries","role":"collection"},"doc://Tries/documentation/Tries/TrieDictionary":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","navigatorTitle":[{"kind":"identifier","text":"TrieDictionary"}],"kind":"symbol","title":"TrieDictionary","type":"topic","abstract":[{"text":"A dictionary keyed by sequences, kept in a trie: a tree whose edges carry symbols and whose","type":"text"},{"text":" ","type":"text"},{"text":"root-to-vertex paths spell the keys, each key’s vertex holding its value (Fredkin, 1960).","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrieDictionary"}],"url":"\/documentation\/tries\/triedictionary"},"doc://Tries/documentation/Tries/Trie":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","navigatorTitle":[{"text":"Trie","kind":"identifier"}],"kind":"symbol","title":"Trie","type":"topic","abstract":[{"text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex","type":"text"},{"text":" ","type":"text"},{"text":"paths spell the keys (Fredkin, 1960).","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}],"url":"\/documentation\/tries\/trie"}}}