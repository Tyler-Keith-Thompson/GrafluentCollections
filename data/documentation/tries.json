{"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Framework","title":"Tries","symbolKind":"module","modules":[{"name":"Tries"}],"externalID":"Tries","role":"collection"},"topicSections":[{"anchor":"Sets-of-sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"title":"Sets of sequences"},{"anchor":"Dictionaries-keyed-by-sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"title":"Dictionaries keyed by sequences"},{"anchor":"Pattern-matching","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"title":"Pattern matching"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"generated":true,"title":"Extended Modules"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","type":"reference","isActive":true},{"type":"text","text":" is a set of sequences and a "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","type":"reference","isActive":true},{"type":"text","text":" a dictionary keyed by them, both kept in"},{"type":"text","text":" "},{"type":"text","text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the"},{"type":"text","text":" "},{"type":"text","text":"keys. They answer the queries a hash set cannot: every key with a prefix"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"elements(withPrefix:)"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is O(1)), whether any key has one ("},{"type":"codeVoice","code":"hasPrefix(_:)"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"the longest key that is a prefix of a query ("},{"type":"codeVoice","code":"longestPrefix(of:)"},{"type":"text","text":")."}]},{"code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Keys are any sequence of the symbol type and are stored as ","type":"text"},{"code":"[Symbol]","type":"codeVoice"},{"text":". For text, the symbol","type":"text"},{"text":" ","type":"text"},{"text":"type decides what a step is: ","type":"text"},{"code":"Trie<Character>","type":"codeVoice"},{"text":" steps by grapheme cluster, ","type":"text"},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"by scalar, and ","type":"text"},{"code":"Trie<UInt8>","type":"codeVoice"},{"text":" over ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":" by byte, the fastest of the three, because comparing","type":"text"},{"text":" ","type":"text"},{"text":"bytes is cheaper than comparing ","type":"text"},{"code":"Character","type":"codeVoice"},{"text":"s. When the symbols are ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", each vertex keeps","type":"text"},{"text":" ","type":"text"},{"text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were added.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true,"type":"reference"},{"text":" and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","isActive":true,"type":"reference"},{"text":" hold the same keys and answer the same queries,","type":"text"},{"text":" ","type":"text"},{"text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and","type":"text"},{"text":" ","type":"text"},{"text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per","type":"text"},{"text":" ","type":"text"},{"text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs, and build faster and in less memory than a trie of the same keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A trie’s shape converts to Grafluent’s "},{"type":"codeVoice","code":"PrefixTree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"PrefixTree(_:)"},{"type":"text","text":", and a radix tree’s to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"Arborescence"},{"type":"text","text":" of its vertices’ prefixes with "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" (import Grafluent’s "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":" "},{"type":"text","text":"module beside this one)."}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"z"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" symbols and ","type":"text"},{"inlineContent":[{"type":"text","text":"z"}],"type":"emphasis"},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries"]}],"kind":"symbol","abstract":[{"text":"Tries over sequences of any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"references":{"doc://Tries/documentation/Tries":{"url":"\/documentation\/tries","role":"collection","identifier":"doc:\/\/Tries\/documentation\/Tries","type":"topic","kind":"symbol","abstract":[{"text":"Tries over sequences of any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"title":"Tries"},"doc://Tries/documentation/Tries/RadixTree":{"navigatorTitle":[{"text":"RadixTree","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of","type":"text"},{"text":" ","type":"text"},{"text":"vertices with one child and no key is merged into one edge labelled with all its symbols.","type":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","title":"RadixTree","url":"\/documentation\/tries\/radixtree","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/StatesView-swift.struct/symbol(ofEdgeAt:)":{"type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.struct\/symbol(ofedgeat:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"symbol"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofEdgeAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The symbol a goto edge reads, or nil for a failure edge."}],"title":"symbol(ofEdgeAt:)"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","abstract":[{"text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the","type":"text"},{"text":" ","type":"text"},{"text":"root, a goto edge from each state to each of its trie children, and a failure edge from","type":"text"},{"text":" ","type":"text"},{"text":"each state but the root to its failure state. ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","type":"reference","isActive":true},{"text":" tells the two","type":"text"},{"text":" ","type":"text"},{"text":"apart.","type":"text"}],"conformance":{"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"co