{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie"},{"text":" is a set of sequences and a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary"},{"text":" a dictionary keyed by them, both kept in","type":"text"},{"text":" ","type":"text"},{"text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the","type":"text"},{"text":" ","type":"text"},{"text":"keys. They answer the queries a hash set cannot: every key with a prefix","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"elements(withPrefix:)","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" is O(1)), whether any key has one (","type":"text"},{"code":"hasPrefix(_:)","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"the longest key that is a prefix of a query (","type":"text"},{"code":"longestPrefix(of:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Keys are any sequence of the symbol type and are stored as ","type":"text"},{"type":"codeVoice","code":"[Symbol]"},{"text":". For text, the symbol","type":"text"},{"text":" ","type":"text"},{"text":"type decides what a step is: ","type":"text"},{"type":"codeVoice","code":"Trie<Character>"},{"text":" steps by grapheme cluster, ","type":"text"},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"text":" ","type":"text"},{"text":"by scalar, and ","type":"text"},{"type":"codeVoice","code":"Trie<UInt8>"},{"text":" over ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" by byte, the fastest of the three, because comparing","type":"text"},{"text":" ","type":"text"},{"text":"bytes is cheaper than comparing ","type":"text"},{"type":"codeVoice","code":"Character"},{"text":"s. When the symbols are ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":", each vertex keeps","type":"text"},{"text":" ","type":"text"},{"text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree"},{"type":"text","text":" and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"},{"type":"text","text":" hold the same keys and answer the same queries,"},{"type":"text","text":" "},{"type":"text","text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and"},{"type":"text","text":" "},{"type":"text","text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per"},{"type":"text","text":" "},{"type":"text","text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file"},{"type":"text","text":" "},{"type":"text","text":"paths or URLs, and build faster and in less memory than a trie of the same keys."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A trie’s shape converts to Grafluent’s "},{"code":"PrefixTree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"PrefixTree(_:)","type":"codeVoice"},{"type":"text","text":", and a radix tree’s to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"code":"Arborescence","type":"codeVoice"},{"type":"text","text":" of its vertices’ prefixes with "},{"code":"Arborescence(_:)","type":"codeVoice"},{"type":"text","text":" (import Grafluent’s "},{"code":"Trees","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"module beside this one)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","isActive":true},{"type":"text","text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of"},{"type":"text","text":" "},{"type":"text","text":"patterns in one pass over a text, in O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"text":"z","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" symbols and "},{"type":"emphasis","inlineContent":[{"text":"z","type":"text"}]},{"type":"text","text":" matches: a trie of the"},{"type":"text","text":" "},{"type":"text","text":"patterns with failure links. Its "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","isActive":true},{"type":"text","text":" is the automaton as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"sections":[],"metadata":{"roleHeading":"Framework","role":"collection","title":"Tries","externalID":"Tries","symbolKind":"module","modules":[{"name":"Tries"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries"]}],"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"title":"Sets of sequences","anchor":"Sets-of-sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"title":"Dictionaries keyed by sequences","anchor":"Dictionaries-keyed-by-sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"title":"Pattern matching","anchor":"Pattern-matching"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules"}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statesView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AhoCorasickAutomaton","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"StatesView","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the"},{"type":"text","text":" "},{"type":"text","text":"root, a goto edge from each state to each of its trie children, and a failure edge from"},{"type":"text","text":" "},{"type":"text","text":"each state but the root to its failure state. "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","type":"reference","isActive":true},{"type":"text","text":" tells the two"},{"type":"text","text":" "},{"type":"text","text":"apart."}],"kind":"symbol","title":"statesView","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]},"url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","type":"topic"},"doc://Tries/documentation/Tries":{"identifier":"doc:\/\/Tries\/documentation\/Tries","abstract":[{"text":"Tries over sequences of any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"type":"topic","kind":"symbol","title":"Tries","role":"collection","url":"\/documentation\/tries"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"abstract":[{"text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text","type":"text"},{"text":" ","type":"text"},{"text":"(Aho and Corasick, 1975).","type":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"}],"role":"symbol","kind":"symbol","title":"AhoCorasickAutomaton","navigatorTitle":[{"kind":"identifier","text":"AhoCorasickAutomaton"}],"url":"\/documentation\/tries\/ahocorasickautomaton","type":"topic"},"doc://Tries/documentation/Tries/Trie":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","navigatorTitle":[{"text":"Trie","kind":"identifier"}],"fragments":[{"text":"struct","k