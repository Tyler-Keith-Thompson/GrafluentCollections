tomaton/statesView-swift.property":{"title":"statesView","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","abstract":[{"text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the","type":"text"},{"text":" ","type":"text"},{"text":"root, a goto edge from each state to each of its trie children, and a failure edge from","type":"text"},{"text":" ","type":"text"},{"text":"each state but the root to its failure state. ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","isActive":true,"type":"reference"},{"text":" tells the two","type":"text"},{"text":" ","type":"text"},{"text":"apart.","type":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statesView"},{"kind":"text","text":": "},{"preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV","kind":"typeIdentifier","text":"AhoCorasickAutomaton"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV","kind":"typeIdentifier","text":"StatesView"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Symbol"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]}}}}