{"variants":[{"paths":["\/documentation\/tries"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","isActive":true,"type":"reference"},{"text":" is a set of sequences and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","isActive":true,"type":"reference"},{"text":" a dictionary keyed by them, both kept in","type":"text"},{"text":" ","type":"text"},{"text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the","type":"text"},{"text":" ","type":"text"},{"text":"keys. They answer the queries a hash set cannot: every key with a prefix","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"elements(withPrefix:)","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" is O(1)), whether any key has one (","type":"text"},{"code":"hasPrefix(_:)","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"the longest key that is a prefix of a query (","type":"text"},{"code":"longestPrefix(of:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Keys are any sequence of the symbol type and are stored as "},{"code":"[Symbol]","type":"codeVoice"},{"type":"text","text":". For text, the symbol"},{"type":"text","text":" "},{"type":"text","text":"type decides what a step is: "},{"code":"Trie<Character>","type":"codeVoice"},{"type":"text","text":" steps by grapheme cluster, "},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"by scalar, and "},{"code":"Trie<UInt8>","type":"codeVoice"},{"type":"text","text":" over "},{"code":"utf8","type":"codeVoice"},{"type":"text","text":" by byte, the fastest of the three, because comparing"},{"type":"text","text":" "},{"type":"text","text":"bytes is cheaper than comparing "},{"code":"Character","type":"codeVoice"},{"type":"text","text":"s. When the symbols are "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":", each vertex keeps"},{"type":"text","text":" "},{"type":"text","text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order"},{"type":"text","text":" "},{"type":"text","text":"they were added."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","type":"reference","isActive":true},{"text":" and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","type":"reference","isActive":true},{"text":" hold the same keys and answer the same queries,","type":"text"},{"text":" ","type":"text"},{"text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and","type":"text"},{"text":" ","type":"text"},{"text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per","type":"text"},{"text":" ","type":"text"},{"text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs, and build faster and in less memory than a trie of the same keys.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A trie’s shape converts to Grafluent’s ","type":"text"},{"code":"PrefixTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"PrefixTree(_:)","type":"codeVoice"},{"text":", and a radix tree’s to","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":" of its vertices’ prefixes with ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":" (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module beside this one).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","type":"reference","isActive":true},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" + ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"z"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" symbols and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"z","type":"text"}]},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","type":"reference","isActive":true},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"externalID":"Tries","modules":[{"name":"Tries"}],"symbolKind":"module","role":"collection","title":"Tries","roleHeading":"Framework"},"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"title":"Sets of sequences","anchor":"Sets-of-sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"title":"Dictionaries keyed by sequences","anchor":"Dictionaries-keyed-by-sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"title":"Pattern matching","anchor":"Pattern-matching"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"title":"Extended Modules","anchor":"Extended-Modules"}],"sections":[],"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"}],"abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"title":"AhoCorasickAutomaton","type":"topic","url":"\/documentation\/tries\/ahocorasickautomaton","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AhoCorasickAutomaton"}],"kind":"symbol"},"doc://Tries/documentation/Tries/Trie":{"type":"topic","role":"symbol","title":"Trie","url":"\/documentation\/tries\/trie","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","navigatorTitle":[{"text":"Trie","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex","type":"text"},{"text":" ","type":"text"},{"text":"paths spell the keys (Fredkin, 1960).","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}]},"doc://Tries/documentation/Tries":{"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"url":"\/documentation\/tries","type":"topic","title":"Tries","identifier":"doc:\/\/Tries\/documentation\/Tries","role":"collection","kind":"symbol"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"abstract":[{"text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the","type":"text"},{"text":" ","type":"text"},{"text":"root, a goto edge from each state to each of its trie children, and a failure edge from","type":"text"},{"text":" ","type":"text"},{"text":"each state but the root to its failure state. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","type":"reference"},{"text":" tells the two","type":"text"},{"text":" ","type":"text"},{"text":"apart.","type":"text"}],"kind":"symbol","title":"statesView","type":"topic","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Symbol","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind"