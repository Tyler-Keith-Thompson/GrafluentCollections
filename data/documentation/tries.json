{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries"]}],"topicSections":[{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trie","doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"anchor":"Sets-of-sequences","title":"Sets of sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary"],"anchor":"Dictionaries-keyed-by-sequences","title":"Dictionaries keyed by sequences"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"],"anchor":"Pattern-matching","title":"Pattern matching"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/Trees"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"hierarchy":{"paths":[[]]},"metadata":{"externalID":"Tries","title":"Tries","role":"collection","modules":[{"name":"Tries"}],"roleHeading":"Framework","symbolKind":"module"},"abstract":[{"text":"Tries over sequences of any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie"},{"text":" is a set of sequences and a ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","isActive":true,"type":"reference"},{"text":" a dictionary keyed by them, both kept in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a trie (Fredkin, 1960): a tree whose edges carry symbols and whose root-to-vertex paths spell the"},{"type":"text","text":" "},{"type":"text","text":"keys. They answer the queries a hash set cannot: every key with a prefix"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"elements(withPrefix:)"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is O(1)), whether any key has one ("},{"code":"hasPrefix(_:)","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"the longest key that is a prefix of a query (","type":"text"},{"code":"longestPrefix(of:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Tries","","let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing"},{"inlineContent":[{"text":"Keys are any sequence of the symbol type and are stored as ","type":"text"},{"code":"[Symbol]","type":"codeVoice"},{"text":". For text, the symbol","type":"text"},{"text":" ","type":"text"},{"text":"type decides what a step is: ","type":"text"},{"code":"Trie<Character>","type":"codeVoice"},{"text":" steps by grapheme cluster, ","type":"text"},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"by scalar, and ","type":"text"},{"code":"Trie<UInt8>","type":"codeVoice"},{"text":" over ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":" by byte, the fastest of the three, because comparing","type":"text"},{"text":" ","type":"text"},{"text":"bytes is cheaper than comparing ","type":"text"},{"code":"Character","type":"codeVoice"},{"text":"s. When the symbols are ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", each vertex keeps","type":"text"},{"text":" ","type":"text"},{"text":"its children sorted, so iteration is in lexicographic order; otherwise children come in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true},{"text":" and a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","isActive":true},{"text":" hold the same keys and answer the same queries,","type":"text"},{"text":" ","type":"text"},{"text":"with the same names, in a radix tree (Morrison, 1968): every chain of vertices with one child and","type":"text"},{"text":" ","type":"text"},{"text":"no key is merged into one edge labelled with all its symbols, so there is a vertex per key and per","type":"text"},{"text":" ","type":"text"},{"text":"branching point rather than per symbol. They suit keys with long shared prefixes, such as file","type":"text"},{"text":" ","type":"text"},{"text":"paths or URLs, and build faster and in less memory than a trie of the same keys.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A trie’s shape converts to Grafluent’s ","type":"text"},{"code":"PrefixTree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"PrefixTree(_:)","type":"codeVoice"},{"text":", and a radix tree’s to","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"Arborescence","type":"codeVoice"},{"text":" of its vertices’ prefixes with ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":" (import Grafluent’s ","type":"text"},{"code":"Trees","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module beside this one).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","isActive":true,"type":"reference"},{"text":" (Aho and Corasick, 1975) finds every occurrence of any of a set of","type":"text"},{"text":" ","type":"text"},{"text":"patterns in one pass over a text, in O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"z"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" symbols and ","type":"text"},{"inlineContent":[{"type":"text","text":"z"}],"type":"emphasis"},{"text":" matches: a trie of the","type":"text"},{"text":" ","type":"text"},{"text":"patterns with failure links. Its ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","isActive":true,"type":"reference"},{"text":" is the automaton as a","type":"text"},{"text":" ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","automaton.matches(in: \"ushers\").map(\\.patternIndex)   \/\/ [1, 0, 3]"],"type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries"},"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property","conformance":{"constraints":[{"type":"codeVoice","code":"Symbol"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"role":"symbol","title":"statesView","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statesView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV","text":"AhoCorasickAutomaton","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV10StatesViewV","text":"StatesView","kind":"typeIdentifier"}],"url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","abstract":[{"text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the","type":"text"},{"text":" ","type":"text"},{"text":"root, a goto edge from each state to each of its trie children, and a failure edge from","type":"text"},{"text":" ","type":"text"},{"text":"each state but the root to its failure state. ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","type":"reference","isActive":true},{"text":" tells the two","type":"text"},{"text":" ","type":"text"},{"text":"apart.","type":"text"}],"type":"topic"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/StatesView-swift.struct/symbol(ofEdgeAt:)":{"url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.struct\/symbol(ofedgeat:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"symbol"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofEdgeAt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":"?"}],"abstract":[{"text":"The symbol a goto edge reads, or nil for a failure edge.","type":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)","title":"symbol(ofEdgeAt:)"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"role":"symbol","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"abstract":[{"text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text","type":"text"},{"text":" ","type":"text"},{"text":"(Aho and Corasick, 1975).","type":"text"}],"kind":"symbol","url":"\/documentation\/tries\/ahocorasickautomaton","title":"AhoCorasickAutomaton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"},"doc://Tries/documentation/Tries":{"url":"\/documentation\/tries","kind":"symbol","type":"topic","role":"collection","abstract":[{"type":"text","text":"Tries over sequences of any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, with prefix queries, and multi-pattern matching."}],"identifier":"doc:\/\/Tries\/documentation\/Tries","title":"Tries"},"doc://Tries/documentation/Tries/RadixTreeDictionary":{"title":"RadixTreeDictionary","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"RadixTreeDictionary","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTreeDictionary","kind":"identifier"}],"abstract":[{"type":"text","text":"A dictionary keyed by sequences, kept in a radix tree (Morrison, 1968): a trie in which every"},{"type":"text","text":" "},{"type":"text","text":"chain of vertices with one child and no key is merged into one edge labelled with all its"},{"type":"text","text":" "},{"type":"text","text":"symbols, each key’s vertex holding its value."}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTreeDictionary","url":"\/documentation\/tries\/radixtreedictionary"},"doc://Tries/documentation/Tries/Trie":{"navigatorTitle":[{"kind":"identifier","text":"Trie"}],"url":"\/documentation\/tries\/trie","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Trie"}],"abstract":[{"text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex","type":"text"},{"text":" ","type":"text"},{"text":"paths spell the keys (Fredkin, 1960).","type":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie","title":"Trie"},"doc://Tries/documentation/Tries/Trees":{"url":"\/documentation\/tries\/trees","kind":"symbol","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trees","title":"Trees"},"doc://Tries/documentation/Tries/TrieDictionary":{"navigatorTitle":[{"kind":"identifier","text":"TrieDictionary"}],"url":"\/documentation\/tries\/triedictionary","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrieDictionary"}],"abstract":[{"text":"A dictionary keyed by sequences, kept in a trie: a tree whose edges carry symbols and whose","type":"text"},{"text":" ","type":"text"},{"text":"root-to-vertex paths spell the keys, each key’s vertex holding its value (Fredkin, 1960).","type":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/TrieDictionary","title":"TrieDictionary"},"doc://Tries/documentation/Tries/RadixTree":{"navigatorTitle":[{"text":"RadixTree","kind":"identifier"}],"url":"\/documentation\/tries\/radixtree","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of"},{"type":"text","text":" "},{"type":"text","text":"vertices with one child and no key is merged into one edge labelled with all its symbols."}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","title":"RadixTree"}}}