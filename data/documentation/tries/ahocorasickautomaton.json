{"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"metadata":{"title":"AhoCorasickAutomaton","symbolKind":"struct","externalID":"s:5Tries20AhoCorasickAutomatonV","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"remoteSource":{"fileName":"AhoCorasickAutomaton.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/AhoCorasickAutomaton.swift#L29"},"role":"symbol","modules":[{"name":"Tries"}],"navigatorTitle":[{"kind":"identifier","text":"AhoCorasickAutomaton"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/Match","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/MatchesView","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct"],"anchor":"Structures"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/containsMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/matches(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(at:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)"],"anchor":"Instance-Methods"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"It is the trie of the patterns with two more links per state: the failure link, to the state","type":"text"},{"text":" ","type":"text"},{"text":"of the longest proper suffix of the state’s prefix that is also a prefix of some pattern, and","type":"text"},{"text":" ","type":"text"},{"text":"the output link, to the nearest state along the failure links at which a pattern ends. A scan","type":"text"},{"text":" ","type":"text"},{"text":"follows the trie while the text matches and the failure links where it stops matching, so it","type":"text"},{"text":" ","type":"text"},{"text":"reads each symbol of the text once and reports all the matches in O(","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":") for a text of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" symbols with ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" matches.","type":"text"}],"type":"paragraph"},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","for match in automaton.matches(in: \"ushers\") {","    print(match.patternIndex, match.range)","}","\/\/ 1 1..<4   (\"she\")","\/\/ 0 2..<4   (\"he\")","\/\/ 3 2..<6   (\"hers\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Matches come in order of where they end, and of those ending at one place, longest first.","type":"text"},{"text":" ","type":"text"},{"text":"Ranges count the text’s symbols from 0. The automaton is built once and is immutable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Symbols are mapped to dense indices at construction, through a 256-entry table when they are"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":" and a dictionary otherwise, so a scan over bytes, such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":", does no"},{"type":"text","text":" "},{"type":"text","text":"hashing. When the states times the distinct symbols are few enough, every transition is"},{"type":"text","text":" "},{"type":"text","text":"precomputed into a table, and a scan takes one load per symbol."}],"type":"paragraph"}]}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/ahocorasickautomaton"]}],"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","interfaceLanguage":"swift"},"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"}],"title":"AhoCorasickAutomaton","role":"symbol","url":"\/documentation\/tries\/ahocorasickautomaton","navigatorTitle":[{"kind":"identifier","text":"AhoCorasickAutomaton"}],"abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/init(patterns:)":{"url":"\/documentation\/tries\/ahocorasickautomaton\/init(patterns:)","title":"init(patterns:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Patterns"},{"kind":"text","text":">("},{"kind":"externalParam","text":"patterns"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Patterns"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)","abstract":[{"text":"The automaton for ","type":"text"},{"code":"patterns","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/stateCount":{"kind":"symbol","url":"\/documentation\/tries\/ahocorasickautomaton\/statecount","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The number of states: the distinct prefixes of the patterns, the empty one included."},{"type":"text","text":" "},{"type":"text","text":"O(1)."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stateCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","title":"stateCount"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/firstMatch(in:)":{"url":"\/documentation\/tries\/ahocorasickautomaton\/firstmatch(in:)","abstract":[{"type":"text","text":"The first match of "},{"type":"codeVoice","code":"matches(in:)"},{"type":"text","text":": of the matches ending first, the longest; nil when no"},{"type":"text","text":" "},{"type":"text","text":"pattern occurs. O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") up to where the match ends."}],"type":"topic","title":"firstMatch(in:)","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"firstMatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"AhoCorasickAutomaton","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Match","preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV5MatchV"},{"kind":"text","text":"?"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"kind":"symbol","type":"topic","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","role":"symbol","abstract":[{"type":"text","text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the"},{"type":"text","text":" "},{"type":"text","text":"root, a goto edge from each state to each of its trie children, and a failure edge from"},{"type":"text","text":" "},{"type":"text","text":"each state but the root to its failure state. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct\/symbol(ofEdgeAt:)"},{"type":"text","tex