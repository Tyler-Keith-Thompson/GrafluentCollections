{"topicSections":[{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/Match","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/MatchesView","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct"],"title":"Structures","anchor":"Structures"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/containsMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/matches(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(at:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)"],"title":"Instance Methods","anchor":"Instance-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"It is the trie of the patterns with two more links per state: the failure link, to the state"},{"type":"text","text":" "},{"type":"text","text":"of the longest proper suffix of the state’s prefix that is also a prefix of some pattern, and"},{"type":"text","text":" "},{"type":"text","text":"the output link, to the nearest state along the failure links at which a pattern ends. A scan"},{"type":"text","text":" "},{"type":"text","text":"follows the trie while the text matches and the failure links where it stops matching, so it"},{"type":"text","text":" "},{"type":"text","text":"reads each symbol of the text once and reports all the matches in O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":") for a text of"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" symbols with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" matches."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","for match in automaton.matches(in: \"ushers\") {","    print(match.patternIndex, match.range)","}","\/\/ 1 1..<4   (\"she\")","\/\/ 0 2..<4   (\"he\")","\/\/ 3 2..<6   (\"hers\")"]},{"inlineContent":[{"text":"Matches come in order of where they end, and of those ending at one place, longest first.","type":"text"},{"text":" ","type":"text"},{"text":"Ranges count the text’s symbols from 0. The automaton is built once and is immutable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Symbols are mapped to dense indices at construction, through a 256-entry table when they are","type":"text"},{"text":" ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":" and a dictionary otherwise, so a scan over bytes, such as a string’s ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":", does no","type":"text"},{"text":" ","type":"text"},{"text":"hashing. When the states times the distinct symbols are few enough, every transition is","type":"text"},{"text":" ","type":"text"},{"text":"precomputed into a table, and a scan takes one load per symbol.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/ahocorasickautomaton"]}],"abstract":[{"text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text","type":"text"},{"text":" ","type":"text"},{"text":"(Aho and Corasick, 1975).","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"}],"role":"symbol","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"modules":[{"name":"Tries"}],"externalID":"s:5Tries20AhoCorasickAutomatonV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/AhoCorasickAutomaton.swift#L29","fileName":"AhoCorasickAutomaton.swift"},"symbolKind":"struct","title":"AhoCorasickAutomaton"},"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","interfaceLanguage":"swift"},"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/stateCount":{"abstract":[{"type":"text","text":"The number of states: the distinct prefixes of the patterns, the empty one included."},{"type":"text","text":" "},{"type":"text","text":"O(1)."}],"title":"stateCoun