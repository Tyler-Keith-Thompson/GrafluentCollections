{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/ahocorasickautomaton"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"It is the trie of the patterns with two more links per state: the failure link, to the state"},{"type":"text","text":" "},{"type":"text","text":"of the longest proper suffix of the state’s prefix that is also a prefix of some pattern, and"},{"type":"text","text":" "},{"type":"text","text":"the output link, to the nearest state along the failure links at which a pattern ends. A scan"},{"type":"text","text":" "},{"type":"text","text":"follows the trie while the text matches and the failure links where it stops matching, so it"},{"type":"text","text":" "},{"type":"text","text":"reads each symbol of the text once and reports all the matches in O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":") for a text of"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":" symbols with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" matches."}],"type":"paragraph"},{"type":"codeListing","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","for match in automaton.matches(in: \"ushers\") {","    print(match.patternIndex, match.range)","}","\/\/ 1 1..<4   (\"she\")","\/\/ 0 2..<4   (\"he\")","\/\/ 3 2..<6   (\"hers\")"],"syntax":"swift"},{"inlineContent":[{"text":"Matches come in order of where they end, and of those ending at one place, longest first.","type":"text"},{"text":" ","type":"text"},{"text":"Ranges count the text’s symbols from 0. The automaton is built once and is immutable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Symbols are mapped to dense indices at construction, through a 256-entry table when they are"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":" and a dictionary otherwise, so a scan over bytes, such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":", does no"},{"type":"text","text":" "},{"type":"text","text":"hashing. When the states times the distinct symbols are few enough, every transition is"},{"type":"text","text":" "},{"type":"text","text":"precomputed into a table, and a scan takes one load per symbol."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"Tries"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"}],"navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"externalID":"s:5Tries20AhoCorasickAutomatonV","role":"symbol","remoteSource":{"fileName":"AhoCorasickAutomaton.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/AhoCorasickAutomaton.swift#L29"},"title":"AhoCorasickAutomaton","roleHeading":"Structure","symbolKind":"struct"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identif