{"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"sections":[],"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/Match","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/MatchesView","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct"],"title":"Structures"},{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/containsMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/matches(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(at:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)"],"title":"Instance Methods"}],"abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/ahocorasickautomaton"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"It is the trie of the patterns with two more links per state: the failure link, to the state"},{"type":"text","text":" "},{"type":"text","text":"of the longest proper suffix of the state’s prefix that is also a prefix of some pattern, and"},{"type":"text","text":" "},{"type":"text","text":"the output link, to the nearest state along the failure links at which a pattern ends. A scan"},{"type":"text","text":" "},{"type":"text","text":"follows the trie while the text matches and the failure links where it stops matching, so it"},{"type":"text","text":" "},{"type":"text","text":"reads each symbol of the text once and reports all the matches in O("},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"type":"text","text":" + "},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"type":"text","text":") for a text of"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"type":"text","text":" symbols with "},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"type":"text","text":" matches."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","for match in automaton.matches(in: \"ushers\") {","    print(match.patternIndex, match.range)","}","\/\/ 1 1..<4   (\"she\")","\/\/ 0 2..<4   (\"he\")","\/\/ 3 2..<6   (\"hers\")"]},{"inlineContent":[{"type":"text","text":"Matches come in order of where they end, and of those ending at one place, longest first."},{"type":"text","text":" "},{"type":"text","text":"Ranges count the text’s symbols from 0. The automaton is built once and is immutable."}],"type":"paragraph"},{"inlineContent":[{"text":"Symbols are mapped to dense indices at construction, through a 256-entry table when they are","type":"text"},{"text":" ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":" and a dictionary otherwise, so a scan over bytes, such as a string’s ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":", does no","type":"text"},{"text":" ","type":"text"},{"text":"hashing. When the states times the distinct symbols are few enough, every transition is","type":"text"},{"text":" ","type":"text"},{"text":"precomputed into a table, and a scan takes one load per symbol.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"AhoCorasickAutomaton"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"externalID":"s:5Tries20AhoCorasickAutomatonV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/AhoCorasickAutomaton.swift#L29","fileName":"AhoCorasickAutomaton.swift"},"role":"symbol","title":"AhoCorasickAutomaton","modules":[{"name":"Tries"}],"symbolKind":"struct"},"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","interfaceLanguage":"swift"},"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/patternLength(checkedAt:)":{"type":"topic","role":"symbol","url":"\/documentation\/tries\/ahocorasickautomaton\/patternlength(checkedat:)","abstract":[{"type":"text","text":"The length of the pattern at "},{"code":"index","type":"codeVoice"},{"type":"text","text":", throwing instead of trapping on an invalid index."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"patternLength","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"IndexOutOfRange","preciseIdentifier":"s:16CollectionErrors15IndexOutOfRangeV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"patternLength(checkedAt:)","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)","kind":"symbol"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"url":"\/documentation\/tries\/ahocorasickautomaton","title":"AhoCorasickAutomaton","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/statesView-swift.property":{"kind":"symbol","role":"symbol","url":"\/documentation\/tries\/ahocorasickautomaton\/statesview-swift.property","abstract":[{"text":"The automaton’s states as a directed graph: a vertex per state, numbered from 0 for the","type":"text"},{"text":" ","type":"text"},{"text":"root, a goto edge from each state to each of its trie children, and a failure edge from","type":"text"},{"text":" ","type":"text"},{"t