{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/ahocorasickautomaton"]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"metadata":{"externalID":"s:5Tries20AhoCorasickAutomatonV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"}],"navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"remoteSource":{"fileName":"AhoCorasickAutomaton.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/AhoCorasickAutomaton.swift#L29"},"title":"AhoCorasickAutomaton","modules":[{"name":"Tries"}],"symbolKind":"struct","role":"symbol"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/Match","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/MatchesView","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/containsMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/matches(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(at:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)"],"anchor":"Instance-Methods","title":"Instance Methods"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"It is the trie of the patterns with two more links per state: the failure link, to the state","type":"text"},{"text":" ","type":"text"},{"text":"of the longest proper suffix of the state’s prefix that is also a prefix of some pattern, and","type":"text"},{"text":" ","type":"text"},{"text":"the output link, to the nearest state along the failure links at which a pattern ends. A scan","type":"text"},{"text":" ","type":"text"},{"text":"follows the trie while the text matches and the failure links where it stops matching, so it","type":"text"},{"text":" ","type":"text"},{"text":"reads each symbol of the text once and reports all the matches in O(","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":") for a text of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" symbols with ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" matches.","type":"text"}],"type":"paragraph"},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","for match in automaton.matches(in: \"ushers\") {","    print(match.patternIndex, match.range)","}","\/\/ 1 1..<4   (\"she\")","\/\/ 0 2..<4   (\"he\")","\/\/ 3 2..<6   (\"hers\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Matches come in order of where they end, and of those ending at one place, longest first."},{"type":"text","text":" "},{"type":"text","text":"Ranges count the text’s symbols from 0. The automaton is built once and is immutable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Symbols are mapped to dense indices at construction, through a 256-entry table when they are"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":" and a dictionary otherwise, so a scan over bytes, such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":", does no"},{"type":"text","text":" "},{"type":"text","text":"hashing. When the states times the distinct symbols are few enough, every transition is"},{"type":"text","text":" "},{"type":"text","text":"precomputed into a table, and a scan takes one load per symbol."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text","type":"text"},{"text":" ","type":"text"},{"text":"(Aho and Corasick, 1975).","type":"text"}],"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/patternCount":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"patternCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","title":"patternCount","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","role":"symbol","abstract":[{"type":"text","text":"The number of patterns. O(1)."}],"url":"\/documentation\/tries\/ahocorasickautomaton\/patterncount"},"doc://Tries/documentation/Tries":{"identifier":"doc:\/\/Tries\/documentation\/Tries","abstract":[{"text":"Tries over sequences of any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" symbols, with prefix queries, and multi-pattern matching.","type":"text"}],"type":"topic","kind":"symbol","title":"Tries","role":"collection","url":"\/documentation\/tries"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/patternLength(checkedAt:)":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"patternLength","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:16CollectionErrors15IndexOutOfRangeV","text":"IndexOutOfRange","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","abstract":[{"type":"text","text":"The length of the pattern at "},{"code":"index","type":"codeVoice"},{"type":"text","text":", throwing instead of trapping on an invalid index."}],"kind":"symbol","title":"patternLength(checkedAt:)","role":"symbol","url":"\/documentation\/tries\/ahocorasickautomaton\/patternlength(checkedat:)"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/stateCount":{"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","fragments":[{"kind":"keyword","text":"var"},{"kind":"te