{"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP"]}],"sections":[],"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/Match","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/MatchesView","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/containsMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/matches(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(at:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)"]}],"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton"},"metadata":{"roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"remoteSource":{"fileName":"AhoCorasickAutomaton.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/AhoCorasickAutomaton.swift#L29"},"title":"AhoCorasickAutomaton","modules":[{"name":"Tries"}],"navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"role":"symbol","externalID":"s:5Tries20AhoCorasickAutomatonV"},"abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"kind":"symbol","variants":[{"paths":["\/documentation\/tries\/ahocorasickautomaton"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AhoCorasickAutomaton"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is the trie of the patterns with two more links per state: the failure link, to the state"},{"type":"text","text":" "},{"type":"text","text":"of the longest proper suffix of the state’s prefix that is also a prefix of some pattern, and"},{"type":"text","text":" "},{"type":"text","text":"the output link, to the nearest state along the failure links at which a pattern ends. A scan"},{"type":"text","text":" "},{"type":"text","text":"follows the trie while the text matches and the failure links where it stops matching, so it"},{"type":"text","text":" "},{"type":"text","text":"reads each symbol of the text once and reports all the matches in O("},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":" + "},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"type":"text","text":") for a text of"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"type":"text","text":" symbols with "},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"type":"text","text":" matches."}]},{"type":"codeListing","code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","for match in automaton.matches(in: \"ushers\") {","    print(match.patternIndex, match.range)","}","\/\/ 1 1..<4   (\"she\")","\/\/ 0 2..<4   (\"he\")","\/\/ 3 2..<6   (\"hers\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Matches come in order of where they end, and of those ending at one place, longest first.","type":"text"},{"text":" ","type":"text"},{"text":"Ranges count the text’s symbols from 0. The automaton is built once and is immutable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbols are mapped to dense indices at construction, through a 256-entry table when they are"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":" and a dictionary otherwise, so a scan over bytes, such as a string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":", does no"},{"type":"text","text":" "},{"type":"text","text":"hashing. When the states times the distinct symbols are few enough, every transition is"},{"type":"text","text":" "},{"type":"text","text":"precomputed into a table, and a scan takes one load per symbol."}]}],"kind":"content"}],"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AhoCorasickAutomaton","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","title":"AhoCorasickAutomaton","url":"\/documentation\/tries\/ahocorasickautomaton","abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}]},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/patternCount":{"title":"patternCount","kind":"symbol","abstract":[{"text":"The number of patterns. O(1).","type":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"patternCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/tries\/ahocorasickautomaton\/patterncount"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/firstMatch(in:)":{"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"firstMatch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV","text":"AhoCorasickAutomaton","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:5Tries20AhoCorasickAutomatonV5MatchV","text":"Match","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","abstract":[{"text":"The first match of ","type":"text"},{"type":"codeVoice","code":"matches(in:)"},{"text":": of the matches ending first, the longest; nil when no","type":"text"},{"text":" ","type":"text"},{"text":"pattern occurs. O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":") up to where the match ends.","type":"text"}],"title":"firstMatch(in:)","url":"\/documentation\/tries\/ahocorasickautomaton\/firstmatch(in:)"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/init(patterns:)":{"title":"init(patterns:)","abstract":[{"type":"text","text":"The automaton for "},{"type":"codeVoice","code":"patterns"},{"type":"text","text":"."}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Patterns","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"patterns","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Patterns","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/tries\/ahocorasickautomaton\/init(patterns:)","type":"topic"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/stateCount":{"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stateCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","abstract":[{"text":"The number of states: the distinct prefixes of the patterns, the empty one included.","type":"text"},{"text":" ","type":"text"},{"text":"O(1).","type":"text"}],"title":"stateCount","url":"\/documentation\/tries\/ahocorasickautomaton\/statecount"},"doc://Tries/documentation/Tries/AhoCorasickAutomaton/matches(in:)":{"type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/matches(in:)","t