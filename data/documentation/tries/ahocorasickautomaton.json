{"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"It is the trie of the patterns with two more links per state: the failure link, to the state","type":"text"},{"text":" ","type":"text"},{"text":"of the longest proper suffix of the state’s prefix that is also a prefix of some pattern, and","type":"text"},{"text":" ","type":"text"},{"text":"the output link, to the nearest state along the failure links at which a pattern ends. A scan","type":"text"},{"text":" ","type":"text"},{"text":"follows the trie while the text matches and the failure links where it stops matching, so it","type":"text"},{"text":" ","type":"text"},{"text":"reads each symbol of the text once and reports all the matches in O(","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":") for a text of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" symbols with ","type":"text"},{"inlineContent":[{"type":"text","text":"k"}],"type":"emphasis"},{"text":" matches.","type":"text"}],"type":"paragraph"},{"code":["let automaton = AhoCorasickAutomaton(patterns: [\"he\", \"she\", \"his\", \"hers\"])","for match in automaton.matches(in: \"ushers\") {","    print(match.patternIndex, match.range)","}","\/\/ 1 1..<4   (\"she\")","\/\/ 0 2..<4   (\"he\")","\/\/ 3 2..<6   (\"hers\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Matches come in order of where they end, and of those ending at one place, longest first.","type":"text"},{"text":" ","type":"text"},{"text":"Ranges count the text’s symbols from 0. The automaton is built once and is immutable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Symbols are mapped to dense indices at construction, through a 256-entry table when they are","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":" and a dictionary otherwise, so a scan over bytes, such as a string’s ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":", does no","type":"text"},{"text":" ","type":"text"},{"text":"hashing. When the states times the distinct symbols are few enough, every transition is","type":"text"},{"text":" ","type":"text"},{"text":"precomputed into a table, and a scan takes one load per symbol.","type":"text"}],"type":"paragraph"}]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/AhoCorasickAutomaton.swift#L29","fileName":"AhoCorasickAutomaton.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AhoCorasickAutomaton","kind":"identifier"}],"modules":[{"name":"Tries"}],"externalID":"s:5Tries20AhoCorasickAutomatonV","roleHeading":"Structure","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AhoCorasickAutomaton"}],"symbolKind":"struct","title":"AhoCorasickAutomaton"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"An automaton that finds every occurrence of every pattern of a set in one pass over a text"},{"type":"text","text":" "},{"type":"text","text":"(Aho and Corasick, 1975)."}],"variants":[{"paths":["\/documentation\/tries\/ahocorasickautomaton"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"topicSections":[{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/Match","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/MatchesView","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/StatesView-swift.struct"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/init(patterns:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/stateCount","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/statesView-swift.property"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/containsMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/firstMatch(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/matches(in:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(at:)","doc:\/\/Tries\/documentation\/Tries\/AhoCorasickAutomaton\/patternLength(checkedAt:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"references":{"doc://Tries/documentation/Tries/AhoCorasickAutomaton/stateCount":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"stateCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","