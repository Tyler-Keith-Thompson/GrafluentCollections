{"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"abstract":[{"text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of","type":"text"},{"text":" ","type":"text"},{"text":"vertices with one child and no key is merged into one edge labelled with all its symbols.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"It holds the same keys and answers the same queries as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree"},{"type":"text","text":", with the same names, but has"},{"type":"text","text":" "},{"type":"text","text":"a vertex per key and per branching point rather than per symbol: O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") vertices for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" keys,"},{"type":"text","text":" "},{"type":"text","text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs."},{"type":"text","text":" "},{"type":"text","text":"Lookup, insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type"