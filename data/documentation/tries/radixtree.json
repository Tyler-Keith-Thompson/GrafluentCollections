""],"syntax":"swift"},{"inlineContent":[{"text":"Iteration visits each key before the keys it is a prefix of. When the symbols are","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":", each vertex keeps its children sorted, so the keys come in lexicographic order;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise children come in the order they were first added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, and the edge labels are slices of one"},{"type":"text","text":" "},{"type":"text","text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1 vertices and label symbols, and copying"},{"type":"text","text":" "},{"type":"text","text":"it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tries\/radixtree"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Tries/documentation/Tries/RadixTree/Equatable-Implementations":{"abstract":[],"kind":"article","role":"collectionGroup","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree\/Equatable-Implementations","title":"Equatable Implementations","url":"\/documentation\/tries\/radixtree\/equatable-implementations"},"doc://Tries/s23CustomStringConvertibleP":{"type":"unresolvable","identifier":"doc:\/\/Tries\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible"},"doc://Tries/documentation/Tries/RadixTree":{"title":"RadixTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of","type":"text"},{"text":" ","type":"text"},{"text":"vertices with one child and no key is merged into one edge labelled w