"emphasis"},{"text":") vertices for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" keys,","type":"text"},{"text":" ","type":"text"},{"text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs.","type":"text"},{"text":" ","type":"text"},{"text":"Lookup, insertion and removal follow the key down from the root, O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"text":") for a key of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" symbols that passes ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" vertices of at most ","type":"text"},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"text":" children.","type":"text"}]},{"type":"codeListing","code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Iteration visits each key before the keys it is a prefix of. When the symbols are"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", each vertex keeps its children sorted, so the keys come in lexicographic order;"},{"type":"text","text":" "},{"type":"text","text":"otherwise children come in the order they were first added."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, and the edge labels are slices of one"},{"type":"text","text":" "},{"type":"text","text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1 vertices and label symbols, and copying"},{"type":"text","text":" "},{"type":"text","text":"it copies a few arrays only when one copy is mutated."}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/RadixTree.swift#L27","fileName":"RadixTree.swift"},"roleHeading":"Structure","symbolKind":"struct","title":"RadixTree","modules":[{"name":"Tries"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"}],"navigatorTitle":[{"text":"RadixTree","kind":"identifier"}],"externalID":"s:5Tries9RadixTreeV","role":"symbol"},"variants":[{"paths":["\/documentation\/tries\/radixtree"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Tries/ST":{"type":"unresolvable","identifier":"doc:\/\/Tries\/ST","title":"Swift.Sequence"},"doc://Tries/s25ExpressibleByArrayLiteralP":{"identifier":"doc:\/\/Tries\/s25ExpressibleByArrayLiteralP","type":"unresolvable","title":"Swift.ExpressibleByArrayLiteral"},"doc://Tries/documentation/Tries/RadixTree/Decodable-Implementations":{"title":"Decodable Implementations","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree\/Decodable-Implementations","abstract":[],"kind":"article","role":"collectionGroup","type":"topic","url":"\/documentation\/tries\/radixtree\/decodable-implementations"},"doc://Tries/documentation/Tries/RadixTree/SetAlgebra-Implementations":{"url":"\/documentation\/tries\/radixtree\/setalgebra-implementations","type":"topic","kind":"article","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree\/SetAlgebra-Implementations","title":"SetAlgebra Implementations","abstract":[],"role":"collectionGroup"