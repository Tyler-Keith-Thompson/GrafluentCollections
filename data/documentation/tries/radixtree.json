{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","title":"RadixTree","remoteSource":{"fileName":"RadixTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/RadixTree.swift#L27"},"externalID":"s:5Tries9RadixTreeV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"RadixTree"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixTree","kind":"identifier"}],"modules":[{"name":"Tries"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries\/RadixTree"},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"It holds the same keys and answers the same queries as "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true},{"type":"text","text":", with the same names, but has"},{"type":"text","text":" "},{"type":"text","text":"a vertex per key and per branching point rather than per symbol: O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") vertices for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" keys,"},{"type":"text","text":" "},{"type":"text","text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs."},{"type":"text","text":" "},{"type":"text","text":"Lookup, insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"text":"d","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"type":"text","text":"σ"}]},{"type":"text","text":") for a key of"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" symbols that passes "},{"type":"emphasis","inlineContent":[{"type":"text","text":"d"}]},{"type":"text","text":" vertices of at most "},{"type":"emphasis","inlineContent":[{"type":"text","text":"σ"}]},{"type":"text","text":" children."}],"type":"paragraph"},{"code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Iteration visits each key before the keys it is a prefix of. When the symbols are"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", each vertex keeps its children sorted, so the keys come in lexicographic order;"},{"type":"text","text":" "},{"type":"text","text":"otherwise children come in the order they were first added."}],"type":"paragraph"},{"inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"type":"codeVoice","code":"Int32"},{"text":" links, and the edge labels are slices of one","type":"text"},{"text":" ","type":"text"},{"text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1