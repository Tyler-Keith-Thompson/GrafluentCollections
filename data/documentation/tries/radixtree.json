ext":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"It holds the same keys and answers the same queries as "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true},{"type":"text","text":", with the same names, but has"},{"type":"text","text":" "},{"type":"text","text":"a vertex per key and per branching point rather than per symbol: O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") vertices for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" keys,"},{"type":"text","text":" "},{"type":"text","text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs."},{"type":"text","text":" "},{"type":"text","text":"Lookup, insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"d"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"σ","type":"text"}]},{"type":"text","text":") for a key of"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" symbols that passes "},{"type":"emphasis","inlineContent":[{"text":"d","type":"text"}]},{"type":"text","text":" vertices of at most "},{"type":"emphasis","inlineContent":[{"type":"text","text":"σ"}]},{"type":"text","text":" children."}],"type":"paragraph"},{"code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","pat