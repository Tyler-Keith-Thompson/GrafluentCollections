"text","text":", with the same names, but has"},{"type":"text","text":" "},{"type":"text","text":"a vertex per key and per branching point rather than per symbol: O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") vertices for "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" keys,"},{"type":"text","text":" "},{"type":"text","text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs."},{"type":"text","text":" "},{"type":"text","text":"Lookup, insertion and removal follow the key down from the root, O("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" + "},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"type":"text","text":") for a key of"},{"type":"text","text":" "},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" symbols that passes "},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"type":"text","text":" vertices of at most "},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"type":"text","text":" children."}]},{"syntax":"swift","type":"codeListing","code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""]},{"type":"paragraph","inlineContent":[{"text":"Iteration visits each key before the keys it is a prefix of. When the symbols are","type":"text"},{"text":" ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", each vertex keeps its children sorted, so the keys come in lexicographic order;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise children come in the order they were first added.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"code":"Int32","type":"codeVoice"},{"text":" links, and the edge labels are slices of one","type":"text"},{"text":" ","type":"text"},{"text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1 vertices and label symbols, and copying","type":"text"},{"text":" ","type":"text"},{"text":"it copies a few arrays only when one copy is mutated.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"abstract":[{"text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of","type":"text"},{"text":" ","type":"text"},{"text":"vertices with one child and no key is merged into one edge labelled with all its symbols.","type":"text"}],"variants":[{"paths":["\/documentation\/tries\/radixtree"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Tries/s8CopyableP":{"identifier":"doc:\/\/Tries\/s8CopyableP","title":"Swift.Copyable","type":"unresolvable"},"doc://Tries/Se":{"type":"unresolvable","identifier":"doc:\/\/Tries\/Se","title":"Swift.Decodable"},"doc://Tries/documentation/Tries/RadixTree/insert(_:)-3ywij":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">) -> (inserted"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", memberAfterInsert"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":"])"}],"kind":"symbol","type":"topic","title":"insert(