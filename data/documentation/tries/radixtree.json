fault-Implementations"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"It holds the same keys and answers the same queries as ","type":"text"},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true,"type":"reference"},{"text":", with the same names, but has","type":"text"},{"text":" ","type":"text"},{"text":"a vertex per key and per branching point rather than per symbol: O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") vertices for ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" keys,","type":"text"},{"text":" ","type":"text"},{"text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs.","type":"text"},{"text":" ","type":"text"},{"text":"Lookup, insertion and removal follow the key down from the root, O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"text":") for a key of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" symbols that passes ","type":"text"},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"text":" vertices of at most ","type":"text"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"text":" children.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""]},{"inlineContent":[{"type":"text","text":"Iteration visits each key before the keys it is a prefix of. When the symbols are"},{"type":"text","text":" "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":", each vertex keeps its children sorted, so the keys come in lexicographic order;"},{"type":"text","text":" "},{"type":"text","text":"otherwise children come in the order they were first added."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, and the edge labels are slices of one"},{"type":"text","text":" "},{"type":"text","text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1 vertices and label symbols, and copying"},{"type":"text","text":" "},{"type":"text","text":"it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries\/RadixTree"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"roleHeading":"Structure","title":"RadixTree","navigatorTitle":[{"kind":"identifier","text":"RadixTree"}],"role":"symbol","remoteSource":{"fileName":"RadixTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/RadixTree.swift#L27"},"module