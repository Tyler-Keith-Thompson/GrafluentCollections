t"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"It holds the same keys and answers the same queries as "},{"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","type":"reference","isActive":true},{"type":"text","text":", with the same names, but has"},{"type":"text","text":" "},{"type":"text","text":"a vertex per key and per branching point rather than per symbol: O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") vertices for "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" keys,"},{"type":"text","text":" "},{"type":"text","text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs."},{"type":"text","text":" "},{"type":"text","text":"Lookup, insertion and removal follow the key down from the root, O("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" + "},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"type":"text","text":") for a key of"},{"type":"text","text":" "},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":" symbols that passes "},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"type":"text","text":" vertices of at most "},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"type":"text","text":" children."}]},{"syntax":"swift","type":"codeListing","code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""]},{"type":"paragraph","inlineContent":[{"text":"Iteration visits each key before the keys it is a prefix of. When the symbols are","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":", each vertex keeps its children sorted, so the keys come in lexicographic order;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise children come in the order they were first added.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, and the edge labels are slices of one"},{"type":"text","text":" "},{"type":"text","text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1 vertices and label symbols, and copying"},{"type":"text","text":" "},{"type":"text","text":"it copies a few arrays only when one copy is mutated."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/radixtree"]}],"references":{"doc://Tries/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/Tries\/SQ"},"doc://Tries/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/Tries\/s8CopyableP","title":"Swift.Copyable"},"doc://Tries/documentation/Tries/RadixTree/longestPrefix(of:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/tries\/radixtree\/longestprefix(of:)","type":"topic","title":"longestPrefix(of:)","abstract":[{"text":"The longest key that is a prefix of ","type":"text"},{"code":"query","type":"codeVoice"},{"text":", ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" itself included, or nil when no key","type":"text"},{"text":" ","type":"text"},{"text":"is. O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"text":" + ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"d"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"type":"