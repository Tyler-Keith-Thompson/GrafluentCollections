text","text":"m"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"text":") for a key of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" symbols that passes ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" vertices of at most ","type":"text"},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"text":" children.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Iteration visits each key before the keys it is a prefix of. When the symbols are"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", each vertex keeps its children sorted, so the keys come in lexicographic order;"},{"type":"text","text":" "},{"type":"text","text":"otherwise children come in the order they were first added."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, and the edge labels are slices of one"},{"type":"text","text":" "},{"type":"text","text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1 vertices and label symbols, and copying"},{"type":"text","text":" "},{"type":"text","text":"it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"p