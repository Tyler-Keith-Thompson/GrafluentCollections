{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/radixtree"]}],"abstract":[{"type":"text","text":"A set of sequences kept in a radix tree (Morrison, 1968): a trie in which every chain of"},{"type":"text","text":" "},{"type":"text","text":"vertices with one child and no key is merged into one edge labelled with all its symbols."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries\/RadixTree"},"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/PrefixView"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/init()","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/init(_:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/count","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/isEmpty"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/contains(_:)-39nls","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/elements(withPrefix:)","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/hasPrefix(_:)","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/insert(_:)-3ywij","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/longestPrefix(of:)","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/remove(_:)-3svqg"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/CustomStringConvertible-Implementations","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/Decodable-Implementations","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/Encodable-Implementations","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/Equatable-Implementations","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/ExpressibleByArrayLiteral-Implementations","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/Hashable-Implementations","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/Sequence-Implementations","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/SetAlgebra-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"It holds the same keys and answers the same queries as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree"},{"type":"text","text":", with the same names, but has"},{"type":"text","text":" "},{"type":"text","text":"a vertex per key and per branching point rather than per symbol: O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") vertices for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" keys,"},{"type":"text","text":" "},{"type":"text","text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs."},{"type":"text","text":" "},{"type":"text","text":"Lookup, insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text",