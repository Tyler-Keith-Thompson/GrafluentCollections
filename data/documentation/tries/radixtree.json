SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"It holds the same keys and answers the same queries as "},{"type":"reference","identifier":"doc:\/\/Tries\/documentation\/Tries\/RadixTree","isActive":true},{"type":"text","text":", with the same names, but has"},{"type":"text","text":" "},{"type":"text","text":"a vertex per key and per branching point rather than per symbol: O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") vertices for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" keys,"},{"type":"text","text":" "},{"type":"text","text":"however long they are. That suits keys with long shared prefixes, such as file paths or URLs."},{"type":"text","text":" "},{"type":"text","text":"Lookup, insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"d"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"σ","type":"text"}]},{"type":"text","text":") for a key of"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":" symbols that passes "},{"type":"emphasis","inlineContent":[{"text":"d","type":"text"}]},{"type":"text","text":" vertices of at most "},{"type":"emphasis","inlineContent":[{"type":"text","text":"σ"}]},{"type":"text","text":" children."}],"type":"paragraph"},{"type":"codeListing","code":["let paths = RadixTree([\"\/usr\/bin\", \"\/usr\/lib\", \"\/usr\/local\/bin\"])","paths.contains(\"\/usr\/lib\")                                   \/\/ true","paths.elements(withPrefix: \"\/usr\/l\").map { String($0) }      \/\/ [\"\/usr\/lib\", \"\/usr\/local\/bin\"]","paths.longestPrefix(of: \"\/usr\/bin\/swift\").map { String($0) } \/\/ \"\/usr\/bin\""],"syntax":"swift"},{"inlineContent":[{"text":"Iteration visits each key before the keys it is a prefix of. When the symbols are","type":"text"},{"text":" ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", each vertex keeps its children sorted, so the keys come in lexicographic order;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise children come in the order they were first added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":" links, and the edge labels are slices of one"},{"type":"text","text":" "},{"type":"text","text":"buffer of symbols, so the tree holds fewer than 2³¹ − 1 vertices and label symbols, and copying"},{"type":"text","text":" "},{"type":"text","text":"it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/PrefixView"],"anchor":"Structures"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/init()","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/init(_:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/count","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/isEmpty"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree\/contains(_:)-39nls","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/elements(withPrefix:)","doc:\/\/Tries\/documentation\/Tries\/RadixTree\/hasPrefix(_:)","doc:\/\/Tries\/documentation\/T