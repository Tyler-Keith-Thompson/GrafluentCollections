eading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Keys are sequences of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, stored as "},{"type":"codeVoice","code":"[Symbol]"},{"type":"text","text":": "},{"type":"codeVoice","code":"Trie<Character>"},{"type":"text","text":" holds words,"},{"type":"text","text":" "},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"type":"text","text":" the same words scalar by scalar, "},{"type":"codeVoice","code":"Trie<UInt8>"},{"type":"text","text":" byte strings. Lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"σ","type":"text"}]},{"type":"text","text":") for a key of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" symbols"},{"type":"text","text":" "},{"type":"text","text":"and at most "},{"type":"emphasis","inlineContent":[{"text":"σ","type":"text"}]},{"type":"text","text":" children per vertex. A trie answers the queries a hash set cannot: every key"},{"type":"text","text":" "},{"type":"text","text":"with a prefix, whether any key has one, and the longest key that is a prefix of a query."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""]},{"inlineContent":[{"type":"text","text":"Iteration visits each key before the keys it is a prefix of. When the symbols are"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", each vertex keeps its children sorted, so the keys come in lexicographic order;"},{"type":"text","text":" "},{"type":"text","text":"otherwise children come in the order they were first added."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the trie holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"vertices, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Tries/documentation/Tries/Trie/count":{"abstract":[{"type":"text","text":"The number of keys. O(1)."}],"type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie\/count","url":"\/documentation\/tries\/trie\/count","title":"count","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"count","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://Tries/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/Tries\/s16SendableMetatypeP","type":"unresolvable"},"doc://Tries/documentation/Tries/Trie/elements(withPrefix:)":{"url":"\/documentation\/tries\/trie\/elements(withprefix:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"elements"},{"kind":"text","text":"("},{"kind":"externalParam","text":"withPrefix"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:5Tries4TrieV","kind":"typeIdentifier","text":"Trie"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":">."},{"preciseIdentifier":"s:5Tries4TrieV10PrefixViewV","kind":"typeIdentifier","text":"PrefixView"}]