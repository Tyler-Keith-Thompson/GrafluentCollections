type":"text","text":" "},{"type":"text","text":"otherwise children come in the order they were first added."}],"type":"paragraph"},{"inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"type":"codeVoice","code":"Int32"},{"text":" links, so the trie holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"vertices, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Tries/documentation/Tries/Trie/init()":{"url":"\/documentation\/tries\/trie\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"title":"init()","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"An empty trie."}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie\/init()"},"doc://Tries/s8CopyableP":{"identifier":"doc:\/\/Tries\/s8CopyableP","title":"Swift.Copyable","type":"unresolvable"},"doc://Tries/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/Tries\/Se","type":"unresolvable"},"doc://Tries/documentation/Tries/Trie/hasPrefix(_:)":{"title":"hasPrefix(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasPrefix","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/tries\/trie\/hasprefix(_:)","type":"topic","abstract":[{"type":"text","text":"Whether some key starts with "},{"code":"prefix","type":"codeVoice"},{"type":"text","text":"; for the empty prefix, whether the trie holds any"},{"type":"text","text":" "},{"type":"text","text":"key. O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":"·"},{"type":"e