{"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Tries\/s8CopyableP","doc:\/\/Tries\/s23CustomStringConvertibleP","doc:\/\/Tries\/Se","doc:\/\/Tries\/SE","doc:\/\/Tries\/SQ","doc:\/\/Tries\/s9EscapableP","doc:\/\/Tries\/s25ExpressibleByArrayLiteralP","doc:\/\/Tries\/SH","doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP","doc:\/\/Tries\/ST","doc:\/\/Tries\/s10SetAlgebraP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Keys are sequences of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, stored as "},{"type":"codeVoice","code":"[Symbol]"},{"type":"text","text":": "},{"type":"codeVoice","code":"Trie<Character>"},{"type":"text","text":" holds words,"},{"type":"text","text":" "},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"type":"text","text":" the same words scalar by scalar, "},{"type":"codeVoice","code":"Trie<UInt8>"},{"type":"text","text":" byte strings. Lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"type":"text","text":"σ"}]},{"type"