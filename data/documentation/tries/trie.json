{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex","type":"text"},{"text":" ","type":"text"},{"text":"paths spell the keys (Fredkin, 1960).","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/Tries\/s8CopyableP","doc:\/\/Tries\/s23CustomStringConvertibleP","doc:\/\/Tries\/Se","doc:\/\/Tries\/SE","doc:\/\/Tries\/SQ","doc:\/\/Tries\/s9EscapableP","doc:\/\/Tries\/s25ExpressibleByArrayLiteralP","doc:\/\/Tries\/SH","doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP","doc:\/\/Tries\/ST","doc:\/\/Tries\/s10SetAlgebraP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/Trie.swift#L26","fileName":"Trie.swift"},"title":"Trie","externalID":"s:5Tries4TrieV","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Trie"}],"role":"symbol","symbolKind":"struct","modules":[{"name":"Tries"}]},"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"anchor":"Sets-of-sequences","title":"Sets of sequences","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Keys are sequences of "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, stored as "},{"code":"[Symbol]","type":"codeVoice"},{"type":"text","text":": "},{"code":"Trie<Character>","type":"codeVoice"},{"type":"text","text":" holds words,"},{"type":"text","text":" "},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"type":"text","text":" the same words scalar by scalar, "},{"code":"Trie<UInt8>","type":"codeVoice"},{"type":"text","text":" byte strings. Lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal follow the key down from the root, O("},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"type":"text","text":") for a key of "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" symbols"},{"type":"text","text":" "},{"type":"text","text":"and at most "},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"type":"text","text":" children per vertex. A trie answers the queries a hash set cannot: every key"},{"type":"text","text":" "},{"type":"text","text":"with a prefix, whether any key has one, and the longest key that is a prefix of a query."}],"type":"paragraph"},{"syntax":"swift","code":["let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing"},{"inlineContent":[{"text":"Iteration visits each key before the keys it is a prefix of. When the symbols are","type":"text"},{"text":" ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", each vertex