{"seeAlsoSections":[{"title":"Sets of sequences","anchor":"Sets-of-sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/trie"]}],"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/Trie","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Trie"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Symbol"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Symbol"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Keys are sequences of "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, stored as "},{"code":"[Symbol]","type":"codeVoice"},{"type":"text","text":": "},{"code":"Trie<Character>","type":"codeVoice"},{"type":"text","text":" holds words,"},{"type":"text","text":" "},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"type":"text","text":" the same words scalar by scalar, "},{"code":"Trie<UInt8>","type":"codeVoice"},{"type":"text","text":" byte strings. Lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal follow the key down from the root, O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"type":"text","text":"σ"}]},{"type":"text","text":") for a key of "},{"type":"emphasis","inlineContent":[{"text":"m","type":"tex