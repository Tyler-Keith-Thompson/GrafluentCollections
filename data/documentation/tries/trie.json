{"abstract":[{"type":"text","text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex"},{"type":"text","text":" "},{"type":"text","text":"paths spell the keys (Fredkin, 1960)."}],"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/Trie","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Keys are sequences of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, stored as ","type":"text"},{"code":"[Symbol]","type":"codeVoice"},{"text":": ","type":"text"},{"code":"Trie<Character>","type":"codeVoice"},{"text":" holds words,","type":"text"},{"text":" ","type":"text"},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"text":" the same words scalar by scalar, ","type":"text"},{"code":"Trie<UInt8>","type":"codeVoice"},{"text":" byte strings. Lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal follow the key down from the root, O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"text":") for a key of ","type":"text"},{"inlineConten