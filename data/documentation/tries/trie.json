ext":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Keys are sequences of "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" symbols, stored as "},{"code":"[Symbol]","type":"codeVoice"},{"type":"text","text":": "},{"code":"Trie<Character>","type":"codeVoice"},{"type":"text","text":" holds words,"},{"type":"text","text":" "},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"type":"text","text":" the same words scalar by scalar, "},{"code":"Trie<UInt8>","type":"codeVoice"},{"type":"text","text":" byte strings. Lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal follow the key down from the root, O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"type":"text","text":") for a key of "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" symbols"},{"type":"text","text":" "},{"type":"text","text":"and at most "},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"type":"text","text":" children per vertex. A trie answers the queries a hash set cannot: every key"},{"type":"text","text":" "},{"type":"text","text":"with a prefix, whether any key has one, and the longest key that is a prefix of a query."}],"type":"paragraph"},{"type":"codeListing","code":["let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Iteration visits each key before the keys it is a prefix of. When the symbols are"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", each vertex keeps its children sorted, so the keys come in lexicographic order;"},{"type":"text","text":" "},{"type":"text","text":"otherwise children come in the order they were first added."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":" links, so the trie holds fewer than 2³¹ − 1"},{"type":"text","text":" "},{"type":"text","text":"vertices, and copying it copies a few arrays only when one copy is mutated."}],"type":"paragraph"}]}],"references":{"doc://Tries/documentation/Tries/Trie/ExpressibleByArrayLiteral-Implementations":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie\/ExpressibleByArrayLiteral-Implementations","title":"ExpressibleByArrayLiteral Implementations","url":"\/documentation\/tries\/trie\/expressiblebyarrayliteral-implementations","abstract":[],"type":"topic"},"doc://Tries/documentation/Tries/Trie/insert(_:)-4uhms":{"type":"topic","abstract":[{"type":"text","text":"Inserts "},{"type":"codeVoice","code":"key"},{"type":"text","text":" unless the trie holds it."}],"url":"\/documentation\/tries\/trie\/insert(_:)-4uhms","role":"symbol","title":"insert(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":">) -> (inserted","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", memberAfterInsert","kind":"text"},{"text":": [","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie\/insert(_:)-4uhms"},"doc://Tries/documentation/Tries/RadixTree":{"type":"topic","fragments":[{"kind":"keyword","text":"struc