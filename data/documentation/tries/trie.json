ebra-Implementations"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Trie"}],"externalID":"s:5Tries4TrieV","remoteSource":{"fileName":"Trie.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/Trie.swift#L26"},"modules":[{"name":"Tries"}],"navigatorTitle":[{"kind":"identifier","text":"Trie"}],"roleHeading":"Structure","symbolKind":"struct","title":"Trie","role":"symbol"},"identifier":{"url":"doc:\/\/Tries\/documentation\/Tries\/Trie","interfaceLanguage":"swift"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Tries\/s8CopyableP","doc:\/\/Tries\/s23CustomStringConvertibleP","doc:\/\/Tries\/Se","doc:\/\/Tries\/SE","doc:\/\/Tries\/SQ","doc:\/\/Tries\/s9EscapableP","doc:\/\/Tries\/s25ExpressibleByArrayLiteralP","doc:\/\/Tries\/SH","doc:\/\/Tries\/s8SendableP","doc:\/\/Tries\/s16SendableMetatypeP","doc:\/\/Tries\/ST","doc:\/\/Tries\/s10SetAlgebraP"]}],"seeAlsoSections":[{"generated":true,"anchor":"Sets-of-sequences","title":"Sets of sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Keys are sequences of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" symbols, stored as "},{"type":"codeVoice","code":"[Symbol]"},{"type":"text","text":": "},{"type":"codeVoice","code":"Trie<Character>"},{"type":"text","text":" holds words,"},{"type":"text","text":" "},{"type":"codeVoice","code":"Trie<Unicode.Scalar>"},{"type":"text","text":" the same words scalar by scalar, "},{"type":"codeVoice","code":"Trie<UInt8>"},{"type":"text","text":" byte strings. Lookup,"},{"type":"text","text":" "},{"type":"text","text":"insertion and removal follow the key down from the root, O("},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"type":"text","text":") for a key of "},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"type":"text","text":" symbols"},{"type":"text","text":" "},{"type":"text","text":"and at most "},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"type":"text","text":" children per vertex. A trie answers the queries a hash set cannot: every key"},{"type":"text","text":" "},{"type":"text","text":"with a prefix, whether any key has one, and the longest key that is a prefix of a query."}],"type":"paragraph"},{"syntax":"swift","code":["let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""],"type":"codeListing"},{"inlineContent":[{"text":"Iteration visits each key before the keys it is a prefix of. When the symbols are","type":"text"},{"text":" ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", each vertex keeps its children sorted, so the keys come in lexicographic order;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise children come in the order they were first added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The vertices live in flat arrays with ","type":"text"},{"type":"codeVoice","code":"Int32"},{"text":" links, so the trie holds fewer than 2³¹ − 1","type":"text"},{"text":" ","type":"text"},{"text":"vertices, and copying it copies a few arrays only when one copy is mutated.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tries\/trie"]}],"references":{"doc://Tries/documentation/Tries/Trie/isEmpty":{"url":"\/documentation\/tries\/trie\/isempty","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEmpty"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"type":"topic","title":"isEmpty","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie\/isEmpty","abstract":[{"type":"text","text":"Whether the trie holds no keys. O(1)."}],"kind":"symbol"},"doc://Tries/ST":{"type":"unresolvable","title":"Swift.Sequence","identifier":"doc:\/\/Tries\/ST"},"doc://Tries/documentation/Tries/Trie/init()":{"url":"\/documentation\/tries\/trie\/init()","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie\/init()","type":"topic","abstract":[{"text":"An empty trie.","type":"text"}],"title":"init()"},"doc://Tries/s25ExpressibleByArrayLiteralP":{"type":"unresolvable","identifier":"doc:\/\/Tries\/s25ExpressibleByArrayLiteralP","title":"Swift.ExpressibleByArrayLiteral"},"doc://Tries/documentation/Tries/Trie/SetAlgebra-Implementations":{"kind":"article","role":"collectionGroup","title":"SetAlgebra Implementations","url":"\/documentation\/tries\/trie\/setalgebra-implementations","type":"topic","identifier":"doc:\/\/Tries\/documentation\/Tries\/Trie\/SetAlgebra-Implementations","abstract":[]},"doc://Tries/documentation/Tries/Trie":{"