{"abstract":[{"type":"text","text":"A set of sequences kept in a trie: a tree whose edges carry symbols and whose root-to-vertex"},{"type":"text","text":" "},{"type":"text","text":"paths spell the keys (Fredkin, 1960)."}],"seeAlsoSections":[{"title":"Sets of sequences","generated":true,"anchor":"Sets-of-sequences","identifiers":["doc:\/\/Tries\/documentation\/Tries\/RadixTree"]}],"hierarchy":{"paths":[["doc:\/\/Tries\/documentation\/Tries"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tries\/documentation\/Tries\/Trie"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"Tries"}],"symbolKind":"struct","externalID":"s:5Tries4TrieV","navigatorTitle":[{"kind":"identifier","text":"Trie"}],"role":"symbol","title":"Trie","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"}],"remoteSource":{"fileName":"Trie.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/GrafluentCollections\/blob\/main\/Sources\/Tries\/Trie.swift#L26"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trie","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Symbol","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Keys are sequences of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" symbols, stored as ","type":"text"},{"code":"[Symbol]","type":"codeVoice"},{"text":": ","type":"text"},{"code":"Trie<Character>","type":"codeVoice"},{"text":" holds words,","type":"text"},{"text":" ","type":"text"},{"code":"Trie<Unicode.Scalar>","type":"codeVoice"},{"text":" the same words scalar by scalar, ","type":"text"},{"code":"Trie<UInt8>","type":"codeVoice"},{"text":" byte strings. Lookup,","type":"text"},{"text":" ","type":"text"},{"text":"insertion and removal follow the key down from the root, O(","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"text":"σ","type":"text"}],"type":"emphasis"},{"text":") for a key of ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" symbols","type":"text"},{"text":" ","type":"text"},{"text":"and at most ","type":"text"},{"inlineContent":[{"type":"text","text":"σ"}],"type":"emphasis"},{"text":" children per vertex. A trie answers the queries a hash set cannot: every key","type":"text"},{"text":" ","type":"text"},{"text":"with a prefix, whether any key has one, and the longest key that is a prefix of a query.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let words = Trie([\"car\", \"cart\", \"cat\", \"dog\"])","words.contains(\"cat\")                                   \/\/ true","words.elements(withPrefix: \"car\").map { String($0) }    \/\/ [\"car\", \"cart\"]","words.longestPrefix(of: \"carton\").map { String($0) }    \/\/ \"cart\""]},{"type":"paragraph","inlineContent":[{"text":"Iteration visits each key before the keys it is a prefix of. When the symbols are","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":", each vertex keeps its children sorted, so the keys come in lexicographic order;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise children come in the order they were first added.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices live in flat arrays with "},{"type":"codeVoi